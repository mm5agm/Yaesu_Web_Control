<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <!-- Same reason as the main project: a Mac/Linux `dotnet restore` of the
         Windows TFM graph must be allowed to evaluate this companion exe
         even though it is never published there. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Yaesu_Sdr_Worker</AssemblyName>
    <RootNamespace>Yaesu_Web_Control.Workers.Sdr</RootNamespace>
    <!-- Match the main app's platform so P/Invoke into sdrplay_api.dll works. -->
    <UseWindowsForms>false</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MathNet.Numerics" Version="5.0.0" />
  </ItemGroup>

  <!--
    File-linking from the main project's Services/Sdr/ folder. Single source of
    truth for the SDR device code — both projects compile the same source files.
    Later (step 2 of the dual-SDR refactor) we may extract to a proper class
    library; for now linking keeps the diff small.
  -->
  <ItemGroup>
    <Compile Include="..\..\Services\Sdr\ISdrDevice.cs"        Link="LinkedSdr\ISdrDevice.cs"        />
    <Compile Include="..\..\Services\Sdr\SdrDeviceInfo.cs"     Link="LinkedSdr\SdrDeviceInfo.cs"     />
    <Compile Include="..\..\Services\Sdr\SdrplayDevice.cs"     Link="LinkedSdr\SdrplayDevice.cs"     />
    <Compile Include="..\..\Services\Sdr\SdrplayDllResolver.cs" Link="LinkedSdr\SdrplayDllResolver.cs" />
    <Compile Include="..\..\Services\Sdr\SoapySdrDevice.cs"    Link="LinkedSdr\SoapySdrDevice.cs"    />
    <Compile Include="..\..\Services\Sdr\SoapySdrInterop.cs"   Link="LinkedSdr\SoapySdrInterop.cs"   />
    <Compile Include="..\..\Services\Sdr\SpectrumProcessor.cs" Link="LinkedSdr\SpectrumProcessor.cs" />
    <Compile Include="..\..\Services\Sdr\WireProtocol.cs"      Link="LinkedSdr\WireProtocol.cs"      />
  </ItemGroup>

</Project>
