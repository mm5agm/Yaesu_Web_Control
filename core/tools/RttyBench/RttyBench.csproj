<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- net10.0, like the library it tests: the bench is a plain console app
         and nothing in it wants Windows. -->
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>RadioWebControl.Core.Tools.RttyBench</RootNamespace>
    <AssemblyName>RttyBench</AssemblyName>
    <!-- No PackageReference, for the same reason the library has none. -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\RadioWebControl.Core.csproj" />
  </ItemGroup>

</Project>
