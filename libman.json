{
  "version": "1.0",
  "defaultProvider": "cdnjs",
  "libraries": [
    {
      "library": "bootstrap@5.3.3",
      "destination": "wwwroot/lib/bootstrap/",
      "files": [
        "dist/css/bootstrap.min.css",
        "dist/css/bootstrap.min.css.map",
        "dist/js/bootstrap.bundle.min.js",
        "dist/js/bootstrap.bundle.min.js.map"
      ]
    },
    {
      "library": "jquery@3.7.1",
      "destination": "wwwroot/lib/jquery/",
      "files": [
        "dist/jquery.min.js",
        "dist/jquery.min.map"
      ]
    },
    {
      "provider": "jsdelivr",
      "library": "canvas-gauges@2.1.7",
      "destination": "wwwroot/lib/canvas-gauges/",
      "files": [
        "gauge.min.js"
      ]
    },
    {
      "library": "microsoft-signalr@8.0.0",
      "destination": "wwwroot/lib/microsoft-signalr/",
      "files": [
        "signalr.min.js"
      ]
    },
    {
      "provider": "jsdelivr",
      "library": "bootstrap-icons@1.11.3",
      "destination": "wwwroot/lib/bootstrap-icons/",
      "files": [
        "font/bootstrap-icons.min.css",
        "font/fonts/bootstrap-icons.woff2",
        "font/fonts/bootstrap-icons.woff"
      ]
    },
    {
      "provider": "jsdelivr",
      "library": "@fontsource/barlow-condensed@5.3.0",
      "destination": "wwwroot/lib/fonts/barlow-condensed/",
      "files": [
        "files/barlow-condensed-latin-500-normal.woff2",
        "files/barlow-condensed-latin-600-normal.woff2",
        "files/barlow-condensed-latin-700-normal.woff2",
        "LICENSE"
      ]
    },
    {
      "provider": "jsdelivr",
      "library": "@fontsource/share-tech-mono@5.3.0",
      "destination": "wwwroot/lib/fonts/share-tech-mono/",
      "files": [
        "files/share-tech-mono-latin-400-normal.woff2",
        "LICENSE"
      ]
    }
  ]
}
