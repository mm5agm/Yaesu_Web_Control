<?xml version="1.0" encoding="utf-8"?>
<!-- nuget.org, plus local-packages/ for YaesuAccScope (the ACC scope library
     from github.com/mm5agm/Yaesu_ACC_Spectrum), which isn't on nuget.org yet.
     The package is checked in so CI and the Docker build restore without the
     ACC repository. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="local-packages" value="local-packages" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="local-packages">
      <package pattern="YaesuAccScope" />
    </packageSource>
  </packageSourceMapping>
</configuration>
