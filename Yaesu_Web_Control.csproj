<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RollForward>Minor</RollForward>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OutputType>WinExe</OutputType>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>wwwroot\favicon.ico</ApplicationIcon>

    <!-- Disable automatic content inclusion so we can manage wwwroot ourselves -->
    <EnableDefaultContentItems>false</EnableDefaultContentItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="publish\**" />
    <Compile Remove="oldFiles\**" />
    <Compile Remove="oldFiles/Backup/**" />
    <Content Remove="oldFiles/Backup/**" />
    <EmbeddedResource Remove="oldFiles/Backup/**" />
    <None Remove="oldFiles/Backup/**" />
    <Compile Remove="YaesuCatNew\**" />
    <Content Remove="YaesuCatNew\**" />
    <EmbeddedResource Remove="YaesuCatNew\**" />
    <None Remove="YaesuCatNew\**" />
    <Compile Remove="BenchmarkSuite1\**" />
    <Content Remove="BenchmarkSuite1\**" />
    <EmbeddedResource Remove="BenchmarkSuite1\**" />
    <None Remove="BenchmarkSuite1\**" />
    <!-- Workers/ is its own .csproj subtree (separate exe per SDR for the
         dual-SDR architecture — see docs/decisions/0001-dual-sdr-architecture.md).
         Exclude it from this project's compilation so main YWC doesn't try to
         absorb the worker's Program.cs and double-define AssemblyInfo. -->
    <Compile Remove="Workers\**" />
    <Content Remove="Workers\**" />
    <EmbeddedResource Remove="Workers\**" />
    <None Remove="Workers\**" />
    <!-- scripts/probe/ is also its own .csproj (the SDRplay probe) -->
    <Compile Remove="scripts\probe\**" />
    <Content Remove="scripts\probe\**" />
    <EmbeddedResource Remove="scripts\probe\**" />
    <None Remove="scripts\probe\**" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Models\RigState.cs" />
    <Compile Remove="Pages\Ports..cshtml.cs" />
    <Compile Remove="Pages\Shared\_BandButtonsPartial.cshtml.cs" />
    <Compile Remove="Services\CatPollingService.cs" />
    <Compile Remove="Services\IRigStateService.cs" />
    <Compile Remove="Services\RigStateService.cs" />
    <Compile Remove="Services\SerialPortCatClient.cs" />
  </ItemGroup>

  <ItemGroup>
    <Content Remove="layout-old.cshtml" />
  </ItemGroup>

  <ItemGroup>
    <None Include=".github\FUNDING.yml" />
    <None Include=".github\workflows\release.yml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Markdig" Version="1.2.0" />
    <PackageReference Include="MathNet.Numerics" Version="5.0.0" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="System.IO.Ports" Version="10.0.1" />
  </ItemGroup>

  <!--
    Yaesu_Sdr_Worker is a separate-process companion (see
    docs/decisions/0001-dual-sdr-architecture.md). YWC main spawns it at
    runtime to hold each SDR. ReferenceOutputAssembly=false because the
    worker is an .exe, not a library — we don't want to link against it,
    we just want MSBuild to build it before us and the post-build copy
    target below to land its output next to YWC's exe.
  -->
  <ItemGroup>
    <ProjectReference Include="Workers\Yaesu_Sdr_Worker\Yaesu_Sdr_Worker.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <Private>false</Private>
      <SkipGetTargetFrameworkProperties>true</SkipGetTargetFrameworkProperties>
    </ProjectReference>
  </ItemGroup>

  <!-- Make the worker's build output participate in YWC's standard
       output + publish copy. CopyToOutputDirectory lands it in bin/
       for `dotnet run`; CopyToPublishDirectory lands it in publish/
       for `dotnet publish` (used by installer.nsi). The worker's
       ProjectReference above guarantees these files exist by the
       time YWC's copy runs.

       Two ItemGroups because the worker's output folder differs
       depending on whether a RuntimeIdentifier is set:
         - `dotnet build`  /  `dotnet run`  → no RID → output at
           bin/<config>/<tfm>/
         - `dotnet publish -r win-x64`     → RID set → output at
           bin/<config>/<tfm>/<rid>/
       The CI workflow uses the latter (RID=win-x64) for the
       installer; local dev typically uses the former. v2.3.0 shipped
       with only the no-RID form and the CI publish failed. -->
  <ItemGroup Condition="'$(RuntimeIdentifier)' == ''">
    <None Include="Workers\Yaesu_Sdr_Worker\bin\$(Configuration)\net10.0-windows\Yaesu_Sdr_Worker.exe" Visible="false">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <Link>Yaesu_Sdr_Worker.exe</Link>
    </None>
    <None Include="Workers\Yaesu_Sdr_Worker\bin\$(Configuration)\net10.0-windows\Yaesu_Sdr_Worker.dll" Visible="false">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <Link>Yaesu_Sdr_Worker.dll</Link>
    </None>
    <None Include="Workers\Yaesu_Sdr_Worker\bin\$(Configuration)\net10.0-windows\Yaesu_Sdr_Worker.deps.json" Visible="false">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <Link>Yaesu_Sdr_Worker.deps.json</Link>
    </None>
    <None Include="Workers\Yaesu_Sdr_Worker\bin\$(Configuration)\net10.0-windows\Yaesu_Sdr_Worker.runtimeconfig.json" Visible="false">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <Link>Yaesu_Sdr_Worker.runtimeconfig.json</Link>
    </None>
  </ItemGroup>

  <ItemGroup Condition="'$(RuntimeIdentifier)' != ''">
    <None Include="Workers\Yaesu_Sdr_Worker\bin\$(Configuration)\net10.0-windows\$(RuntimeIdentifier)\Yaesu_Sdr_Worker.exe" Visible="false">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <Link>Yaesu_Sdr_Worker.exe</Link>
    </None>
    <None Include="Workers\Yaesu_Sdr_Worker\bin\$(Configuration)\net10.0-windows\$(RuntimeIdentifier)\Yaesu_Sdr_Worker.dll" Visible="false">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <Link>Yaesu_Sdr_Worker.dll</Link>
    </None>
    <None Include="Workers\Yaesu_Sdr_Worker\bin\$(Configuration)\net10.0-windows\$(RuntimeIdentifier)\Yaesu_Sdr_Worker.deps.json" Visible="false">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <Link>Yaesu_Sdr_Worker.deps.json</Link>
    </None>
    <None Include="Workers\Yaesu_Sdr_Worker\bin\$(Configuration)\net10.0-windows\$(RuntimeIdentifier)\Yaesu_Sdr_Worker.runtimeconfig.json" Visible="false">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <Link>Yaesu_Sdr_Worker.runtimeconfig.json</Link>
    </None>
  </ItemGroup>

  <PropertyGroup>
    <Version>1.5.6</Version>
    <FileVersion>1.5.6.0</FileVersion>
    <AssemblyVersion>1.5.6.0</AssemblyVersion>
    <AssemblyTitle>Yaesu Web Control</AssemblyTitle>
    <Product>Yaesu Web Control</Product>
    <Description>Browser-based CAT controller for Yaesu HF transceivers</Description>
    <AssemblyName>Yaesu_Web_Control</AssemblyName>
    <RootNamespace>Yaesu_Web_Control</RootNamespace>
    <Company>MM5AGM</Company>
    <Copyright>© 2026 MM5AGM</Copyright>
  </PropertyGroup>
  <!-- Explicitly copy the entire wwwroot folder into the output directory -->
  <ItemGroup>
    <Content Include="wwwroot\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- Copy pictures folder (user manual screenshots served via PhysicalFileProvider) -->
  <ItemGroup>
    <Content Include="pictures\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- Ship USER_MANUAL.md alongside the app so the in-app /UserManual page
       can render it. Read at request time from IWebHostEnvironment.ContentRootPath. -->
  <ItemGroup>
    <Content Include="USER_MANUAL.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- Explicitly include Razor Pages now that EnableDefaultContentItems is false -->
  <ItemGroup>
    <Content Include="Pages\**\*.cshtml" />
    <Content Include="Pages\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>


