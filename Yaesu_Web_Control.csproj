<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFrameworks>net10.0-windows;net10.0</TargetFrameworks>
    <RollForward>Minor</RollForward>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>wwwroot\favicon.ico</ApplicationIcon>
    <!-- Allow restoring/building the Windows TFM on macOS/Linux CI or dev machines
         (packaging still targets win-x64 on Windows runners). -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>

    <!-- Disable automatic content inclusion so we can manage wwwroot ourselves -->
    <EnableDefaultContentItems>false</EnableDefaultContentItems>
  </PropertyGroup>

  <!-- Windows product build: WinForms tray host, voice (SAPI), SDR worker companion. -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
    <OutputType>WinExe</OutputType>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <!-- macOS / Linux CAT-only host: console process, no WinForms / voice / SDR worker. -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="publish\**" />
    <Compile Remove="oldFiles\**" />
    <Compile Remove="oldFiles/Backup/**" />
    <Content Remove="oldFiles/Backup/**" />
    <EmbeddedResource Remove="oldFiles/Backup/**" />
    <None Remove="oldFiles/Backup/**" />
    <Compile Remove="YaesuCatNew\**" />
    <Content Remove="YaesuCatNew\**" />
    <EmbeddedResource Remove="YaesuCatNew\**" />
    <None Remove="YaesuCatNew\**" />
    <Compile Remove="BenchmarkSuite1\**" />
    <Content Remove="BenchmarkSuite1\**" />
    <EmbeddedResource Remove="BenchmarkSuite1\**" />
    <None Remove="BenchmarkSuite1\**" />
    <!-- Workers/ is its own .csproj subtree (separate exe per SDR for the
         dual-SDR architecture — see docs/decisions/0001-dual-sdr-architecture.md).
         Exclude it from this project's compilation so main YWC doesn't try to
         absorb the worker's Program.cs and double-define AssemblyInfo. -->
    <Compile Remove="Workers\**" />
    <Content Remove="Workers\**" />
    <EmbeddedResource Remove="Workers\**" />
    <None Remove="Workers\**" />
    <!-- scripts/probe/ is also its own .csproj (the SDRplay probe) -->
    <Compile Remove="scripts\probe\**" />
    <Content Remove="scripts\probe\**" />
    <EmbeddedResource Remove="scripts\probe\**" />
    <None Remove="scripts\probe\**" />
    <!-- core/ is the Radio_Web_Control_Core git subtree and is its own .csproj
         (ProjectReference below), the same arrangement as Workers/ above. The
         Web SDK globs **/*.cs, so without this removal every file in there is
         compiled TWICE — once into RadioWebControl.Core.dll and once straight
         into this assembly — which surfaces as duplicate-type errors rather
         than as anything naming the real cause. -->
    <Compile Remove="core\**" />
    <Content Remove="core\**" />
    <EmbeddedResource Remove="core\**" />
    <None Remove="core\**" />
    <!-- tools/ holds standalone bench utilities, each its own .csproj (CwBench
         is a console harness that runs the Core CW decoder over a .wav file).
         Same reason as core/ above: the Web SDK globs **/*.cs, and a second
         Program.cs in this assembly is an error that names neither the file
         nor the cause. -->
    <Compile Remove="tools\**" />
    <Content Remove="tools\**" />
    <EmbeddedResource Remove="tools\**" />
    <None Remove="tools\**" />
  </ItemGroup>

  <!-- Radio-agnostic code shared with Icom Web Control. Pulled in as a git
       subtree, NOT a submodule, so a plain `git clone` of this repository still
       builds with no extra steps. Deliberately NOT conditioned on
       TargetFramework: the core targets net10.0, which both this project's
       Windows TFM and its macOS/Linux CAT-only TFM can load. See core/README.md
       for the subtree commands. -->
  <ItemGroup>
    <ProjectReference Include="core\RadioWebControl.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Models\RigState.cs" />
    <Compile Remove="Pages\Ports..cshtml.cs" />
    <Compile Remove="Pages\Shared\_BandButtonsPartial.cshtml.cs" />
    <Compile Remove="Services\CatPollingService.cs" />
    <Compile Remove="Services\IRigStateService.cs" />
    <Compile Remove="Services\RigStateService.cs" />
    <Compile Remove="Services\SerialPortCatClient.cs" />
  </ItemGroup>

  <!-- CAT-only TFM: omit WinForms tray, SAPI/NAudio voice stack, and
       FolderBrowserDialog-based SDR controller. VCTuneRecognizer stays
       (intent dispatch for VC-Tune UI); its GrammarBuilder surface is
       #if WINDOWS. Mac menu-bar tray lives in MacSystemTrayService. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <Compile Remove="Services\SystemTrayService.cs" />
    <Compile Remove="Controllers\SdrController.cs" />
    <Compile Remove="Controllers\VoiceController.cs" />
    <Compile Remove="Services\Voice\VoiceControlService.cs" />
    <Compile Remove="Services\Voice\VoiceGrammar.cs" />
    <Compile Remove="Services\Voice\VoiceTtsService.cs" />
    <Compile Remove="Services\Voice\MicrophoneCapture.cs" />
    <Compile Remove="Services\Voice\AudioOutput.cs" />
    <Compile Remove="Services\Voice\IntentDispatcher.cs" />
    <Compile Remove="Services\Voice\VoicePhraseStore.cs" />
    <Compile Remove="Services\Voice\VoiceHelpBuilder.cs" />
    <Compile Remove="Services\Voice\VoicePhraseValidator.cs" />
  </ItemGroup>

  <!-- Windows TFM does not need the Avalonia-backed macOS tray. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
    <Compile Remove="Services\MacSystemTrayService.cs" />
  </ItemGroup>

  <ItemGroup>
    <Content Remove="layout-old.cshtml" />
  </ItemGroup>

  <ItemGroup>
    <None Include=".github\FUNDING.yml" />
    <None Include=".github\workflows\release.yml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Concentus" Version="2.2.2" />
    <PackageReference Include="Markdig" Version="1.2.0" />
    <PackageReference Include="MathNet.Numerics" Version="5.0.0" />
    <PackageReference Include="PortAudioSharp2" Version="1.0.6" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.Async" Version="2.1.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="System.IO.Ports" Version="10.0.1" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
    <!-- System.Speech: Windows SAPI 5 grammar-based speech recognition.
         In-process voice control, replaces the parked Alexa work. See
         docs/VoiceControl/v1-plan.md. -->
    <PackageReference Include="System.Speech" Version="10.0.1" />
    <!-- NAudio.WinMM: WaveIn/WaveOut (MME) device enumeration + capture/playback
         only. Lets the user pick a specific microphone and announcement speaker
         in Settings — System.Speech can bind only to the Windows *default*
         recording/playback device or to a raw audio Stream, so we capture the
         chosen mic ourselves (48 kHz/16-bit/mono, fed to SAPI via
         SetInputToAudioStream) and render+play confirmations to the chosen
         speaker. See Services/Voice/MicrophoneCapture.cs and AudioOutput.cs.
         WinMM subset keeps WASAPI/MediaFoundation out. -->
    <PackageReference Include="NAudio.WinMM" Version="2.2.1" />
  </ItemGroup>

  <!-- Avalonia TrayIcon for the macOS menu-bar status item on the CAT-only host.
       Pin Tmds.DBus.Protocol above the vulnerable 0.21.2 pulled transitively by
       Avalonia's Linux backend (NU1903 / GHSA-xrw6-gwf8-vvr9). -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Avalonia.Desktop" Version="11.3.9" />
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.94.2" />
  </ItemGroup>

  <!-- Voice control grammar files shipped alongside the exe so
       VoiceControlService can load them at startup. Only .srgs is shipped;
       the README in this folder is documentation, not loaded by code. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
    <Content Include="Grammars\*.srgs">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <!--
    Yaesu_Sdr_Worker is a separate-process companion (see
    docs/decisions/0001-dual-sdr-architecture.md). YWC main spawns it at
    runtime to hold each SDR. ReferenceOutputAssembly=false because the
    worker is an .exe, not a library — we don't want to link against it,
    we just want MSBuild to build it before us and the post-build copy
    target below to land its output next to YWC's exe.
  -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
    <ProjectReference Include="Workers\Yaesu_Sdr_Worker\Yaesu_Sdr_Worker.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <Private>false</Private>
      <SkipGetTargetFrameworkProperties>true</SkipGetTargetFrameworkProperties>
    </ProjectReference>
  </ItemGroup>

  <!-- Make the worker's build output participate in YWC's standard
       output + publish copy. CopyToOutputDirectory lands it in bin/
       for `dotnet run`; CopyToPublishDirectory lands it in publish/
       for `dotnet publish` (used by installer.nsi). The worker's
       ProjectReference above guarantees these files exist by the
       time YWC's copy runs.

       Two ItemGroups because the worker's output folder differs
       depending on whether a RuntimeIdentifier is set:
         - `dotnet build`  /  `dotnet run`  → no RID → output at
           bin/<config>/<tfm>/
         - `dotnet publish -r win-x64`     → RID set → output at
           bin/<config>/<tfm>/<rid>/
       The CI workflow uses the latter (RID=win-x64) for the
       installer; local dev typically uses the former. v2.3.0 shipped
       with only the no-RID form and the CI publish failed. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows' And '$(RuntimeIdentifier)' == ''">
    <None Include="Workers\Yaesu_Sdr_Worker\bin\$(Configuration)\net10.0-windows\Yaesu_Sdr_Worker.exe" Visible="false" Condition="Exists('Workers\Yaesu_Sdr_Worker\bin\$(Configuration)\net10.0-windows\Yaesu_Sdr_Worker.exe')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <Link>Yaesu_Sdr_Worker.exe</Link>
    </None>
    <None Include="Workers\Yaesu_Sdr_Worker\bin\$(Configuration)\net10.0-windows\Yaesu_Sdr_Worker.dll" Visible="false" Condition="Exists('Workers\Yaesu_Sdr_Worker\bin\$(Configuration)\net10.0-windows\Yaesu_Sdr_Worker.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <Link>Yaesu_Sdr_Worker.dll</Link>
    </None>
    <None Include="Workers\Yaesu_Sdr_Worker\bin\$(Configuration)\net10.0-windows\Yaesu_Sdr_Worker.deps.json" Visible="false" Condition="Exists('Workers\Yaesu_Sdr_Worker\bin\$(Configuration)\net10.0-windows\Yaesu_Sdr_Worker.deps.json')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <Link>Yaesu_Sdr_Worker.deps.json</Link>
    </None>
    <None Include="Workers\Yaesu_Sdr_Worker\bin\$(Configuration)\net10.0-windows\Yaesu_Sdr_Worker.runtimeconfig.json" Visible="false" Condition="Exists('Workers\Yaesu_Sdr_Worker\bin\$(Configuration)\net10.0-windows\Yaesu_Sdr_Worker.runtimeconfig.json')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <Link>Yaesu_Sdr_Worker.runtimeconfig.json</Link>
    </None>
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows' And '$(RuntimeIdentifier)' != ''">
    <None Include="Workers\Yaesu_Sdr_Worker\bin\$(Configuration)\net10.0-windows\$(RuntimeIdentifier)\Yaesu_Sdr_Worker.exe" Visible="false" Condition="Exists('Workers\Yaesu_Sdr_Worker\bin\$(Configuration)\net10.0-windows\$(RuntimeIdentifier)\Yaesu_Sdr_Worker.exe')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <Link>Yaesu_Sdr_Worker.exe</Link>
    </None>
    <None Include="Workers\Yaesu_Sdr_Worker\bin\$(Configuration)\net10.0-windows\$(RuntimeIdentifier)\Yaesu_Sdr_Worker.dll" Visible="false" Condition="Exists('Workers\Yaesu_Sdr_Worker\bin\$(Configuration)\net10.0-windows\$(RuntimeIdentifier)\Yaesu_Sdr_Worker.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <Link>Yaesu_Sdr_Worker.dll</Link>
    </None>
    <None Include="Workers\Yaesu_Sdr_Worker\bin\$(Configuration)\net10.0-windows\$(RuntimeIdentifier)\Yaesu_Sdr_Worker.deps.json" Visible="false" Condition="Exists('Workers\Yaesu_Sdr_Worker\bin\$(Configuration)\net10.0-windows\$(RuntimeIdentifier)\Yaesu_Sdr_Worker.deps.json')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <Link>Yaesu_Sdr_Worker.deps.json</Link>
    </None>
    <None Include="Workers\Yaesu_Sdr_Worker\bin\$(Configuration)\net10.0-windows\$(RuntimeIdentifier)\Yaesu_Sdr_Worker.runtimeconfig.json" Visible="false" Condition="Exists('Workers\Yaesu_Sdr_Worker\bin\$(Configuration)\net10.0-windows\$(RuntimeIdentifier)\Yaesu_Sdr_Worker.runtimeconfig.json')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <Link>Yaesu_Sdr_Worker.runtimeconfig.json</Link>
    </None>
  </ItemGroup>

  <PropertyGroup>
    <Version>2.4.3</Version>
    <FileVersion>2.4.3.0</FileVersion>
    <AssemblyVersion>2.4.3.0</AssemblyVersion>
    <AssemblyTitle>Yaesu Web Control</AssemblyTitle>
    <Product>Yaesu Web Control</Product>
    <Description>Browser-based CAT controller for Yaesu HF transceivers</Description>
    <AssemblyName>Yaesu_Web_Control</AssemblyName>
    <RootNamespace>Yaesu_Web_Control</RootNamespace>
    <Company>MM5AGM</Company>
    <Copyright>© 2026 MM5AGM</Copyright>
  </PropertyGroup>
  <!-- Explicitly copy the entire wwwroot folder into the output directory -->
  <ItemGroup>
    <Content Include="wwwroot\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- Copy pictures folder (user manual screenshots served via PhysicalFileProvider) -->
  <ItemGroup>
    <Content Include="pictures\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- Ship USER_MANUAL.md alongside the app so the in-app /UserManual page
       can render it. Read at request time from IWebHostEnvironment.ContentRootPath. -->
  <ItemGroup>
    <Content Include="USER_MANUAL.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- Explicitly include Razor Pages now that EnableDefaultContentItems is false -->
  <ItemGroup>
    <Content Include="Pages\**\*.cshtml" />
    <Content Include="Pages\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- Shared browser modules from the Radio_Web_Control_Core subtree (core/js).
       The engine is authored once in core/js and copied into wwwroot at build
       time; the copies are git-ignored so core/js stays the single source of
       truth (see core/js/README.md). Runs before AssignTargetPaths so the
       freshly-copied files are first-class Content THIS build, not next build:
       EnableDefaultContentItems is false and the wwwroot glob above is evaluated
       before any target runs, so on a clean checkout the file is absent when the
       glob is computed and would 404 until a second build. Exclude="@(Content)"
       drops anything that glob already found on a later build, so we never add a
       duplicate Content item. -->
  <Target Name="CopySharedCoreJs" BeforeTargets="AssignTargetPaths">
    <ItemGroup>
      <_SharedCoreJs Include="core\js\**\*.js" />
    </ItemGroup>
    <Copy SourceFiles="@(_SharedCoreJs)"
          DestinationFiles="@(_SharedCoreJs->'wwwroot\js\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
    <ItemGroup>
      <Content Include="@(_SharedCoreJs->'wwwroot\js\%(RecursiveDir)%(Filename)%(Extension)')"
               Exclude="@(Content)">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
    </ItemGroup>
  </Target>

</Project>
