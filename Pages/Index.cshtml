                                       style="flex: 1; height: 16px;"
                                       oninput="document.getElementById('manualNotchFreqValueA').textContent = this.value + ' Hz'; window.radioControl.setManualNotchFreq('A', this.value)">
                                <span id="manualNotchFreqValueA" class="vfo-control-label" style="min-width: 52px; text-align: right;">@Model.RadioState.ManualNotchFreqA Hz</span>
                            </div>
                            <div class="vfo-control-item" style="grid-column: 1 / -1;">
                                <label class="vfo-control-label">RF Gain</label>
                                <input type="range" id="rfGainSliderA" aria-label="VFO A RF gain" title="VFO A RF gain (0=min, 255=max)" min="0" max="255" step="1" value="@Model.RadioState.RfGainA"
                                       style="flex: 1; height: 16px;"
                                       oninput="document.getElementById('rfGainValueA').textContent = this.value"
                                       onchange="setRfGain('A', this.value)">
