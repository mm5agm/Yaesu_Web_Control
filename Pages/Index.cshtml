<!-- VOX Dialog -->
<dialog id="voxDialog" style="border:1px solid #555; border-radius:8px; background:#222; color:#eee; padding:0; min-width:280px;" aria-labelledby="voxDialogTitle">
    <div class="d-flex align-items-center justify-content-between px-3 py-2" style="border-bottom:1px solid #444;">
        <strong id="voxDialogTitle">VOX Controls</strong>
        <button class="btn btn-sm ywc-dialog-close" onclick="document.getElementById('voxDialog').close()" aria-label="Close VOX controls">✕</button>
    </div>
    <div class="p-3 d-flex flex-column gap-2">
        <div class="d-flex align-items-center gap-2">
            <button id="voxOnBtn" class="btn btn-sm @(Model.VoxOn ? "btn-warning" : "btn-outline-secondary")"
                    onclick="toggleVox()" aria-label="VOX on/off" title="Toggle VOX">
                @(Model.VoxOn ? "VOX On" : "VOX Off")
            </button>
        </div>
        <div class="d-flex align-items-center gap-2">
            <label class="mb-0 text-nowrap" style="min-width:90px;">VOX Gain: <span id="voxGainValue">@Model.VoxGain</span></label>
            <input type="range" id="voxGainSlider" min="0" max="100" step="1" value="@Model.VoxGain"
                   style="flex:1; height:18px;"
                   oninput="document.getElementById('voxGainValue').textContent = this.value"
                   onchange="setVoxGain(this.value)"
                   aria-label="VOX gain" title="VOX sensitivity">
        </div>
        <div class="d-flex align-items-center gap-2">
            <label class="mb-0 text-nowrap" style="min-width:90px;">Delay ms: <span id="voxDelayValue">@Model.VoxDelay</span></label>
            <input type="range" id="voxDelaySlider" min="0" max="2500" step="50" value="@Model.VoxDelay"
                   style="flex:1; height:18px;"
                   oninput="document.getElementById('voxDelayValue').textContent = this.value"
                   onchange="setVoxDelay(this.value)"
                   aria-label="VOX delay" title="VOX drop delay in ms">
        </div>
        <div class="d-flex align-items-center gap-2">
            <label class="mb-0 text-nowrap" style="min-width:90px;">Anti-VOX: <span id="antiVoxValue">@Model.AntiVoxGain</span></label>
            <input type="range" id="antiVoxSlider" min="0" max="100" step="1" value="@Model.AntiVoxGain"
                   style="flex:1; height:18px;"
                   oninput="document.getElementById('antiVoxValue').textContent = this.value"
                   onchange="setAntiVoxGain(this.value)"
                   aria-label="Anti-VOX gain" title="Anti-VOX sensitivity">
        </div>
    </div>
</dialog>

<!-- FM Repeater Dialog -->
<dialog id="fmDialog" style="border:1px solid #555; border-radius:8px; background:#222; color:#eee; padding:0; min-width:300px;" aria-labelledby="fmDialogTitle">
    <div class="d-flex align-items-center justify-content-between px-3 py-2" style="border-bottom:1px solid #444;">
        <strong id="fmDialogTitle">FM Repeater</strong>
        <button class="btn btn-sm ywc-dialog-close" onclick="document.getElementById('fmDialog').close()" aria-label="Close FM repeater controls">✕</button>
    </div>
    <div class="p-3 d-flex flex-column gap-2">
        <div class="d-flex align-items-center gap-2">
            <label class="mb-0 text-nowrap" style="min-width:80px;">Shift:</label>
            <select id="fmShiftSelect" class="form-select form-select-sm" style="width:auto;"
                    aria-label="Repeater shift direction" title="Repeater shift direction"
                    onchange="setFmShift(this.value)">
                <option value="0" selected="@(Model.FmShiftDir=="0"?"selected":null)">None</option>
                <option value="1" selected="@(Model.FmShiftDir=="1"?"selected":null)">Up (+)</option>
                <option value="2" selected="@(Model.FmShiftDir=="2"?"selected":null)">Down (−)</option>
                <option value="3" selected="@(Model.FmShiftDir=="3"?"selected":null)">Split</option>
            </select>
        </div>
        <div class="d-flex align-items-center gap-2">
            <label class="mb-0 text-nowrap" style="min-width:80px;">Offset kHz:</label>
            <input type="number" id="fmOffsetInput" min="0" max="999999" step="100"
                   value="@(Model.FmOffsetHz / 1000)"
                   class="form-control form-control-sm" style="width:90px;"
                   aria-label="Repeater offset in kHz" title="Repeater frequency offset in kHz"
                   onchange="setFmOffset(parseInt(this.value) * 1000)">
            <span>kHz</span>
        </div>
        <div class="d-flex align-items-center gap-2">
            <label class="mb-0 text-nowrap" style="min-width:80px;">CTCSS:</label>
            <select id="ctcssModeSelect" class="form-select form-select-sm" style="width:auto;"
                    aria-label="CTCSS mode" title="CTCSS encode/decode mode"
                    onchange="setCtcssMode(this.value)">
                @* Values are CT's P1P2 for MAIN: P1=0, P2 per CAT manual p.8 —
                   0 OFF, 1 CTCSS ENC/DEC, 2 CTCSS ENC. The radio has exactly
                   these three. The old list labelled 01 "Encode" (it is encode
                   AND decode) and 02 "Decode" (it is encode only), and offered
                   a fourth "Tone-Dec" 03 that no Yaesu accepts. (2026-08-17) *@
                <option value="00" selected="@(Model.CtcssMode=="00"?"selected":null)">OFF</option>
                <option value="01" selected="@(Model.CtcssMode=="01"?"selected":null)">Enc/Dec</option>
                <option value="02" selected="@(Model.CtcssMode=="02"?"selected":null)">Encode</option>
            </select>
        </div>
        <div class="d-flex align-items-center gap-2">
            <label class="mb-0 text-nowrap" style="min-width:80px;">Tone Hz:</label>
            <select id="ctcssToneSelect" class="form-select form-select-sm" style="width:auto;"
                    aria-label="CTCSS tone" title="CTCSS tone frequency"
                    onchange="setCtcssTone(this.value)">
                @foreach (var t in ctcssTones)
                {
                    <option value="@t.Code" selected="@(Model.CtcssTone==t.Code?"selected":null)">@t.Label Hz</option>
                }
            </select>
        </div>
        <button class="btn btn-sm btn-primary mt-1" onclick="saveFmRepeater()" title="Apply FM repeater settings to radio" aria-label="Apply FM repeater settings to radio">Apply</button>
    </div>
</dialog>

<!-- CW Keyer Dialog -->
<dialog id="cwDialog" style="border:1px solid #555; border-radius:8px; background:#222; color:#eee; padding:0; min-width:320px;" aria-labelledby="cwDialogTitle">
    <div class="d-flex align-items-center justify-content-between px-3 py-2" style="border-bottom:1px solid #444;">
        <strong id="cwDialogTitle">CW Keyer</strong>
        <button class="btn btn-sm ywc-dialog-close" onclick="document.getElementById('cwDialog').close()" aria-label="Close CW keyer controls">✕</button>
    </div>
    <div class="p-3 d-flex flex-column gap-2">
        <div class="d-flex align-items-center gap-2">
            <label class="mb-0 text-nowrap" style="min-width:100px;">Speed WPM: <span id="cwSpeedValue">@Model.CwSpeed</span></label>
            <input type="range" id="cwSpeedSlider" min="4" max="60" step="1" value="@Model.CwSpeed"
                   style="flex:1; height:18px;"
                   oninput="document.getElementById('cwSpeedValue').textContent = this.value"
                   onchange="setCwSpeed(this.value)"
                   aria-label="CW keyer speed" title="CW keyer speed in WPM">
            <button type="button" class="btn btn-sm btn-outline-light flex-shrink-0"
                    onclick="cwZeroIn()"
                    title="CW Auto Zero In — nudges the active VFO so the received CW signal sits at your preferred pitch"
                    aria-label="CW Auto Zero In">ZIN</button>
        </div>
        <div class="d-flex align-items-center gap-2">
            <label class="mb-0 text-nowrap" style="min-width:100px;">Break-in:</label>
            <select id="cwBreakInSelect" class="form-select form-select-sm" style="width:auto;"
                    aria-label="CW break-in mode" title="CW break-in mode"
                    onchange="setCwBreakIn(this.value)">
                <option value="0" selected="@(Model.CwBreakIn=="0"?"selected":null)">Off</option>
                <option value="1" selected="@(Model.CwBreakIn=="1"?"selected":null)">Semi BK-IN</option>
                <option value="2" selected="@(Model.CwBreakIn=="2"?"selected":null)">Full BK-IN</option>
            </select>
        </div>
        <div class="d-flex align-items-center gap-2">
            <label class="mb-0 text-nowrap" style="min-width:100px;">BK-IN Delay: <span id="cwDelayValue">@Model.CwBreakInDelay</span> ms</label>
            <input type="range" id="cwDelaySlider" min="0" max="2500" step="50" value="@Model.CwBreakInDelay"
                   style="flex:1; height:18px;"
                   oninput="document.getElementById('cwDelayValue').textContent = this.value"
                   onchange="setCwBreakInDelay(this.value)"
                   aria-label="CW break-in delay" title="Semi break-in delay in ms">
        </div>
        <div class="d-flex align-items-center gap-2">
            <label class="mb-0 text-nowrap" style="min-width:100px;">Pitch: <span id="cwPitchHz">@(300 + Model.CwPitch * 10)</span> Hz</label>
            <input type="range" id="cwPitchSlider" min="0" max="75" step="1" value="@Model.CwPitch"
                   style="flex:1; height:18px;"
                   oninput="document.getElementById('cwPitchHz').textContent = 300 + parseInt(this.value) * 10"
                   onchange="setCwPitch(this.value)"
                   aria-label="CW pitch frequency" title="CW sidetone pitch (300–1050 Hz)">
        </div>
        <hr style="border-color:#444; margin:4px 0;">
        <div class="fw-bold small" style="color:#aaa;">Memory Keyer</div>
        @for (int mi = 0; mi < 5; mi++) {
        <div class="d-flex align-items-center gap-1">
            <button class="btn btn-sm btn-outline-info flex-shrink-0" id="cwMemBtn@(mi)"
                    onclick="sendCwMessage(@mi)"
                    title="Send CW message M@(mi+1)"
                    aria-label="Send CW memory @(mi+1)">M@(mi+1)</button>
            <input type="text" id="cwMsg@(mi)" value="@(Model.CwMessages.Count > mi ? Model.CwMessages[mi] : "")"
                   class="form-control form-control-sm" maxlength="50"
                   placeholder="CW message @(mi+1)"
                   aria-label="CW message @(mi+1)" title="CW memory @(mi+1) text">
        </div>
        }
        <div id="cwKeyerStatus" class="small mt-1" role="status" aria-live="polite" style="min-height:1.2em; color:#aaa;"></div>
        <button class="btn btn-sm btn-primary mt-1" onclick="saveCwMessages()" title="Save CW message memories" aria-label="Save CW memory messages to settings">Save Messages</button>
    </div>
</dialog>

