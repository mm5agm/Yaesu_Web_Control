@page
@model Yaesu_Web_Control.Pages.IndexModel
@{
    ViewData["Title"]     = "Yaesu Web Control";
    ViewData["BodyRole"]  = "application";
    ViewData["BodyLabel"] = "Yaesu radio control panel";
    var allModes = new[] {
        "LSB", "USB", "CW-U", "CW-L", "FM", "FM-N", "AM", "AM-N", "RTTY-L", "RTTY-U",
        "DATA-L", "DATA-U", "DATA-FM", "DATA-FM-N", "PSK"
    };
    // Display label shown in the dropdown — value stays as the CAT mode string.
    string ModeLabel(string m) => m == "DATA-FM-N" ? "D-FM-N" : m;

    bool isFtdx10  = Model.RadioModel == "FTdx10";
    bool isFt710   = Model.RadioModel == "FT-710";
    bool isFtdx3000 = Model.RadioModel == "FTDX3000";

    // Single-receiver radios (FTdx10, FT-710, FTDX3000) store per-VFO RX
    // settings but expose only the active VFO's state via CAT — see
    // docs/decisions/0003-single-vs-dual-receiver-ui.md. The home page
    // greys out the inactive VFO panel on these radios to reflect that
    // editing it via CAT would silently swap the radio's active VFO.
    // Dual-receiver radios (FTdx101MP/D) keep both panels active because
    // each VFO is its own physical receiver chain.
    bool isSingleReceiver  = Yaesu_Web_Control.Services.RadioCapabilities.IsSingleReceiver(Model.RadioModel);
    bool hasAntennaSelector = Yaesu_Web_Control.Services.RadioCapabilities.HasAntennaSelector(Model.RadioModel);
    // Render VC Tune controls only when both the model supports VC Tune (FTdx101MP)
    // AND the hardware ID is positively confirmed to support VT CAT commands.
    // Empty/unknown ID → hidden (user can reload once radio connects and ID; is received).
    bool hasVcTune    = Yaesu_Web_Control.Services.RadioCapabilities.SupportsVCTuneMain(Model.RadioModel)
                     && Yaesu_Web_Control.Services.RadioCapabilities.SupportsVCTuneCat(Model.RadioState.Id);
    bool hasVcTuneSub = Yaesu_Web_Control.Services.RadioCapabilities.SupportsVCTuneSubStatic(Model.RadioModel);

    string clarModeInit = (Model.RadioState.RxClarOn, Model.RadioState.TxClarOn) switch
    {
        (true, true)  => "rxtx",
        (true, false) => "rx",
        (false, true) => "tx",
        _             => "off"
    };

    int contourMaxFreq = isFtdx3000 ? 4000 : 3200;
    int contourStep    = isFtdx3000 ? 100  : 10;
    int apfStep        = isFtdx3000 ? 25   : 10;

    // IF Width options differ by model. Values match the SH command code sent to the radio.
    var ifWidthOptions = isFtdx10
        ? new (string Value, string Label)[]
        {
            // FTdx10 SH codes: code 0 is the wide 3 kHz default; codes 1-22 run narrow→wide.
            ("0","3.0 kHz"),
            ("1","300 Hz"), ("2","400 Hz"), ("3","600 Hz"), ("4","850 Hz"),
            ("5","1.1 kHz"), ("6","1.2 kHz"), ("7","1.5 kHz"), ("8","1.65 kHz"),
            ("9","1.8 kHz"), ("10","1.95 kHz"), ("11","2.1 kHz"), ("12","2.25 kHz"),
            ("13","2.4 kHz"), ("14","2.45 kHz"), ("15","2.5 kHz"), ("16","2.6 kHz"),
            ("17","2.7 kHz"), ("18","2.8 kHz"), ("19","2.9 kHz"), ("20","3.2 kHz"),
            ("21","3.5 kHz"), ("22","4.0 kHz")
        }
        : isFt710
        ? new (string Value, string Label)[]
        {
            ("0","300 Hz"), ("2","600 Hz"), ("3","850 Hz"), ("5","1.2 kHz"),
            ("7","1.65 kHz"), ("9","1.95 kHz"), ("12","2.4 kHz"), ("16","2.7 kHz"),
            ("19","3.0 kHz"), ("20","3.2 kHz"), ("21","3.5 kHz"), ("22","4.0 kHz")
        }
        : isFtdx3000
        ? new (string Value, string Label)[]
        {
            ("1","200 Hz"), ("2","400 Hz"), ("3","600 Hz"), ("4","850 Hz"),
            ("6","1.35 kHz"), ("7","1.5 kHz"), ("9","1.8 kHz"), ("12","2.2 kHz"),
            ("14","2.4 kHz"), ("16","2.6 kHz"), ("18","2.8 kHz"), ("20","3.0 kHz"),
            ("22","3.4 kHz"), ("25","4.0 kHz")
        }
        : new (string Value, string Label)[]
        {
            // FTdx101MP/D SH codes. The 2308-L CAT manual documents 0-21; current
            // firmware (verified empirically by Colin on the FTdx101MP, #50)
            // extends to code 23 = 4.0 kHz, with code 22 = 3.5 kHz between them.
            // Code 0 is the radio's mode-dependent default (3 kHz with a 3 kHz
            // roofing filter in SSB); codes 1-21 run narrow→wide as per the
            // manual, then 22/23 add the wider SSB filters.
            ("0","3.0 kHz"),
            ("1","300 Hz"), ("2","400 Hz"), ("3","600 Hz"), ("4","850 Hz"),
            ("5","1.1 kHz"), ("6","1.2 kHz"), ("7","1.5 kHz"), ("8","1.65 kHz"),
            ("9","1.8 kHz"), ("10","1.95 kHz"), ("11","2.1 kHz"), ("12","2.2 kHz"),
            ("13","2.3 kHz"), ("14","2.4 kHz"), ("15","2.5 kHz"), ("16","2.6 kHz"),
            ("17","2.7 kHz"), ("18","2.8 kHz"), ("19","2.9 kHz"), ("20","3.0 kHz"),
            ("21","3.2 kHz"), ("22","3.5 kHz"), ("23","4.0 kHz")
        };
    string ifWidthDefaultA = isFtdx10 ? "0" : isFt710 ? "12" : isFtdx3000 ? "14" : "0";
    string ifWidthDefaultB = isFtdx10 ? "0" : isFt710 ? "12" : isFtdx3000 ? "14" : "0";

    // Roofing filter options: FTdx101MP/D only (FTdx10 and FT-710 have no CAT roofing filter control).
    // RF command codes 6-A, filtered to only fitted filters per Settings.
    var roofingOptions = new (string Value, string Label)[]
            { ("A","300 Hz"), ("9","600 Hz"), ("8","1.2 kHz"), ("7","3 kHz"), ("6","12 kHz") }
            .Where(o => Model.InstalledRoofingFilters.Contains(o.Value))
            .ToArray();

    // FTDX3000 roofing filter options (codes 0-5; always show standard 0-3, optional 4-5 if fitted).
    var roofingOptions3000 = new (string Value, string Label)[]
            { ("0","Auto"), ("1","15 kHz"), ("2","6 kHz"), ("3","3 kHz"), ("4","600 Hz"), ("5","300 Hz") }
            .Where(o => o.Value == "0" || o.Value == "1" || o.Value == "2" || o.Value == "3"
                     || Model.InstalledRoofingFilters.Contains(o.Value))
            .ToArray();

    // Standard CTCSS tones
    var ctcssTones = new (string Code, string Label)[]
    {
        ("01","67.0"), ("02","69.3"), ("03","71.9"), ("04","74.4"), ("05","77.0"),
        ("06","79.7"), ("07","82.5"), ("08","85.4"), ("09","88.5"), ("10","91.5"),
        ("11","94.8"), ("12","97.4"), ("13","100.0"), ("14","103.5"), ("15","107.2"),
        ("16","110.9"), ("17","114.8"), ("18","118.8"), ("19","123.0"), ("20","127.3"),
        ("21","131.8"), ("22","136.5"), ("23","141.3"), ("24","146.2"), ("25","150.0"),
        ("26","151.4"), ("27","156.7"), ("28","162.2"), ("29","165.5"), ("30","167.9"),
        ("31","171.3"), ("32","173.8"), ("33","177.3"), ("34","179.9"), ("35","183.5"),
        ("36","186.2"), ("37","189.9"), ("38","192.8"), ("39","196.6"), ("40","199.5"),
        ("41","203.5"), ("42","206.5"), ("43","210.7"), ("44","218.1"), ("45","225.7"),
        ("46","229.1"), ("47","233.6"), ("48","241.8"), ("49","250.3"), ("50","254.1")
    };
}

<!-- Cache-busted CSS reference -->
<link rel="stylesheet" href="~/css/site.css?v=20260520a" />
<link rel="stylesheet" href="~/css/closer-to-raw-power.css?v=20260226n" />
<style>
    #saveMemBtnA, #saveMemBtnB { font-weight: 700 !important; font-size: 0.85rem !important; color: #212529 !important; }

    /* Single-receiver radios (FTdx10, FT-710, FTDX3000): the inactive VFO
       card BODY is greyed and made non-interactive. The card HEADER stays
       normal so TX / ZIN / badges remain full-colour and clickable — dimming
       the whole column (including the header) made the TX button look
       disabled in split mode even though it was still active (CSS cannot
       undo a parent's opacity/filter on a child).
       Editing body controls on the inactive section via CAT would silently
       swap the radio's active VFO; better to disable visually and require
       an explicit A/B swap on the rig first.
       See docs/decisions/0003-single-vs-dual-receiver-ui.md
       Reported by Jacek SP3L on #34. */
    .vfo-inactive > .card > .card-body {
        pointer-events: none;
    }
    .vfo-inactive > .card > .card-body > * {
        opacity: 0.55;
        filter: grayscale(0.5);
        transition: opacity 0.25s ease, filter 0.25s ease;
    }
    /* R10/R11 (Jacek SP3L #34): in split mode the inactive panel IS the TX
       VFO and its frequency must remain interactive so operators can set
       the TX frequency from YWC without un-splitting first. .vfo-tx-editable
       is added by applyVfoActiveStyling() only when splitMode>0. The freq
       row is undimmed as a unit (parent opacity cannot be undone on nested
       children), then non-frequency siblings in that row (roofing, AF gain)
       are re-dimmed. */
    .vfo-inactive.vfo-tx-editable > .card > .card-body > .vfo-freq-row {
        opacity: 1;
        filter: none;
    }
    .vfo-inactive.vfo-tx-editable > .card > .card-body > .vfo-freq-row > *:not(.frequency-display):not(.freq-step-controls):not(.fkb-open-btn) {
        opacity: 0.55;
        filter: grayscale(0.5);
        pointer-events: none;
    }
    .vfo-inactive.vfo-tx-editable .frequency-display,
    .vfo-inactive.vfo-tx-editable .freq-step-controls,
    .vfo-inactive.vfo-tx-editable .fkb-open-btn {
        /* pointer-events:auto on a child overrides pointer-events:none on
           an ancestor — that is the CSS exception that makes the carve-out
           work. !important is needed on <button> (fkb-open / ▲▼). */
        pointer-events: auto !important;
    }

    /* Hide live receive indicators on the inactive VFO panel — on a real
       single-receiver radio there is no signal data for the inactive VFO,
       so showing a moving S-meter and a scrolling history would be
       misleading (suggests a signal is being received when nothing is).
       Display:none rather than visibility:hidden so the panel shrinks
       and the active panel's prominence is reinforced. */
    .vfo-inactive .analog-meter-container,
    .vfo-inactive .smeter-history-container {
        display: none !important;
    }
</style>

<!-- Message Box Modal (Windows-style) -->
<div class="modal fade" id="messageBoxModal" tabindex="-1" aria-labelledby="messageBoxTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 400px;">
        <div class="modal-content" style="border-radius: 4px; border: 2px solid #dc3545;">
            <div class="modal-header py-2" style="background: linear-gradient(to bottom, #dc3545, #c82333); border-bottom: 1px solid #bd2130;">
                <h6 class="modal-title text-white" id="messageBoxTitle" style="font-size: 0.9rem;">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>Warning
                </h6>
            </div>
            <div class="modal-body py-3" style="background: #fff;">
                <p id="messageBoxText" class="mb-0" style="font-size: 0.9rem; color: #000;"></p>
            </div>
            <div class="modal-footer py-2 justify-content-center" style="background: #f8f9fa; border-top: 1px solid #dee2e6;">
                <button type="button" class="btn btn-danger btn-sm px-4" data-bs-dismiss="modal" style="min-width: 80px;">OK</button>
            </div>
        </div>
    </div>
</div>

<!-- Overlay for initialization status -->
<div id="initOverlay" class="init-overlay">
    <div class="init-message">
        <span id="initStatusText">Initializing radio, please wait...</span>
        <div class="spinner-border text-primary" role="status"></div>
    </div>
</div>

<!-- Viewport too-narrow warning (shown once, dismissible) -->
<div id="viewportWarning" class="alert alert-warning alert-dismissible mb-1 py-1 px-3" role="alert" style="display:none; font-size:0.85rem;">
    <strong>Display settings may need attention.</strong>
    Your browser viewport appears narrow — meter gauges may wrap to a second row.
    Check <strong>Windows Display Settings</strong>: ensure resolution is set to native and scaling is correct for your monitor
    (recommended: <strong>150%</strong> for 4K, <strong>125%</strong> for 1440p, <strong>100%</strong> for 1080p).
    <button type="button" class="btn-close btn-sm py-2" onclick="dismissViewportWarning()" aria-label="Dismiss"></button>
</div>

<div class="row mb-1" style="padding-top: 2px; padding-bottom: 2px;">
        @if (Model.ShowApp1Button)
        {
            <div class="col-auto">
                <button id="wsjtxBtn" class="btn btn-secondary btn-sm" style="padding-top: 1px; padding-bottom: 1px;"
                        onclick="launchWsjtx()" title="Launch @Model.App1Name" aria-label="Launch @Model.App1Name">
                    @Model.App1Name
                    <span id="wsjtxTxBadge" class="badge bg-danger ms-1" style="display:none;">TX</span>
                </button>
            </div>
        }
        @if (Model.ShowApp3Button)
        {
            <div class="col-auto">
                <button id="log4omBtn" class="btn btn-secondary btn-sm" style="padding-top: 1px; padding-bottom: 1px;"
                        onclick="launchLog4om()" title="Launch @Model.App3Name" aria-label="Launch @Model.App3Name">
                    @Model.App3Name
                </button>
            </div>
        }
        @if (Model.ShowApp2Button)
        {
            <div class="col-auto">
                <button id="jtalertBtn" class="btn btn-secondary btn-sm" style="padding-top: 1px; padding-bottom: 1px;"
                        onclick="launchJtalert()" title="Launch @Model.App2Name" aria-label="Launch @Model.App2Name">
                    @Model.App2Name
                </button>
            </div>
        }
        @if (Model.ShowApp4Button)
        {
            <div class="col-auto">
                <button id="gridtrackerBtn" class="btn btn-secondary btn-sm" style="padding-top: 1px; padding-bottom: 1px;"
                        onclick="launchGridtracker()" title="Launch @Model.App4Name" aria-label="Launch @Model.App4Name">
                    @Model.App4Name
                </button>
            </div>
        }
        @if (Model.ShowApp5Button)
        {
            <div class="col-auto">
                <button id="fldigiBtn" class="btn btn-secondary btn-sm" style="padding-top: 1px; padding-bottom: 1px;"
                        onclick="launchFldigi()" title="Launch @Model.App5Name" aria-label="Launch @Model.App5Name">
                    @Model.App5Name
                </button>
            </div>
        }
        <div class="col-auto ms-auto d-flex gap-2 align-items-center">
            <span id="utcClock"
                  class="font-monospace fw-bold px-2"
                  style="font-size:0.95rem; color:#ffe066; background:#222; border:1px solid #444; border-radius:4px; padding-top: 1px; padding-bottom: 1px; cursor:help;"
                  title="UTC time from your PC system clock. Drifts if Windows can't reach time.windows.com. Click for details and how to verify."
                  onclick="document.getElementById('utcClockInfoDialog').show()"
                  aria-live="off"
                  aria-label="Current UTC time. Click for source and accuracy details.">--:--:--Z</span>
            <a href="https://paypal.me/mm5agm" target="_blank" rel="noopener noreferrer"
               class="btn btn-warning btn-sm" style="padding-top: 1px; padding-bottom: 1px;" title="Support this project via PayPal"
               aria-label="Support this project via PayPal — Buy Me a Coffee">
                <i class="bi bi-cup-hot-fill" aria-hidden="true"></i> Buy Me a Coffee
            </a>
            <button id="memBtn" class="btn btn-sm btn-outline-info fw-bold"
                    style="padding-top: 1px; padding-bottom: 1px; color: #000;" title="Open memories panel"
                    aria-label="Open memories panel">
                Mem
            </button>
            <button id="sMeterHistoryToggleBtn" class="btn btn-sm btn-outline-secondary"
                    style="padding-top: 1px; padding-bottom: 1px;"
                    title="Show/hide 30-second S-meter history strip (QSB, noise spikes, noise floor)"
                    aria-label="Show or hide the S-meter history strip"
                    aria-pressed="false">
                S-hist
            </button>
            <button id="vfoBToggleBtn" class="btn btn-sm btn-outline-secondary"
                    style="padding-top: 1px; padding-bottom: 1px;" title="Show/Hide VFO-B"
                    aria-label="Show or hide VFO B panel">
                VFO-B
            </button>
            <button id="swapVfoBtn" class="btn btn-sm btn-outline-secondary"
                    style="padding-top: 1px; padding-bottom: 1px;" title="Swap VFO A and VFO B frequencies"
                    aria-label="Swap VFO A and VFO B frequencies">
                A&#8596;B
            </button>
            <button id="copyBtoABtn" class="btn btn-sm btn-outline-secondary"
                    style="padding-top: 1px; padding-bottom: 1px;"
                    title="Copy VFO B frequency &amp; mode to VFO A. VFO B is left unchanged. Useful for transmitting on VFO B's settings without enabling split."
                    aria-label="Copy VFO B to VFO A">
                B&rarr;A
            </button>
            <button id="copyAtoBBtn" class="btn btn-sm btn-outline-secondary"
                    style="padding-top: 1px; padding-bottom: 1px;"
                    title="Copy VFO A frequency &amp; mode to VFO B. VFO A is left unchanged. Useful for seeding VFO B from VFO A before adjusting one of them."
                    aria-label="Copy VFO A to VFO B">
                A&rarr;B
            </button>
            <button id="splitBtn" class="btn btn-sm btn-outline-secondary"
                    style="padding-top: 1px; padding-bottom: 1px;" title="Toggle Split: VFO A = receive, VFO B = transmit"
                    aria-label="Toggle split mode: VFO A receive, VFO B transmit">
                Split
            </button>
            <button id="quickSplitBtn" class="btn btn-sm btn-outline-secondary"
                    style="padding-top: 1px; padding-bottom: 1px;" title="Quick Split: enable split and set VFO B to VFO A + 5 kHz"
                    aria-label="Quick split: enable split and set VFO B to VFO A plus 5 kHz">
                +5k
            </button>
            <button id="connectBtn" class="btn btn-danger btn-sm"
                    onclick="toggleCatConnection()" style="padding-top: 1px; padding-bottom: 1px;" title="Connect or disconnect CAT serial port"
                    aria-label="CAT serial connection — currently disconnected">
                <i class="bi bi-plug" aria-hidden="true"></i> Disconnected
            </button>
            <button id="radioPowerBtn" class="btn btn-danger btn-sm"
                    onclick="toggleRadioPower()" style="padding-top: 1px; padding-bottom: 1px;" title="Radio Power On/Off"
                    aria-label="Radio power on or off">
                <i class="bi bi-power" aria-hidden="true"></i> POWER
            </button>
        </div>
    </div>

    <!-- (Status line moved inside each VFO panel — see #vfoAStatusLine / #vfoBStatusLine) -->

    <!-- Power and SWR Meters -->
    <div class="row mt-3">
        <div class="col-12">
            <div class="card border-secondary">
                <div class="card-body py-2">
                    <!-- Gauges row -->
                    <div class="d-flex justify-content-start align-items-start flex-wrap" style="margin-left: 0; gap: 0; margin-bottom: 0.2rem !important;">
                        <!-- S-Meter rolling history strip — leftmost so the live trace
                             reads left-to-right toward the S-meter needle. Hidden
                             until the toolbar's S-hist toggle is on. Sized to match
                             the meter cells alongside it. Moved from inside the VFO
                             panels in v2.3.9 (Jacek SP3L #34 / Colin's design call).
                             v2.4.0: restored as a VFO A / VFO B pair — dual-receiver
                             radios (FTdx101MP/D) have an independently calibrated
                             S-meter per receiver (SM0;/SM1;); single-receiver radios
                             only get the VFO A pair since there's no SUB receiver. -->
                        <div id="sMeterHistoryContainer"
                             class="text-center smeter-history-container"
                             style="display:none; position: relative; height: 135px; width: 260px; flex-shrink: 0; margin: 0; padding: 0;">
                            <canvas id="sMeterHistoryCanvas"
                                    role="img" aria-hidden="true"
                                    aria-label="S-meter 30-second history — VFO A"
                                    data-a11y-key="meters.smeterHistoryA"
                                    style="display:block; width:100%; height:100%; border-radius:3px;"></canvas>
                        </div>
                        <!-- S-Meter A (MAIN) — moved from per-VFO panels to the top
                             row in v2.3.9. Always live (unlike SWR/Power/etc which
                             are TX-only). -->
                        <div class="text-center" style="position: relative; height: 135px; min-width: 165px; margin: 0; padding: 0;">
                            <div class="analog-meter-container">
                                <canvas id="sMeterCanvas" role="img" aria-hidden="true" aria-label="S meter A" data-a11y-key="meters.smeterA"></canvas>
                            </div>
                        </div>
                        @if (!isSingleReceiver)
                        {
                            <!-- S-Meter B (SUB) — dual-receiver radios only. -->
                            <div id="sMeterHistoryContainerB"
                                 class="text-center smeter-history-container"
                                 style="display:none; position: relative; height: 135px; width: 260px; flex-shrink: 0; margin: 0; padding: 0;">
                                <canvas id="sMeterHistoryCanvasB"
                                        role="img" aria-hidden="true"
                                        aria-label="S-meter 30-second history — VFO B"
                                        data-a11y-key="meters.smeterHistoryB"
                                        style="display:block; width:100%; height:100%; border-radius:3px;"></canvas>
                            </div>
                            <div class="text-center" style="position: relative; height: 135px; min-width: 165px; margin: 0; padding: 0;">
                                <div class="analog-meter-container">
                                    <canvas id="sMeterCanvasB" role="img" aria-hidden="true" aria-label="S meter B" data-a11y-key="meters.smeterB"></canvas>
                                </div>
                            </div>
                        }
                        <!-- SWR Meter -->
                        <div class="text-center" style="position: relative; height: 135px; min-width: 165px; margin: 0; padding: 0;">
                            <div class="analog-meter-container">
                                <canvas id="swrMeterCanvas" role="img" aria-hidden="true" aria-label="SWR meter" data-a11y-key="meters.swr"></canvas>
                            </div>
                        </div>
                        <!-- Power Meter -->
                        <div class="text-center power-meter-container" style="position: relative; height: 135px; min-width: 165px; margin: 0; padding: 0;">
                            <div class="analog-meter-container">
                                <canvas id="powerMeterCanvas" role="img" aria-hidden="true" aria-label="Power output meter" data-a11y-key="meters.power"></canvas>
                            </div>
                        </div>
                        <!-- Compression Meter -->
                        <div class="text-center" style="position: relative; height: 135px; min-width: 165px; margin: 0; padding: 0;">
                            <div class="analog-meter-container">
                                <canvas id="compressionMeterCanvas" role="img" aria-hidden="true" aria-label="Compression meter" data-a11y-key="meters.compression"></canvas>
                            </div>
                        </div>
                        <!-- ALC Meter -->
                        <div class="text-center" style="position: relative; height: 135px; min-width: 165px; margin: 0; padding: 0;">
                            <div class="analog-meter-container">
                                <canvas id="alcMeterCanvas" role="img" aria-hidden="true" aria-label="ALC meter" data-a11y-key="meters.alc"></canvas>
                            </div>
                        </div>
                        @if (!isFtdx10 && !isFt710) {
                        <!-- PA Temperature Meter — FTdx101/FTDX3000 only (high-voltage PA board) -->
                        <div class="text-center" style="position: relative; height: 135px; min-width: 165px; margin: 0; padding: 0;">
                            <div class="analog-meter-container">
                                <canvas id="tempMeterCanvas" role="img" aria-hidden="true" aria-label="Amplifier temperature meter" data-a11y-key="meters.temp"></canvas>
                            </div>
                        </div>
                        <!-- IDD Meter — FTdx101/FTDX3000 only -->
                        <div class="text-center" style="position: relative; height: 135px; min-width: 165px; margin: 0; padding: 0;">
                            <div class="analog-meter-container">
                                <canvas id="iddMeterCanvas" role="img" aria-hidden="true" aria-label="Drain current meter" data-a11y-key="meters.idd"></canvas>
                            </div>
                        </div>
                        <!-- VDD Meter — FTdx101/FTDX3000 only -->
                        <div class="text-center" style="position: relative; height: 135px; min-width: 165px; margin: 0; padding: 0;">
                            <div class="analog-meter-container">
                                <canvas id="vddMeterCanvas" role="img" aria-hidden="true" aria-label="Amplifier supply voltage meter" data-a11y-key="meters.vdd"></canvas>
                            </div>
                        </div>
                        }
                    </div>
                    <!-- Power and MIC Gain on one row.
                         padding-left: 260px reserves the same width as the
                         S-meter history strip in the meter row above (whether
                         the strip is currently visible or not), so the Power
                         label always sits directly under the S-meter gauge
                         rather than under the (sometimes-hidden) history
                         strip. v2.3.9 layout change.
                         Padding on the flex container itself rather than a
                         spacer child -- a child element would have its own
                         flex slot and (with flex-wrap on) the spillover items
                         would wrap to a new line at x=0, defeating the point. -->
                    <div class="d-flex align-items-center gap-2 mb-2 closer-to-raw-power" style="margin-top: -18px !important; flex-wrap: wrap; padding-left: 280px;">
                        <label class="mb-0 text-nowrap">Power: <span id="powerValue" class="fw-bold">@Model.RadioState.Power W</span></label>
                        <input type="range" class="flex-shrink-0" id="powerSlider"
                               aria-label="Transmit power"
                               title="Transmit power"
                               min="5" max="200" step="5"
                               value="@Model.RadioState.Power"
                               style="width: clamp(80px, 10vw, 150px); height: 18px;"
                               oninput="window.radioControl.updatePowerDisplay(window.txVfo === 1 ? 'B' : 'A', this.value)"
                               onchange="window.radioControl.setPower(window.txVfo === 1 ? 'B' : 'A', this.value)">
                        <label class="mb-0 text-nowrap ms-2"><span id="micGainLabel">MIC Gain</span>: <span id="micGainValue" class="fw-bold">@Model.MicGain</span></label>
                        <input type="range" class="flex-shrink-0"
                               id="micGainSlider"
                               aria-label="Microphone gain"
                               title="Microphone gain"
                               min="0" max="100" step="1"
                               value="@Model.MicGain"
                               style="width: clamp(80px, 10vw, 150px); height: 18px;"
                               oninput="document.getElementById('micGainValue').innerText = this.value;"
                               onchange="setMicGain(this.value);">
                        <button id="procBtn"
                                class="btn btn-sm ms-2 @(Model.ProcEnabled ? "btn-success" : "btn-outline-secondary")"
                                aria-label="Speech processor"
                                title="Speech processor on/off"
                                onclick="toggleProc()">@(Model.ProcEnabled ? "Proc On" : "Proc Off")</button>
                        <label class="mb-0 text-nowrap ms-2">PROC Level: <span id="procLevelValue" class="fw-bold">@Model.ProcLevel</span></label>
                        <input type="range" class="flex-shrink-0"
                               id="procLevelSlider"
                               aria-label="Speech processor level"
                               title="Speech processor level"
                               min="0" max="100" step="1"
                               value="@Model.ProcLevel"
                               style="width: clamp(80px, 10vw, 150px); height: 18px;"
                               oninput="document.getElementById('procLevelValue').innerText = this.value;"
                               onchange="setProcLevel(this.value);">
                        <button id="atuBtn"
                                class="btn btn-sm ms-2 @(Model.AtuEnabled ? "btn-success" : "btn-outline-secondary")"
                                aria-label="Antenna tuner — short tap toggles on/off, long press starts auto-tune"
                                title="Tap to toggle ATU on/off; press and hold to start auto-tune"
                                style="touch-action: manipulation; user-select: none;">@(Model.AtuEnabled ? "ATU On" : "ATU Off")</button>
                        <button id="monitorOnBtn"
                                class="btn btn-sm ms-2 @(Model.MonitorOn ? "btn-warning" : "btn-outline-secondary")"
                                aria-label="TX monitor — currently @(Model.MonitorOn ? "on" : "off")"
                                title="Toggle TX monitor / sidetone on/off"
                                onclick="toggleMonitor()">Mon</button>
                        <label class="mb-0 text-nowrap ms-1"><span id="monLevelValue" class="fw-bold">@Model.MonitorLevelA</span></label>
                        <input type="range" class="flex-shrink-0"
                               id="monLevelSlider"
                               aria-label="TX monitor / sidetone level"
                               title="TX monitor / sidetone level"
                               min="0" max="100" step="1"
                               value="@Model.MonitorLevelA"
                               style="width: clamp(60px, 8vw, 110px); height: 18px;"
                               oninput="document.getElementById('monLevelValue').innerText = this.value;"
                               onchange="setMonitorLevel(this.value);">
                        <button id="voxBtn"
                                class="btn btn-sm ms-2 @(Model.VoxOn ? "btn-warning" : "btn-outline-secondary")"
                                aria-label="VOX controls"
                                title="Open VOX controls panel"
                                onclick="document.getElementById('voxDialog').show()">VOX</button>
                        <button class="btn btn-sm ms-1 btn-outline-secondary"
                                aria-label="CW keyer controls"
                                title="Open CW keyer controls panel"
                                onclick="document.getElementById('cwDialog').show()">CW</button>
                        <button class="btn btn-sm ms-1 btn-outline-secondary"
                                aria-label="FM repeater controls"
                                title="Open FM repeater controls panel"
                                onclick="document.getElementById('fmDialog').show()">FM Rep</button>
                        <button class="btn btn-sm ms-1 btn-outline-secondary"
                                aria-label="DX watch — alerts for spotted callsigns"
                                title="Open DX watch list — get alerts when watched callsigns are spotted"
                                onclick="document.getElementById('dxWatchDialog').show(); window.refreshDxWatchList && window.refreshDxWatchList();">DX Watch</button>
                        <button class="btn btn-sm ms-1 btn-outline-secondary"
                                aria-label="DX spots — list of cluster spots on current band"
                                title="Open DX spots list — see callsigns spotted on the current band"
                                onclick="window.dxSpotsPanel && window.dxSpotsPanel.toggle()">DX Spots</button>
                        <button id="voiceBtn"
                                class="btn btn-sm ms-1 btn-outline-secondary"
                                aria-label="Voice announcements settings"
                                title="Voice announcements for band, mode, TX state etc. — useful for partially sighted operators"
                                onclick="document.getElementById('voiceDialog').show();">Voice</button>
                    </div>

                </div>
            </div>
        </div>
    </div>

    <!-- Spectrum Display — dual-VFO layout (v2.3.0+).
         Each panel has its own canvas. Mono A / Mono B / Multi toggle below
         hides/shows individual panels. Outer container hides itself when no
         SDR is configured for either VFO. -->
    <div id="spectrumContainer" class="row mt-3" style="display:none;">
        <div class="col-12">
            <!-- Toggles row: VFO selector + layout (stacked vs side-by-side).
                 Both hidden when only one side is configured. -->
            <div id="spectrumModeToggle" class="d-flex justify-content-end align-items-center gap-2 mb-2" style="display:none;">
                <div class="btn-group btn-group-sm" role="group" aria-label="Spectrum panel layout">
                    <button type="button" class="btn btn-outline-secondary spectrum-layout-btn active" data-layout="stacked" title="Stack panels vertically">Stacked</button>
                    <button type="button" class="btn btn-outline-secondary spectrum-layout-btn" data-layout="side" title="Place panels side by side">Side&nbsp;by&nbsp;side</button>
                </div>
                <div class="btn-group btn-group-sm" role="group" aria-label="Spectrum visible VFO">
                    <button type="button" class="btn btn-outline-secondary spectrum-mode-btn" data-mode="A">VFO A</button>
                    <button type="button" class="btn btn-outline-secondary spectrum-mode-btn" data-mode="B">VFO B</button>
                    <button type="button" class="btn btn-outline-secondary spectrum-mode-btn active" data-mode="Multi">Both</button>
                </div>
            </div>

            <!-- Inner flex container — direction set by JS based on layout toggle.
                 flex-column (default) = stacked vertically.
                 flex-row             = side by side, each panel takes half the width. -->
            <div id="spectrumPanels" class="d-flex flex-column gap-2">
                <!-- VFO A spectrum panel.
                     flex:1 1 0 (not flex-fill = 1 1 auto) so two side-by-side
                     panels split evenly regardless of header content width.
                     Without this, a longer status-badge text on one side
                     pulls that card wider than the other. -->
                <div id="spectrumContainerA" class="card border-dark" style="flex: 1 1 0; min-width:0;">
                    <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center py-1">
                        <span class="small fw-bold"><i class="bi bi-broadcast-pin me-1" aria-hidden="true"></i>Spectrum — VFO A</span>
                        <div class="d-flex align-items-center gap-2">
                            <div class="btn-group btn-group-sm" role="group" aria-label="VFO A spectrum span">
                                <button type="button" class="btn btn-outline-light btn-sm span-btn @(Model.SdrSampleRateHzA == 62_500 ? "active" : "")" data-hz="62500" data-vfo="A" data-a11y-key="spectrum.spanA62k" aria-label="VFO A span 62.5 kHz" title="VFO A span 62.5 kHz — narrowest available, best for a single QSO">62.5k</button>
                                <button type="button" class="btn btn-outline-light btn-sm span-btn @(Model.SdrSampleRateHzA == 125_000 ? "active" : "")" data-hz="125000" data-vfo="A" data-a11y-key="spectrum.spanA125k" aria-label="VFO A span 125 kHz" title="VFO A span 125 kHz — best for narrow bands like 30m / 60m">125k</button>
                                <button type="button" class="btn btn-outline-light btn-sm span-btn @(Model.SdrSampleRateHzA == 250_000 ? "active" : "")" data-hz="250000" data-vfo="A" data-a11y-key="spectrum.spanA250k" aria-label="VFO A span 250 kHz" title="VFO A span 250 kHz">250k</button>
                                <button type="button" class="btn btn-outline-light btn-sm span-btn @(Model.SdrSampleRateHzA == 500_000 ? "active" : "")" data-hz="500000" data-vfo="A" data-a11y-key="spectrum.spanA500k" aria-label="VFO A span 500 kHz" title="VFO A span 500 kHz">500k</button>
                                <button type="button" class="btn btn-outline-light btn-sm span-btn @(Model.SdrSampleRateHzA == 1_024_000 ? "active" : "")" data-hz="1024000" data-vfo="A" data-a11y-key="spectrum.spanA1m" aria-label="VFO A span 1 MHz" title="VFO A span 1 MHz">1M</button>
                                <button type="button" class="btn btn-outline-light btn-sm span-btn @(Model.SdrSampleRateHzA == 2_048_000 ? "active" : "")" data-hz="2048000" data-vfo="A" data-a11y-key="spectrum.spanA2m" aria-label="VFO A span 2 MHz" title="VFO A span 2 MHz">2M</button>
                            </div>
                            <button type="button" class="btn btn-outline-light btn-sm spectrum-hold-btn" data-vfo="A" title="Freeze this spectrum at the current frame so you can study it. Click again to resume live streaming.">Hold</button>
                            <span id="spectrumStatusBadgeA" class="badge bg-secondary small">—</span>
                        </div>
                    </div>
                    <div class="spectrum-dsp-bar d-flex align-items-center gap-2 px-2 py-1 small" data-vfo="A">
                        <label class="text-nowrap mb-0" title="Display floor — bins below this dB level are clamped (SDR Console &quot;Low&quot;)">Low</label>
                        <input type="range" class="form-range spectrum-low-slider" data-vfo="A" min="-160" max="-60" step="1" value="@((int)Math.Round(Model.SdrSpectrumLowDbA))" aria-label="VFO A spectrum Low (dB floor)" style="flex:1; min-width:60px;">
                        <span class="text-monospace spectrum-low-label" data-vfo="A" style="min-width:3.5em; text-align:right;">@((int)Math.Round(Model.SdrSpectrumLowDbA))</span>
                        <label class="text-nowrap mb-0 ms-2" title="Display ceiling — bins above this dB level are clamped (SDR Console &quot;High&quot;)">High</label>
                        <input type="range" class="form-range spectrum-high-slider" data-vfo="A" min="-100" max="0" step="1" value="@((int)Math.Round(Model.SdrSpectrumHighDbA))" aria-label="VFO A spectrum High (dB ceiling)" style="flex:1; min-width:60px;">
                        <span class="text-monospace spectrum-high-label" data-vfo="A" style="min-width:3.5em; text-align:right;">@((int)Math.Round(Model.SdrSpectrumHighDbA))</span>
                        <label class="text-nowrap mb-0 ms-2" title="Pre-dB digital gain — brightens the whole trace so weak signals climb into the Low/High window. Does not change the frequency span (use the kHz/MHz buttons for that).">Gain</label>
                        <input type="range" class="form-range spectrum-gain-slider" data-vfo="A" min="0" max="30" step="1" value="@((int)Math.Round(20.0 * Math.Log10(Math.Max(0.0001, (double)Model.SdrSpectrumGainA))))" aria-label="VFO A spectrum digital gain (dB)" style="flex:1; min-width:60px;">
                        <span class="text-monospace spectrum-gain-label" data-vfo="A" style="min-width:3.5em; text-align:right;">+@((int)Math.Round(20.0 * Math.Log10(Math.Max(0.0001, (double)Model.SdrSpectrumGainA)))) dB</span>
                        <label class="text-nowrap mb-0 ms-2" title="How fast the waterfall scrolls, from full speed down to 1/128. Does not affect the spectrum trace above it.">Speed</label>
                        <input type="range" class="form-range spectrum-speed-slider" data-vfo="A" min="0" max="7" step="1" value="0" aria-label="VFO A waterfall scroll speed" style="flex:1; min-width:60px;">
                        <span class="text-monospace spectrum-speed-label" data-vfo="A" style="min-width:3.5em; text-align:right;">Full</span>
                    </div>
                    <div class="card-body p-0">
                        <canvas id="spectrumCanvasA" role="img" aria-hidden="true" aria-label="RF spectrum display VFO A" style="display:block; width:100%;"></canvas>
                    </div>
                </div>

                <!-- VFO B spectrum panel — hidden by default; shown when SdrDeviceKeyB is configured.
                     Same flex:1 1 0 + min-width:0 as A so the two panels stay equal-width
                     in side-by-side layout regardless of badge text content. -->
                <div id="spectrumContainerB" class="card border-dark" style="display:none; flex: 1 1 0; min-width:0;">
                    <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center py-1">
                        <span class="small fw-bold"><i class="bi bi-broadcast-pin me-1" aria-hidden="true"></i>Spectrum — VFO B</span>
                        <div class="d-flex align-items-center gap-2">
                            <div class="btn-group btn-group-sm" role="group" aria-label="VFO B spectrum span">
                                <button type="button" class="btn btn-outline-light btn-sm span-btn @(Model.SdrSampleRateHzB == 62_500 ? "active" : "")" data-hz="62500" data-vfo="B" data-a11y-key="spectrum.spanB62k" aria-label="VFO B span 62.5 kHz" title="VFO B span 62.5 kHz — narrowest available, best for a single QSO">62.5k</button>
                                <button type="button" class="btn btn-outline-light btn-sm span-btn @(Model.SdrSampleRateHzB == 125_000 ? "active" : "")" data-hz="125000" data-vfo="B" data-a11y-key="spectrum.spanB125k" aria-label="VFO B span 125 kHz" title="VFO B span 125 kHz — best for narrow bands like 30m / 60m">125k</button>
                                <button type="button" class="btn btn-outline-light btn-sm span-btn @(Model.SdrSampleRateHzB == 250_000 ? "active" : "")" data-hz="250000" data-vfo="B" data-a11y-key="spectrum.spanB250k" aria-label="VFO B span 250 kHz" title="VFO B span 250 kHz">250k</button>
                                <button type="button" class="btn btn-outline-light btn-sm span-btn @(Model.SdrSampleRateHzB == 500_000 ? "active" : "")" data-hz="500000" data-vfo="B" data-a11y-key="spectrum.spanB500k" aria-label="VFO B span 500 kHz" title="VFO B span 500 kHz">500k</button>
                                <button type="button" class="btn btn-outline-light btn-sm span-btn @(Model.SdrSampleRateHzB == 1_024_000 ? "active" : "")" data-hz="1024000" data-vfo="B" data-a11y-key="spectrum.spanB1m" aria-label="VFO B span 1 MHz" title="VFO B span 1 MHz">1M</button>
                                <button type="button" class="btn btn-outline-light btn-sm span-btn @(Model.SdrSampleRateHzB == 2_048_000 ? "active" : "")" data-hz="2048000" data-vfo="B" data-a11y-key="spectrum.spanB2m" aria-label="VFO B span 2 MHz" title="VFO B span 2 MHz">2M</button>
                            </div>
                            <button type="button" class="btn btn-outline-light btn-sm spectrum-hold-btn" data-vfo="B" title="Freeze this spectrum at the current frame so you can study it. Click again to resume live streaming.">Hold</button>
                            <span id="spectrumStatusBadgeB" class="badge bg-secondary small">—</span>
                        </div>
                    </div>
                    <div class="spectrum-dsp-bar d-flex align-items-center gap-2 px-2 py-1 small" data-vfo="B">
                        <label class="text-nowrap mb-0" title="Display floor — bins below this dB level are clamped (SDR Console &quot;Low&quot;)">Low</label>
                        <input type="range" class="form-range spectrum-low-slider" data-vfo="B" min="-160" max="-60" step="1" value="@((int)Math.Round(Model.SdrSpectrumLowDbB))" aria-label="VFO B spectrum Low (dB floor)" style="flex:1; min-width:60px;">
                        <span class="text-monospace spectrum-low-label" data-vfo="B" style="min-width:3.5em; text-align:right;">@((int)Math.Round(Model.SdrSpectrumLowDbB))</span>
                        <label class="text-nowrap mb-0 ms-2" title="Display ceiling — bins above this dB level are clamped (SDR Console &quot;High&quot;)">High</label>
                        <input type="range" class="form-range spectrum-high-slider" data-vfo="B" min="-100" max="0" step="1" value="@((int)Math.Round(Model.SdrSpectrumHighDbB))" aria-label="VFO B spectrum High (dB ceiling)" style="flex:1; min-width:60px;">
                        <span class="text-monospace spectrum-high-label" data-vfo="B" style="min-width:3.5em; text-align:right;">@((int)Math.Round(Model.SdrSpectrumHighDbB))</span>
                        <label class="text-nowrap mb-0 ms-2" title="Pre-dB digital gain — brightens the whole trace so weak signals climb into the Low/High window. Does not change the frequency span (use the kHz/MHz buttons for that).">Gain</label>
                        <input type="range" class="form-range spectrum-gain-slider" data-vfo="B" min="0" max="30" step="1" value="@((int)Math.Round(20.0 * Math.Log10(Math.Max(0.0001, (double)Model.SdrSpectrumGainB))))" aria-label="VFO B spectrum digital gain (dB)" style="flex:1; min-width:60px;">
                        <span class="text-monospace spectrum-gain-label" data-vfo="B" style="min-width:3.5em; text-align:right;">+@((int)Math.Round(20.0 * Math.Log10(Math.Max(0.0001, (double)Model.SdrSpectrumGainB)))) dB</span>
                        <label class="text-nowrap mb-0 ms-2" title="How fast the waterfall scrolls, from full speed down to 1/128. Does not affect the spectrum trace above it.">Speed</label>
                        <input type="range" class="form-range spectrum-speed-slider" data-vfo="B" min="0" max="7" step="1" value="0" aria-label="VFO B waterfall scroll speed" style="flex:1; min-width:60px;">
                        <span class="text-monospace spectrum-speed-label" data-vfo="B" style="min-width:3.5em; text-align:right;">Full</span>
                    </div>
                    <div class="card-body p-0">
                        <canvas id="spectrumCanvasB" role="img" aria-hidden="true" aria-label="RF spectrum display VFO B" style="display:block; width:100%;"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3 flex-wrap" id="vfoRow" data-radio-model="@Model.RadioModel" data-single-receiver="@(isSingleReceiver ? "true" : "false")">
        <!-- VFO A Panel -->
        <div class="col-lg-6 col-12" id="vfoACol">
            <div class="card border-primary h-100 receiver-card">
                <div class="card-header bg-primary text-white py-1">
                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-1">
                        <h5 class="mb-0">
                            <span id="receiverAHeading">VFO A</span>
                        </h5>
                        <div class="d-flex align-items-center gap-1 flex-wrap">
                            <span id="splitTxBadgeA" class="badge bg-danger" style="display:none;" aria-live="polite">SPLIT TX</span>
                            <button type="button" id="zinBtnA" class="btn btn-outline-light btn-sm"
                                    onclick="cwZeroIn('A')"
                                    aria-label="VFO A CW Auto Zero In"
                                    title="CW Auto Zero In on VFO A — nudges the VFO so the received CW signal sits at your configured CW pitch">ZIN</button>
                            @if (hasVcTune) {
                            <button type="button" id="vcTuneToggleBtnA" class="btn btn-outline-light btn-sm"
                                    onclick="vcTuneToggle('a')"
                                    aria-label="MAIN VC Tune on/off"
                                    title="Toggle MAIN VC Tune preselector on/off">VC Tune</button>
                            <span id="vcTuneRowA" class="d-inline-flex align-items-center gap-1">
                                <button id="vcTuneDefaultBtnA" class="btn btn-sm btn-outline-light"
                                        onclick="vcTuneCommand('a','default')"
                                        aria-label="MAIN VC Tune default" title="MAIN VC Tune auto-tune">Default</button>
                                <button class="btn btn-sm btn-outline-light"
                                        onclick="vcTuneStep('a','minus')"
                                        aria-label="MAIN VC Tune step down" title="Step MAIN preselector capacitor down">−</button>
                                <select id="vcTuneStepA" class="form-select form-select-sm"
                                        style="width: 3.5rem; background-color: transparent; color: white; border-color: rgba(255,255,255,0.5);"
                                        aria-label="MAIN VC Tune step size" title="Step size (1–9)">
                                    <option value="1" style="color:black;">1</option><option value="2" style="color:black;">2</option><option value="3" style="color:black;">3</option>
                                    <option value="4" style="color:black;">4</option><option value="5" selected style="color:black;">5</option><option value="6" style="color:black;">6</option>
                                    <option value="7" style="color:black;">7</option><option value="8" style="color:black;">8</option><option value="9" style="color:black;">9</option>
                                </select>
                                <button class="btn btn-sm btn-outline-light"
                                        onclick="vcTuneStep('a','plus')"
                                        aria-label="MAIN VC Tune step up" title="Step MAIN preselector capacitor up">+</button>
                                <button id="vcTuneCenterBtnA" class="btn btn-sm btn-outline-light"
                                        onclick="vcTuneCommand('a','center')"
                                        aria-label="MAIN VC Tune center" title="Center MAIN preselector capacitor">Center</button>
                                <span id="vcTuneMeterA" class="small text-white-50" style="font-size: 0.75rem; min-width: 44px;">P5: —</span>
                                <span id="vcTuneWarnA" class="text-warning small" style="display:none; font-size: 0.75rem;"></span>
                            </span>
                            }
                            <button id="txButtonA" class="btn btn-warning btn-sm" style="display:none;"
                                    onclick="toggleTx()" title="Toggle Transmit">
                                <i class="bi bi-broadcast" aria-hidden="true"></i> TX
                            </button>
                        </div>
                    </div>
                </div>
                <div class="card-body p-2">
                    <!-- Receiver Controls Group: Save-to-Mem, Band buttons, Mode select.
                         The S-meter and its history strip moved to the top meter row
                         in v2.3.9 (Jacek SP3L #34, Colin's design call) -- the radio
                         has only one calibrated S-meter, so showing it once at the
                         top is honest. -->
                    <div class="receiver-controls-group d-flex flex-nowrap mb-0 gap-2 align-items-start">
                        <!-- Left: Save-to-Mem button (S-meter moved to top row) -->
                        <div class="flex-shrink-0">
                            <button id="saveMemBtnA" type="button"
                                    class="btn btn-outline-secondary btn-sm"
                                    style="padding:1px 4px;"
                                    onclick="saveVfoToMemory('A')"
                                    aria-label="Save VFO A to memories"
                                    title="Save VFO A frequency, mode and clarifier to app memories">
                                Save to Mem
                            </button>
                            <span id="saveMemStatusA" class="visually-hidden" role="status" aria-live="polite"></span>
                        </div>
                        <!-- Middle: Band buttons + Mode/Antenna below + filter scope -->
                        <div class="flex-grow-1 d-flex flex-column gap-1">
                            @await Html.PartialAsync("_BandButtonsPartial", Tuple.Create("unused", "A", Model.SelectedBandA))
                            <div class="d-flex gap-2 mt-1">
                                <select class="form-select form-select-sm vfo-mode-select" id="modeSelectA"
                                        aria-label="VFO A mode"
                                        title="VFO A mode"
                                        onchange="setMode('A', this.value)">
                                    @foreach (var mode in allModes)
                                    {
                                        @if (Model.RadioState.ModeA == mode)
                                        {
                                            <option value="@mode" selected>@ModeLabel(mode)</option>
                                        }
                                        else
                                        {
                                            <option value="@mode">@ModeLabel(mode)</option>
                                        }
                                    }
                                </select>
                                @if (hasAntennaSelector)
                                {
                                    <select class="form-select form-select-sm vfo-ant-select" id="antennaSelectA"
                                            aria-label="VFO A antenna"
                                            title="VFO A antenna"
                                            onchange="window.radioControl.setAntenna('A', this.value)">
                                        @foreach (var ant in new[] { "1", "2", "3" })
                                        {
                                            @if (Model.RadioState.AntennaA == ant)
                                            {
                                                <option value="@ant" selected>ANT @ant</option>
                                            }
                                            else
                                            {
