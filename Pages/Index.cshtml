        // --- ATU ---
        // Short tap toggles ATU on/off. Press-and-hold (>= 500 ms) starts
        // the radio's auto-tune cycle (CAT command AC002;). Sending AC002;
        // a second time stops it — so during a running tune cycle, any
        // tap on the button also stops it. The Yaesu radios use a single
        // physical button with the same short/long behaviour, so this
        // matches the radio's UX exactly.
        const ATU_LONG_PRESS_MS = 500;
        let atuPressTimer = null;
        let atuLongFired = false;

        async function toggleAtu() {
            const btn = document.getElementById('atuBtn');
            const enabled = btn.getAttribute('aria-pressed') === 'true';
            try {
                await fetch('/api/cat/atu', {
                    method: 'POST', headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ enabled: !enabled })
                });
                updateAtuButton(!enabled);
            } catch (e) { console.error('toggleAtu error:', e); }
        }
        // Yaesu's CAT spec doesn't report tuning-in-progress (AC P2 is
        // "Fixed at 0" in the manual), so the "Tuning…" UI state is driven
        // entirely on the client. We mark the button as tuning immediately
        // after sending AC002;, then auto-clear after a safe upper bound
        // (typical tune cycles are 2-7 s; 8 s is a reasonable margin) and
        // GET /api/cat/atu to sync the settled on/off state.
        const ATU_TUNE_AUTOCLEAR_MS = 8000;
        let atuAutoclearTimer = null;

        // Shared end-of-tune cleanup: query the radio for the settled ATU
        // state and use the response body directly to update the button.
        // We deliberately don't rely on btn.dataset.atuEnabled here because
        // it's only updated when SignalR delivers an AtuEnabled change —
        // and there's an inherent race between the SignalR push and this
        // function reading the dataset. Using the GET response body removes
        // the race entirely.
        async function refreshAtuAfterTune() {
            let finalEnabled = null;
            try {
                const r = await fetch('/api/cat/atu');
                if (r.ok) {
                    const data = await r.json();
                    finalEnabled = (data.atuEnabled === true);
                }
            } catch (e) { console.error('refreshAtuAfterTune fetch error:', e); }
            const btn = document.getElementById('atuBtn');
            if (btn && finalEnabled !== null) {
                btn.dataset.atuEnabled = finalEnabled ? 'true' : 'false';
            }
            updateAtuTuningState(false);
        }

        async function startAtuTune() {
            try {
                await fetch('/api/cat/atu/tune', { method: 'POST' });
                updateAtuTuningState(true);
                clearTimeout(atuAutoclearTimer);
                atuAutoclearTimer = setTimeout(refreshAtuAfterTune, ATU_TUNE_AUTOCLEAR_MS);
            } catch (e) { console.error('startAtuTune error:', e); }
        }

        // User tapped the button while a tune cycle was running. Send the
        // AC002; toggle again to stop the radio, cancel the auto-clear
        // timer, then refresh + clear the UI after a brief settle period.
        // We don't await fetch() — fire-and-forget so the UI clears quickly
        // regardless of HTTP latency.
        async function stopAtuTune() {
            try { fetch('/api/cat/atu/tune', { method: 'POST' }); } catch (e) {}
            clearTimeout(atuAutoclearTimer);
            atuAutoclearTimer = null;
            setTimeout(refreshAtuAfterTune, 500);
        }
        function updateAtuButton(enabled) {
            const btn = document.getElementById('atuBtn');
            if (!btn) return;
            // Only restyle the on/off appearance if we're not mid-tune; the
            // tuning state owns the button look while it's running.
            if (btn.dataset.tuning === 'true') return;
            btn.dataset.atuEnabled = enabled ? 'true' : 'false';
            btn.setAttribute('aria-pressed', enabled ? 'true' : 'false');
            btn.setAttribute('aria-label',
                `Antenna tuner — currently ${enabled ? 'on' : 'off'}; short tap toggles, long press starts auto-tune`);
            const led = btn.querySelector('.toggle-dd__led');
            if (led) led.classList.toggle('is-on', enabled);
            const label = btn.querySelector('.toggle-dd__label');
            if (label) label.textContent = 'ATU';
        }
        // Drives the "Tuning..." visual when the radio reports an auto-tune
        // cycle in progress (AC P2 = 1). Called from the SignalR AtuTuning
        // route in site.js.
        function updateAtuTuningState(tuning) {
            const btn = document.getElementById('atuBtn');
            if (!btn) return;
            const label = btn.querySelector('.toggle-dd__label');
            const led = btn.querySelector('.toggle-dd__led');
            if (tuning) {
                btn.dataset.tuning = 'true';
                btn.classList.add('is-tuning');
                if (label) label.textContent = 'Tuning…';
                if (led) led.classList.add('is-on');
                btn.setAttribute('aria-label', 'Antenna tuner — tuning in progress; tap to stop');
            } else {
                btn.dataset.tuning = 'false';
                btn.classList.remove('is-tuning');
                if (label) label.textContent = 'ATU';
                // Restore on/off styling from current state.
                const onNow = btn.dataset.atuEnabled === 'true';
                updateAtuButton(onNow);
            }
            // Mirror the state on the dedicated Tune button: it becomes a red
            // "Stop" while a cycle runs so the button never silently means
            // something other than what it says. aria-label / title follow,
            // and the idle label is preserved so a customised or translated
            // accessible label (data-a11y-key="controls.atuTune") survives a
            // tune cycle rather than being overwritten with a hard-coded string.
            const tuneBtn = document.getElementById('atuTuneBtn');
            if (tuneBtn) {
                if (tuning) {
                    if (!tuneBtn.dataset.idleLabel)
                        tuneBtn.dataset.idleLabel = tuneBtn.getAttribute('aria-label') || 'Start antenna auto-tune';
                    tuneBtn.classList.remove('btn-outline-secondary');
                    tuneBtn.classList.add('btn-danger');
                    tuneBtn.textContent = 'Stop';
                    tuneBtn.setAttribute('aria-label', 'Stop antenna tuning');
                    tuneBtn.setAttribute('title', 'Stop antenna tuning');
                } else {
                    const idle = tuneBtn.dataset.idleLabel || 'Start antenna auto-tune';
                    tuneBtn.classList.remove('btn-danger');
                    tuneBtn.classList.add('btn-outline-secondary');
                    tuneBtn.textContent = 'Tune';
                    tuneBtn.setAttribute('aria-label', idle);
                    tuneBtn.setAttribute('title', idle);
                    delete tuneBtn.dataset.idleLabel;
                }
            }
        }

        // Dedicated Tune button: start a tune when idle, stop the running
        // cycle when one's in progress. Mirrors the ATU button's short-tap
        // behaviour but as an explicit, announceable, keyboard-reachable
        // control (the press-and-hold gesture is neither).
        function atuTuneButtonClick() {
            const atuBtn = document.getElementById('atuBtn');
            if (atuBtn && atuBtn.dataset.tuning === 'true') {
                stopAtuTune();
            } else {
                startAtuTune();
            }
        }
        // Wire short-tap vs long-press behaviour. Using pointer events
        // covers mouse, touch, and pen with one code path.
        document.addEventListener('DOMContentLoaded', function() {
            const atuBtn = document.getElementById('atuBtn');
            if (!atuBtn) return;
            atuBtn.addEventListener('pointerdown', function(e) {
                atuLongFired = false;
                clearTimeout(atuPressTimer);
                atuPressTimer = setTimeout(() => {
                    atuLongFired = true;
                    startAtuTune();
                }, ATU_LONG_PRESS_MS);
            });
            const cancelPress = function() {
                clearTimeout(atuPressTimer);
                atuPressTimer = null;
            };
            atuBtn.addEventListener('pointerup', function(e) {
                clearTimeout(atuPressTimer);
                atuPressTimer = null;
                if (!atuLongFired) {
                    // Short tap — toggle on/off if idle, or stop the
                    // running tune cycle if one is in progress.
                    if (atuBtn.dataset.tuning === 'true') {
                        stopAtuTune();
                    } else {
                        toggleAtu();
                    }
                }
            });
            atuBtn.addEventListener('pointerleave', cancelPress);
            atuBtn.addEventListener('pointercancel', cancelPress);
        });

