            catch (e) { console.error('setAntiVoxGain error:', e); }
        }

        // --- FM REPEATER ---
        async function setFmShift(v) { _fmSettings.shiftDir = v; }
        async function setFmOffset(v) { _fmSettings.offsetHz = v; }
        async function setCtcssMode(v) { _fmSettings.ctcssMode = v; }
        async function setCtcssTone(v) { _fmSettings.ctcssTone = v; }
        const _fmSettings = {
            shiftDir: '@Model.FmShiftDir',
            offsetHz: @Model.FmOffsetHz,
            ctcssMode: '@Model.CtcssMode',
            ctcssTone: '@Model.CtcssTone'
        };
        async function saveFmRepeater() {
            _fmSettings.shiftDir  = document.getElementById('fmShiftSelect').value;
            _fmSettings.offsetHz  = parseInt(document.getElementById('fmOffsetInput').value) * 1000;
            _fmSettings.ctcssMode = document.getElementById('ctcssModeSelect').value;
            _fmSettings.ctcssTone = document.getElementById('ctcssToneSelect').value;
            try {
                await fetch('/api/cat/fmrepeater', {
