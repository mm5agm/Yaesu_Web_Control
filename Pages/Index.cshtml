        // populated before any SignalR updates arrive.
        _statusState.freqHzA = @Model.State.vfoA.frequency;
        _statusState.bandA   = '@(Model.State.vfoA.band ?? "")';
        _statusState.modeA   = '@(Model.State.vfoA.mode ?? "")';
        _statusState.freqHzB = @Model.State.vfoB.frequency;
        _statusState.bandB   = '@(Model.State.vfoB.band ?? "")';
        _statusState.modeB   = '@(Model.State.vfoB.mode ?? "")';
        _statusState.power   = @Model.State.vfoA.power;
        _renderToolbarStatus(true);
        console.log('[a11y] toolbar status announcer: single shared region, debounced (#123)');

        // --- VOX ---
        async function toggleVox() {
