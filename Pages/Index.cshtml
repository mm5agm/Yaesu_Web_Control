<!-- CW SEND - type a line, Enter keys it. Built on the same KM/KY keyer
     memories as the M1-M5 buttons, borrowing M5 as the scratch slot and
     putting it back afterwards. Non-modal and draggable like the reader. -->
<style>
    #cwSendDialog .cws-header { cursor:move; }
    /* A definite width so lines wrap instead of stretching the panel to
       the longest one; the corner drags to resize, and a size the operator
       has set is kept (dlgSize_cwSendDialog) - see makeResizable. */
    #cwSendDialog { width:560px; min-width:420px; min-height:220px; max-height:95vh; resize:both; overflow:auto; }
    #cwSendDialog[open] { display:flex; flex-direction:column; }
    #cwSendDialog .cws-header { flex:0 0 auto; }
    #cwSendDialog .cws-body { flex:1 1 auto; min-height:0; }
    #cwSendDialog.user-sized #cwSendLog { max-height:none; flex:1 1 auto; min-height:4rem; }
    #cwSendInput {
        font-family: ui-monospace, Consolas, monospace;
        font-size: 1.05rem;
        text-transform: uppercase;
        background: #111; border-color: #444; color: #dfe;
    }
    #cwSendInput:focus { background: #111; color: #dfe; border-color: #6aa; box-shadow: none; }
    #cwSendLog {
        font-family: ui-monospace, Consolas, monospace;
        font-size: 0.95rem;
        line-height: 1.5;
        min-height: 6rem;
        max-height: 30vh;
        overflow-y: auto;
        position: relative;   /* offsetTop of a character is then within the log */
        background: #111;
        border: 1px solid #444;
        border-radius: 6px;
        padding: 6px 10px;
        color: #dfe;
    }
    #cwSendLog .cws-line { display:flex; gap:0.6rem; align-items:baseline; }
    #cwSendLog .cws-time { color:#778; font-size:0.75rem; flex:0 0 auto; }
    #cwSendLog .cws-text { flex:1 1 auto; white-space:pre-wrap; word-break:break-word; }
    #cwSendLog .cws-tag  { color:#9ab; font-size:0.75rem; flex:0 0 auto; }
    #cwSendLog .cws-line[data-state="queued"]  .cws-text { color:#9ab; }
    #cwSendLog .cws-line[data-state="sending"] .cws-text { color:#ffd24a; }
    #cwSendLog .cws-line[data-state="sending"] .cws-tag  { color:#ffd24a; }
    #cwSendLog .cws-line[data-state="sent"]    .cws-tag  { color:#9d9; }
    #cwSendLog .cws-line[data-state="monitor"] .cws-tag  { color:#8fd0ff; }
    #cwSendLog .cws-line[data-state="dropped"] .cws-text { color:#778; text-decoration:line-through; }
    #cwSendLog .cws-line[data-state="error"]   .cws-tag  { color:#ff6b6b; }
    #cwSendLog .cws-ch.cws-done { color:#eee; }
    #cwSendLog .cws-ch.cws-cur  { background:#ffd24a; color:#111; border-radius:2px; }
    #cwSendStatus { font-size: 0.8rem; color:#9ab; min-height:1.2em; }
    #cwSendStatus.cws-problem { color:#ffd23f; font-weight:600; }
    #cwSendBanner {
        font-size: 0.9rem; font-weight: 600; color: #ffd23f;
        background: rgba(255, 210, 63, 0.10);
        border-left: 3px solid #ffd23f;
        padding: 0.4rem 0.6rem; border-radius: 0.25rem;
    }
</style>
<dialog id="cwSendDialog" style="border:1px solid #555; border-radius:8px; background:#222; color:#eee; padding:0; max-width:95vw;" aria-labelledby="cwSendTitle">
    <div class="cws-header d-flex align-items-center justify-content-between px-3 py-2" style="border-bottom:1px solid #444;">
        <strong id="cwSendTitle">CW Send</strong>
        <div class="d-flex align-items-center gap-2">
            <button id="cwSendStopBtn" class="btn btn-sm btn-outline-warning" type="button"
                    title="Send nothing further. The piece already playing cannot be stopped - the radio has no CAT command for that.">Stop</button>
            <button id="cwSendClearBtn" class="btn btn-sm btn-outline-light" type="button" title="Clear the sent-lines log">Clear log</button>
            <button class="btn btn-sm ywc-dialog-close"
                    onclick="document.getElementById('cwSendDialog').close()"
                    aria-label="Close CW send panel">&#10005;</button>
        </div>
    </div>
    <div class="cws-body p-2 d-flex flex-column gap-2">
        <div id="cwSendBanner" role="status" aria-live="polite" hidden></div>
        <div id="cwSendLog" role="log" aria-live="polite" aria-label="CW lines sent"></div>
        <div class="input-group">
            <input type="text" id="cwSendInput" class="form-control"
                   autocomplete="off" spellcheck="false" autocapitalize="characters"
                   placeholder="Type here and press Enter to send"
                   aria-label="CW text to send - Enter sends, Escape stops"
                   title="A-Z 0-9 space ? / . , - Enter sends the line, Escape drops anything not yet started (or clears the box when nothing is sending)">
            <button id="cwSendClearInputBtn" class="btn btn-outline-light" type="button"
                    title="Empty the text box without sending it" aria-label="Clear the text box">Clear</button>
        </div>
        <div class="d-flex align-items-center gap-2">
            <label class="mb-0 text-nowrap" for="cwSendSpeedSlider">Speed WPM: <span id="cwSendSpeedValue">@Model.CwSpeed</span></label>
            <input type="range" id="cwSendSpeedSlider" min="4" max="60" step="1" value="@Model.CwSpeed"
                   style="flex:1; height:18px;"
                   aria-label="CW keyer speed" title="CW keyer speed in WPM - the same control as in the CW keyer panel">
        </div>
        <div id="cwSendStatus" role="status" aria-live="polite"></div>
    </div>
</dialog>

<!-- CW Reader panel - server-side Morse decode of the receive audio.
     Non-modal and draggable, like DX Spots: the operator has to be able to
     work the station while the text is on screen. -->
<style>
    #cwReaderDialog .cwr-header { cursor:move; }
    #cwReaderDialog { width:680px; min-width:480px; min-height:260px; max-height:95vh; resize:both; overflow:auto; }
    #cwReaderDialog[open] { display:flex; flex-direction:column; }
    #cwReaderDialog .cwr-header { flex:0 0 auto; }
    #cwReaderDialog .cwr-body { flex:1 1 auto; min-height:0; display:flex; flex-direction:column; }
    #cwReaderDialog.user-sized .cwr-main { flex:1 1 auto; min-height:0; }
    #cwReaderDialog.user-sized .cwr-textcol { display:flex; flex-direction:column; min-height:0; align-self:stretch; }
    #cwReaderDialog.user-sized #cwReaderOut { max-height:none; flex:1 1 auto; min-height:4rem; }
    #cwReaderOut {
        font-family: ui-monospace, Consolas, monospace;
        font-size: 1.05rem;
        line-height: 1.5;
        letter-spacing: 0.02em;
        white-space: pre-wrap;
        word-break: break-word;
        min-height: 9rem;
        max-height: 40vh;
        overflow-y: auto;
        background: #111;
        border: 1px solid #444;
        border-radius: 6px;
        padding: 8px 10px;
        color: #dfe;
    }
    /* Tokens that have the shape of QSO traffic. Colour is the only change -
       nothing is added, removed or reordered - and it means "this looks like
       something an operator sends", not "this is right". A callsign seen only
       once is dimmed rather than hidden, because garble finds callsign shape
       by chance and the first sighting of a real call looks identical. */
    #cwReaderDialog .cw-tok-proc { color:#8fd0ff; }
    #cwReaderDialog .cw-tok-rst  { color:#c9a6ff; }
    #cwReaderDialog .cw-tok-call { color:#ffd24a; font-weight:600; }
    #cwReaderDialog .cw-tok-call1 { color:#a08a3c; }
    .cwr-legend { font-size: 0.72rem; color:#89a; }
    #cwReaderStatus { font-family: ui-monospace, Consolas, monospace; font-size: 0.78rem; color:#9ab; }
    /* A problem the operator has to act on must not be drawn like the running
       tone/SNR commentary. Same dim monospace at 0.78rem meant 'your radio
       audio could not be opened' was read straight past. */
    #cwReaderStatus.cwr-problem {
        font-family: inherit;
        font-size: 0.95rem;
        font-weight: 600;
        color: #ffd23f;
        background: rgba(255, 210, 63, 0.10);
        border-left: 3px solid #ffd23f;
        padding: 0.5rem 0.6rem;
        border-radius: 0.25rem;
    }

    /* QSO log form. The module builds its own DOM; the palette is the host
       app's business, so the classes are styled here. */
    .cwq { border-top: 1px solid #444; margin-top: 0.6rem; padding-top: 0.6rem; }
    .cwq-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.5rem; }
    .cwq-head-btns { display: flex; align-items: center; gap: 0.4rem; }
    .cwq-grid {
        display: grid;
        grid-template-columns: auto 1fr;
        gap: 0.35rem 0.6rem;
        align-items: start;
    }
    .cwq-label { font-size: 0.85rem; color: #cde; padding-top: 0.3rem; white-space: nowrap; }
    .cwq-input { background: #111; border-color: #444; color: #dfe; }
    .cwq-input:focus { background: #111; color: #dfe; border-color: #6aa; box-shadow: none; }
    .cwq-chips { display: flex; flex-wrap: wrap; gap: 0.3rem; margin-top: 0.25rem; }
    /* A chip is a suggestion, so it is drawn as something to consider, not as
       an answer already given: outlined and quiet until it is chosen. */
    .cwq-chip {
        display: inline-flex; align-items: baseline; gap: 0.35rem;
        background: transparent; color: #ffd24a;
        border: 1px solid #6a5a20; border-radius: 999px;
        padding: 0.1rem 0.55rem; font-size: 0.85rem; line-height: 1.4; cursor: pointer;
    }
    .cwq-chip:hover { border-color: #ffd24a; }
    .cwq-chip-on { background: rgba(255, 210, 74, 0.15); border-color: #ffd24a; }
    .cwq-why { font-size: 0.7rem; color: #9ab; }
    .cwq-none { font-size: 0.72rem; color: #778; font-style: italic; }
    .cwq-facts {
        font-family: ui-monospace, Consolas, monospace;
        font-size: 0.72rem; color: #9ab; margin-top: 0.5rem;
    }
    .cwq-status { font-size: 0.85rem; color: #9d9; margin-top: 0.35rem; min-height: 1.2rem; }
    .cwq-status.cwq-problem { color: #ffd23f; font-weight: 600; }
</style>
<dialog id="cwReaderDialog" style="border:1px solid #555; border-radius:8px; background:#222; color:#eee; padding:0; max-width:95vw;" aria-labelledby="cwReaderTitle">
    <div class="cwr-header d-flex align-items-center justify-content-between px-3 py-2" style="border-bottom:1px solid #444;">
        <strong id="cwReaderTitle">CW Reader</strong>
        <div class="d-flex align-items-center gap-2">
            <button id="cwReaderStartBtn" class="btn btn-sm btn-success" type="button">Start</button>
            <button id="cwReaderClearBtn" class="btn btn-sm btn-outline-secondary" type="button">Clear</button>
            <button id="cwReaderModeBtn" class="btn btn-sm btn-outline-info" type="button" aria-pressed="false"
                    title="Set CW mode, a narrow filter and APF for decoding. Your current settings are put back when you stop.">Reader Mode</button>
            <button id="cwReaderLogBtn" class="btn btn-sm btn-outline-warning" type="button"
                    title="Log this contact to ywc-log.adi, using what the copy suggests">Log QSO</button>
            <div class="form-check form-switch mb-0" style="cursor:default;">
                <input class="form-check-input" type="checkbox" id="cwReaderAutoScroll" checked>
                <label class="form-check-label small" for="cwReaderAutoScroll">Follow</label>
            </div>
            <div class="form-check form-switch mb-0" style="cursor:default;">
                <input class="form-check-input" type="checkbox" id="cwPhasorToggle">
                <label class="form-check-label small" for="cwPhasorToggle"
                       title="X-Y tuning figure: tune until it stops turning">Tune</label>
            </div>
            <button class="btn btn-sm ywc-dialog-close"
                    onclick="document.getElementById('cwReaderDialog').close()"
                    aria-label="Close CW reader panel">&#10005;</button>
        </div>
    </div>
    <div class="cwr-body p-2">
        <div class="cwr-main d-flex gap-2 align-items-start">
            <div class="cwr-textcol flex-grow-1" style="min-width:0;">
                <div id="cwReaderOut" role="log" aria-live="polite" aria-label="Decoded CW text"></div>
                <div class="cwr-legend mt-1">
                    Colour marks what <em>looks like</em> QSO traffic, and nothing is hidden or corrected:
                    <span class="cw-tok-proc">CQ DE 73</span>,
                    <span class="cw-tok-rst">5NN</span>,
                    <span class="cw-tok-call">a call heard more than once</span>,
                    <span class="cw-tok-call1">a call heard once</span>.
                </div>
            </div>
            <div id="cwPhasorBox" style="display:none; flex:0 0 auto; width:200px;">
                <canvas id="cwSpectrumCanvas" width="200" height="90"
                        style="width:200px; height:90px; display:block; border:1px solid #444; border-radius:6px;"
                        aria-label="CW passband spectrum with a marker at the wanted pitch"></canvas>
                <div id="cwSpectrumInfo" class="mb-1"
                     style="font-family:ui-monospace,Consolas,monospace; font-size:0.72rem; color:#9ab;">
                    Waiting.
                </div>
                <canvas id="cwPhasorCanvas" width="200" height="200"
                        style="width:200px; display:block; border:1px solid #444; border-radius:6px;"
                        aria-label="CW tuning phasor"></canvas>
                <div id="cwPhasorInfo" class="mt-1"
                     style="font-family:ui-monospace,Consolas,monospace; font-size:0.72rem; color:#9ab;">
                    Waiting.
                </div>
            </div>
        </div>
        <div id="cwReaderStatus" class="mt-2 px-1">Stopped.</div>
        <div class="text-muted small px-1 mt-1">
            A machine reading Morse out of noise. On a strong clean signal it is close to
            perfect; on a marginal one it prints plausible-looking rubbish that looks no
            different. The line above tells you which you are looking at.
        </div>
        <div id="cwQsoForm" class="px-1"></div>
    </div>
</dialog>

<!-- DX Watch alert toast container — populated by site.js when a watched spot arrives.
     Position is user-draggable; saved in localStorage as dxAlertPos. Defaults to
     bottom-right of the viewport on first run. -->
<div id="dxAlertToastHost" aria-live="assertive" aria-atomic="true"
     style="position:fixed; right:16px; bottom:16px; z-index:9999;
            display:flex; flex-direction:column; gap:8px;"></div>

<!-- TX timeout warning banner — shown when transmit has been on longer than the threshold -->
<div id="txTimeoutBanner"
     role="alert"
     aria-live="assertive"
     style="display:none; position:fixed; top:0; left:0; right:0; z-index:10000;
            background:#a02020; color:#fff; padding:10px 16px;
            font-family:sans-serif; font-weight:bold; font-size:1.05em;
            box-shadow:0 2px 8px rgba(0,0,0,0.5);">
    <span id="txTimeoutBannerText">TX has been on for too long</span>
    <button type="button" id="txTimeoutDismissBtn"
            style="float:right; background:#fff; color:#a02020; border:none;
                   padding:2px 10px; border-radius:4px; font-weight:bold; cursor:pointer;"
            aria-label="Dismiss TX timeout warning">Dismiss</button>
    <button type="button" id="txTimeoutSetBtn"
            style="float:right; background:#7a1818; color:#fff; border:1px solid #fff;
                   padding:2px 10px; border-radius:4px; margin-right:8px; cursor:pointer;"
            aria-label="Change TX timeout threshold">Change timeout…</button>
</div>

@section Scripts {
    <!-- Cache-busted JS reference, placed BEFORE your inline script if you use window.radioControl, etc. -->
    <script>
        window.bandPlan = '@Model.BandPlan';
        // Classic script so this is set before the deferred module runs
        // initVfoKeyButtons / rebuildIfWidthSelect. Assigning it only inside
        // the module's DOMContentLoaded left IF Width stuck on a placeholder
        // ("…") with no Hz values.
        window._radioModel = '@Model.RadioModel';
    </script>
    <script>
        window.ywcTxToggleKey = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.TxToggleKey));
        window.ywcVoiceNudgeStepHzA = @Model.VoiceNudgeStepHzA;
        window.ywcVoiceNudgeStepHzB = @Model.VoiceNudgeStepHzB;
        window.ywcIsWindowsHost = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.IsWindowsHost));
    </script>
    @* Every import below is tied to the app version, so a release invalidates
       all of them at once. They used to carry hand-kept numbers (?v=1 … ?v=22)
       that had to be bumped by whoever edited the module, and in practice were
       not: three modules changed in an IWC release without a single bump, so
       upgrading users went on running the old code. Do not reintroduce a
       hand-kept number here -- if a module changes, the release bumps it. *@
    <script type="module">
        import { MeterPanel }           from "/js/guages/meter-panel.js?v=@Yaesu_Web_Control.AppVersion.Current";
        import { SMeterHistoryPanel }   from "/js/guages/smeter-history-panel.js?v=@Yaesu_Web_Control.AppVersion.Current";
        import { FTdx101Meters }        from "/js/orchestrators/FTdx101Meters.js?v=@Yaesu_Web_Control.AppVersion.Current";
        import { SdrSpectrumPipeline }  from "/js/sdr/sdr-spectrum-pipeline.js?v=@Yaesu_Web_Control.AppVersion.Current";
        import { SpectrumPanel }        from "/js/sdr/spectrum-panel.js?v=@Yaesu_Web_Control.AppVersion.Current";
        import { axisOffsetHz }         from "/js/sdr/if-out-offset.js?v=@Yaesu_Web_Control.AppVersion.Current";
        import { FilterScopePanel }    from "/js/ui/filter-scope-panel.js?v=@Yaesu_Web_Control.AppVersion.Current";
        import "/js/ui/if-width-tables.js?v=@Yaesu_Web_Control.AppVersion.Current";
        import { BAND_PLANS, BAND_EDGES, getSegments, segmentForHz, bandForHz, nearestBandForHz, loadBandPlanFromServer } from "/js/ui/band-plan.js?v=@Yaesu_Web_Control.AppVersion.Current";
        import { loadLabels }           from "/js/ui/a11y-labels.js?v=@Yaesu_Web_Control.AppVersion.Current";
        import { initFreqKeyboard }     from "/js/ui/freq-keyboard.js?v=@Yaesu_Web_Control.AppVersion.Current";
        import { initMemoriesPanel }   from "/js/ui/memories.js?v=@Yaesu_Web_Control.AppVersion.Current";
        import { DxSpotsPanel }         from "/js/ui/dx-spots-panel.js?v=@Yaesu_Web_Control.AppVersion.Current";
        // Side-effect import: publishes window.radioFeatureSetup, which the
        // shared CW panel calls if the host app provides it. Loaded before
        // the panels that offer it so the global is there when they render.
        import "/js/ui/feature-setup.js?v=@Yaesu_Web_Control.AppVersion.Current";
        import { CwReaderPanel }        from "/js/cw/cw-reader-panel.js?v=@Yaesu_Web_Control.AppVersion.Current";
        import { CwSendPanel }          from "/js/ui/cw-send-panel.js?v=@Yaesu_Web_Control.AppVersion.Current";
        import { CwQsoForm }           from "/js/cw/cw-qso-form.js?v=@Yaesu_Web_Control.AppVersion.Current";
        import { initRemoteAudioUi }    from "/js/audio/remote-audio-ui.js?v=@Yaesu_Web_Control.AppVersion.Current";
        import { RadioScopeControl }    from "/js/ui/radio-scope.js?v=@Yaesu_Web_Control.AppVersion.Current";
        import { initRadioDisplayUi }   from "/js/video/radio-display-ui.js?v=@Yaesu_Web_Control.AppVersion.Current";
        import { initNrCycleButtons }   from "/js/ui/nr-cycle-button.js?v=@Yaesu_Web_Control.AppVersion.Current";
        import { initVfoKeyButtons }    from "/js/ui/vfo-key-buttons.js?v=@Yaesu_Web_Control.AppVersion.Current";
        import { initKeyboardShortcuts } from "/js/ui/keyboard-shortcuts.js?v=@Yaesu_Web_Control.AppVersion.Current";

        window.bandPlanData = BAND_PLANS;
        window.getBandSegments = getSegments;
        window.getBandSegmentForHz = segmentForHz;

        // Band key + out-of-band marker (site.js) resolve against the operator's
        // own region. Resolve BAND_EDGES inside the arrow so they pick up any
        // loadBandPlanFromServer() overlay applied later.
        const _ywcRegion0 = '@Model.BandPlan';
        window.bandForHz = (hz) =>
            bandForHz(hz, BAND_EDGES[_ywcRegion0] || BAND_EDGES.Region1);
        window.nearestBandForHz = (hz) =>
            nearestBandForHz(hz, BAND_EDGES[_ywcRegion0] || BAND_EDGES.Region1);

        // bfcache guard. When the browser restores this page from its
        // back/forward cache (e.g. returning from Meter Calibration via the
        // Back button), DOMContentLoaded does NOT fire — so none of the init
        // below runs and the spectrum SignalR connection is never re-opened.
        // The panels sit frozen and only a hard reload (Ctrl+F5) brings them
        // back. Forcing a fresh load on a persisted restore re-runs init and
        // reconnects the spectrum pipeline. (Registered at module-eval time; the
        // listener survives in the restored page, so it fires on the restore.)
        window.addEventListener('pageshow', function (e) {
            if (e.persisted) window.location.reload();
        });

        loadLabels();
        initRemoteAudioUi();
        initRadioDisplayUi('index');
        // loadLabels() rewrites every title from labels.json on each focus,
        // wiping the "out of band" title suffix; restore it once that has run.
        window.addEventListener('focus', async () => {
            await loadLabels();
            if (typeof window.refreshBandOutOfBand === 'function') window.refreshBandOutOfBand();
        });
        document.addEventListener('DOMContentLoaded', function () {
            initFreqKeyboard();
            initMemoriesPanel();

            // Radio-scope CAT controls. Bind each host (standalone card and/or
            // Radio Display Controls dialog) so SignalR updates reach every
            // instance. The constructor no-ops when the root is absent.
            window.radioScopeControls = [];
            const scopeCard = document.getElementById('radioScopeCard');
            if (scopeCard) window.radioScopeControls.push(new RadioScopeControl(scopeCard));
            const scopeDlg = document.getElementById('radioDisplayScopeDialog');
            if (scopeDlg) window.radioScopeControls.push(new RadioScopeControl(scopeDlg));
            window.radioScopeControl = window.radioScopeControls[0] || null;

            // ── UTC clock in the top bar ──────────────────────────────────────
            const utcClockEl = document.getElementById('utcClock');
            if (utcClockEl) {
                const pad2 = n => String(n).padStart(2, '0');
                const tick = () => {
                    const d = new Date();
                    utcClockEl.textContent =
                        `${pad2(d.getUTCHours())}:${pad2(d.getUTCMinutes())}:${pad2(d.getUTCSeconds())}Z`;
                };
                tick();
                setInterval(tick, 1000);
            }
            window.meterPanel = new MeterPanel({
                // v2.3.9 dropped SMeterB to a single shared gauge; v2.4.0
                // restored it as a real VFO A / VFO B pair on dual-receiver
                // radios (FTdx101MP/D each have an independently calibrated
                // S-meter, SM0;/SM1;). smeterB's canvas doesn't exist on
                // single-receiver radios, so MeterPanel._createGauges skips
                // it automatically (config entries for missing canvases are
                // no-ops) — no isSingleReceiver check needed here.
                smeter:      { type: 'smeter', canvasId: 'sMeterCanvas' },
                smeterB:     { type: 'smeter', canvasId: 'sMeterCanvasB', gaugeTitleId: 'sMeterValueB' },
                power:       { canvasId: 'powerMeterCanvas', maxValue: @maxPowerWatts },
                swr:         { canvasId: 'swrMeterCanvas' },
                // Compact horizontal bar siblings (PoC). Same display scale as
                // the radials; MeterPanel.update mirrors automatically.
                powerLinear:       { type: 'powerLinear',       canvasId: 'powerLinearCanvas', maxValue: @maxPowerWatts },
                swrLinear:         { type: 'swrLinear',         canvasId: 'swrLinearCanvas' },
                compressionLinear: { type: 'compressionLinear', canvasId: 'compressionLinearCanvas' },
                alcLinear:         { type: 'alcLinear',         canvasId: 'alcLinearCanvas' },
                // Per-VFO linear S-meters (between frequency and RF gain). Present
                // on both single- and dual-receiver layouts — inactive greying for
                // single-receiver is CSS via applyVfoActiveStyling.
                smeterLinearA:     { type: 'smeterLinear', canvasId: 'sMeterLinearCanvasA', gaugeTitleId: 'sMeterLinearValueA' },
                smeterLinearB:     { type: 'smeterLinear', canvasId: 'sMeterLinearCanvasB', gaugeTitleId: 'sMeterLinearValueB' },
                compression: { canvasId: 'compressionMeterCanvas' },
                alc:         { canvasId: 'alcMeterCanvas' },
                temp:        { canvasId: 'tempMeterCanvas' },
                idd:         { canvasId: 'iddMeterCanvas' },
                vdd:         { canvasId: 'vddMeterCanvas' }
            });
            window.ftdx101Meters = new FTdx101Meters(window.meterPanel, window.calibrationEngine, @maxPowerWatts);

            // ── S-meter history strips ───────────────────────────────────────
            // Hidden by default. Toggle via the "S-hist" button in the top
            // toolbar; visibility persists in localStorage so the choice
            // survives page reloads. Both A and B strips (when B exists)
            // share the one toggle — independent per-VFO toggles can be
            // added later if wanted, but one button is the smaller change.
            window.sMeterHistory  = new SMeterHistoryPanel('sMeterHistoryCanvas');
            window.sMeterHistoryB = new SMeterHistoryPanel('sMeterHistoryCanvasB');
            (function () {
                const btn  = document.getElementById('sMeterHistoryToggleBtn');
                const con  = document.getElementById('sMeterHistoryContainer');
                const conB = document.getElementById('sMeterHistoryContainerB');
                if (!btn || !con) return;

                const KEY = 'ywc.sMeterHistoryVisible';
                const apply = (visible) => {
                    con.style.display = visible ? '' : 'none';
                    if (conB) conB.style.display = visible ? '' : 'none';
                    btn.classList.toggle('active', visible);
                    btn.setAttribute('aria-pressed', visible ? 'true' : 'false');
                };
                let visible = false;
                try { visible = localStorage.getItem(KEY) === '1'; } catch {}
                apply(visible);

                btn.addEventListener('click', () => {
                    visible = !visible;
                    try { localStorage.setItem(KEY, visible ? '1' : '0'); } catch {}
                    apply(visible);
                });
            })();

            // ── Analogue gauges row (temporary layout toggle) ───────────────
            // Hides #meterGaugesRow (rendered by _MeterGaugesPartial) so the
            // operating controls stay reachable while the dials are off.
            // Choice persists in localStorage. Default is shown.
            (function () {
                const btn  = document.getElementById('meterGaugesToggleBtn');
                const body = document.getElementById('metersCardBody');
                if (!btn || !body) return;

                const KEY = 'ywc.meterGaugesVisible';
                const apply = (visible) => {
                    body.classList.toggle('gauges-hidden', !visible);
                    btn.classList.toggle('active', visible);
                    btn.setAttribute('aria-pressed', visible ? 'true' : 'false');
                    btn.title = visible
                        ? 'Hide analogue meter gauges'
                        : 'Show analogue meter gauges';
                };
                let visible = true;
                try { visible = localStorage.getItem(KEY) !== '0'; } catch {}
                apply(visible);

                btn.addEventListener('click', () => {
                    visible = !visible;
                    try { localStorage.setItem(KEY, visible ? '1' : '0'); } catch {}
                    apply(visible);
                });
            })();

            // ── Spectrum display (dual-VFO, v2.3.0+) ─────────────────────────
            // One SpectrumPanel per VFO. SdrSpectrumPipeline routes by sdrId.
            // SdrManager will only spawn worker(s) for VFO(s) actually configured.
            // CAT-only hosts skip SpectrumPanel UI but keep the pipeline for DX.
            const spectrumPanelA = window.ywcIsWindowsHost
                ? new SpectrumPanel('spectrumCanvasA', 'spectrumContainerA', @Model.RadioState.FrequencyA, 'A')
                : null;
            const spectrumPanelB = window.ywcIsWindowsHost
                ? new SpectrumPanel('spectrumCanvasB', 'spectrumContainerB', @Model.RadioState.FrequencyB, 'B')
                : null;
            window.spectrumPanelA = spectrumPanelA;
            window.spectrumPanelB = spectrumPanelB;

            // After Radio Scope + spectrum panels exist so z/w/s target detection works.
            initKeyboardShortcuts();

            // Region-specific band plan for FT8/CW/SSB markers on both panels.
            const _ywcRegion = '@Model.BandPlan';
            if (spectrumPanelA && spectrumPanelB && BAND_PLANS[_ywcRegion]) {
                spectrumPanelA.setBandPlan(BAND_PLANS[_ywcRegion]);
                spectrumPanelB.setBandPlan(BAND_PLANS[_ywcRegion]);
            }
            // Region-specific band edges (red dashed guard rails). Falls back
            // to the class-static worldwide envelope inside SpectrumPanel if
            // the region key isn't found.
            // First, overlay any updates from /bandplan.default.json so users
            // who've dropped in a corrected band plan see them on next reload.
            // This is fire-and-forget: if the fetch succeeds in time we apply
            // the result; if not, the panels keep the hardcoded defaults and
            // we re-apply once the fetch resolves. Net effect: hardcoded
            // defaults always work; updated JSON applies as soon as it loads.
            loadBandPlanFromServer().then(loaded => {
                if (!spectrumPanelA || !spectrumPanelB) return;
                if (loaded && BAND_PLANS[_ywcRegion]) {
                    spectrumPanelA.setBandPlan(BAND_PLANS[_ywcRegion]);
                    spectrumPanelB.setBandPlan(BAND_PLANS[_ywcRegion]);
                }
                if (loaded && BAND_EDGES[_ywcRegion]) {
                    spectrumPanelA.setBandEdges(BAND_EDGES[_ywcRegion]);
                    spectrumPanelB.setBandEdges(BAND_EDGES[_ywcRegion]);
                }
            });
            if (spectrumPanelA && spectrumPanelB && BAND_EDGES[_ywcRegion]) {
                spectrumPanelA.setBandEdges(BAND_EDGES[_ywcRegion]);
                spectrumPanelB.setBandEdges(BAND_EDGES[_ywcRegion]);
            }

            const spectrumPipeline = new SdrSpectrumPipeline();

            // Per-VFO spectrum routing.
            //
            // An incoming frame is itself proof the SDR is streaming — the worker
            // only emits frames while streaming. Waiting for the periodic
            // "streaming" heartbeat (SdrStatus, re-sent every ~3s) to un-hide the
            // container means a freshly-loaded page can sit blank for up to that
            // long even though frames are already flowing. So promote the VFO to
            // "streaming" on its first frame, which reveals the panel within
            // ~100ms of connecting instead of waiting on the heartbeat.
            spectrumPipeline.onSpectrumUpdate('A', data => { spectrumPanelA.update(data); markStreamingFromFrame('A'); });
            spectrumPipeline.onSpectrumUpdate('B', data => { spectrumPanelB.update(data); markStreamingFromFrame('B'); });

            // Per-VFO status routing — drives the panel state + small badge in the header.
            function setStatusBadge(vfo, status) {
                const badge = document.getElementById('spectrumStatusBadge' + vfo);
                if (!badge) return;
                const labels = {
                    unconfigured: ['secondary', 'No SDR'],
                    connecting:   ['warning',   'Connecting…'],
                    streaming:    ['success',   'Live'],
                    disconnected: ['danger',    'Disconnected'],
                    nodll:        ['danger',    'No SoapySDR'],
                };
                const [colour, text] = labels[status] ?? ['secondary', status];
                badge.className = `badge bg-${colour} small`;
                badge.textContent = text;
            }
            // Track per-VFO configured/streaming state so we can show or hide the
            // outer spectrumContainer and the Mono/Multi toggle as appropriate.
            const sdrState = { A: 'unconfigured', B: 'unconfigured' };
            function updateContainerVisibility() {
                if (!window.ywcIsWindowsHost) {
                    const c = document.getElementById('spectrumContainer');
                    if (c) c.style.display = 'none';
                    return;
                }
                const aConfigured = sdrState.A !== 'unconfigured';
                let bConfigured = sdrState.B !== 'unconfigured';

                // Single-receiver radios (FTdx10, FT-710, FTDX3000) only have
                // ONE IF output, so the second spectrum panel is never
                // meaningful regardless of what's in Settings. Force B
                // as unconfigured here so the Mono/Multi toggle and the
                // spectrum-B panel are both hidden, leaving just one
                // spectrum + a show/hide control (#34 follow-up,
                // 2026-06-13).
                const vfoRow = document.getElementById('vfoRow');
                if (vfoRow?.dataset.singleReceiver === 'true') {
                    bConfigured = false;
                }

                // Outer container visible if either VFO has an SDR configured.
                document.getElementById('spectrumContainer').style.display =
                    (aConfigured || bConfigured) ? '' : 'none';

                // Mono/Multi toggle only meaningful when BOTH are configured.
                // Note: spectrumModeToggle has Bootstrap's d-flex class which
                // applies display: flex !important — so plain
                // `style.display = 'none'` is silently ignored. Use
                // setProperty with priority='important' to actually win.
                // For the show case, just remove the inline override and
                // let d-flex take over.
                const toggleEl = document.getElementById('spectrumModeToggle');
                if (toggleEl) {
                    if (aConfigured && bConfigured) {
                        toggleEl.style.removeProperty('display');
                    } else {
                        toggleEl.style.setProperty('display', 'none', 'important');
                    }
                }

                // If only one side is configured, force that side visible regardless of mode.
                if (!bConfigured) {
                    document.getElementById('spectrumContainerB').style.display = 'none';
                    document.getElementById('spectrumContainerA').style.display = aConfigured ? '' : 'none';
                } else if (!aConfigured) {
                    document.getElementById('spectrumContainerA').style.display = 'none';
                    document.getElementById('spectrumContainerB').style.display = '';
                } else {
                    // Both configured — honour the active mode.
                    applyMode(currentMode);
                }
            }

            // Promote a VFO to "streaming" the moment its first frame arrives, so
            // the container reveals without waiting for the periodic heartbeat.
            // A no-op once already streaming, so it costs nothing per frame after
            // the first. A later real SdrStatus (e.g. "disconnected") still wins
            // through the onStatusChange handler below.
            function markStreamingFromFrame(vfo) {
                if (sdrState[vfo] === 'streaming') return;
                sdrState[vfo] = 'streaming';
                const panel = vfo === 'A' ? spectrumPanelA : spectrumPanelB;
                panel.setStatus('streaming');
                setStatusBadge(vfo, 'streaming');
                updateContainerVisibility();
            }

            // Mono/Multi toggle — persisted in localStorage so the user's
            // last-used layout sticks across page reloads. Default Multi (both).
            const MODE_STORAGE_KEY = 'ywc.spectrumMode';
            let currentMode = localStorage.getItem(MODE_STORAGE_KEY) || 'Multi';
            function applyMode(mode) {
                currentMode = mode;
                localStorage.setItem(MODE_STORAGE_KEY, mode);
                const showA = (mode === 'A' || mode === 'Multi');
                const showB = (mode === 'B' || mode === 'Multi');
                document.getElementById('spectrumContainerA').style.display = showA ? '' : 'none';
                document.getElementById('spectrumContainerB').style.display = showB ? '' : 'none';
                document.querySelectorAll('.spectrum-mode-btn').forEach(b => {
                    b.classList.toggle('active', b.dataset.mode === mode);
                });
                // Trigger canvas resize since the layout just changed.
                window.dispatchEvent(new Event('resize'));
            }
            document.querySelectorAll('.spectrum-mode-btn').forEach(b => {
                b.addEventListener('click', () => applyMode(b.dataset.mode));
            });

            // Stacked / Side-by-side layout toggle — persisted in localStorage
            // so the user's preference sticks across reloads. Default stacked
            // (matches the v2.3.0 initial layout).
            const LAYOUT_STORAGE_KEY = 'ywc.spectrumLayout';
            let currentLayout = localStorage.getItem(LAYOUT_STORAGE_KEY) || 'stacked';
            function applyLayout(layout) {
                currentLayout = layout;
                localStorage.setItem(LAYOUT_STORAGE_KEY, layout);
                const panels = document.getElementById('spectrumPanels');
                if (!panels) return;
                if (layout === 'side') {
                    panels.classList.remove('flex-column');
                    panels.classList.add('flex-row');
                } else {
                    panels.classList.remove('flex-row');
                    panels.classList.add('flex-column');
                }
                document.querySelectorAll('.spectrum-layout-btn').forEach(b => {
                    b.classList.toggle('active', b.dataset.layout === layout);
                });
                // Canvas dimensions changed — let ResizeObserver pick up the new width.
                window.dispatchEvent(new Event('resize'));
            }
            document.querySelectorAll('.spectrum-layout-btn').forEach(b => {
                b.addEventListener('click', () => applyLayout(b.dataset.layout));
            });
            // Apply the persisted layout immediately so the page renders in the
            // user's chosen layout from the first frame.
            applyLayout(currentLayout);

            spectrumPipeline.onStatusChange('A', status => {
                sdrState.A = status;
                spectrumPanelA?.setStatus(status);
                setStatusBadge('A', status);
                updateContainerVisibility();
            });
            spectrumPipeline.onStatusChange('B', status => {
                sdrState.B = status;
                spectrumPanelB?.setStatus(status);
                setStatusBadge('B', status);
                updateContainerVisibility();
            });
            spectrumPipeline.onError('A', detail => spectrumPanelA?.setError(detail));
            spectrumPipeline.onError('B', detail => spectrumPanelB?.setError(detail));

            // Stand up the DX Spots list panel BEFORE wiring the pipeline so its
            // handlers can dispatch to it. It works whether or not the SDR is
            // configured — relies only on the DxSpot/FrequencyA event stream.
            window.dxSpotsPanel = new DxSpotsPanel();
            window.dxSpotsPanel.init();
            window.dxSpotsPanel.setVfoFrequency(@Model.RadioState.FrequencyA);

            // The CW reader is independent of the SDR and of the cluster: it
            // needs only the audio bridge, which it taps rather than opening a
            // second stream on the radio's codec.
            window.cwReaderPanel = new CwReaderPanel();
            window.cwReaderPanel.init();

            // Typed CW goes out through the keyer memories the M1-M5 buttons
            // use; the panel only sequences the writes and plays.
            window.cwSendPanel = new CwSendPanel();
            window.cwSendPanel.init();

            // The log form is separate from the reader and starts closed. The
            // operator opens it when a QSO is worth keeping, and it asks the
            // server what is in the copy at that moment - so opening it late
            // in the contact gets the name and QTH that arrived after the
            // callsign, which opening it early would not.
            window.cwQsoForm = new CwQsoForm();
            window.cwQsoForm.init('cwQsoForm');
            document.getElementById('cwReaderLogBtn')
                ?.addEventListener('click', () => window.cwQsoForm.toggle());

            spectrumPipeline.onFrequencyA(hz => {
                spectrumPanelA?.setVfoFrequency(hz);
                window.dxSpotsPanel.setVfoFrequency(hz);
            });
            spectrumPipeline.onFrequencyB(hz => {
                spectrumPanelB?.setVfoFrequency(hz);
            });

            // CW click-to-tune needs the sidetone pitch and the mode, or it
            // tunes a clicked CW signal to zero beat — silent at any IF width,
            // and invisible too because zero beat parks the carrier on the
            // display's centre bin where the DC blocker cancels it. Seeded from
            // the server-rendered state, then kept current over SignalR.
            spectrumPanelA?.setCwPitchHz(300 + @Model.CwPitch * 10);
            spectrumPanelB?.setCwPitchHz(300 + @Model.CwPitch * 10);
            spectrumPanelA?.setMode('@Model.RadioState.ModeA');
            spectrumPanelB?.setMode('@Model.RadioState.ModeB');
            spectrumPipeline.onCwPitch(hz => {
                spectrumPanelA?.setCwPitchHz(hz);
                spectrumPanelB?.setCwPitchHz(hz);
                // The filter scopes centre the CW passband on the pitch too,
                // so they have to hear about it or their trapezium (and the
                // passband overlay drawn from it) sits at the wrong place.
                window.filterScopePanelA?.setState({ cwPitchHz: hz });
                window.filterScopePanelB?.setState({ cwPitchHz: hz });
            });
            spectrumPipeline.onModeA(mode => {
                spectrumPanelA?.setMode(mode);
                ensureRttyTones(mode);
            });
            spectrumPipeline.onModeB(mode => {
                spectrumPanelB?.setMode(mode);
                ensureRttyTones(mode);
            });

            // RTTY click-to-tune needs the mark and shift frequencies the
            // decoder is listening for, exactly as CW needs the pitch. They
            // live in the radio's extended menu rather than in any polled
            // state, so read them once, the first time a VFO actually lands in
            // RTTY — they are menu settings that change about never, and there
            // is no point spending a CAT read on an operator who never leaves
            // SSB.
            let rttyTonesRequested = false;
            function ensureRttyTones(mode) {
                if (rttyTonesRequested) return;
                if (typeof mode !== 'string' || !mode.startsWith('RTTY')) return;
                rttyTonesRequested = true;
                fetch('/api/cat/rtty')
                    .then(r => r.ok ? r.json() : null)
                    .then(t => {
                        if (!t) return;
                        spectrumPanelA?.setRttyTones(t);
                        spectrumPanelB?.setRttyTones(t);
                    })
                    .catch(() => {
                        // Leaving the Yaesu defaults in place is a better
                        // outcome than disabling the offset, so swallow this.
                        rttyTonesRequested = false;
                    });
            }
            ensureRttyTones('@Model.RadioState.ModeA');
            ensureRttyTones('@Model.RadioState.ModeB');

            // Show each spectrum panel the slice of RF its receiver is actually
            // listening to. The edges are computed by the matching filter scope
            // panel, which already knows the IF width, shift, roofing filter and
            // mode — looked up lazily because those panels are constructed
            // further down this script than this wiring runs.
            spectrumPanelA?.setPassbandProvider(() => window.filterScopePanelA?.getPassband() ?? null);
            spectrumPanelB?.setPassbandProvider(() => window.filterScopePanelB?.getPassband() ?? null);

            // Draw each spectrum panel's axis in true RF. The SDR sits on the
            // radio's IF OUT, which is not at the dial and moves with filter
            // width, IF shift and CW pitch, so the naive "dial at the centre"
            // axis is 5-7 kHz out on an FTdx101. if-out-offset.js holds the
            // measured per-radio table; the filter state it needs comes from
            // the same filter scope panel as the passband above. Unmeasured
            // radios get null, which leaves the axis exactly as it was.
            spectrumPanelA?.setAxisOffsetProvider(centreHz =>
                axisOffsetHz('@Model.RadioModel', 'A', centreHz, window.filterScopePanelA?.getFilterState()));
            spectrumPanelB?.setAxisOffsetProvider(centreHz =>
                axisOffsetHz('@Model.RadioModel', 'B', centreHz, window.filterScopePanelB?.getFilterState()));

            // DX cluster spots — incoming SignalR pushes feed BOTH spectrum
            // overlays (when visible) plus the DX Spots list (always available).
            spectrumPipeline.onDxSpot(spot => {
                spectrumPanelA?.addSpot(spot);
                spectrumPanelB?.addSpot(spot);
                window.dxSpotsPanel.addSpot(spot);
            });
            spectrumPipeline.onDxClusterStatus(s => {
                spectrumPanelA?.setDxStatus(s?.status, s?.detail);
                spectrumPanelB?.setDxStatus(s?.status, s?.detail);
            });
            spectrumPipeline.onDxAlert(spot => { if (window.handleDxAlert) window.handleDxAlert(spot); });

            // Repaint when "Show only watched callsigns" changes.
            window.addEventListener('dxWatchFilterChanged', () => {
                try { spectrumPanelA?.redraw(); } catch {}
                try { spectrumPanelB?.redraw(); } catch {}
                try { window.dxSpotsPanel && window.dxSpotsPanel.redraw(); } catch {}
            });
            fetch('/api/dxcluster/spots')
                .then(r => r.ok ? r.json() : [])
                .then(arr => {
                    spectrumPanelA?.setSpots(arr);
                    spectrumPanelB?.setSpots(arr);
                    window.dxSpotsPanel.setSpots(arr);
                })
                .catch(() => { /* feature off or backend not ready — ignore */ });
            fetch('/api/dxcluster/status')
                .then(r => r.ok ? r.json() : null)
                .then(s => {
                    if (s) {
                        spectrumPanelA?.setDxStatus(s.status, s.detail);
                        spectrumPanelB?.setDxStatus(s.status, s.detail);
                    }
                })
                .catch(() => { /* ignore */ });

            spectrumPipeline.connect();
            // Drop the spectrum SignalR connection the instant we navigate away or
            // get frozen into the bfcache. If we don't, the frozen page's socket
            // stays half-open and the server still treats it as a live client; when
            // we come back and open a fresh connection, the worker's per-frame
            // Clients.All.SendAsync back-pressures on that zombie (spectrum frames
            // are large, its buffer fills) and frame delivery to the new connection
            // stalls for ~7 s until the transport reaps it. Disconnecting here lets
            // the server drop it at once, so the reloaded page traces almost instantly.
            window.addEventListener('pagehide', function () {
                try { spectrumPipeline.disconnect(); } catch { /* already gone */ }
            });
            // Expose both panels globally for cross-module access (overlay redraws,
            // band-plan reloads, etc.). window.spectrumPanel kept pointing at the
            // A panel as a backward-compatible alias for code that may still expect
            // a single-panel handle.
            window.spectrumPanelA = spectrumPanelA;
            window.spectrumPanelB = spectrumPanelB;
            window.spectrumPanel  = spectrumPanelA;

            // ── Filter scope panels ──────────────────────────────────────────
            window.filterScopePanelA = new FilterScopePanel('filterScopeCanvasA', '@Model.RadioModel', {
                ifWidthCode:       '@Model.RadioState.IfWidthA',
                ifShiftHz:          @Model.RadioState.IfShiftA,
                roofingCode:       '@Model.RadioState.RoofingFilterA',
                manualNotchOn:      @(Model.RadioState.ManualNotchA == "1" ? "true" : "false"),
                manualNotchFreqHz:  @Model.RadioState.ManualNotchFreqA,
                contourOn:          @(Model.RadioState.ContourOnA ? "true" : "false"),
                contourFreqHz:      @Model.RadioState.ContourFreqA,
                apfOn:              @(Model.RadioState.ApfOnA ? "true" : "false"),
                apfFreqHz:          @Model.RadioState.ApfFreqA,
                mode:              '@Model.RadioState.ModeA',
                cwPitchHz:          @(300 + Model.CwPitch * 10)
            });
            window.filterScopePanelB = new FilterScopePanel('filterScopeCanvasB', '@Model.RadioModel', {
                ifWidthCode:       '@Model.RadioState.IfWidthB',
                ifShiftHz:          @Model.RadioState.IfShiftB,
                roofingCode:       '@Model.RadioState.RoofingFilterB',
                manualNotchOn:      @(Model.RadioState.ManualNotchB == "1" ? "true" : "false"),
                manualNotchFreqHz:  @Model.RadioState.ManualNotchFreqB,
                contourOn:          @(Model.RadioState.ContourOnB ? "true" : "false"),
                contourFreqHz:      @Model.RadioState.ContourFreqB,
                apfOn:              @(Model.RadioState.ApfOnB ? "true" : "false"),
                apfFreqHz:          @Model.RadioState.ApfFreqB,
                mode:              '@Model.RadioState.ModeB',
                cwPitchHz:          @(300 + Model.CwPitch * 10)
            });

            // Tighten the contour sliders' ranges to the current passband
            // now that the panels (which compute the passband) are ready.
            // Subsequent recomputes happen on mode / IF Width / roofing changes.
            if (typeof window.updateContourSliderBounds === 'function') {
                window.updateContourSliderBounds('A');
                window.updateContourSliderBounds('B');
            }

            // Repeat of the classic-script assignment above; kept so anything
            // in this DOMContentLoaded block can rely on it locally.
            window._radioModel = '@Model.RadioModel';

            // Hold button — toggles whether the panel updates from incoming
            // SDR frames. While held the spectrum + waterfall freeze at the
            // last received frame so the operator can study a fleeting
            // signal. Click again to resume. State is per-VFO.
            document.querySelectorAll('.spectrum-hold-btn').forEach(btn => {
                btn.addEventListener('click', () => {
                    const vfo = btn.dataset.vfo;
                    const panel = vfo === 'B' ? spectrumPanelB : spectrumPanelA;
                    if (!panel) return;
                    const nowHeld = !panel.isHeld();
                    panel.setHold(nowHeld);
                    // Visual feedback: button goes 'active' (filled) when held.
                    btn.classList.toggle('active', nowHeld);
                    btn.classList.toggle('btn-warning', nowHeld);
                    btn.classList.toggle('btn-outline-light', !nowHeld);
                    // Reflect in the status badge so the change is obvious
                    // even when looking at the panel, not just the toolbar.
                    const badge = document.getElementById('spectrumStatusBadge' + vfo);
                    if (badge && nowHeld) {
                        badge.className = 'badge bg-warning small';
                        badge.textContent = 'Hold';
                    } else if (badge && !nowHeld) {
                        // Falls back to whatever the next status update sets;
                        // until then show "Live" if we were streaming.
                        badge.className = 'badge bg-success small';
                        badge.textContent = 'Live';
                    }
                });
            });

            // Spectrum display sliders — Range (vertical scale), Speed (waterfall
            // scroll rate), Bright (waterfall colour lift) and Smooth (spatial
            // averaging across bins). All four are PURELY
            // client-side and persisted per-VFO in localStorage by the panel; none
            // touch the server. The old Low/High pair and the Gain round-trip to the
            // worker are both gone — the trace auto-tracks the noise floor (see
            // SpectrumPanel auto-floor) and the worker streams a fixed wide window,
            // so the operator only sets how much dB of headroom sits above the floor
            // (Range) and how the waterfall reads (Speed below, Bright further down).
            (function wireRangeSliders() {
                ['A', 'B'].forEach(vfo => {
                    const rangeSlider = document.querySelector(`.spectrum-range-slider[data-vfo="${vfo}"]`);
                    const rangeLabel  = document.querySelector(`.spectrum-range-label[data-vfo="${vfo}"]`);
                    const panel       = vfo === 'B' ? spectrumPanelB : spectrumPanelA;
                    if (!rangeSlider || !panel) return;   // VFO B hidden when no SDR

                    // Sync the Range slider to the panel's persisted value (localStorage).
                    const initialRange = Math.round(panel.getSpectrumRange());
                    rangeSlider.value = String(initialRange);
                    rangeLabel.textContent = initialRange + ' dB';

                    rangeSlider.addEventListener('input', () => {
                        const r = parseInt(rangeSlider.value, 10);
                        rangeLabel.textContent = r + ' dB';
                        panel.setSpectrumRange(r);
                    });
                });
            })();

            // Waterfall scroll speed — purely client-side (no backend/worker
            // involvement, unlike the DSP sliders above): it only changes how
            // often SpectrumPanel advances the waterfall by one row per
            // incoming FFT frame. Persisted in localStorage by the panel
            // itself. The slider drags across an *index* into
            // SpectrumPanel.WATERFALL_SPEEDS (1,2,4,...,128) rather than the
            // divisor itself, since the divisors aren't evenly spaced.
            ['A', 'B'].forEach(vfo => {
                const slider = document.querySelector(`.spectrum-speed-slider[data-vfo="${vfo}"]`);
                const label  = document.querySelector(`.spectrum-speed-label[data-vfo="${vfo}"]`);
                const panel  = vfo === 'B' ? spectrumPanelB : spectrumPanelA;
                if (!slider || !label || !panel) return;

                const speeds = SpectrumPanel.WATERFALL_SPEEDS;
                const formatSpeed = (d) => d === 1 ? 'Full' : `1/${d}`;

                const initialIndex = Math.max(0, speeds.indexOf(panel.getWaterfallSpeed()));
                slider.value = String(initialIndex);
                label.textContent = formatSpeed(speeds[initialIndex]);

                slider.addEventListener('input', () => {
                    const divisor = speeds[parseInt(slider.value, 10)];
                    label.textContent = formatSpeed(divisor);
                    panel.setWaterfallSpeed(divisor);
                });
            });

            // Waterfall brightness — purely client-side (like Range and Speed): it
            // adds a dB lift to the waterfall's colour mapping only, leaving the
            // spectrum trace alone. 0 = "Off". Persisted per-VFO in localStorage by
            // the panel. Replaces the old Gain slider, which drove the worker's
            // pre-dB gain; with the trace auto-ranging that only ever brightened the
            // waterfall, so it's now done entirely in the browser.
            ['A', 'B'].forEach(vfo => {
                const slider = document.querySelector(`.spectrum-bright-slider[data-vfo="${vfo}"]`);
                const label  = document.querySelector(`.spectrum-bright-label[data-vfo="${vfo}"]`);
                const panel  = vfo === 'B' ? spectrumPanelB : spectrumPanelA;
                if (!slider || !label || !panel) return;

                const formatBright = (db) => db <= 0 ? 'Off' : `+${db}`;

                const initial = panel.getWaterfallBrightness();
                slider.value = String(initial);
                label.textContent = formatBright(initial);

                slider.addEventListener('input', () => {
                    const db = parseInt(slider.value, 10);
                    label.textContent = formatBright(db);
                    panel.setWaterfallBrightness(db);
                });
            });

            // Spectrum spatial smoothing — purely client-side, persisted per-VFO
            // by the panel like Range, Speed and Bright. Averages neighbouring FFT
            // bins to flatten the noise floor. It is a slider rather than a fixed
            // constant because the right amount depends entirely on what you are
            // listening to: a CW carrier occupies a single bin, so any smoothing at
            // all costs it amplitude, while SSB is wide enough not to care. This
            // was console-only (setSpectrumSmooth) until CW work showed signals
            // visible in the waterfall with no peak in the trace at all.
            ['A', 'B'].forEach(vfo => {
                const slider = document.querySelector(`.spectrum-smooth-slider[data-vfo="${vfo}"]`);
                const label  = document.querySelector(`.spectrum-smooth-label[data-vfo="${vfo}"]`);
                const panel  = vfo === 'B' ? spectrumPanelB : spectrumPanelA;
                if (!slider || !label || !panel) return;

                const formatSmooth = (r) => r <= 0 ? 'Off' : String(r);

                const initial = panel.getSpectrumSmooth();
                slider.value = String(initial);
                label.textContent = formatSmooth(initial);

                slider.addEventListener('input', () => {
                    const r = parseInt(slider.value, 10);
                    label.textContent = formatSmooth(r);
                    panel.setSpectrumSmooth(r);
                });
            });

            // Passband overlay toggle. On by default and persisted per VFO by
            // the panel itself, so the checkbox is initialised FROM the panel
            // rather than from the markup's `checked` attribute — otherwise a
            // reload would silently switch it back on for anyone who turned it
            // off, the same trap the Smooth slider's localStorage value has.
            ['A', 'B'].forEach(vfo => {
                const box   = document.querySelector(`.spectrum-passband-toggle[data-vfo="${vfo}"]`);
                const panel = vfo === 'B' ? spectrumPanelB : spectrumPanelA;
                if (!box || !panel) return;

                box.checked = panel.getShowPassband();
                box.addEventListener('change', () => panel.setShowPassband(box.checked));
            });

            // Span selector — POST new sample rate for this VFO and restart
            // the corresponding worker. data-vfo on each button tells the
            // server which VFO to apply the change to so the other panel
            // keeps its current bandwidth.
            document.querySelectorAll('.span-btn').forEach(btn => {
                btn.addEventListener('click', async () => {
                    const hz  = btn.dataset.hz;
                    const vfo = btn.dataset.vfo || 'A';   // default A for safety
                    try {
                        const res = await fetch(`/api/sdr/span?hz=${hz}&sdrId=${vfo}`, { method: 'POST' });
                        if (res.ok) {
                            // Move active state only among buttons for this VFO,
                            // leaving the other VFO's group untouched.
                            document
                                .querySelectorAll(`.span-btn[data-vfo="${vfo}"]`)
                                .forEach(b => b.classList.remove('active'));
                            btn.classList.add('active');
                        }
                    } catch { /* network error — ignore */ }
                });
            });
        });
        async function launchWsjtx() {
            try {
                const response = await fetch('/api/wsjtx/launch', { method: 'POST' });
                if (response.ok) {
                    const data = await response.json();
                    if (data.alreadyRunning) {
                        console.log('WSJT-X is already running, brought window to front');
                        // Optional: show a brief message to the user
                        const btn = document.getElementById('wsjtxBtn');
                        const originalText = btn.innerHTML;
                        btn.innerHTML = 'WSJT-X Already Running';
                        setTimeout(() => { btn.innerHTML = originalText; }, 2000);
                    }
                } else {
                    const data = await response.json();
                    alert(data.error || 'Failed to launch WSJT-X');
                }
            } catch (e) {
                alert('Error launching WSJT-X: ' + e.message);
            }
        }

        async function updateWsjtxStatus() {
            try {
                const response = await fetch('/api/wsjtx/status');
                if (response.ok) {
                    const data = await response.json();
                    const btn = document.getElementById('wsjtxBtn');
                    const txBadge = document.getElementById('wsjtxTxBadge');

                    // Green = UDP connected (WSJT-X talking to us)
                    // Yellow = process running but no UDP yet
                    // Grey = not running
                    btn.classList.remove('btn-secondary', 'btn-success', 'btn-warning', 'btn-danger');
                    if (data.connected) {
                        btn.classList.add('btn-success');
                        btn.title = 'WSJT-X connected' + (data.mode ? ' \u2014 ' + data.mode : '');
                    } else if (data.running) {
                        btn.classList.add('btn-warning');
                        btn.title = 'WSJT-X running \u2014 waiting for UDP data';
                    } else {
                        btn.classList.add('btn-danger');
                        btn.title = 'WSJT-X is not running';
                    }

                    // Red TX badge when transmitting
                    if (txBadge) {
                        txBadge.style.display = data.transmitting ? 'inline' : 'none';
                    }
                }
            } catch (e) { /* ignore */ }
        }

        updateWsjtxStatus();
        setInterval(updateWsjtxStatus, 5000);

        // JTAlert launch and status functions
        async function launchJtalert() {
