                            {
                                @foreach (var opt in roofingOptions3000)
                                {
                                    <option value="@opt.Value" selected="@(Model.RadioState.RoofingFilterA==opt.Value ? "selected" : null)">@opt.Label</option>
                                }
                            }
                            else
                            {
                                @foreach (var opt in roofingOptions)
                                {
                                    <option value="@opt.Value" selected="@(Model.RadioState.RoofingFilterA==opt.Value ? "selected" : null)">@opt.Label</option>
                                }
                            }
                        </select>
                        }
                        <label class="mb-0 text-nowrap ms-1 fw-bold">AF Gain: <span id="afGainValueA" class="fw-bold">@Model.AfGainA</span></label>
                        <input type="range" class="flex-shrink-0"
                               id="afGainSliderA"
                               aria-label="VFO A AF gain"
                               title="VFO A AF gain"
                               min="0" max="255" step="1" value="@Model.AfGainA"
                               style="width: clamp(70px, 8vw, 120px); height: 18px;"
                               oninput="document.getElementById('afGainValueA').innerText = this.value">
                    </div>

                    <!-- IF Width and IF Shift -->
                    <div class="d-flex align-items-center gap-2 mb-0" style="flex-wrap: wrap;">
