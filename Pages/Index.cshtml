                                <label class="vfo-control-label">Squelch</label>
                                <input type="range" id="squelchSliderA" aria-label="VFO A squelch" title="VFO A squelch level (0=open, 255=max)" min="0" max="255" step="1" value="@Model.RadioState.SquelchA"
                                       style="flex: 1; height: 16px;"
                                       oninput="document.getElementById('squelchValueA').textContent = this.value"
                                       onchange="setSquelch('A', this.value)">
                                <span id="squelchValueA" class="vfo-control-label" style="min-width: 36px; text-align: right;">@Model.RadioState.SquelchA</span>
                            </div>
                        </div>
                    </div>

                    <!-- Segment selector + Contour/APF controls on one row -->
                    <div class="d-flex align-items-center gap-1 mb-1 flex-wrap" style="margin-top: 2px;">
                        <span class="fw-bold" style="font-size: 0.8rem; white-space: nowrap;">Segment</span>
                        <select class="form-select form-select-sm segment-select" id="segmentSelectA"
                                aria-label="VFO A band segment"
                                title="VFO A band segment"
                                onchange="window.onSegmentChange && window.onSegmentChange('A', this.value)">
                            <option value="">--</option>
                        </select>
                        <button type="button" id="contourBtnA"
                                class="btn btn-sm @(Model.RadioState.ContourOnA ? "btn-success" : "btn-outline-secondary") flex-shrink-0"
                                style="color: black; font-weight: bold;"
                                aria-label="VFO A Contour filter" title="Toggle Contour audio peak filter"
                                onclick="toggleContour('A')">@(Model.RadioState.ContourOnA ? "Contour On" : "Contour Off")</button>
                        <input type="range" id="contourFreqSliderA"
                               min="100" max="@contourMaxFreq" step="@contourStep"
                               value="@Model.RadioState.ContourFreqA"
                               style="width: clamp(60px, 8vw, 110px); height: 16px;"
                               oninput="document.getElementById('contourFreqValueA').textContent = this.value + ' Hz'"
                               onchange="setContourFreq('A', parseInt(this.value))"
                               aria-label="VFO A Contour frequency">
