@page
@model Yaesu_Web_Control.Pages.IndexModel
@{
    ViewData["Title"]     = "Yaesu Web Control";
    ViewData["BodyRole"]  = "application";
    ViewData["BodyLabel"] = "Yaesu radio control panel";

    bool isFtdx10  = Model.RadioModel == "FTdx10";
    bool isFt710   = Model.RadioModel == "FT-710";
    bool isFtdx3000 = Model.RadioModel == "FTDX3000";
    bool isFtdx5000 = Model.RadioModel == "FTDX5000MP" || Model.RadioModel == "FTDX5000D";

    // Single- vs dual-receiver layout gates (RX/TX selectors, S-meter B, etc.)
    // — see docs/decisions/0003-single-vs-dual-receiver-ui.md.
    bool isSingleReceiver  = Yaesu_Web_Control.Services.RadioCapabilities.IsSingleReceiver(Model.RadioModel);
    bool hasAntennaSelector = Yaesu_Web_Control.Services.RadioCapabilities.HasAntennaSelector(Model.RadioModel);
    // Rated TX output. Server-rendered rather than derived in JavaScript so the
    // slider and the Power dial are right on first paint, and so the browser
    // agrees with the range check CatController.SetPower applies to the same value.
    int maxPowerWatts = Yaesu_Web_Control.Services.RadioCapabilities.MaxPowerWatts(Model.RadioModel);
    // Quick Memory Bank Store/Recall (Thomas OZ1JTE request) — rendered once
    // in operating-controls column 4, since QMB is a radio-global function.
    bool hasQmb = Yaesu_Web_Control.Services.RadioCapabilities.SupportsQmb(Model.RadioModel);
    // Render VC Tune controls only when both the model supports VC Tune (FTdx101MP)
    // AND the hardware ID is positively confirmed to support VT CAT commands.
    // Empty/unknown ID → hidden (user can reload once radio connects and ID; is received).
    bool hasVcTune    = Yaesu_Web_Control.Services.RadioCapabilities.SupportsVCTuneMain(Model.RadioModel)
                     && Yaesu_Web_Control.Services.RadioCapabilities.SupportsVCTuneCat(Model.RadioState.Id);
    // SUB VC Tune, like MAIN above, also requires the hardware ID to support
    // VT CAT — the VT command is shared, so a revision that rejects VT (e.g.
    // ID0682) can drive neither MAIN nor SUB. Previously this line omitted the
    // SupportsVCTuneCat check, so the SUB control leaked onto blocked-ID radios
    // (Colin MM5AGM, FTdx101MP ID0682) even though MAIN was correctly hidden.
    bool hasVcTuneSub = Yaesu_Web_Control.Services.RadioCapabilities.SupportsVCTuneSubStatic(Model.RadioModel)
                     && Yaesu_Web_Control.Services.RadioCapabilities.SupportsVCTuneCat(Model.RadioState.Id);

    string clarModeInit = (Model.RadioState.RxClarOn, Model.RadioState.TxClarOn) switch
    {
        (true, true)  => "rxtx",
        (true, false) => "rx",
        (false, true) => "tx",
        _             => "off"
    };

    int contourMaxFreq = isFtdx3000 ? 4000 : 3200;
    int contourStep    = isFtdx3000 ? 100  : 10;
    int apfStep        = isFtdx3000 ? 25   : 10;

    // IF Width options differ by model. Values match the SH command code sent to the radio.
    var ifWidthOptions = isFtdx10
        ? new (string Value, string Label)[]
        {
            // FTdx10 SH codes: code 0 is the wide 3 kHz default; codes 1-22 run narrow→wide.
            ("0","3.0 kHz"),
            ("1","300 Hz"), ("2","400 Hz"), ("3","600 Hz"), ("4","850 Hz"),
            ("5","1.1 kHz"), ("6","1.2 kHz"), ("7","1.5 kHz"), ("8","1.65 kHz"),
            ("9","1.8 kHz"), ("10","1.95 kHz"), ("11","2.1 kHz"), ("12","2.25 kHz"),
            ("13","2.4 kHz"), ("14","2.45 kHz"), ("15","2.5 kHz"), ("16","2.6 kHz"),
            ("17","2.7 kHz"), ("18","2.8 kHz"), ("19","2.9 kHz"), ("20","3.2 kHz"),
            ("21","3.5 kHz"), ("22","4.0 kHz")
        }
        : isFt710
        ? new (string Value, string Label)[]
        {
            ("0","300 Hz"), ("2","600 Hz"), ("3","850 Hz"), ("5","1.2 kHz"),
            ("7","1.65 kHz"), ("9","1.95 kHz"), ("12","2.4 kHz"), ("16","2.7 kHz"),
            ("19","3.0 kHz"), ("20","3.2 kHz"), ("21","3.5 kHz"), ("22","4.0 kHz")
        }
        : isFtdx3000
        ? new (string Value, string Label)[]
        {
            ("1","200 Hz"), ("2","400 Hz"), ("3","600 Hz"), ("4","850 Hz"),
            ("6","1.35 kHz"), ("7","1.5 kHz"), ("9","1.8 kHz"), ("12","2.2 kHz"),
            ("14","2.4 kHz"), ("16","2.6 kHz"), ("18","2.8 kHz"), ("20","3.0 kHz"),
            ("22","3.4 kHz"), ("25","4.0 kHz")
        }
        : new (string Value, string Label)[]
        {
            // FTdx101MP/D SH codes. The 2308-L CAT manual documents 0-21; current
            // firmware (verified empirically by Colin on the FTdx101MP, #50)
            // extends to code 23 = 4.0 kHz, with code 22 = 3.5 kHz between them.
            // Code 0 is the radio's mode-dependent default (3 kHz with a 3 kHz
            // roofing filter in SSB); codes 1-21 run narrow→wide as per the
            // manual, then 22/23 add the wider SSB filters.
            ("0","3.0 kHz"),
            ("1","300 Hz"), ("2","400 Hz"), ("3","600 Hz"), ("4","850 Hz"),
            ("5","1.1 kHz"), ("6","1.2 kHz"), ("7","1.5 kHz"), ("8","1.65 kHz"),
            ("9","1.8 kHz"), ("10","1.95 kHz"), ("11","2.1 kHz"), ("12","2.2 kHz"),
            ("13","2.3 kHz"), ("14","2.4 kHz"), ("15","2.5 kHz"), ("16","2.6 kHz"),
            ("17","2.7 kHz"), ("18","2.8 kHz"), ("19","2.9 kHz"), ("20","3.0 kHz"),
            ("21","3.2 kHz"), ("22","3.5 kHz"), ("23","4.0 kHz")
        };
    string ifWidthDefaultA = isFtdx10 ? "0" : isFt710 ? "12" : isFtdx3000 ? "14" : "0";
    string ifWidthDefaultB = isFtdx10 ? "0" : isFt710 ? "12" : isFtdx3000 ? "14" : "0";

    // Roofing filter options: FTdx101MP/D only (FT-710 has no CAT roofing filter control).
    // RF command codes 6-A, filtered to only fitted filters per Settings.
    var roofingOptions = new (string Value, string Label)[]
            { ("A","300 Hz"), ("9","600 Hz"), ("8","1.2 kHz"), ("7","3 kHz"), ("6","12 kHz") }
            .Where(o => Model.InstalledRoofingFilters.Contains(o.Value))
            .ToArray();

    // FTdx10 roofing filter options (RF read codes 6/7/9 standard, A optional).
    var roofingOptionsFtdx10 = new (string Value, string Label)[]
            { ("6","12 kHz"), ("7","3 kHz"), ("9","500 Hz"), ("A","300 Hz") }
            .Where(o => o.Value == "6" || o.Value == "7" || o.Value == "9"
                     || Model.InstalledRoofingFilters.Contains(o.Value))
            .ToArray();

    // FTDX3000 roofing filter options (codes 0-5; always show standard 0-3, optional 4-5 if fitted).
    var roofingOptions3000 = new (string Value, string Label)[]
            { ("0","Auto"), ("1","15 kHz"), ("2","6 kHz"), ("3","3 kHz"), ("4","600 Hz"), ("5","300 Hz") }
            .Where(o => o.Value == "0" || o.Value == "1" || o.Value == "2" || o.Value == "3"
                     || Model.InstalledRoofingFilters.Contains(o.Value))
            .ToArray();

    // Active set for the Yaesu-style Roofing key (FT-710 has no CAT roofing).
    var activeRoofingOptions = isFt710
        ? Array.Empty<(string Value, string Label)>()
        : isFtdx10 ? roofingOptionsFtdx10
        : isFtdx3000 ? roofingOptions3000
        : roofingOptions;
    var roofingOptionsJson = System.Text.Json.JsonSerializer.Serialize(
        activeRoofingOptions.Select(o => new { id = o.Value, label = o.Label }));

    // CTCSS tones — these codes go on the wire as CN's P3, so they must be
    // Yaesu's Table 1 (CAT manual p.8) exactly: 3 digits, 000-049, 000 = 67.0 Hz.
    // This list used to be a generic 1-based 2-digit EIA list, which was off by
    // one against Table 1 for every tone AND diverged from it: it carried a
    // 150.0 Hz entry that Yaesu does not have, and was missing 159.8 Hz, so
    // everything from 146.2 Hz up was shifted a further step. (2026-08-17)
    var ctcssTones = new (string Code, string Label)[]
    {
        ("000","67.0"),  ("001","69.3"),  ("002","71.9"),  ("003","74.4"),  ("004","77.0"),
        ("005","79.7"),  ("006","82.5"),  ("007","85.4"),  ("008","88.5"),  ("009","91.5"),
        ("010","94.8"),  ("011","97.4"),  ("012","100.0"), ("013","103.5"), ("014","107.2"),
        ("015","110.9"), ("016","114.8"), ("017","118.8"), ("018","123.0"), ("019","127.3"),
        ("020","131.8"), ("021","136.5"), ("022","141.3"), ("023","146.2"), ("024","151.4"),
        ("025","156.7"), ("026","159.8"), ("027","162.2"), ("028","165.5"), ("029","167.9"),
        ("030","171.3"), ("031","173.8"), ("032","177.3"), ("033","179.9"), ("034","183.5"),
        ("035","186.2"), ("036","189.9"), ("037","192.8"), ("038","196.6"), ("039","199.5"),
        ("040","203.5"), ("041","206.5"), ("042","210.7"), ("043","218.1"), ("044","225.7"),
        ("045","229.1"), ("046","233.6"), ("047","241.8"), ("048","250.3"), ("049","254.1")
    };
}

<!-- Cache-busted CSS reference -->
<link rel="stylesheet" href="~/css/site.css?v=20260915g" />
<link rel="stylesheet" href="~/css/closer-to-raw-power.css?v=20260226n" />
<link rel="stylesheet" href="~/css/toggle-dropdown-button.css" asp-append-version="true" />
<style>
    #saveMemBtnA, #saveMemBtnB { font-weight: 700 !important; font-size: 0.85rem !important; color: var(--yaesu-ink, #e6e6e6) !important; }

    /* Dual-receiver (FTdx101) active-band highlight: a subtle amber ring on
       the VFO panel the main tuning knob currently controls (MAIN or SUB).
       box-shadow so it never shifts layout; both receivers stay full-colour. */
    .vfo-active > .card.receiver-card {
        box-shadow: 0 0 0 2px #ffc107, 0 0 10px rgba(255, 193, 7, 0.5);
        transition: box-shadow 0.2s ease;
    }

    /* Grey the S-meters while transmitting.

       The radio does not keep measuring during an over — it latches SM0 and
       SM1 at key-down and holds them until release. Measured on an FTdx101MP
       by sampling TX;/SM0;/SM1; together at ~21 Hz with the app stopped:

         RECEIVE   n=375   SM0 29 distinct values   SM1 21 distinct
         TRANSMIT  n=101   SM0  1 distinct value    SM1  1 distinct

       101 consecutive transmit samples returned SM0=154 SM1=75 unchanged;
       both resumed within ~200 ms of release. So every reading drawn during
       an over was a snapshot of the instant you keyed, presented as live.

       Greyed, not hidden: the S-meters are leftmost, so removing them would
       shift the whole row sideways on every over. site.js also substitutes 0
       for the frozen value — see updateSMeter(). The two go together: a
       zeroed needle on its own would claim "no signal", but greyed-and-zero
       reads as "not measuring", which is what is actually happening. */
    .meters-tx-dim [data-meter-scope="rx"] {
        filter: grayscale(1);
        opacity: 0.3;
        transition: opacity 0.25s ease, filter 0.25s ease;
    }

    /* Temporary gauges-row hide: keep the operating controls visible. */
    #metersCardBody.gauges-hidden #meterGaugesRow {
        display: none !important;
    }
    #metersCardBody.gauges-hidden #operatingControlsRow {
        margin-top: 0 !important;
    }

    /* Voice command help popup (right-click a mic button). */
    #voiceHelpBody .vh-intro   { color: #bbb; font-size: 0.85rem; margin-bottom: 0.75rem; }
    #voiceHelpBody .vh-group   { margin-bottom: 0.85rem; }
    #voiceHelpBody .vh-group h6 { color: #4db8ff; font-size: 0.8rem; text-transform: uppercase;
                                  letter-spacing: 0.04em; margin: 0 0 0.35rem 0; }
    #voiceHelpBody .vh-item    { display: flex; flex-wrap: wrap; gap: 0.25rem 0.6rem;
                                 align-items: baseline; padding: 0.15rem 0; }
    #voiceHelpBody .vh-what    { flex: 0 0 auto; min-width: 190px; }
    #voiceHelpBody .vh-ex      { color: #ffd47a; font-size: 0.85rem; }
    #voiceHelpBody .vh-ex code { color: #ffd47a; background: #333; border-radius: 3px;
                                 padding: 1px 5px; margin-right: 4px; white-space: nowrap; }

    #remoteAudioBar .remote-audio-icon-btn {
        width: 2rem;
        height: 2rem;
        padding: 0;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        line-height: 1;
    }
    #remoteAudioBar .remote-audio-btn-icon {
        font-size: 1rem;
        line-height: 1;
    }

    /* Voice PTT button — three visually distinct states so the operator can
       always tell whether it's listening:
         1. Rest / hover (armed, NOT listening) -> amber outline. Bootstrap
            normally fills btn-outline-danger solid RED on hover, which was
            indistinguishable from the pressed/listening red; we override that
            to amber so "hovering" never looks like "listening".
         2. Pressed / listening -> solid red, pressed *in* (scaled down), with a
            bright pulsing ring and a breathing icon. Impossible to mistake.
         3. Release (pointer still on the button) -> snaps back to the amber
            hover look, so the red->amber change is proof the release registered.
       The pressed-in scale means the shape changes too, not just colour, which
       helps a partially-sighted operator. */

    /* Armed hover — amber, deliberately not red. :not(.voice-mic-listening)
       so it never fights the pressed state. */
    .voice-mic-btn.btn-outline-danger:hover:not(.voice-mic-listening) {
        background-color: #ffe69c;
        border-color: #ffc107;
        color: #664d03;
    }

    /* Pressed / listening — wins over every other state. */
    .voice-mic-btn.voice-mic-listening,
    .voice-mic-btn.voice-mic-listening:hover {
        background-color: #dc3545 !important;
        border-color: #b02a37 !important;
        color: #fff !important;
        transform: scale(0.94);
        animation: voiceMicPulse 1s ease-in-out infinite;
    }
    .voice-mic-btn.voice-mic-listening > i {
        animation: voiceMicIcon 1s ease-in-out infinite;
    }
    @@keyframes voiceMicPulse {
        0%   { box-shadow: 0 0 0 0    rgba(220, 53, 69, 0.75); }
        70%  { box-shadow: 0 0 0 18px rgba(220, 53, 69, 0);    }
        100% { box-shadow: 0 0 0 0    rgba(220, 53, 69, 0);    }
    }
    @@keyframes voiceMicIcon {
        0%, 100% { transform: scale(1);    opacity: 1;   }
        50%      { transform: scale(1.12); opacity: 0.85; }
    }

    /* Dialog close (✕) button — a solid red so it stands out clearly against
       the dark dialog header. The default btn-outline-secondary was a faint
       grey outline that several operators found hard to spot. */
    .ywc-dialog-close {
        background: #c0392b;
        color: #fff;
        border: 1px solid #e74c3c;
        font-weight: bold;
        line-height: 1;
    }
    .ywc-dialog-close:hover,
    .ywc-dialog-close:focus {
        background: #e74c3c;
        color: #fff;
        border-color: #ff6b5a;
    }
</style>

<!-- Message Box Modal (Windows-style) -->
<div class="modal fade" id="messageBoxModal" tabindex="-1" aria-labelledby="messageBoxTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 400px;">
        <div class="modal-content" style="border-radius: 4px; border: 2px solid #dc3545;">
            <div class="modal-header py-2" style="background: linear-gradient(to bottom, #dc3545, #c82333); border-bottom: 1px solid #bd2130;">
                <h6 class="modal-title text-white" id="messageBoxTitle" style="font-size: 0.9rem;">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>Warning
                </h6>
            </div>
            <div class="modal-body py-3" style="background: var(--yaesu-face, #2a2a2a);">
                <p id="messageBoxText" class="mb-0" style="font-size: 0.9rem; color: var(--yaesu-ink, #e6e6e6);"></p>
            </div>
            <div class="modal-footer py-2 justify-content-center" style="background: var(--yaesu-face-lo, #1a1a1a); border-top: 1px solid #4a4a4a;">
                <button type="button" class="btn btn-danger btn-sm px-4" data-bs-dismiss="modal" style="min-width: 80px;">OK</button>
            </div>
        </div>
    </div>
</div>

<!-- Overlay for initialization status -->
<div id="initOverlay" class="init-overlay">
    <div class="init-message">
        <span id="initStatusText">Initializing radio, please wait...</span>
        <div class="spinner-border text-primary" role="status"></div>
    </div>
</div>

<!-- Viewport too-narrow warning (shown once, dismissible) -->
<div id="viewportWarning" class="alert alert-warning alert-dismissible mb-1 py-1 px-3" role="alert" style="display:none; font-size:0.85rem;">
    <strong>Display settings may need attention.</strong>
    Your browser viewport appears narrow — meter gauges may wrap to a second row.
    Check <strong>Windows Display Settings</strong>: ensure resolution is set to native and scaling is correct for your monitor
    (recommended: <strong>150%</strong> for 4K, <strong>125%</strong> for 1440p, <strong>100%</strong> for 1080p).
    <button type="button" class="btn-close btn-sm py-2" onclick="dismissViewportWarning()" aria-label="Dismiss"></button>
</div>

<div class="row mb-1" style="padding-top: 2px; padding-bottom: 2px;">
        @if (Model.ShowApp1Button)
        {
            <div class="col-auto">
                <button id="wsjtxBtn" class="btn btn-secondary btn-sm" style="padding-top: 1px; padding-bottom: 1px;"
                        onclick="launchWsjtx()" title="Launch @Model.App1Name" aria-label="Launch @Model.App1Name">
                    @Model.App1Name
                    <span id="wsjtxTxBadge" class="badge bg-danger ms-1" style="display:none;">TX</span>
                </button>
            </div>
        }
        @if (Model.ShowApp3Button)
        {
            <div class="col-auto">
                <button id="log4omBtn" class="btn btn-secondary btn-sm" style="padding-top: 1px; padding-bottom: 1px;"
                        onclick="launchLog4om()" title="Launch @Model.App3Name" aria-label="Launch @Model.App3Name">
                    @Model.App3Name
                </button>
            </div>
        }
        @if (Model.ShowApp2Button)
        {
            <div class="col-auto">
                <button id="jtalertBtn" class="btn btn-secondary btn-sm" style="padding-top: 1px; padding-bottom: 1px;"
                        onclick="launchJtalert()" title="Launch @Model.App2Name" aria-label="Launch @Model.App2Name">
                    @Model.App2Name
                </button>
            </div>
        }
        @if (Model.ShowApp4Button)
        {
            <div class="col-auto">
                <button id="gridtrackerBtn" class="btn btn-secondary btn-sm" style="padding-top: 1px; padding-bottom: 1px;"
                        onclick="launchGridtracker()" title="Launch @Model.App4Name" aria-label="Launch @Model.App4Name">
                    @Model.App4Name
                </button>
            </div>
        }
        @if (Model.ShowApp5Button)
        {
            <div class="col-auto">
                <button id="fldigiBtn" class="btn btn-secondary btn-sm" style="padding-top: 1px; padding-bottom: 1px;"
                        onclick="launchFldigi()" title="Launch @Model.App5Name" aria-label="Launch @Model.App5Name">
                    @Model.App5Name
                </button>
            </div>
        }
        <div class="col-auto ms-auto d-flex gap-2 align-items-center">
            <span id="utcClock"
                  class="font-monospace fw-bold px-2"
                  style="font-size:0.95rem; color:#ffe066; background:#222; border:1px solid #444; border-radius:4px; padding-top: 1px; padding-bottom: 1px; cursor:help;"
                  title="UTC time from your PC system clock. Drifts if Windows can't reach time.windows.com. Click for details and how to verify."
                  onclick="document.getElementById('utcClockInfoDialog').show()"
                  aria-live="off"
                  aria-label="Current UTC time. Click for source and accuracy details.">--:--:--Z</span>
            <a href="https://paypal.me/mm5agm" target="_blank" rel="noopener noreferrer"
               class="btn btn-warning btn-sm" style="padding-top: 1px; padding-bottom: 1px;" title="Support this project via PayPal"
               aria-label="Support this project via PayPal — Buy Me a Coffee">
                <i class="bi bi-cup-hot-fill" aria-hidden="true"></i> Buy Me a Coffee
            </a>
            <button id="memBtn" class="btn btn-sm btn-outline-info fw-bold"
                    style="padding-top: 1px; padding-bottom: 1px; color: #000;" title="Open memories panel"
                    aria-label="Open memories panel">
                Mem
            </button>
            <button id="sMeterHistoryToggleBtn" class="btn btn-sm btn-outline-secondary"
                    style="padding-top: 1px; padding-bottom: 1px;"
                    title="Show/hide 30-second S-meter history strip (QSB, noise spikes, noise floor)"
                    aria-label="Show or hide the S-meter history strip"
                    aria-pressed="false">
                S-hist
            </button>
            <button id="meterGaugesToggleBtn" class="btn btn-sm btn-outline-secondary"
                    style="padding-top: 1px; padding-bottom: 1px;"
                    title="Show/hide analogue meter gauges"
                    aria-label="Show or hide the meter gauges row"
                    aria-pressed="true">
                Gauges
            </button>
            <button type="button" class="btn btn-sm btn-outline-secondary"
                    data-kb-display-target
                    style="padding-top: 1px; padding-bottom: 1px;"
                    title="Keyboard z/w/s target: SDR spectrum or Radio Scope (t)"
                    aria-label="Toggle keyboard shortcuts between SDR spectrum and Radio Scope"
                    aria-pressed="false"
                    hidden>
                SDR
            </button>
            <button type="button" class="btn btn-sm btn-outline-secondary"
                    data-open-shortcuts
                    data-bs-toggle="tooltip"
                    data-bs-placement="bottom"
                    data-bs-title="Keyboard shortcuts (?)"
                    style="padding-top: 1px; padding-bottom: 1px;"
                    aria-label="Show keyboard shortcuts">
                <i class="bi bi-keyboard" aria-hidden="true"></i>
            </button>
            <button id="vfoBToggleBtn" class="btn btn-sm btn-outline-secondary"
                    style="padding-top: 1px; padding-bottom: 1px;" title="Show/Hide VFO-B"
                    aria-label="Show or hide VFO B panel">
                VFO-B
            </button>
            <button id="swapVfoBtn" class="btn btn-sm btn-outline-secondary"
                    style="padding-top: 1px; padding-bottom: 1px;" title="Swap VFO A and VFO B frequencies"
                    aria-label="Swap VFO A and VFO B frequencies">
                A&#8596;B
            </button>
            <button id="copyBtoABtn" class="btn btn-sm btn-outline-secondary"
                    style="padding-top: 1px; padding-bottom: 1px;"
                    title="Copy VFO B frequency &amp; mode to VFO A. VFO B is left unchanged. Useful for transmitting on VFO B's settings without enabling split."
                    aria-label="Copy VFO B to VFO A">
                B&rarr;A
            </button>
            <button id="copyAtoBBtn" class="btn btn-sm btn-outline-secondary"
                    style="padding-top: 1px; padding-bottom: 1px;"
                    title="Copy VFO A frequency &amp; mode to VFO B. VFO A is left unchanged. Useful for seeding VFO B from VFO A before adjusting one of them."
                    aria-label="Copy VFO A to VFO B">
                A&rarr;B
            </button>
            <button id="splitBtn" class="btn btn-sm btn-outline-secondary"
                    style="padding-top: 1px; padding-bottom: 1px;" title="Toggle Split: VFO A = receive, VFO B = transmit"
                    aria-label="Toggle split mode: VFO A receive, VFO B transmit">
                Split
            </button>
            <button id="quickSplitBtn" class="btn btn-sm btn-outline-secondary"
                    style="padding-top: 1px; padding-bottom: 1px;" title="Quick Split: enable split and set VFO B to VFO A + 5 kHz"
                    aria-label="Quick split: enable split and set VFO B to VFO A plus 5 kHz">
                +5k
            </button>
            @if (isSingleReceiver)
            {
                <span id="rxTxSplitGroup" class="d-inline-flex align-items-center gap-1 ms-1"
                      title="Independent RX / TX VFO selection. Split is on whenever RX and TX are different VFOs.">
                    <span class="small text-nowrap">RX</span>
                    <div class="btn-group btn-group-sm" role="group" aria-label="Receive VFO">
                        <button type="button" id="rxVfoA" class="btn btn-outline-secondary py-0" data-rx="A" aria-label="Receive on VFO A">A</button>
                        <button type="button" id="rxVfoB" class="btn btn-outline-secondary py-0" data-rx="B" aria-label="Receive on VFO B">B</button>
                    </div>
                    <span class="small text-nowrap ms-1">TX</span>
                    <div class="btn-group btn-group-sm" role="group" aria-label="Transmit VFO">
                        <button type="button" id="txVfoA" class="btn btn-outline-secondary py-0" data-tx="A" aria-label="Transmit on VFO A">A</button>
                        <button type="button" id="txVfoB" class="btn btn-outline-secondary py-0" data-tx="B" aria-label="Transmit on VFO B">B</button>
                    </div>
                </span>
            }
            <button id="connectBtn" class="btn btn-danger btn-sm"
                    onclick="toggleCatConnection()" style="padding-top: 1px; padding-bottom: 1px;" title="Connect or disconnect CAT serial port"
                    aria-label="CAT serial connection — currently disconnected">
                <i class="bi bi-plug" aria-hidden="true"></i> Disconnected
            </button>
            <button id="radioPowerBtn" class="btn btn-danger btn-sm"
                    onclick="toggleRadioPower()" style="padding-top: 1px; padding-bottom: 1px;" title="Radio Power On/Off"
                    aria-label="Radio power on or off">
                <i class="bi bi-power" aria-hidden="true"></i> POWER
            </button>
        </div>
    </div>

    <!-- (Status line moved inside each VFO panel — see #vfoAStatusLine / #vfoBStatusLine) -->
    @* Single live region for BOTH status lines. One region means one utterance:
       two polite regions changing in the same tick are not reliably read one after
       the other, which is why a change on VFO B could go unheard. Emptied a couple
       of seconds after speaking so its text is not met a second time when the page
       is browsed. *@
    <span id="vfoStatusAnnounce" class="visually-hidden" role="status"
          aria-live="polite" aria-atomic="true"></span>

    <!-- Power and SWR Meters -->
    <div class="row mt-3">
        <div class="col-12">
            <div class="card border-secondary">
                <div id="metersCardBody" class="card-body py-2">
                    <partial name="_MeterGaugesPartial" model="Model.RadioModel" />
                    <!-- Operating controls — independent of the gauges strip layout.
                         Resize with Bootstrap col-* on each .op-col. -->
                    <div id="operatingControlsRow" class="row g-2 align-items-start">
                        <!-- Column 0 — Compact linear meters (PoC). Radials in
                             #meterGaugesRow stay in place. Steal width from the
                             extras column (was col-6 → col-4). -->
                        <div class="col-2 op-col op-col--linear-meters">
                            <div class="linear-meter-row">
                                <span class="linear-meter-label">SWR</span>
                                <canvas id="swrLinearCanvas"
                                        role="img" aria-hidden="true"
                                        aria-label="SWR meter (linear)"
                                        data-a11y-key="meters.linearSwr"></canvas>
                                <span id="swrLinearValue" class="linear-meter-value linear-meter-value--swr">1.0:1</span>
                            </div>
                            <div class="linear-meter-row">
                                <span class="linear-meter-label">PWR</span>
                                <canvas id="powerLinearCanvas"
                                        role="img" aria-hidden="true"
                                        aria-label="Power output meter (linear)"
                                        data-a11y-key="meters.linearPower"></canvas>
                                <span id="powerLinearValue" class="linear-meter-value linear-meter-value--pwr">0 W</span>
                            </div>
                            <div class="linear-meter-row">
                                <span class="linear-meter-label">COMP</span>
                                <canvas id="compressionLinearCanvas"
                                        role="img" aria-hidden="true"
                                        aria-label="Compression meter (linear)"
                                        data-a11y-key="meters.linearCompression"></canvas>
                                <span id="compressionLinearValue" class="linear-meter-value linear-meter-value--comp">0 dB</span>
                            </div>
                            <div class="linear-meter-row">
                                <span class="linear-meter-label">ALC</span>
                                <canvas id="alcLinearCanvas"
                                        role="img" aria-hidden="true"
                                        aria-label="ALC meter (linear)"
                                        data-a11y-key="meters.linearAlc"></canvas>
                                <span id="alcLinearValue" class="linear-meter-value linear-meter-value--alc">0V</span>
                            </div>
                        </div>
                        <!-- Column 1 — TX levels (a little wider for key + slider) -->
                        <div class="col-3 op-col op-col--levels">
                            <div class="op-slider-row">
                                <label class="mb-0 text-nowrap">Power: <span id="powerValue" class="fw-bold">@Model.RadioState.Power W</span></label>
                                <input type="range" class="flex-shrink-0" id="powerSlider"
                                       aria-label="Transmit power"
                                       title="Transmit power"
                                       min="5" max="@maxPowerWatts" step="5"
                                       value="@Model.RadioState.Power"
                                       oninput="window.radioControl.updatePowerDisplay(window.txVfo === 1 ? 'B' : 'A', this.value)"
                                       onchange="window.radioControl.setPower(window.txVfo === 1 ? 'B' : 'A', this.value)">
                            </div>
                            <div class="op-slider-row">
                                <label class="mb-0 text-nowrap"><span id="micGainLabel">MIC Gain</span>: <span id="micGainValue" class="fw-bold">@Model.MicGain</span></label>
                                <input type="range" class="flex-shrink-0"
                                       id="micGainSlider"
                                       aria-label="Microphone gain"
                                       title="Microphone gain"
                                       min="0" max="100" step="1"
                                       value="@Model.MicGain"
                                       oninput="document.getElementById('micGainValue').innerText = this.value;"
                                       onchange="setMicGain(this.value);">
                            </div>
                            <div class="yaesu-level-key">
                                <button id="procBtn"
                                        type="button"
                                        class="btn toggle-dd__btn"
                                        aria-pressed="@(Model.ProcEnabled ? "true" : "false")"
                                        aria-label="Speech processor — currently @(Model.ProcEnabled ? "on" : "off")"
                                        title="Speech processor on/off"
                                        onclick="toggleProc()">
                                    <span class="toggle-dd__led @(Model.ProcEnabled ? "is-on" : "")" aria-hidden="true"></span>
                                    <span class="toggle-dd__label">PROC</span>
                                </button>
                                <div class="yaesu-level-key__level">
                                    <span id="procLevelValue" class="fw-bold">@Model.ProcLevel</span>
                                    <input type="range"
                                           id="procLevelSlider"
                                           aria-label="Speech processor level"
                                           title="Speech processor level"
                                           min="0" max="100" step="1"
                                           value="@Model.ProcLevel"
                                           oninput="document.getElementById('procLevelValue').innerText = this.value;"
                                           onchange="setProcLevel(this.value);">
                                </div>
                            </div>
                            <div class="yaesu-level-key">
                                <button id="monitorOnBtn"
                                        type="button"
                                        class="btn toggle-dd__btn"
                                        aria-pressed="@(Model.MonitorOn ? "true" : "false")"
                                        aria-label="TX monitor — currently @(Model.MonitorOn ? "on" : "off")"
                                        title="Toggle TX monitor / sidetone on/off"
                                        onclick="toggleMonitor()">
                                    <span class="toggle-dd__led @(Model.MonitorOn ? "is-on" : "")" aria-hidden="true"></span>
                                    <span class="toggle-dd__label">MON</span>
                                </button>
                                <div class="yaesu-level-key__level">
                                    <span id="monLevelValue" class="fw-bold">@Model.MonitorLevelA</span>
                                    <input type="range"
                                           id="monLevelSlider"
                                           aria-label="TX monitor / sidetone level"
                                           title="TX monitor / sidetone level"
                                           min="0" max="100" step="1"
                                           value="@Model.MonitorLevelA"
                                           oninput="document.getElementById('monLevelValue').innerText = this.value;"
                                           onchange="setMonitorLevel(this.value);">
                                </div>
                            </div>
                        </div>

                        <!-- Column 2 — ATU / Tune / FM / VOX -->
                        <div class="col-1 op-col op-col--buttons">
                            <button id="atuBtn"
                                    type="button"
                                    class="btn toggle-dd__btn"
                                    data-a11y-key="controls.atu"
                                    data-atu-enabled="@(Model.AtuEnabled ? "true" : "false")"
                                    aria-pressed="@(Model.AtuEnabled ? "true" : "false")"
                                    aria-label="Antenna tuner — short tap toggles on/off, long press starts auto-tune"
                                    title="Tap to toggle ATU on/off; press and hold to start auto-tune"
                                    style="touch-action: manipulation; user-select: none;">
                                <span class="toggle-dd__led @(Model.AtuEnabled ? "is-on" : "")" aria-hidden="true"></span>
                                <span class="toggle-dd__label">ATU</span>
                            </button>
                            @* Explicit auto-tune button. The ATU button above also
                               starts a tune on press-and-hold, but a long press can't
                               be announced by a screen reader or performed by voice —
                               this gives keyboard/AT/voice users a real control. It
                               becomes a red "Stop" while a tune cycle is running. *@
                            <button id="atuTuneBtn"
                                    type="button"
                                    class="btn btn-sm btn-outline-secondary"
                                    data-a11y-key="controls.atuTune"
                                    aria-label="Start antenna auto-tune"
                                    title="Start antenna auto-tune"
                                    onclick="atuTuneButtonClick()"
                                    style="touch-action: manipulation;">Tune</button>
                            <button class="btn btn-sm btn-outline-secondary"
                                    aria-label="FM repeater controls"
                                    title="Open FM repeater controls panel"
                                    onclick="document.getElementById('fmDialog').show()">FM Rep</button>
                            <button id="voxBtn"
                                    class="btn btn-sm @(Model.VoxOn ? "btn-warning" : "btn-outline-secondary")"
                                    aria-label="VOX controls"
                                    title="Open VOX controls panel"
                                    onclick="document.getElementById('voxDialog').show()">VOX</button>
                        </div>

                        <!-- Column 3 — CW -->
                        <div class="col-1 op-col op-col--buttons">
                            <button class="btn btn-sm btn-outline-secondary"
                                    aria-label="CW keyer controls"
                                    title="Open CW keyer controls panel"
                                    onclick="document.getElementById('cwDialog').show()">CW</button>
                            <button class="btn btn-sm btn-outline-secondary"
                                    aria-label="CW reader - decode received Morse to text"
                                    title="Open the CW reader - decodes the received Morse to text"
                                    onclick="window.cwReaderPanel && window.cwReaderPanel.toggle()">CW Read</button>
                            <button class="btn btn-sm btn-outline-secondary"
                                    aria-label="CW send - type text and send it as Morse"
                                    title="Open CW send - type a line, press Enter, the radio keys it"
                                    onclick="window.cwSendPanel && window.cwSendPanel.toggle()">CW Send</button>
                        </div>

                        <!-- Column 4 — remaining -->
                        <div class="col-1 op-col op-col--buttons">
                            <button class="btn btn-sm btn-outline-secondary"
                                    aria-label="DX spots — list of cluster spots on current band"
                                    title="Open DX spots list — see callsigns spotted on the current band"
                                    onclick="window.dxSpotsPanel && window.dxSpotsPanel.toggle()">DX Spots</button>
                            <button class="btn btn-sm btn-outline-secondary"
                                    aria-label="DX watch — alerts for spotted callsigns"
                                    title="Open DX watch list — get alerts when watched callsigns are spotted"
                                    onclick="document.getElementById('dxWatchDialog').show(); window.refreshDxWatchList && window.refreshDxWatchList();">DX Watch</button>
                            @if (hasQmb)
                            {
                                <!-- Quick Memory Bank (QMB) — global radio function, shown once.
                                     Store (QI;) pushes the current VFO into the QMB stack; Recall
                                     (QR;) recalls / cycles through the stored slots. Left-click
                                     opens Store / Recall / V/M. -->
                                <div id="qmbControls">
                                    <div id="qmbButton"></div>
                                    <span id="qmbStatus" class="visually-hidden" role="status" aria-live="polite"></span>
                                </div>
                            }
                            <button id="voiceBtn"
                                    class="btn btn-sm btn-outline-secondary"
                                    aria-label="Voice announcements settings"
                                    title="Voice announcements for band, mode, TX state etc. — useful for partially sighted operators"
                                    onclick="document.getElementById('voiceDialog').show();">Voice</button>
                        </div>

                        <!-- Column 5 — Remote Audio / Clarifier -->
                        <div class="col-4 op-col op-col--extras">
                            <!-- Remote Audio — visible when Settings → Remote Audio is enabled -->
                            <div id="remoteAudioBar" class="op-extras-block" style="display:none;">
                                <strong class="text-nowrap"><i class="bi bi-soundwave" aria-hidden="true"></i> Remote Audio</strong>
                                <span class="d-inline-block remote-audio-tip" data-bs-toggle="tooltip" data-bs-placement="top"
                                      data-bs-title="Connect to transceiver audio" aria-label="Connect to transceiver audio">
                                    <button type="button" class="btn btn-sm btn-success remote-audio-icon-btn" id="remoteAudioStartBtn"
                                            aria-label="Connect to transceiver audio">
                                        <i class="bi bi-telephone-fill remote-audio-btn-icon" aria-hidden="true"></i>
                                    </button>
                                </span>
                                <span class="d-inline-block remote-audio-tip" data-bs-toggle="tooltip" data-bs-placement="top"
                                      data-bs-title="Disconnect transceiver audio" aria-label="Disconnect transceiver audio">
                                    <button type="button" class="btn btn-sm btn-danger remote-audio-icon-btn" id="remoteAudioStopBtn" disabled
                                            aria-label="Disconnect transceiver audio">
                                        <i class="bi bi-telephone-x-fill remote-audio-btn-icon" aria-hidden="true"></i>
                                    </button>
                                </span>
                                <span class="d-inline-block remote-audio-tip" id="remoteAudioPopoutTip" data-bs-toggle="tooltip"
                                      data-bs-placement="top"
                                      data-bs-title="Popout audio, useful to navigate YWC without interrupting the audio stream"
                                      aria-label="Popout audio, useful to navigate YWC without interrupting the audio stream">
                                    <button type="button" class="btn btn-sm btn-outline-secondary remote-audio-icon-btn" id="remoteAudioPopoutBtn"
                                            aria-label="Popout audio, useful to navigate YWC without interrupting the audio stream">
                                        <i class="bi bi-window-plus remote-audio-btn-icon" aria-hidden="true"></i>
                                    </button>
                                </span>
                                <span class="d-inline-block remote-audio-tip" id="remoteAudioMicMuteTip" data-bs-toggle="tooltip"
                                      data-bs-placement="top" data-bs-title="Mute microphone" aria-label="Mute microphone">
                                    <button type="button" class="btn btn-sm btn-success remote-audio-icon-btn" id="remoteAudioMicMute"
                                            aria-pressed="false" aria-label="Mute microphone" disabled>
                                        <i class="bi bi-mic-fill remote-audio-btn-icon" aria-hidden="true"></i>
                                    </button>
                                </span>
                                <span class="d-inline-block remote-audio-tip" id="remoteAudioRxMuteTip" data-bs-toggle="tooltip"
                                      data-bs-placement="top" data-bs-title="Deafen — mute received audio"
                                      aria-label="Deafen — mute received audio">
                                    <button type="button" class="btn btn-sm btn-success remote-audio-icon-btn" id="remoteAudioRxMute"
                                            aria-pressed="false" aria-label="Deafen — mute received audio" disabled>
                                        <i class="bi bi-headphones remote-audio-btn-icon" aria-hidden="true"></i>
                                    </button>
                                </span>
                                <span class="d-inline-block remote-audio-tip" id="remoteAudioLevelsTip" data-bs-toggle="tooltip"
                                      data-bs-placement="top"
                                      data-bs-title="Browser microphone and software gain"
                                      aria-label="Browser microphone and software gain">
                                    <button type="button" class="btn btn-sm btn-outline-secondary" id="remoteAudioLevelsBtn"
                                            aria-label="Open mic and gain settings">
                                        <i class="bi bi-sliders remote-audio-btn-icon" aria-hidden="true"></i>&nbsp;Mic &amp; Gain
                                    </button>
                                </span>
                                <span class="small text-muted" id="remoteAudioStatus">Idle</span>
                                <div class="op-extras-meters">
                                    <span class="small" title="Radio → browser level">RX</span>
                                    <div class="progress flex-grow-1" style="height:8px; width:80px;">
                                        <div id="remoteAudioRxMeter" class="progress-bar bg-info" style="width:0%"></div>
                                    </div>
                                    <span class="small" title="Browser mic → radio level">TX</span>
                                    <div class="progress flex-grow-1" style="height:8px; width:80px;">
                                        <div id="remoteAudioTxMeter" class="progress-bar bg-warning" style="width:0%"></div>
                                    </div>
                                </div>
                            </div>

                            <!-- Clarifier (RIT/XIT) -->
                            <div id="clarifierRow" class="op-extras-block">
                                <span class="fw-bold text-nowrap">Clarifier</span>
                                <div class="btn-group btn-group-sm" id="clarVfoGroup" role="group" aria-label="Clarifier VFO selection">
                                    <button type="button" class="btn btn-outline-primary active" id="clarVfoABtn"
                                            onclick="selectClarVfo('A')" title="Apply clarifier to VFO A"
                                            aria-label="Apply clarifier to VFO A">VFO A</button>
                                    <button type="button" class="btn btn-outline-primary" id="clarVfoBBtn"
                                            onclick="selectClarVfo('B')" title="Apply clarifier to VFO B"
                                            aria-label="Apply clarifier to VFO B">VFO B</button>
                                </div>
                                <label class="mb-0 fw-bold text-nowrap" id="clarModeLabel">Mode:</label>
                                <select class="form-select form-select-sm fw-bold flex-shrink-0" id="clarModeSelect"
                                        style="width:auto;" onchange="setClarifierMode(this.value)"
                                        aria-labelledby="clarModeLabel" aria-label="Clarifier mode">
                                    <option value="off"  selected="@(clarModeInit=="off"  ? "selected" : null)">OFF</option>
                                    <option value="rx"   selected="@(clarModeInit=="rx"   ? "selected" : null)">RX</option>
                                    <option value="tx"   selected="@(clarModeInit=="tx"   ? "selected" : null)">TX</option>
                                    <option value="rxtx" selected="@(clarModeInit=="rxtx" ? "selected" : null)">RX+TX</option>
                                </select>
                                <label class="mb-0 fw-bold text-nowrap">Offset:
                                    <span id="clarOffsetValue">@Model.RadioState.ClarifierOffsetA</span> Hz
                                </label>
                                <div class="op-clar-offset">
                                    <button type="button" class="btn btn-outline-secondary btn-sm flex-shrink-0 px-2"
                                            onclick="nudgeClarifier(-10)" title="−10 Hz"
                                            aria-label="Decrease clarifier offset by 10 Hz">−</button>
                                    <input type="range" id="clarOffsetSlider"
                                           min="-9990" max="9990" step="10"
                                           value="@Model.RadioState.ClarifierOffsetA"
                                           oninput="document.getElementById('clarOffsetValue').textContent = this.value"
                                           onchange="setClarifierOffset(parseInt(this.value))"
                                           aria-label="Clarifier offset in Hz" aria-valuemin="-9990" aria-valuemax="9990">
                                    <button type="button" class="btn btn-outline-secondary btn-sm flex-shrink-0 px-2"
                                            onclick="nudgeClarifier(10)" title="+10 Hz"
                                            aria-label="Increase clarifier offset by 10 Hz">+</button>
                                    <button type="button" class="btn btn-secondary btn-sm flex-shrink-0"
                                            onclick="resetClarifier()"
                                            title="Reset offset to 0 Hz (mode unchanged)"
                                            aria-label="Reset clarifier offset to zero">Reset</button>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>

    @* Controls for the RADIO's own scope, sent over CAT (SS command). Hidden
       when Radio Display is on — those controls dock beside the video (or
       float when the column is hidden). CAT-without-video keeps this
       standalone card.

       See docs/design/scope-control-via-cat.md. *@
    @if (!Model.VideoDisplayEnabled)
    {
        <partial name="_RadioScopePartial" model="@Model.RadioModel" />
    }

    <!-- Radio Display — USB UVC / HDMI capture MJPEG; visible when Settings enable it -->
    <div id="radioDisplayContainer" class="row mt-3" style="display:none;"
         data-radio-model="@Model.RadioModel" data-dual-receiver="@(isSingleReceiver ? "false" : "true")">
        <div class="col-12">
            <div class="card border-dark">
                <div class="card-header bg-dark text-white d-flex flex-wrap align-items-center gap-2 py-2">
                    <strong class="me-1"><i class="bi bi-display" aria-hidden="true"></i> Radio Display</strong>
                    <span id="radioDisplayBadge" class="badge bg-secondary">Idle</span>
                    <select id="radioDisplayDeviceSelect" class="form-select form-select-sm"
                            style="width:14rem; max-width:min(14rem, 40vw); min-width:0;"
                            aria-label="Capture device">
                        <option value="">(None)</option>
                    </select>
                    <span class="d-inline-block radio-display-tip" data-bs-toggle="tooltip" data-bs-placement="top"
                          data-bs-title="Refresh capture device list" aria-label="Refresh capture device list">
                        <button type="button" class="btn btn-sm btn-outline-light" id="radioDisplayRefreshDevicesBtn"
                                aria-label="Refresh capture device list">
                            <i class="bi bi-arrow-clockwise" aria-hidden="true"></i>
                        </button>
                    </span>
                    <span class="d-inline-block radio-display-tip" id="radioDisplaySizeWrap"
                          data-bs-toggle="tooltip" data-bs-placement="top"
                          data-bs-title="Capture size. Auto picks the best mode for this dongle. Larger modes are usually the dongle upscaling the same picture — no more detail, softer, and about twice the bandwidth."
                          aria-label="Capture size" hidden>
                        <select id="radioDisplaySizeSelect" class="form-select form-select-sm"
                                style="width:7.5rem; max-width:7.5rem;" aria-label="Capture size">
                            <option value="">Auto size</option>
                        </select>
                    </span>
                    <span class="d-inline-block radio-display-tip" data-bs-toggle="tooltip" data-bs-placement="top"
                          data-bs-title="How fast the picture updates" aria-label="Stream frame rate">
                        <select id="radioDisplayFpsSelect" class="form-select form-select-sm"
                                style="width:5.5rem; max-width:5.5rem;" aria-label="Stream frame rate">
                            <option value="15">15 fps</option>
                            <option value="30">30 fps</option>
                            <option value="60">60 fps</option>
                        </select>
                    </span>
                    <span class="d-inline-block radio-display-tip" data-bs-toggle="tooltip" data-bs-placement="top"
                          data-bs-title="Max keeps the image as captured. Low and Medium recompress — smaller stream (saves bandwidth), more CPU."
                          aria-label="Image quality">
                        <select id="radioDisplayQualitySelect" class="form-select form-select-sm"
                                style="width:6.5rem; max-width:6.5rem;" aria-label="Image quality">
                            <option value="40">Low</option>
                            <option value="65">Medium</option>
                            <option value="85" selected>Max</option>
                        </select>
                    </span>
                    <span class="d-inline-block radio-display-tip" data-bs-toggle="tooltip" data-bs-placement="top"
                          data-bs-title="Start or stop the video stream" aria-label="Start or stop the video stream">
                        <button type="button" class="btn btn-sm btn-outline-success" id="radioDisplayStreamBtn"
                                aria-label="Start stream">
                            <i class="bi bi-play-fill" aria-hidden="true"></i>
                        </button>
                    </span>
                    <span class="d-inline-block radio-display-tip" data-bs-toggle="tooltip" data-bs-placement="top"
                          data-bs-title="Start the stream automatically when the panel opens"
                          aria-label="Auto-start stream">
                        <label class="form-check-label small d-flex align-items-center gap-1 mb-0 user-select-none">
                            <input class="form-check-input mt-0" type="checkbox" id="radioDisplayAutoStart" />
                            Auto
                        </label>
                    </span>
                    @if (Yaesu_Web_Control.Services.RadioCapabilities.SupportsSpectrumScopeCat(Model.RadioModel))
                    {
                        <span class="d-inline-block radio-display-tip" data-bs-toggle="tooltip" data-bs-placement="top"
                              data-bs-title="Change what the radio's own screen is showing (span, 3DSS, speed)"
                              aria-label="Open radio scope controls">
                            <button type="button" class="btn btn-sm btn-outline-light" id="radioDisplayScopeBtn"
                                    aria-haspopup="dialog" aria-expanded="false" aria-controls="radioDisplayScopeDialog"
                                    aria-label="Open radio scope controls">
                                <i class="bi bi-sliders" aria-hidden="true"></i>&nbsp;Controls
                            </button>
                        </span>
                    }
                    <div class="ms-auto d-flex flex-wrap align-items-center gap-2">
                        <span class="d-inline-block radio-display-tip" data-bs-toggle="tooltip" data-bs-placement="top"
                              data-bs-title="Fit shows the whole TFT. Fill covers the pane and may crop edges."
                              aria-label="Video scaling: Fit or Fill">
                            <div class="btn-group btn-group-sm" role="group" aria-label="Video scaling mode">
                                <input type="radio" class="btn-check" name="radioDisplayFitMode" id="radioDisplayFitContain"
                                       value="contain" autocomplete="off" checked>
                                <label class="btn btn-outline-light" for="radioDisplayFitContain">Fit</label>
                                <input type="radio" class="btn-check" name="radioDisplayFitMode" id="radioDisplayFitCover"
                                       value="cover" autocomplete="off">
                                <label class="btn btn-outline-light" for="radioDisplayFitCover">Fill</label>
                            </div>
                        </span>
                        <span class="d-inline-block radio-display-tip" data-bs-toggle="tooltip" data-bs-placement="top"
                              data-bs-title="Fullscreen" aria-label="Fullscreen">
                            <button type="button" class="btn btn-sm btn-outline-light" id="radioDisplayFullscreenBtn"
                                    aria-label="Fullscreen">
