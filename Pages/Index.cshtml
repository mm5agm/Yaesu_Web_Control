                                    <option value="0" selected="@(Model.RadioState.AutoNotchA == "0" ? "selected" : null)">OFF</option>
                                    <option value="1" selected="@(Model.RadioState.AutoNotchA == "1" ? "selected" : null)">ON</option>
                                </select>
                            </div>
                            <div class="vfo-control-item">
                                <label class="vfo-control-label">Man Notch</label>
                                <select class="form-select form-select-sm" id="manualNotchSelectA"
