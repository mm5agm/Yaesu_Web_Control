        // Fldigi launch and status functions
        async function launchFldigi() {
            try {
                const response = await fetch('/api/fldigi/launch', { method: 'POST' });
                const btn = document.getElementById('fldigiBtn');
                if (response.ok) {
                    const data = await response.json();
                    btn.classList.remove('btn-secondary');
                    btn.classList.add('btn-success');
                    btn.title = 'Fldigi is running';
                    if (data.alreadyRunning) {
                        const originalText = btn.innerHTML;
                        btn.innerHTML = 'Fldigi Already Running';
                        setTimeout(() => { btn.innerHTML = originalText; }, 2000);
                    }
                } else {
                    const data = await response.json();
                    alert(data.error || 'Failed to launch Fldigi');
                }
