                                <button type="button" class="btn btn-outline-light btn-sm span-btn @(Model.SdrSampleRateHzB == 20_000 ? "active" : "")" data-hz="20000" data-vfo="B" data-a11y-key="spectrum.spanB20k" aria-label="VFO B span 20 kHz" title="VFO B span 20 kHz — a CW sub-band at CW resolution; software zoom, switches instantly">20k</button>
                                <button type="button" class="btn btn-outline-light btn-sm span-btn @(Model.SdrSampleRateHzB == 50_000 ? "active" : "")" data-hz="50000" data-vfo="B" data-a11y-key="spectrum.spanB50k" aria-label="VFO B span 50 kHz" title="VFO B span 50 kHz — a busy slice of band; software zoom, switches instantly">50k</button>
                                <button type="button" class="btn btn-outline-light btn-sm span-btn @(Model.SdrSampleRateHzB == 100_000 ? "active" : "")" data-hz="100000" data-vfo="B" data-a11y-key="spectrum.spanB100k" aria-label="VFO B span 100 kHz" title="VFO B span 100 kHz — best for narrow bands like 30m / 60m; software zoom, switches instantly">100k</button>
                                <button type="button" class="btn btn-outline-light btn-sm span-btn @(Model.SdrSampleRateHzB == 200_000 ? "active" : "")" data-hz="200000" data-vfo="B" data-a11y-key="spectrum.spanB200k" aria-label="VFO B span 200 kHz" title="VFO B span 200 kHz">200k</button>
                                <button type="button" class="btn btn-outline-light btn-sm span-btn @(Model.SdrSampleRateHzB == 500_000 ? "active" : "")" data-hz="500000" data-vfo="B" data-a11y-key="spectrum.spanB500k" aria-label="VFO B span 500 kHz" title="VFO B span 500 kHz">500k</button>
                                <button type="button" class="btn btn-outline-light btn-sm span-btn @(Model.SdrSampleRateHzB == 1_000_000 ? "active" : "")" data-hz="1000000" data-vfo="B" data-a11y-key="spectrum.spanB1m" aria-label="VFO B span 1 MHz" title="VFO B span 1 MHz">1M</button>
                                <button type="button" class="btn btn-outline-light btn-sm span-btn @(Model.SdrSampleRateHzB == 2_000_000 ? "active" : "")" data-hz="2000000" data-vfo="B" data-a11y-key="spectrum.spanB2m" aria-label="VFO B span 2 MHz" title="VFO B span 2 MHz">2M</button>
                            </div>
