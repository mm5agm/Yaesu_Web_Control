                    body: JSON.stringify({ shiftDir: _fmSettings.shiftDir, offsetHz: _fmSettings.offsetHz, ctcssMode: _fmSettings.ctcssMode, ctcssTone: _fmSettings.ctcssTone })
                });
            } catch (e) { console.error('saveFmRepeater error:', e); }
        }

        // --- CW KEYER ---
        async function setCwPitch(code) {
            try { await fetch('/api/cat/cwpitch', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ code: parseInt(code) }) }); }
            catch (e) { console.error('setCwPitch error:', e); }
        }
        async function setCwSpeed(v) {
            try { await fetch('/api/cat/cw/speed', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ speed: parseInt(v) }) }); }
            catch (e) { console.error('setCwSpeed error:', e); }
        }
        // vfo argument: 'a', 'b', or 'active'. Fire-and-forget. The CW Keyer
        // popup button passes 'active' so it follows whichever VFO is in
        // focus; the per-VFO buttons on each VFO panel pass their own letter
        // so they always target that specific receiver.
        async function cwZeroIn(vfo) {
            const target = (vfo === 'A' || vfo === 'B') ? vfo.toLowerCase() : 'active';
            try { await fetch(`/api/cat/cw/zin/${target}`, { method: 'POST' }); }
            catch (e) { console.error('cwZeroIn error:', e); }
        }
        async function setCwBreakIn(v) {
            try { await fetch('/api/cat/cw/breakin', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ mode: v }) }); }
            catch (e) { console.error('setCwBreakIn error:', e); }
        }
        async function setCwBreakInDelay(v) {
            try { await fetch('/api/cat/cw/breakindelay', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ delayMs: parseInt(v) }) }); }
            catch (e) { console.error('setCwBreakInDelay error:', e); }
        }
        // While a memory is playing nothing can stop it - the radio has no
        // CAT command for that, measured 2026-09-09 - so the buttons say so.
        // The playing one is marked, the rest go disabled until it ends, and
        // the aria-label follows, because a screen reader reading "Send CW
        // memory 2" off a button that will refuse is worse than no label.
        let cwPlaybackFollow = 0;
        // A press takes a few hundred ms to serve - the radio is asked whether
        // anything is playing before it is told what to do. A second press
        // inside that window is not a second decision, it is the same press
        // arriving twice: a rapid double click, a worn mouse switch, a key
        // repeat. Measured on the bench 2026-09-09, seven presses landed in
        // 1.4s. Ignore anything that arrives while a press is being served.
        let cwSendBusy = false;
        function cwSetMemButton(index, state) {      // 'idle' | 'playing' | 'busy'
            const b = document.getElementById(`cwMemBtn${index}`);
            if (!b) return;
            const n = index + 1;
            b.textContent = state === 'playing' ? `▶ M${n}` : `M${n}`;
            b.classList.toggle('btn-outline-warning', state === 'playing');
            b.classList.toggle('btn-outline-info', state !== 'playing');
            b.disabled = state === 'busy';
            if (state === 'idle') { b.setAttribute('aria-label', `Send CW memory ${n}`); b.title = `Send CW message M${n}`; }
            else if (state === 'playing') { b.setAttribute('aria-label', `CW memory ${n} is sending`); b.title = `M${n} is sending - it cannot be stopped`; }
            else { b.setAttribute('aria-label', `Send CW memory ${n} - unavailable while a message is sending`); b.title = 'A message is sending'; }
        }
        function cwClearMemButtons() { for (let i = 0; i < 5; i++) cwSetMemButton(i, 'idle'); }
        // The CW Send panel borrows M5 while a typed line goes out; the
        // buttons go busy so a press here does not land on top of it.
        function cwMemButtonsBusy(busy) {
            cwPlaybackFollow++;                       // abandon any follow in progress
            for (let i = 0; i < 5; i++) cwSetMemButton(i, busy ? 'busy' : 'idle');
        }
        // RI4 is the radio's playing flag, and it only ever reports a
        // playback that is keying the transmitter. With break-in off the
        // memory plays to the sidetone monitor and RI4 stays 0 throughout -
        // measured 2026-09-09, sixteen consecutive polls of 0 across a
        // message the operator could hear. Ending the wait on the first
        // RI40 therefore cleared the buttons instantly on every monitor-only
        // send, which is exactly the "I don't see a disabled state" report.
        //
        // So RI4 can only END the wait once it has first CONFIRMED a start.
        // Until it does, the server's estimate of how long the message takes
        // holds the buttons instead. A flag that never asserts can no longer
        // be read as "already finished".
        async function cwFollowPlayback(index, estimatedMs) {
            const token = ++cwPlaybackFollow;
            for (let i = 0; i < 5; i++) cwSetMemButton(i, i === index ? 'playing' : 'busy');
            const endBy = Date.now() + Math.max(1000, estimatedMs || 0);
            let sawPlaying = false;
            for (let i = 0; i < 240 && token === cwPlaybackFollow; i++) {
                await new Promise(r => setTimeout(r, 500));
                if (token !== cwPlaybackFollow) return;
                let playing = null;
                try {
                    const r = await fetch('/api/cat/cw/playing');
                    const d = await r.json().catch(() => ({}));
                    playing = d.playing;
                } catch { break; }
                if (playing === true) { sawPlaying = true; continue; }
                if (playing === false && sawPlaying) break;   // it started, it has finished
                if (Date.now() >= endBy) break;               // the estimate has run out
            }
            if (token === cwPlaybackFollow) cwClearMemButtons();
        }
        async function sendCwMessage(index) {
            const input = document.getElementById(`cwMsg${index}`);
            const status = document.getElementById('cwKeyerStatus');
            const say = (text, bad) => { if (status) { status.textContent = text; status.style.color = bad ? '#ff6b6b' : '#aaa'; } };
            // An empty box used to return here silently, so the button looked
            // dead - no message, no request, nothing in the log to say the
            // press had even happened. Say so instead.
            if (!input) { say(`M${index + 1} text box is missing.`, true); return; }
            if (!input.value.trim()) { say(`M${index + 1} is empty - type a message first.`, true); return; }
            if (cwSendBusy) return;
            cwSendBusy = true;
            // index is 0-based; the radio's keyer slots are 1-5.
            try {
                const r = await fetch('/api/cat/cw/send', {
                    method: 'POST', headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ message: input.value, slot: index + 1 })
                });
                const d = await r.json().catch(() => ({}));
                if (r.ok) {
                    // Whether it went on the air is the part that matters, and
                    // an operator who cannot see the BK-IN lamp has no other way
                    // to know. Never just say "sent".
                    const secs = d.estimatedMs ? ` (about ${Math.round(d.estimatedMs / 1000)} seconds)` : '';
                    if (d.transmitted === false) {
                        say(`M${index + 1} played to the monitor only, not transmitted - break-in is off${secs}. ${d.sent || ''}`);
                    } else {
                        say(`Transmitted M${index + 1}${secs}: ${d.sent || ''}`);
                    }
                    cwFollowPlayback(index, d.estimatedMs);
                    return;
                }
                say(d.error || `M${index + 1} was not sent (HTTP ${r.status}).`, true);
            }
            catch (e) { console.error('sendCwMessage error:', e); say(`M${index + 1} failed: ${e.message}`, true); }
            finally { cwSendBusy = false; }
        }
        async function saveCwMessages() {
            const msgs = [];
            for (let i = 0; i < 5; i++) {
                const el = document.getElementById(`cwMsg${i}`);
                msgs.push(el ? el.value : '');
            }
            try {
                await fetch('/api/cat/cw/messages', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(msgs) });
            } catch (e) { console.error('saveCwMessages error:', e); }
        }

        // --- AUDIO FILTER POPOUT ---
        // One independent dialog per VFO so the user can view/adjust both at
        // once on FTdx101-family dual-receiver radios. Each instance reads/
        // writes the four EX-menu values for *its* VFO's current mode class,
        // backed by /api/cat/audiofilter/{vfo}. The dialog is a thin read/
        // write proxy — the radio holds all state.
        window.audioFilter = (function () {
            const $ = (id) => document.getElementById(id);

            function makeInstance(vfo) {
                const dialogId = 'audioFilterDialog' + vfo;
                const dlg = () => $(dialogId);
                const id = (suffix) => `audioFilter${suffix}${vfo}`;
                const el = (suffix) => $(id(suffix));
                // Remember the slider's last non-OFF Hz so toggling OFF→ON
                // returns to the same value rather than the slider's min.
                let _lastLcutHz = 300;
                let _lastHcutHz = 3000;
                let _busy = false;

                async function open() {
                    const d = dlg();
                    if (d && typeof d.show === 'function' && !d.open) {
                        // On first open (no saved drag position), anchor the
                        // dialog just below the Audio Filter button that
                        // opened it.
                        const hasSaved = !!localStorage.getItem('dlgPos_' + dialogId);
                        if (!hasSaved) {
                            const btn = $('audioFilterBtn' + vfo);
                            if (btn) {
                                const r = btn.getBoundingClientRect();
                                d.style.left = Math.round(r.left) + 'px';
                                d.style.top  = Math.round(r.bottom + 6) + 'px';
                                d.style.transform = 'none';
                            }
                        }
                        d.show();
                    }
                    await refresh();
                }

                async function refresh() {
                    if (_busy) return;
                    _busy = true;
                    try {
                        const resp = await fetch(`/api/cat/audiofilter/${vfo.toLowerCase()}`);
                        if (!resp.ok) {
                            el('Status').textContent = 'Failed to read audio filter.';
                            return;
                        }
                        const data = await resp.json();
                        el('ModeLabel').textContent = data.modeClass ? `(${data.modeClass})` : '';

                        const otherVfo = vfo === 'A' ? 'B' : 'A';
                        el('Status').textContent = data.otherVfoShares
                            ? `VFO ${otherVfo} is also in ${data.modeClass} — these settings affect both VFOs.`
                            : '';

                        const anySupported = (data.lcutFreq && data.lcutFreq.supported)
                                          || (data.lcutSlope && data.lcutSlope.supported)
                                          || (data.hcutFreq && data.hcutFreq.supported)
                                          || (data.hcutSlope && data.hcutSlope.supported);
                        el('Unsupported').style.display = anySupported ? 'none' : '';
                        el('Controls').style.display    = anySupported ? '' : 'none';
                        if (!anySupported) return;

                        renderFreqRow('Lcut', data.lcutFreq);
                        renderSlopeBtn('Lcut', data.lcutSlope);
                        renderFreqRow('Hcut', data.hcutFreq);
                        renderSlopeBtn('Hcut', data.hcutSlope);
                    } catch (e) {
                        console.error(`audioFilter[${vfo}].refresh error:`, e);
                    } finally {
                        _busy = false;
                    }
                }

                function renderFreqRow(prefix, v) {
                    const slider = el(prefix + 'FreqSlider');
                    const off    = el(prefix + 'FreqOff');
                    const label  = el(prefix + 'FreqLabel');
                    if (!v || !v.supported) {
                        slider.disabled = true; off.disabled = true; label.textContent = '—';
                        return;
                    }
                    off.disabled = false;
                    if (v.label === 'OFF') {
                        off.checked = true; slider.disabled = true;
                        label.textContent = 'OFF';
                    } else {
                        off.checked = false; slider.disabled = false;
                        if (typeof v.hz === 'number') {
                            slider.value = v.hz;
                            if (prefix === 'Lcut') _lastLcutHz = v.hz; else _lastHcutHz = v.hz;
                        }
                        label.textContent = v.label || (slider.value + ' Hz');
                    }
                }

                function renderSlopeBtn(prefix, v) {
                    const btn = el(prefix + 'SlopeBtn');
                    if (!v || !v.supported) {
                        btn.disabled = true; btn.textContent = '—';
                        btn.classList.remove('btn-warning'); btn.classList.add('btn-outline-light');
                        return;
                    }
                    btn.disabled = false;
                    btn.dataset.slopeCode = v.code || '0';
                    btn.textContent = v.label || (v.code === '1' ? '18 dB/oct' : '6 dB/oct');
                    btn.classList.toggle('btn-warning',      v.code === '1');
                    btn.classList.toggle('btn-outline-light', v.code !== '1');
                }

                function hzToFreqCode(hz, isLcut) {
                    const base = isLcut ? 100 : 700;
                    const n = Math.round((hz - base) / 50) + 1;
                    return String(n).padStart(2, '0');
                }

                async function writeOne(setting, code) {
                    try {
                        const resp = await fetch(`/api/cat/audiofilter/${vfo.toLowerCase()}/${setting}`, {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ code })
                        });
                        if (!resp.ok) return;
                        const data = await resp.json();
                        const v = data.result;
                        if (setting === 'lcutFreq') renderFreqRow('Lcut', v);
                        else if (setting === 'hcutFreq') renderFreqRow('Hcut', v);
                        else if (setting === 'lcutSlope') renderSlopeBtn('Lcut', v);
                        else if (setting === 'hcutSlope') renderSlopeBtn('Hcut', v);
                    } catch (e) { console.error(`audioFilter[${vfo}].writeOne error:`, e); }
                }

                function wireDom() {
                    el('LcutFreqSlider').addEventListener('input',  (e) => el('LcutFreqLabel').textContent = e.target.value + ' Hz');
                    el('LcutFreqSlider').addEventListener('change', (e) => writeOne('lcutFreq', hzToFreqCode(parseInt(e.target.value), true)));
                    el('LcutFreqOff').addEventListener('change', (e) => {
                        if (e.target.checked) writeOne('lcutFreq', '00');
                        else                  writeOne('lcutFreq', hzToFreqCode(_lastLcutHz, true));
                    });
                    el('LcutSlopeBtn').addEventListener('click', () => {
                        const cur = el('LcutSlopeBtn').dataset.slopeCode || '0';
                        writeOne('lcutSlope', cur === '0' ? '1' : '0');
                    });
                    el('HcutFreqSlider').addEventListener('input',  (e) => el('HcutFreqLabel').textContent = e.target.value + ' Hz');
                    el('HcutFreqSlider').addEventListener('change', (e) => writeOne('hcutFreq', hzToFreqCode(parseInt(e.target.value), false)));
                    el('HcutFreqOff').addEventListener('change', (e) => {
                        if (e.target.checked) writeOne('hcutFreq', '00');
                        else                  writeOne('hcutFreq', hzToFreqCode(_lastHcutHz, false));
                    });
                    el('HcutSlopeBtn').addEventListener('click', () => {
                        const cur = el('HcutSlopeBtn').dataset.slopeCode || '0';
                        writeOne('hcutSlope', cur === '0' ? '1' : '0');
                    });
                }

                function onModeChanged(changedVfo) {
                    if (changedVfo !== vfo) return;
                    const d = dlg();
                    if (!d || !d.open) return;
                    refresh();
                }

                return { open, refresh, onModeChanged, wireDom };
            }

            const instances = { A: makeInstance('A'), B: makeInstance('B') };

            document.addEventListener('DOMContentLoaded', () => {
                instances.A.wireDom();
                instances.B.wireDom();
            });

            return {
                open: (vfo) => instances[(vfo === 'B') ? 'B' : 'A'].open(),
                onModeChanged: (vfo, mode) => {
                    instances.A.onModeChanged(vfo, mode);
                    instances.B.onModeChanged(vfo, mode);
                }
            };
        })();

        // Expose functions called from HTML onclick/onchange attributes
        window.launchWsjtx  = launchWsjtx;
        window.launchJtalert = launchJtalert;
        window.launchLog4om  = launchLog4om;
        window.launchGridtracker = launchGridtracker;
        window.launchFldigi      = launchFldigi;
        window.setMicGain    = setMicGain;
        window.toggleProc    = toggleProc;
        window.setProcLevel  = setProcLevel;
        window.updateProcButton = updateProcButton;
        window.toggleAtu        = toggleAtu;
        window.startAtuTune     = startAtuTune;
        window.stopAtuTune      = stopAtuTune;
        window.atuTuneButtonClick = atuTuneButtonClick;
        window.updateAtuButton  = updateAtuButton;
        window.updateAtuTuningState = updateAtuTuningState;
        window.toggleMonitor    = toggleMonitor;
        window._updateMonitorBtn = _updateMonitorBtn;
        window.setMonitorLevel  = setMonitorLevel;
        window.setNbLevel      = setNbLevel;
        window.setNrLevel      = setNrLevel;
        initNrCycleButtons();
        initVfoKeyButtons();
        // BandA/B SignalR may have arrived before the Yaesu keys existed;
        // replay from last frequency (or cached band) now that widgets exist.
        if (typeof window.syncBandButtonsFromFrequency === "function") {
            window.syncBandButtonsFromFrequency();
        }
        // Mode-aware IF Width menus (keys exist now).
        if (window.IfWidth && window._radioModel) {
            window.IfWidth.rebuildIfWidthSelect(
                window.ifWidthButtonA, window._radioModel, '@Model.RadioState.ModeA');
            window.IfWidth.rebuildIfWidthSelect(
                window.ifWidthButtonB, window._radioModel, '@Model.RadioState.ModeB');
        }
        // Contour keys are created above; tighten their slider range to the
        // current passband (FilterScopePanel already exists by this point).
        if (typeof window.updateContourSliderBounds === "function") {
            window.updateContourSliderBounds("A");
            window.updateContourSliderBounds("B");
        }
        window.setRfGain                  = setRfGain;
        window.setSquelch                 = setSquelch;
        window._updateSquelchVisibility   = _updateSquelchVisibility;
        // Apply squelch visibility for initial mode on page load
        _updateSquelchVisibility('A', '@Model.RadioState.ModeA');
        _updateSquelchVisibility('B', '@Model.RadioState.ModeB');
        window.toggleCatConnection = toggleCatConnection;
        window.toggleVox       = toggleVox;
        window.setVoxGain      = setVoxGain;
        window.setVoxDelay     = setVoxDelay;
        window.setAntiVoxGain  = setAntiVoxGain;
        window.setFmShift      = setFmShift;
        window.setFmOffset     = setFmOffset;
        window.setCtcssMode    = setCtcssMode;
        window.setCtcssTone    = setCtcssTone;
        window.saveFmRepeater  = saveFmRepeater;
        window.setCwPitch      = setCwPitch;
        window.setCwSpeed      = setCwSpeed;
        window.cwZeroIn        = cwZeroIn;
        window.setCwBreakIn    = setCwBreakIn;
        window.setCwBreakInDelay = setCwBreakInDelay;
        window.sendCwMessage   = sendCwMessage;
        window.cwMemButtonsBusy = cwMemButtonsBusy;
        window.saveCwMessages  = saveCwMessages;
    </script>
    <script>
    (function () {
        const STORAGE_KEY = 'vfoBVisible';
        function getVisible() {
            const stored = localStorage.getItem(STORAGE_KEY);
            return stored !== null ? stored === 'true' : true;
        }

        function applyVisibility(visible) {
            const aCol  = document.getElementById('vfoACol');
            const bCol  = document.getElementById('vfoBCol');
            const btn   = document.getElementById('vfoBToggleBtn');
            const vfoRow = document.getElementById('vfoRow');
            if (bCol) bCol.style.display = visible ? '' : 'none';
            if (aCol) {
                if (visible) {
                    aCol.classList.remove('col-12');
                    aCol.classList.add('col-lg-6');
                } else {
                    aCol.classList.remove('col-lg-6');
                    aCol.classList.add('col-12');
                }
            }
            vfoRow?.classList.toggle('vfo-b-hidden', !visible);
            if (btn) {
                btn.textContent = visible ? 'Hide B' : 'Show B';
                btn.title = visible ? 'Hide VFO-B panel' : 'Show VFO-B panel';
            }
        }

        document.getElementById('vfoBToggleBtn')?.addEventListener('click', function () {
            const newVisible = !getVisible();
            localStorage.setItem(STORAGE_KEY, String(newVisible));
            applyVisibility(newVisible);
        });

        applyVisibility(getVisible());
    })();
    </script>
}