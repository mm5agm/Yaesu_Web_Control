            if (mainBtn) { mainBtn.classList.toggle('btn-warning', on); mainBtn.classList.toggle('btn-outline-secondary', !on); }
        }
        async function setVoxGain(v) {
            try { await fetch('/api/cat/vox/gain', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ gain: parseInt(v) }) }); }
