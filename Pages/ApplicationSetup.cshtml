@page "/ApplicationSetup"
@model Yaesu_Web_Control.Pages.ApplicationSetupModel
@{
    ViewData["Title"] = "Application Setup";
}

<h1>Application Setup</h1>

@if (TempData["Message"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Message"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card mb-4">
    <div class="card-header">
        <h5><i class="bi bi-toggles"></i> External Application Buttons</h5>
    </div>
    <div class="card-body">
        <p class="text-muted">Configure up to 5 external application launcher buttons. You can customize the button name and command line for each.</p>

        <form method="post">
            <div class="row g-4">
                <!-- App 1 -->
                <div class="col-md-4">
                    <div class="card h-100">
                        <div class="card-header d-flex justify-content-between align-items-center">
                            <span><strong>Application 1</strong></span>
                            <div class="form-check form-switch mb-0">
                                <input class="form-check-input" type="checkbox" id="showApp1" asp-for="ShowApp1Button">
                                <label class="form-check-label" for="showApp1">Show</label>
                            </div>
                        </div>
                        <div class="card-body">
                            <div class="mb-2">
                                <label class="form-label small text-muted">Button Name:</label>
                                <input type="text" class="form-control" asp-for="App1Name" placeholder="WSJT-X" />
                            </div>
                            <div>
                                <label class="form-label small text-muted">Command Line:</label>
                                <input type="text" class="form-control form-control-sm" asp-for="App1CommandLine" placeholder="C:\path\to\program.exe" />
                            </div>
                        </div>
                    </div>
                </div>

                <!-- App 2 -->
                <div class="col-md-4">
                    <div class="card h-100">
                        <div class="card-header d-flex justify-content-between align-items-center">
                            <span><strong>Application 2</strong></span>
                            <div class="form-check form-switch mb-0">
                                <input class="form-check-input" type="checkbox" id="showApp2" asp-for="ShowApp2Button">
                                <label class="form-check-label" for="showApp2">Show</label>
                            </div>
                        </div>
                        <div class="card-body">
                            <div class="mb-2">
                                <label class="form-label small text-muted">Button Name:</label>
                                <input type="text" class="form-control" asp-for="App2Name" placeholder="JTAlert" />
                            </div>
                            <div>
                                <label class="form-label small text-muted">Command Line:</label>
                                <input type="text" class="form-control form-control-sm" asp-for="App2CommandLine" placeholder="C:\path\to\program.exe" />
                            </div>
                        </div>
                    </div>
                </div>

                <!-- App 3 -->
                <div class="col-md-4">
                    <div class="card h-100">
                        <div class="card-header d-flex justify-content-between align-items-center">
                            <span><strong>Application 3</strong></span>
                            <div class="form-check form-switch mb-0">
                                <input class="form-check-input" type="checkbox" id="showApp3" asp-for="ShowApp3Button">
                                <label class="form-check-label" for="showApp3">Show</label>
                            </div>
                        </div>
                        <div class="card-body">
                            <div class="mb-2">
                                <label class="form-label small text-muted">Button Name:</label>
                                <input type="text" class="form-control" asp-for="App3Name" placeholder="Log4OM" />
                            </div>
                            <div>
                                <label class="form-label small text-muted">Command Line:</label>
                                <input type="text" class="form-control form-control-sm" asp-for="App3CommandLine" placeholder="C:\path\to\program.exe" />
                            </div>
                        </div>
                    </div>
                </div>

                <!-- App 4 -->
                <div class="col-md-4">
                    <div class="card h-100">
                        <div class="card-header d-flex justify-content-between align-items-center">
                            <span><strong>Application 4</strong></span>
                            <div class="form-check form-switch mb-0">
                                <input class="form-check-input" type="checkbox" id="showApp4" asp-for="ShowApp4Button">
                                <label class="form-check-label" for="showApp4">Show</label>
                            </div>
                        </div>
                        <div class="card-body">
                            <div class="mb-2">
                                <label class="form-label small text-muted">Button Name:</label>
                                <input type="text" class="form-control" asp-for="App4Name" placeholder="GridTracker" />
                            </div>
                            <div>
                                <label class="form-label small text-muted">Command Line:</label>
                                <input type="text" class="form-control form-control-sm" asp-for="App4CommandLine" placeholder="C:\Program Files\GridTracker2\GridTracker2.exe" />
                            </div>
                        </div>
                    </div>
                </div>

                <!-- App 5 -->
                <div class="col-md-4">
                    <div class="card h-100">
                        <div class="card-header d-flex justify-content-between align-items-center">
                            <span><strong>Application 5</strong></span>
                            <div class="form-check form-switch mb-0">
                                <input class="form-check-input" type="checkbox" id="showApp5" asp-for="ShowApp5Button">
                                <label class="form-check-label" for="showApp5">Show</label>
                            </div>
                        </div>
                        <div class="card-body">
                            <div class="mb-2">
                                <label class="form-label small text-muted">Button Name:</label>
                                <input type="text" class="form-control" asp-for="App5Name" placeholder="Fldigi" />
                            </div>
                            <div>
                                <label class="form-label small text-muted">Command Line:</label>
                                <input type="text" class="form-control form-control-sm" asp-for="App5CommandLine" placeholder="C:\Program Files\Fldigi-4.2.11\fldigi.exe" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <hr class="my-4" />

            <h6><i class="bi bi-broadcast"></i> WSJT-X UDP Settings</h6>
            <p class="text-muted">Configure the UDP connection for WSJT-X integration (only applies if using WSJT-X).</p>

            <div class="form-check mb-3">
                <input class="form-check-input" type="checkbox" asp-for="WsjtxIntegrationEnabled" id="wsjtxIntegrationEnabled" />
                <label class="form-check-label" for="wsjtxIntegrationEnabled">
                    <strong>Enable WSJT-X integration</strong>
                </label>
                <div class="form-text">
                    When on, YWC listens on the WSJT-X UDP port below (default 2237) to show WSJT-X status.
                    Turn it <strong>off</strong> if another WSJT-X program needs that port — YWC will then leave it free.
                    <strong>Restart YWC after changing.</strong>
                </div>
            </div>

            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">UDP Address:</label>
                    <input type="text" class="form-control" asp-for="WsjtxUdpAddress" placeholder="239.255.0.1" />
                    <div class="form-text">Multicast address WSJT-X sends to (default: 239.255.0.1). Must match WSJT-X Settings &rarr; Reporting &rarr; UDP Server.</div>
                </div>
                <div class="col-md-6">
                    <label class="form-label">UDP Port:</label>
                    <input type="number" class="form-control" asp-for="WsjtxUdpPort" min="1024" max="65535" />
                    <div class="form-text">The UDP port number (default: 2237)</div>
                </div>
            </div>

            <div class="mt-4">
                <button type="submit" class="btn btn-primary btn-lg">
                    <i class="bi bi-check-lg"></i> Save All Settings
                </button>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <h5><i class="bi bi-info-circle"></i> Network Setup Guide</h5>
    </div>
    <div class="card-body">
        <h6>WSJT-X Settings</h6>
        <p>In WSJT-X <strong>Settings &rarr; Reporting</strong>:</p>
        <ul>
            <li>UDP Server: <strong>239.255.0.1</strong></li>
            <li>UDP Server port number: <strong>2237</strong></li>
            <li>Outgoing Interfaces: <strong>loopback_0</strong> (or leave blank for all interfaces)</li>
            <li>Multicast TTL: <strong>1</strong></li>
            <li>Tick: <em>Accept UDP requests</em>, <em>Notify on accepted UDP request</em></li>
        </ul>
        <p class="text-muted small">If you use <code>--rig-name=WebApp</code> in the WSJT-X command line above, these settings must be configured in that WSJT-X profile (open WSJT-X, go to Settings, save — it writes to the WebApp profile).</p>

        <h6>JTAlert</h6>
        <p>There is nothing to set up. JTAlert reads WSJT-X log files directly (not UDP).</p>

        <h6>Log4OM</h6>
        <p>Settings -&gt; Program Configuration -&gt; Software Integration -&gt; Connections</p>
        <ul>
            <li>Type: JT_Message</li>
            <li>Port: 2236</li>
            <li>Enabled: Yes</li>
        </ul>
    </div>
</div>
