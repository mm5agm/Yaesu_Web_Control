@model Yaesu_Web_Control.Pages.FlexUiModel
@{
    var isSingleReceiver = Model.View.IsSingleReceiver;
}
<div class="ywc-flex-toolbar row g-1 mb-1" style="padding-top: 2px; padding-bottom: 2px;">
    <div class="col-auto d-flex gap-2 align-items-center">
        <span id="utcClock"
              class="utc-clock font-monospace fw-bold px-2"
              style="font-size:0.95rem; color:#ffe066; background:#222; border:1px solid #444; padding-top: 1px; padding-bottom: 1px; cursor:help;"
              title="UTC time from your PC system clock. Click for details and how to verify."
              onclick="document.getElementById('utcClockInfoDialog').show()"
              aria-live="off"
              aria-label="Current UTC time. Click for source and accuracy details.">--:--:--Z</span>
        <a href="https://paypal.me/mm5agm" target="_blank" rel="noopener noreferrer"
           class="btn btn-warning btn-sm" style="padding-top: 1px; padding-bottom: 1px;" title="Support this project via PayPal"
           aria-label="Support this project via PayPal — Buy Me a Coffee">
            <i class="bi bi-cup-hot-fill" aria-hidden="true"></i> Buy Me a Coffee
        </a>
    </div>
    <div class="col-auto ms-auto d-flex gap-2 align-items-center flex-wrap justify-content-end">
        @{
            var enabledApps = new List<object>();
            if (Model.ShowApp1Button) enabledApps.Add(new { id = "wsjtx", label = Model.App1Name });
            if (Model.ShowApp3Button) enabledApps.Add(new { id = "log4om", label = Model.App3Name });
            if (Model.ShowApp2Button) enabledApps.Add(new { id = "jtalert", label = Model.App2Name });
            if (Model.ShowApp4Button) enabledApps.Add(new { id = "gridtracker", label = Model.App4Name });
            if (Model.ShowApp5Button) enabledApps.Add(new { id = "fldigi", label = Model.App5Name });
            var appsJson = System.Text.Json.JsonSerializer.Serialize(enabledApps);
        }
        @if (enabledApps.Count > 0)
        {
            <div id="appsLauncher" class="apps-launcher">
                <div id="appsButton"></div>
                @if (Model.ShowApp1Button)
                {
                    <span id="wsjtxTxBadge" class="badge bg-danger apps-launcher__tx"
                          style="display:none;" aria-hidden="true">TX</span>
                }
            </div>
            <script type="application/json" id="appsLauncherConfig">@Html.Raw(appsJson)</script>
        }
        <button id="memBtn" type="button"
                class="btn toggle-dd__btn toggle-dd__btn--action toggle-dd__btn--toolbar"
                title="Open memories panel"
                aria-label="Open memories panel">
            <span class="toggle-dd__label">Mem</span>
        </button>
        <button type="button" class="btn btn-sm btn-outline-secondary"
                data-kb-display-target
                style="padding-top: 1px; padding-bottom: 1px;"
                title="Keyboard z/w/s target: SDR spectrum or Radio Scope (t)"
                aria-label="Toggle keyboard shortcuts between SDR spectrum and Radio Scope"
                aria-pressed="false"
                hidden>
            Keys → SDR
        </button>
        <button type="button" class="btn btn-sm btn-outline-secondary"
                data-open-shortcuts
                data-bs-toggle="tooltip"
                data-bs-placement="bottom"
                data-bs-title="Keyboard shortcuts (?)"
                style="padding-top: 1px; padding-bottom: 1px;"
                aria-label="Show keyboard shortcuts">
            <i class="bi bi-keyboard" aria-hidden="true"></i>
        </button>

        @* Layouts menu — switch between saved panel arrangements. Rows are
           built by flex-workspace.js (window.ywcFlex.buildLayoutsMenu). *@
        <div class="dropdown ywc-flex-layouts">
            <button type="button" id="flexLayoutsBtn" class="btn btn-sm btn-outline-secondary dropdown-toggle"
                    data-bs-toggle="dropdown" aria-expanded="false"
                    title="Saved panel arrangements"
                    aria-label="Saved panel arrangements">
                <i class="bi bi-layout-wtf" aria-hidden="true"></i>
                <span id="ywcFlexLayoutName">Default</span>
            </button>
            <ul class="dropdown-menu dropdown-menu-end" id="ywcFlexLayoutMenu" aria-label="Saved layouts"></ul>
        </div>

        @* Panels menu — reopen a tab that has been closed. Each entry toggles
           the panel via window.ywcFlex.togglePanel(id). *@
        <div class="dropdown ywc-flex-panels">
            <button type="button" class="btn btn-sm btn-outline-secondary dropdown-toggle"
                    data-bs-toggle="dropdown" aria-expanded="false"
                    title="Show or hide flex panels"
                    aria-label="Show or hide flex panels">
                <i class="bi bi-layout-text-window-reverse" aria-hidden="true"></i> Panels
            </button>
            <ul class="dropdown-menu dropdown-menu-end" id="ywcFlexPanelsMenu" aria-label="Flex panels"></ul>
        </div>

        <label class="d-inline-flex align-items-center gap-1 small mb-0" for="flexLayoutScale"
               title="UI size — font and component scale. Does not move panels.">
            Size
            <select id="flexLayoutScale" class="form-select form-select-sm" style="width:auto;"
                    aria-label="UI size (font and component scale)">
                <option value="xsmall">Extra small</option>
                <option value="small">Small</option>
                <option value="medium">Medium</option>
                <option value="large">Large</option>
            </select>
        </label>
        <button type="button" id="flexResetLayoutBtn" class="btn btn-sm btn-outline-secondary"
                title="Reset the panel arrangement to its default positions" aria-label="Reset panel arrangement">
            Reset layout
        </button>

        @if (isSingleReceiver)
        {
            <span id="rxTxSplitGroup" class="d-inline-flex align-items-center gap-1 ms-1"
                  title="Independent RX / TX VFO selection. Split is on whenever RX and TX are different VFOs.">
                <span class="small text-nowrap">RX</span>
                <div class="btn-group btn-group-sm" role="group" aria-label="Receive VFO">
                    <button type="button" id="rxVfoA" class="btn btn-outline-secondary py-0" data-rx="A" aria-label="Receive on VFO A">A</button>
                    <button type="button" id="rxVfoB" class="btn btn-outline-secondary py-0" data-rx="B" aria-label="Receive on VFO B">B</button>
                </div>
                <span class="small text-nowrap ms-1">TX</span>
                <div class="btn-group btn-group-sm" role="group" aria-label="Transmit VFO">
                    <button type="button" id="txVfoA" class="btn btn-outline-secondary py-0" data-tx="A" aria-label="Transmit on VFO A">A</button>
                    <button type="button" id="txVfoB" class="btn btn-outline-secondary py-0" data-tx="B" aria-label="Transmit on VFO B">B</button>
                </div>
            </span>
        }
        <button id="connectBtn" class="btn btn-danger btn-sm"
                onclick="toggleCatConnection()" style="padding-top: 1px; padding-bottom: 1px;" title="Connect or disconnect CAT serial port"
                aria-label="CAT serial connection — currently disconnected">
            <i class="bi bi-plug" aria-hidden="true"></i> Disconnected
        </button>
        <button id="radioPowerBtn" class="btn btn-danger btn-sm"
                onclick="toggleRadioPower()" style="padding-top: 1px; padding-bottom: 1px;" title="Radio Power On/Off"
                aria-label="Radio power on or off">
            <i class="bi bi-power" aria-hidden="true"></i> POWER
        </button>
    </div>
</div>
