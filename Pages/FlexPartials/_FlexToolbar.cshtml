<div class="ywc-flex-toolbar" role="toolbar" aria-label="Radio control toolbar">
        @if (Model.ShowApp1Button)
        {
            <span class="ywc-toolbar-item">
                <button id="wsjtxBtn" class="ywc-btn ywc-btn-secondary ywc-btn-sm"
                        onclick="launchWsjtx()" title="Launch @Model.App1Name" aria-label="Launch @Model.App1Name">
                    @Model.App1Name
                    <span id="wsjtxTxBadge" class="ywc-badge ywc-badge-danger" style="display:none;">TX</span>
                </button>
            </span>
        }
        @if (Model.ShowApp3Button)
        {
            <span class="ywc-toolbar-item">
                <button id="log4omBtn" class="ywc-btn ywc-btn-secondary ywc-btn-sm"
                        onclick="launchLog4om()" title="Launch @Model.App3Name" aria-label="Launch @Model.App3Name">
                    @Model.App3Name
                </button>
            </span>
        }
        @if (Model.ShowApp2Button)
        {
            <span class="ywc-toolbar-item">
                <button id="jtalertBtn" class="ywc-btn ywc-btn-secondary ywc-btn-sm"
                        onclick="launchJtalert()" title="Launch @Model.App2Name" aria-label="Launch @Model.App2Name">
                    @Model.App2Name
                </button>
            </span>
        }
        @if (Model.ShowApp4Button)
        {
            <span class="ywc-toolbar-item">
                <button id="gridtrackerBtn" class="ywc-btn ywc-btn-secondary ywc-btn-sm"
                        onclick="launchGridtracker()" title="Launch @Model.App4Name" aria-label="Launch @Model.App4Name">
                    @Model.App4Name
                </button>
            </span>
        }
        @if (Model.ShowApp5Button)
        {
            <span class="ywc-toolbar-item">
                <button id="fldigiBtn" class="ywc-btn ywc-btn-secondary ywc-btn-sm"
                        onclick="launchFldigi()" title="Launch @Model.App5Name" aria-label="Launch @Model.App5Name">
                    @Model.App5Name
                </button>
            </span>
        }
        <span class="ywc-toolbar-spacer"></span>
        <span class="ywc-toolbar-item ywc-toolbar-right">
            <span id="utcClock" class="ywc-utc-clock"
                  title="UTC time from your PC system clock."
                  onclick="document.getElementById('utcClockInfoDialog').show()"
                  aria-live="off"
                  aria-label="Current UTC time. Click for details.">--:--:--Z</span>
            <a href="https://paypal.me/mm5agm" target="_blank" rel="noopener noreferrer"
               class="ywc-btn ywc-btn-warning ywc-btn-sm" title="Support this project via PayPal"
               aria-label="Support this project via PayPal">Coffee</a>
            <button id="sMeterHistoryToggleBtn" class="ywc-btn ywc-btn-outline ywc-btn-sm"
                    title="Show/hide S-meter history strip" aria-label="Show or hide the S-meter history strip"
                    aria-pressed="false">S-hist</button>
            <button id="connectBtn" class="ywc-btn ywc-btn-danger ywc-btn-sm"
                    onclick="toggleCatConnection()" aria-label="CAT serial connection">Disconnected</button>
            <button id="radioPowerBtn" class="ywc-btn ywc-btn-danger ywc-btn-sm"
                    onclick="toggleRadioPower()" aria-label="Radio power">POWER</button>
            <label class="ywc-preset-label" for="flexLayoutPreset" title="Layout preset (saved separately per device class)">
                Layout
                <select id="flexLayoutPreset" class="ywc-select ywc-select-sm" aria-label="Flex layout preset">
                    <option value="desktop">Desktop</option>
                    <option value="tablet">Tablet</option>
                    <option value="phone">Phone</option>
                </select>
            </label>
            <button type="button" id="flexResetLayoutBtn" class="ywc-btn ywc-btn-outline ywc-btn-sm"
                    title="Reset flex layout for the current preset" aria-label="Reset flex layout">Reset layout</button>
        </span>
</div>
