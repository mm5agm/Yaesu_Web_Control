@model Yaesu_Web_Control.Pages.FlexUiModel
@{
    var isFtdx10 = Model.View.IsFtdx10;
    var isFt710 = Model.View.IsFt710;
    var isFtdx3000 = Model.View.IsFtdx3000;
    var isFtdx5000 = Model.View.IsFtdx5000;
    var isFtdx101 = Model.View.IsFtdx101;
    var isSingleReceiver = Model.View.IsSingleReceiver;
    var hasAntennaSelector = Model.View.HasAntennaSelector;
    var maxPowerWatts = Model.View.MaxPowerWatts;
    var hasQmb = Model.View.HasQmb;
    var hasVcTune = Model.View.HasVcTune;
    var hasVcTuneSub = Model.View.HasVcTuneSub;
    var clarModeInit = Model.View.ClarModeInit;
    var contourMaxFreq = Model.View.ContourMaxFreq;
    var contourStep = Model.View.ContourStep;
    var apfStep = Model.View.ApfStep;
    var ifWidthDefaultA = Model.View.IfWidthDefaultA;
    var ifWidthDefaultB = Model.View.IfWidthDefaultB;
    var roofingOptionsJson = Model.View.RoofingOptionsJson;
    var ctcssTones = Model.View.CtcssTones;
}

        <div class="col-12 h-100" id="vfoACol">
            <div class="card border-0 h-100 receiver-card">
                <div class="card-header bg-transparent border-0 text-white py-0">
                    <div class="d-flex justify-content-end align-items-center flex-wrap gap-1">
                        @* Heading kept for site.js (updateTxButton writes to it) but
                           not shown — the FlexLayout tab carries the VFO name. *@
                        <span id="receiverAHeading" class="visually-hidden">VFO A</span>
                        <div class="d-flex align-items-center gap-1 flex-wrap">
                            <span id="splitTxBadgeA" class="badge bg-danger" style="display:none;" aria-live="polite">SPLIT TX</span>
                            @if (hasVcTune) {
                            <button type="button" id="vcTuneToggleBtnA" class="btn btn-outline-light btn-sm"
                                    onclick="vcTuneToggle('a')"
                                    aria-label="MAIN VC Tune on/off"
                                    title="Toggle MAIN VC Tune preselector on/off">VC Tune</button>
                            <span id="vcTuneRowA" class="d-inline-flex align-items-center gap-1">
                                <button id="vcTuneDefaultBtnA" class="btn btn-sm btn-outline-light"
                                        onclick="vcTuneCommand('a','default')"
                                        aria-label="MAIN VC Tune default" title="MAIN VC Tune auto-tune">Default</button>
                                <button class="btn btn-sm btn-outline-light"
                                        onclick="vcTuneStep('a','minus')"
                                        aria-label="MAIN VC Tune step down" title="Step MAIN preselector capacitor down">−</button>
                                <select id="vcTuneStepA" class="form-select form-select-sm"
                                        style="width: 3.5rem; background-color: transparent; color: white; border-color: rgba(255,255,255,0.5);"
                                        aria-label="MAIN VC Tune step size" title="Step size (1–9)">
                                    <option value="1" style="color:black;">1</option><option value="2" style="color:black;">2</option><option value="3" style="color:black;">3</option>
                                    <option value="4" style="color:black;">4</option><option value="5" selected style="color:black;">5</option><option value="6" style="color:black;">6</option>
                                    <option value="7" style="color:black;">7</option><option value="8" style="color:black;">8</option><option value="9" style="color:black;">9</option>
                                </select>
                                <button class="btn btn-sm btn-outline-light"
                                        onclick="vcTuneStep('a','plus')"
                                        aria-label="MAIN VC Tune step up" title="Step MAIN preselector capacitor up">+</button>
                                <button id="vcTuneCenterBtnA" class="btn btn-sm btn-outline-light"
                                        onclick="vcTuneCommand('a','center')"
                                        aria-label="MAIN VC Tune center" title="Center MAIN preselector capacitor">Center</button>
                                <span id="vcTuneMeterA" class="small text-white-50" style="font-size: 0.75rem; min-width: 44px;">P5: —</span>
                                <span id="vcTuneWarnA" class="text-warning small" style="display:none; font-size: 0.75rem;"></span>
                            </span>
                            }
                        </div>
                    </div>
                </div>
                <div class="card-body p-2">
                    <div class="vfo-body-grid">
                        <!-- Col 1: frequency (+ filter scope), RF/AF, band/segment/mode -->
                        <div class="vfo-col vfo-col--tune">
                            <div class="vfo-freq-row">
                                <span id="freqA" class="fw-bold frequency-display digit-display" role="spinbutton" aria-label="VFO A frequency" title="VFO A frequency" data-a11y-key="vfo.a.frequency" tabindex="0" aria-valuemin="0.03" aria-valuemax="75" aria-valuenow="0"></span>
                                <span class="frequency-display digit-display">MHz</span>
                                <div id="freqA-controls" class="freq-step-controls" style="display:@(Model.ShowFrequencyArrowButtons ? "inline-flex" : "none");">
                                    <button type="button" id="freqA-up" class="btn btn-secondary btn-sm" aria-label="Step VFO A selected digit up" title="Step VFO A selected digit up (↑)">▲</button>
                                    <button type="button" id="freqA-down" class="btn btn-secondary btn-sm" aria-label="Step VFO A selected digit down" title="Step VFO A selected digit down (↓)">▼</button>
                                </div>
                                <button class="btn btn-outline-secondary btn-sm fkb-open-btn"
                                        data-freq-keyboard="A"
                                        aria-label="Keyboard — enter VFO A frequency"
                                        data-a11y-key="keyboard.openA"
                                        title="Keyboard — enter VFO A frequency">
                                    <strong>123</strong>
                                </button>
                            </div>
                            <!-- Compact linear S-meter between frequency and RF gain.
                                 On single-receiver radios the inactive VFO's meter
                                 is greyed via .linear-smeter-inactive (applyVfoActiveStyling). -->
                            <div id="sMeterLinearRowA" class="linear-meter-row linear-meter-row--vfo"
                                 data-meter-scope="rx" data-linear-smeter="A">
                                <span class="linear-meter-label">S</span>
                                <canvas id="sMeterLinearCanvasA"
                                        role="img" aria-hidden="true"
                                        aria-label="S meter A (linear)"
                                        data-a11y-key="meters.linearSmeterA"></canvas>
                                <span id="sMeterLinearValueA" class="linear-meter-value linear-meter-value--smeter">S0</span>
                            </div>
                            <div class="vfo-gain-stack">
                                <div class="vfo-control-item">
                                    <label class="vfo-control-label">RF Gain</label>
                                    <input type="range" id="rfGainSliderA" aria-label="VFO A RF gain" title="VFO A RF gain (0=min, 255=max)" min="0" max="255" step="1" value="@Model.RadioState.RfGainA"
                                           oninput="document.getElementById('rfGainValueA').textContent = this.value"
                                           onchange="setRfGain('A', this.value)">
                                    <span id="rfGainValueA" class="vfo-control-label" style="text-align: right;">@Model.RadioState.RfGainA</span>
                                </div>
                                <div class="vfo-control-item">
                                    <label class="vfo-control-label">AF Gain</label>
                                    <input type="range" id="afGainSliderA" aria-label="VFO A AF gain" title="VFO A AF gain" min="0" max="255" step="1" value="@Model.AfGainA"
                                           oninput="document.getElementById('afGainValueA').textContent = this.value">
                                    <span id="afGainValueA" class="vfo-control-label" style="text-align: right;">@Model.AfGainA</span>
                                </div>
                                <div class="vfo-control-item" id="squelchRowA" style="display:none;">
                                    <label class="vfo-control-label">Squelch</label>
                                    <input type="range" id="squelchSliderA" aria-label="VFO A squelch" title="VFO A squelch level (0=open, 255=max)" min="0" max="255" step="1" value="@Model.RadioState.SquelchA"
                                           oninput="document.getElementById('squelchValueA').textContent = this.value"
                                           onchange="setSquelch('A', this.value)">
                                    <span id="squelchValueA" class="vfo-control-label" style="text-align: right;">@Model.RadioState.SquelchA</span>
                                </div>
                            </div>
                            <div class="vfo-band-row @(isFtdx101 ? "vfo-band-row--ftdx101" : "")">
                                <div class="vfo-band-row__band-controls">
                                    <div id="bandButtonA" data-selected="@(Model.SelectedBandA ?? "")"></div>
                                    <div id="segmentButtonA" data-selected=""></div>
                                </div>
                                <div class="d-flex align-items-center gap-2 vfo-band-row__mode-controls">
                                    <div id="modeButtonA" data-selected="@(Model.RadioState.ModeA ?? "USB")"></div>
                                    <span class="d-inline-block save-mem-tip" data-bs-toggle="tooltip" data-bs-placement="top"
                                          data-bs-title="Save VFO A frequency, mode, and all current settings to app memories."
                                          aria-label="Save VFO A to memories">
                                        <button id="saveMemBtnA" type="button"
                                                class="btn toggle-dd__btn toggle-dd__btn--icon save-mem-key flex-shrink-0"
                                                onclick="saveVfoToMemory('A')"
                                                aria-label="Save VFO A to memories">
                                            <i class="bi bi-floppy-fill save-mem-key__icon" aria-hidden="true"></i>
                                        </button>
                                    </span>
                                    @if (hasAntennaSelector)
                                    {
                                        <div id="antennaButtonA"
                                             data-selected="@(Model.RadioState.AntennaA ?? "1")"></div>
                                    }
                                </div>
                            </div>
                            <span id="saveMemStatusA" class="visually-hidden" role="status" aria-live="polite"></span>
                        </div>

                        <!-- Col 2: roofing, IF width, IF shift, audio filter -->
                        <div class="vfo-col vfo-col--band">
                            <div class="filter-scope-vfo-slot" id="filterScopeContainerA">
                                <canvas id="filterScopeCanvasA" role="img" aria-hidden="true"
                                        aria-label="VFO A filter display" data-a11y-key="filter.scopeA"></canvas>
                            </div>
                            @if (!isFt710)
                            {
                                <div id="roofingButtonA"
                                     data-selected="@(Model.RadioState.RoofingFilterA ?? "")"
                                     data-options="@roofingOptionsJson"></div>
                            }
                            <div id="ifWidthButtonA"
                                 data-selected="@(string.IsNullOrEmpty(Model.RadioState.IfWidthA) ? ifWidthDefaultA : Model.RadioState.IfWidthA)"
                                 data-mode="@Model.RadioState.ModeA"></div>
                            <div id="ifShiftButtonA"
                                 data-value="@Model.RadioState.IfShiftA"></div>
                            <button type="button"
                                    class="btn toggle-dd__btn toggle-dd__btn--action"
                                    id="audioFilterBtnA"
                                    aria-label="VFO A Audio Filter"
                                    title="Open the Audio Filter dialog for VFO A's current mode (LCUT FREQ, LCUT SLOPE, HCUT FREQ, HCUT SLOPE)"
                                    onclick="window.audioFilter && window.audioFilter.open('A')">
                                <span class="toggle-dd__label">Audio Filter</span>
                            </button>
                        </div>

                        <!-- Col 3: remaining keys -->
                        <div class="vfo-col vfo-col--keys">
                            <!-- Voice control mic button + step selector VFO A — large PTT target for accessibility, step select left of the button, both enlarged per Colin's testing feedback; shown only when voice control is enabled (voice-control.js) -->
                            <div class="flex-shrink-0" id="voiceMicContainerA" style="display:none;">
                                <div class="d-flex align-items-center gap-2">
                                    <select id="voiceNudgeStepSelectA"
                                            class="form-select"
                                            style="width:auto; font-size:1.4rem; font-weight:600; padding:0.4rem 2.4rem 0.4rem 0.6rem;"
                                            title="Voice nudge step size — how far 'tune up'/'tune down' moves VFO A"
                                            aria-label="VFO A voice nudge step size">
                                        <option value="1">1 Hz</option>
                                        <option value="10">10 Hz</option>
                                        <option value="100">100 Hz</option>
                                        <option value="1000">1 kHz</option>
                                        <option value="10000">10 kHz</option>
                                        <option value="100000">100 kHz</option>
                                    </select>
                                    <button id="voiceMicBtnA" type="button"
                                            class="btn btn-outline-danger voice-mic-btn d-flex align-items-center justify-content-center"
                                            style="width:140px; height:120px; padding:0;"
                                            title="Hold to give a VFO A voice command (right-click for the command list)"
                                            aria-label="Voice command VFO A — hold to speak">
                                        <i class="bi bi-mic-fill" style="font-size:4.5rem; line-height:1;" aria-hidden="true"></i>
                                    </button>
                                </div>
                                <div id="voiceLastHeardA"
                                     style="font-size:1.1rem; font-weight:700; color:#000; margin-top:0.3rem; max-width:320px; overflow-wrap:break-word;"
                                     aria-live="polite"></div>
                            </div>
                            <div class="vfo-controls-column">
                                <div class="vfo-control-item">
                                    <button type="button" id="zinBtnA"
                                            class="btn toggle-dd__btn toggle-dd__btn--action"
                                            onclick="cwZeroIn('A')"
                                            aria-label="VFO A CW Auto Zero In"
                                            title="CW Auto Zero In on VFO A — nudges the VFO so the received CW signal sits at your configured CW pitch">
                                        <span class="toggle-dd__label">ZIN</span>
                                    </button>
                                </div>
                                <div class="vfo-control-item">
                                    <div id="agcButtonA" data-selected="@Model.RadioState.AgcA"></div>
                                </div>
                                <div class="vfo-control-item">
                                    <div id="ipoButtonA" data-selected="@Model.RadioState.IpoA"></div>
                                </div>
                                <div class="vfo-control-item">
                                    <div id="attButtonA" data-selected="@Model.RadioState.AttA"></div>
                                </div>
                                <div class="vfo-control-item">
                                    @* DNR is ON/OFF on every supported radio (NR P2 is 0/1 in the FTdx101,
                                       FTdx10, FT-710, FTDX3000 and FTDX5000 CAT manuals). There is no NR1/NR2;
                                       the 1-15 DNR level is the only depth control. Kees ON9KVE, #144. *@
                                    <div id="nrButtonA"
                                         data-vfo="A"
                                         data-label="DNR"
                                         data-selected="@Model.RadioState.NrA"
                                         data-level="@Model.RadioState.NrLevelA"></div>
                                </div>
                                <div class="vfo-control-item">
                                    <div id="nbButtonA"
                                         data-enabled="@Model.RadioState.NbA"
                                         data-value="@Model.RadioState.NbLevelA"></div>
                                </div>
                                <div class="vfo-control-item">
                                    <div id="autoNotchButtonA" data-enabled="@Model.RadioState.AutoNotchA"></div>
                                </div>
                                <div class="vfo-control-item">
                                    <div id="manNotchButtonA"
                                         data-enabled="@Model.RadioState.ManualNotchA"
                                         data-value="@Model.RadioState.ManualNotchFreqA"></div>
                                </div>
                                <div class="vfo-control-item">
                                    <div id="contourButtonA"
                                         data-enabled="@(Model.RadioState.ContourOnA ? "1" : "0")"
                                         data-value="@Model.RadioState.ContourFreqA"
                                         data-min="100"
                                         data-max="@contourMaxFreq"
                                         data-step="@contourStep"></div>
                                </div>
                                <div class="vfo-control-item">
                                    <div id="apfButtonA"
                                         data-enabled="@(Model.RadioState.ApfOnA ? "1" : "0")"
                                         data-value="@Model.RadioState.ApfFreqA"
                                         data-min="-250"
                                         data-max="250"
                                         data-step="@apfStep"></div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- VFO A status line — live band/mode/freq/power summary, banner-coloured -->
                    @* Deliberately NOT a live region — see #123. Announcing from here
                       read the whole line once per property update rather than once per
                       operator action. #vfoStatusAnnounce does the speaking now; this
                       line stays plainly readable so it can still be reviewed on demand. *@
                    <div id="vfoAStatusLine"
                         class="bg-primary text-white px-2 py-1 mt-1 font-monospace rounded"
                         style="font-size:0.9rem; line-height:1.25; overflow-x:auto; white-space:nowrap;">—</div>
                            </div>
                        </div>
        </div>
