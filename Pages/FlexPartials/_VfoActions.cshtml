@model Yaesu_Web_Control.Pages.FlexUiModel
@{
    var isFtdx10 = Model.View.IsFtdx10;
    var isFt710 = Model.View.IsFt710;
    var isFtdx3000 = Model.View.IsFtdx3000;
    var isFtdx5000 = Model.View.IsFtdx5000;
    var isFtdx101 = Model.View.IsFtdx101;
    var isSingleReceiver = Model.View.IsSingleReceiver;
    var hasAntennaSelector = Model.View.HasAntennaSelector;
    var maxPowerWatts = Model.View.MaxPowerWatts;
    var hasQmb = Model.View.HasQmb;
    var hasVcTune = Model.View.HasVcTune;
    var hasVcTuneSub = Model.View.HasVcTuneSub;
    var clarModeInit = Model.View.ClarModeInit;
    var contourMaxFreq = Model.View.ContourMaxFreq;
    var contourStep = Model.View.ContourStep;
    var apfStep = Model.View.ApfStep;
    var ifWidthDefaultA = Model.View.IfWidthDefaultA;
    var ifWidthDefaultB = Model.View.IfWidthDefaultB;
    var roofingOptionsJson = Model.View.RoofingOptionsJson;
    var ctcssTones = Model.View.CtcssTones;
}


<div class="op-col op-col--buttons op-col--vfo-actions">
                            <button id="swapVfoBtn" class="btn toggle-dd__btn toggle-dd__btn--action toggle-dd__btn--toolbar"
                                    title="Swap VFO A and VFO B frequencies"
                                    aria-label="Swap VFO A and VFO B frequencies">
                                <span class="toggle-dd__label">A&#8596;B</span>
                            </button>
                            <button id="copyBtoABtn" class="btn toggle-dd__btn toggle-dd__btn--action toggle-dd__btn--toolbar"
                                    title="Copy VFO B frequency &amp; mode to VFO A. VFO B is left unchanged. Useful for transmitting on VFO B's settings without enabling split."
                                    aria-label="Copy VFO B to VFO A">
                                <span class="toggle-dd__label">B&rarr;A</span>
                            </button>
                            <button id="copyAtoBBtn" class="btn toggle-dd__btn toggle-dd__btn--action toggle-dd__btn--toolbar"
                                    title="Copy VFO A frequency &amp; mode to VFO B. VFO A is left unchanged. Useful for seeding VFO B from VFO A before adjusting one of them."
                                    aria-label="Copy VFO A to VFO B">
                                <span class="toggle-dd__label">A&rarr;B</span>
                            </button>
                            <button id="splitBtn" class="btn toggle-dd__btn toggle-dd__btn--action toggle-dd__btn--toolbar"
                                    title="Toggle Split: VFO A = receive, VFO B = transmit"
                                    aria-label="Toggle split mode: VFO A receive, VFO B transmit">
                                <span class="toggle-dd__label">Split</span>
                            </button>
                            <button id="quickSplitBtn" class="btn toggle-dd__btn toggle-dd__btn--action toggle-dd__btn--toolbar"
                                    title="Quick Split: enable split and set VFO B to VFO A + 5 kHz"
                                    aria-label="Quick split: enable split and set VFO B to VFO A plus 5 kHz">
                                <span class="toggle-dd__label">+5k</span>
                            </button>
    </div>
