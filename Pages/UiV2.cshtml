        <button type="button" class="u2-btn u2-btn-func u2-mobile-only" onclick="u2Open('dlgMode')">Mode</button>
        <button type="button" class="u2-btn u2-btn-func" id="nrFuncBtn"
                onclick="u2ToggleSwitch('nrSelectA', (on) => window.radioControl?.setNr('A', on ? '1' : '0'))">NR</button>
