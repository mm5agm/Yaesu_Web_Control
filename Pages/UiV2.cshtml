@section Scripts {
    <script>
        window.ywcTxToggleKey = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.TxToggleKey));
        window.ywcIsWindowsHost = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.IsWindowsHost));
        window.bandPlan = '@Model.BandPlan';
        window._radioModel = '@Model.RadioModel';

        async function setRfGain(receiver, value) {
            try {
                await fetch(`/api/cat/rfgain/${receiver.toLowerCase()}`, {
                    method: 'POST', headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ value: parseInt(value) })
                });
            } catch (e) { console.error('setRfGain error:', e); }
        }
        window.setRfGain = setRfGain;
    </script>
    <script>
        function u2Open(id) {
            const d = document.getElementById(id);
            if (!d) return;
            if (id === 'dlgBand') {
                const body = document.getElementById('dlgBandBody');
                const src = document.querySelector('.u2-col-side .band-buttons-container');
                if (body && src && !body.dataset.ready) {
                    body.appendChild(src.cloneNode(true));
                    body.dataset.ready = '1';
                    body.querySelectorAll('input[type=radio]').forEach(inp => {
                        inp.addEventListener('change', () => {
                            const live = document.querySelector(`.u2-col-side input[name="${inp.name}"][value="${inp.value}"]`);
                            if (live) { live.checked = true; live.dispatchEvent(new Event('change', { bubbles: true })); }
                            u2Close('dlgBand');
                        });
                    });
                }
            }
            if (typeof d.showModal === 'function') d.showModal();
        }
        function u2Close(id) {
            const d = document.getElementById(id);
            if (d && d.open) d.close();
        }
        function u2SetMode(vfo, mode) {
            // Call window.setMode directly (same as classic Index). The IIFE
            // radioControl.setMode used to miss MODE_TO_CAT_CODE and no-op'ed.
            if (typeof setMode === 'function') setMode(vfo, mode);
            else if (window.setMode) window.setMode(vfo, mode);
            const sel = document.getElementById('modeSelect' + vfo);
            if (sel) sel.value = mode;
            u2SyncModeChips(vfo, mode);
            const panel = vfo === 'B' ? window.filterScopePanelB : window.filterScopePanelA;
            if (panel) panel.setState({ mode });
            if (window.IfWidth) {
                window.IfWidth.rebuildIfWidthSelect(
                    document.getElementById('ifWidthSelect' + vfo),
                    window._radioModel,
                    mode
                );
                if (vfo === 'A') {
                    const wSel = document.getElementById('ifWidthSelectA');
                    const wLab = document.getElementById('ifWidthValueA');
                    if (wSel && wLab && wSel.selectedIndex >= 0) {
                        wLab.textContent = wSel.options[wSel.selectedIndex].text;
                    }
                }
            }
        }

        window.u2ApplyActiveVfo = function (state) {
            const aActive = state.activeVfo === 0;
            const bActive = state.activeVfo === 1;
            const single = !!state.singleReceiver;
            const splitOn = (state.splitMode || 0) > 0;
            const display = document.getElementById('u2DisplayA');
            const rowB = document.getElementById('u2DisplayB');
            const pillA = document.getElementById('u2ActivePillA');
            const pillB = document.getElementById('u2ActivePillB');

            display?.classList.toggle('u2-vfo-active', aActive);
            display?.classList.toggle('u2-vfo-inactive', single && !aActive);
            rowB?.classList.toggle('u2-vfo-active', bActive);
            rowB?.classList.toggle('u2-vfo-inactive', single && !bActive && !splitOn);
            rowB?.classList.toggle('u2-vfo-tx', single && !bActive && splitOn);

            if (pillA) {
                pillA.classList.toggle('u2-vfo-active', aActive);
                pillA.textContent = aActive
                    ? (splitOn ? 'VFO A · RX' : 'VFO A · ACTIVE')
                    : (splitOn && single ? 'VFO A · TX' : 'VFO A');
            }
            if (pillB) {
                pillB.classList.toggle('u2-vfo-active', bActive);
                pillB.textContent = bActive
                    ? (splitOn ? 'VFO B · RX' : 'VFO B · ACTIVE')
                    : (splitOn && single ? 'VFO B · TX' : 'VFO B');
            }
        };
        function u2SyncModeChips(vfo, mode) {
            const groups = vfo === 'B'
                ? '#modeChipGroupB .u2-btn-mode, #modeChipGroupBMobile .u2-btn-mode'
                : '#modeChipGroupA .u2-btn-mode, #modeChipGroupAMobile .u2-btn-mode';
            document.querySelectorAll(groups).forEach(b => {
                b.classList.toggle('u2-btn-active', b.dataset.mode === mode);
            });
            if (vfo === 'A') {
                const dm = document.getElementById('u2DisplayMode');
                if (dm) dm.textContent = mode;
            } else {
                const dm = document.getElementById('u2DisplayModeB');
                if (dm) dm.textContent = mode;
            }
        }
        function u2ToggleSwitch(id, apply) {
            const el = document.getElementById(id);
            if (!el) return;
            el.checked = !el.checked;
            el.dispatchEvent(new Event('change'));
            if (typeof apply === 'function') apply(el.checked);
            u2SyncDspChips();
        }
        function u2SyncDspChips() {
            const map = [
                ['nrSelectA', 'nrChipA', 'nrFuncBtn'],
                ['nbSelectA', 'nbChipA', 'nbFuncBtn'],
                ['autoNotchSelectA', 'anChipA'],
                ['manualNotchSelectA', 'mnChipA'],
            ];
            map.forEach(([id, ...btns]) => {
                const el = document.getElementById(id);
                const on = !!(el && el.checked);
                btns.forEach(bid => {
                    const b = document.getElementById(bid);
                    if (b) b.classList.toggle('u2-btn-active', on);
                });
            });
        }

        async function setMicGain(value) {
            try {
                await fetch('/api/cat/micgain', {
                    method: 'POST', headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ value: parseInt(value) })
                });
            } catch (e) { /* ignore */ }
        }
        async function toggleProc() {
            const btn = document.getElementById('procBtn');
            const enabled = btn && (btn.classList.contains('u2-btn-ok') || btn.classList.contains('btn-success'));
            try {
                const response = await fetch('/api/cat/proc', {
                    method: 'POST', headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ enabled: !enabled })
                });
                if (response.ok) updateProcButton(!enabled);
            } catch (e) { /* ignore */ }
        }
        async function setProcLevel(value) {
            try {
                await fetch('/api/cat/proclevel', {
                    method: 'POST', headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ value: parseInt(value) })
                });
            } catch (e) { /* ignore */ }
        }
        function updateProcButton(enabled) {
            const btn = document.getElementById('procBtn');
            if (!btn) return;
            btn.classList.toggle('u2-btn-ok', enabled);
            btn.classList.toggle('btn-success', enabled);
            btn.textContent = enabled ? 'Proc On' : 'Proc Off';
        }

        const ATU_LONG_PRESS_MS = 500;
        const ATU_TUNE_AUTOCLEAR_MS = 8000;
        let atuPressTimer = null, atuLongFired = false, atuAutoclearTimer = null;

        async function toggleAtu() {
            const btn = document.getElementById('atuBtn');
            const enabled = btn && (btn.classList.contains('u2-btn-ok') || btn.classList.contains('btn-success'));
            try {
                await fetch('/api/cat/atu', {
                    method: 'POST', headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ enabled: !enabled })
                });
                updateAtuButton(!enabled);
            } catch (e) { /* ignore */ }
        }
        async function refreshAtuAfterTune() {
            let finalEnabled = null;
            try {
                const r = await fetch('/api/cat/atu');
                if (r.ok) finalEnabled = (await r.json()).atuEnabled === true;
            } catch (e) { /* ignore */ }
            const btn = document.getElementById('atuBtn');
            if (btn && finalEnabled !== null) btn.dataset.atuEnabled = finalEnabled ? 'true' : 'false';
            updateAtuTuningState(false);
        }
        async function startAtuTune() {
            try {
                await fetch('/api/cat/atu/tune', { method: 'POST' });
                updateAtuTuningState(true);
                clearTimeout(atuAutoclearTimer);
                atuAutoclearTimer = setTimeout(refreshAtuAfterTune, ATU_TUNE_AUTOCLEAR_MS);
            } catch (e) { /* ignore */ }
        }
        async function stopAtuTune() {
            try { fetch('/api/cat/atu/tune', { method: 'POST' }); } catch (e) {}
            clearTimeout(atuAutoclearTimer);
            atuAutoclearTimer = null;
            setTimeout(refreshAtuAfterTune, 500);
        }
        function updateAtuButton(enabled) {
            const btn = document.getElementById('atuBtn');
            if (!btn || btn.dataset.tuning === 'true') return;
            btn.classList.toggle('u2-btn-ok', enabled);
            btn.classList.toggle('btn-success', enabled);
            btn.textContent = enabled ? 'ATU' : 'ATU';
        }
        function updateAtuTuningState(tuning) {
            const btn = document.getElementById('atuBtn');
            if (!btn) return;
            if (tuning) {
                btn.dataset.tuning = 'true';
                btn.classList.add('u2-btn-bad');
                btn.textContent = 'Tune…';
            } else {
                btn.dataset.tuning = 'false';
                btn.classList.remove('u2-btn-bad');
                updateAtuButton(btn.dataset.atuEnabled === 'true');
            }
        }

        document.addEventListener('DOMContentLoaded', function () {
            const atuBtn = document.getElementById('atuBtn');
            if (atuBtn) {
                atuBtn.dataset.atuEnabled = '@(Model.AtuEnabled ? "true" : "false")';
                atuBtn.addEventListener('pointerdown', function () {
                    atuLongFired = false;
                    clearTimeout(atuPressTimer);
                    atuPressTimer = setTimeout(() => { atuLongFired = true; startAtuTune(); }, ATU_LONG_PRESS_MS);
                });
                const cancelPress = () => { clearTimeout(atuPressTimer); atuPressTimer = null; };
                atuBtn.addEventListener('pointerup', function () {
                    clearTimeout(atuPressTimer); atuPressTimer = null;
                    if (!atuLongFired) {
                        if (atuBtn.dataset.tuning === 'true') stopAtuTune();
                        else toggleAtu();
                    }
                });
                atuBtn.addEventListener('pointerleave', cancelPress);
                atuBtn.addEventListener('pointercancel', cancelPress);
            }
            u2SyncDspChips();
        });

        let _monitorOn = @(Model.MonitorOn ? "true" : "false");
        function _updateMonitorBtn(on) {
            _monitorOn = on;
            const btn = document.getElementById('monitorOnBtn');
            if (!btn) return;
            btn.classList.toggle('u2-btn-warn', on);
            btn.classList.toggle('btn-warning', on);
        }
        async function toggleMonitor() {
            const newOn = !_monitorOn;
            _monitorOn = newOn;
            _updateMonitorBtn(newOn);
            try {
                await fetch('/api/cat/monitoron', {
                    method: 'POST', headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ on: newOn })
                });
            } catch (e) { /* ignore */ }
        }
        async function setMonitorLevel(value) {
            try {
                await fetch('/api/cat/monitorlevel/a', {
                    method: 'POST', headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ level: parseInt(value) })
                });
            } catch (e) { /* ignore */ }
        }

        async function toggleVox() {
            const btn = document.getElementById('voxOnBtn');
            const on = btn && (btn.classList.contains('btn-warning') || btn.classList.contains('u2-btn-warn'));
            try {
                await fetch('/api/cat/vox', {
                    method: 'POST', headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ on: !on })
                });
                updateVoxButton(!on);
            } catch (e) { /* ignore */ }
        }
        function updateVoxButton(on) {
            const btn = document.getElementById('voxOnBtn');
            const mainBtn = document.getElementById('voxBtn');
            [btn, mainBtn].forEach(b => {
                if (!b) return;
                b.classList.toggle('btn-warning', on);
                b.classList.toggle('u2-btn-warn', on);
                if (b === mainBtn) b.textContent = on ? 'VOX On' : 'VOX Off';
            });
        }

        let _catConnected = false;
        function _applyConnectBtnState(connected) {
            const btn = document.getElementById('connectBtn');
            const dot = document.getElementById('catDot');
            if (btn) {
                btn.classList.toggle('u2-btn-ok', connected);
                btn.classList.toggle('u2-btn-bad', !connected);
                btn.classList.toggle('btn-success', connected);
                btn.classList.toggle('btn-danger', !connected);
                btn.textContent = connected ? 'Connected' : 'Disconnected';
            }
            if (dot) dot.classList.toggle('on', connected);
            _catConnected = connected;
        }
        async function toggleCatConnection() {
            const btn = document.getElementById('connectBtn');
            try {
                if (_catConnected) {
                    const r = await fetch('/api/cat/disconnect', { method: 'POST' });
                    if ((await r.json()).success) _applyConnectBtnState(false);
                } else {
                    if (btn) btn.textContent = 'Connecting…';
                    const r = await fetch('/api/cat/connect', { method: 'POST' });
                    _applyConnectBtnState((await r.json()).success);
                }
            } catch (e) {
                _applyConnectBtnState(false);
            }
        }

        fetch('/api/cat/status').then(r => r.json()).then(d => _applyConnectBtnState(d.isConnected === true)).catch(() => {});

        document.addEventListener('DOMContentLoaded', () => {
            const utcClockEl = document.getElementById('utcClock');
            if (utcClockEl) {
                const pad2 = (n) => String(n).padStart(2, '0');
                const tick = () => {
                    const d = new Date();
                    utcClockEl.textContent = `${pad2(d.getUTCHours())}:${pad2(d.getUTCMinutes())}:${pad2(d.getUTCSeconds())}Z`;
                };
                tick();
                setInterval(tick, 1000);
            }
            // Mirror main freq into side label + VFO B into center secondary line
            const freqA = document.getElementById('freqA');
            const side = document.getElementById('freqASide');
            if (freqA && side) {
                const sync = () => { side.textContent = freqA.textContent; };
                sync();
                new MutationObserver(sync).observe(freqA, { childList: true, characterData: true, subtree: true });
            }
            const freqB = document.getElementById('freqB');
            const freqBDisp = document.getElementById('freqBDisplay');
            if (freqB && freqBDisp) {
                const syncB = () => { freqBDisp.textContent = freqB.textContent; };
                syncB();
                new MutationObserver(syncB).observe(freqB, { childList: true, characterData: true, subtree: true });
            }
            // Band label in display
            const syncBand = () => {
                const checked = document.querySelector('.u2-col-side input[name="band-A"]:checked');
                const el = document.getElementById('u2DisplayBand');
                if (el) el.textContent = checked ? checked.value : '—';
            };
            syncBand();
            document.querySelectorAll('.u2-col-side input[name="band-A"]').forEach(i => i.addEventListener('change', syncBand));
        });

        window.setMicGain = setMicGain;
        window.toggleProc = toggleProc;
        window.setProcLevel = setProcLevel;
        window.toggleAtu = toggleAtu;
        window.startAtuTune = startAtuTune;
        window.stopAtuTune = stopAtuTune;
        window.updateAtuButton = updateAtuButton;
        window.updateAtuTuningState = updateAtuTuningState;
        window._updateMonitorBtn = _updateMonitorBtn;
        window.toggleMonitor = toggleMonitor;
        window.setMonitorLevel = setMonitorLevel;
        window.toggleCatConnection = toggleCatConnection;
        window.toggleVox = toggleVox;
        window.updateVoxButton = updateVoxButton;
        window.updateProcButton = updateProcButton;
        window.u2SetMode = u2SetMode;
        window.u2SyncModeChips = u2SyncModeChips;
        window.u2ToggleSwitch = u2ToggleSwitch;
        window.u2Open = u2Open;
        window.u2Close = u2Close;
        window.u2SyncDspChips = u2SyncDspChips;
        window.toggleTx = toggleTx;
        window.setActiveVfo = setActiveVfo;

        try { if (typeof applyVfoActiveStyling === 'function') applyVfoActiveStyling(); } catch { /* ignore */ }

        // Keep footer MOX label in sync when site.js restyles #txButtonA.
        (function () {
            const syncMox = () => {
                const btnA = document.getElementById('txButtonA');
                const mox = document.getElementById('txMoxBtn');
                if (!mox || !btnA) return;
                const on = btnA.classList.contains('btn-danger')
                    || /\bON\b/i.test(btnA.textContent || '');
                mox.classList.toggle('u2-btn-bad', on);
                mox.classList.toggle('u2-btn-warn', !on);
                mox.textContent = on ? 'TX ON' : 'MOX';
            };
            const btnA = document.getElementById('txButtonA');
            if (btnA) {
                new MutationObserver(syncMox).observe(btnA, {
                    attributes: true, attributeFilter: ['class', 'style'],
                    childList: true, characterData: true, subtree: true
                });
            }
            try { window.updateTxButton?.(); } catch { /* ignore */ }
            syncMox();
        })();
    </script>

    <script type="module">
        import { MeterPanel }          from "/js/guages/meter-panel.js?v=1";
        import { FTdx101Meters }       from "/js/orchestrators/FTdx101Meters.js?v=2";
        import { SdrSpectrumPipeline } from "/js/sdr/sdr-spectrum-pipeline.js?v=4";
        import { SpectrumPanel }       from "/js/sdr/spectrum-panel.js?v=5";
        import { FilterScopePanel }    from "/js/ui/filter-scope-panel.js?v=3";
        import { SMeterHistoryPanel }  from "/js/guages/smeter-history-panel.js?v=1";
        import { initRemoteAudioUi }   from "/js/audio/remote-audio-ui.js?v=11";
        import { initFreqKeyboard }    from "/js/ui/freq-keyboard.js?v=14";
        import "/js/ui/if-width-tables.js?v=3";

        const isSingleReceiver = @(isSingleReceiver ? "true" : "false");

        initFreqKeyboard();

        // Mode-aware IF Width SH codes (same as classic Index).
        if (window.IfWidth) {
            window.IfWidth.rebuildIfWidthSelect(
                document.getElementById('ifWidthSelectA'),
                window._radioModel,
                '@Model.RadioState.ModeA'
            );
            window.IfWidth.rebuildIfWidthSelect(
                document.getElementById('ifWidthSelectB'),
                window._radioModel,
                '@Model.RadioState.ModeB'
            );
            const wSel = document.getElementById('ifWidthSelectA');
            const wLab = document.getElementById('ifWidthValueA');
            if (wSel && wLab && wSel.selectedIndex >= 0) {
                wLab.textContent = wSel.options[wSel.selectedIndex].text;
            }
        }

        try { window.updateTxButton?.(); } catch { /* ignore */ }

        // No radial canvases — horizontal CSS bars are driven from site.js.
        window.meterPanel = new MeterPanel({});
        window.ftdx101Meters = new FTdx101Meters(window.meterPanel, window.calibrationEngine);
        window.sMeterHistory = new SMeterHistoryPanel('sMeterHistoryCanvas', {
            colors: {
                background: '#0b1220',
                grid: 'rgba(180,200,220,0.12)',
                gridLabel: '#8899aa',
                history: '#4af09a',
                peakHold: '#f0c040',
                noiseFloor: 'rgba(255,120,120,0.7)'
            }
        });
        if (!isSingleReceiver) {
            window.sMeterHistoryB = new SMeterHistoryPanel('sMeterHistoryCanvasB', {
                colors: {
                    background: '#0b1220',
                    grid: 'rgba(180,200,220,0.12)',
                    gridLabel: '#8899aa',
                    history: '#4af09a',
                    peakHold: '#f0c040',
                    noiseFloor: 'rgba(255,120,120,0.7)'
                }
            });
        }

        // Filter / IF band-scope (works without SDR)
        window.filterScopePanelA = new FilterScopePanel('filterScopeCanvasA', '@Model.RadioModel', {
            ifWidthCode:       '@Model.RadioState.IfWidthA',
            ifShiftHz:          @Model.RadioState.IfShiftA,
            roofingCode:       '@Model.RadioState.RoofingFilterA',
            manualNotchOn:      @(Model.RadioState.ManualNotchA == "1" ? "true" : "false"),
            manualNotchFreqHz:  @(Model.RadioState.ManualNotchFreqA),
            contourOn:          false,
            contourFreqHz:      0,
            apfOn:              false,
            apfFreqHz:          0,
            mode:              '@Model.RadioState.ModeA'
        });
        if (!isSingleReceiver) {
            window.filterScopePanelB = new FilterScopePanel('filterScopeCanvasB', '@Model.RadioModel', {
                ifWidthCode:       '@Model.RadioState.IfWidthB',
                ifShiftHz:          @Model.RadioState.IfShiftB,
                roofingCode:       '@Model.RadioState.RoofingFilterB',
                manualNotchOn:      @(Model.RadioState.ManualNotchB == "1" ? "true" : "false"),
                manualNotchFreqHz:  @(Model.RadioState.ManualNotchFreqB),
                contourOn:          false,
                contourFreqHz:      0,
                apfOn:              false,
                apfFreqHz:          0,
                mode:              '@Model.RadioState.ModeB'
            });
        }

        initRemoteAudioUi();

        const spectrumPanelA = new SpectrumPanel('spectrumCanvasA', 'spectrumContainerA', @Model.RadioState.FrequencyA, 'A');
        const spectrumPanelB = isSingleReceiver
            ? null
            : new SpectrumPanel('spectrumCanvasB', 'spectrumContainerB', @Model.RadioState.FrequencyB, 'B');

        const spectrumPipeline = new SdrSpectrumPipeline();
        let aHasFrame = false, bHasFrame = false;

        spectrumPipeline.onSpectrumUpdate('A', data => {
            if (!aHasFrame) { aHasFrame = true; spectrumPanelA?.setStatus('streaming'); }
            spectrumPanelA?.update(data);
        });
        spectrumPipeline.onSpectrumUpdate('B', data => {
            if (!bHasFrame) { bHasFrame = true; spectrumPanelB?.setStatus('streaming'); }
            spectrumPanelB?.update(data);
        });
        spectrumPipeline.onStatusChange('A', status => spectrumPanelA?.setStatus(status));
        spectrumPipeline.onStatusChange('B', status => spectrumPanelB?.setStatus(status));
        spectrumPipeline.onError('A', detail => spectrumPanelA?.setError(detail));
        spectrumPipeline.onError('B', detail => spectrumPanelB?.setError(detail));
        spectrumPipeline.onFrequencyA(hz => spectrumPanelA?.setVfoFrequency(hz));
        spectrumPipeline.onFrequencyB(hz => spectrumPanelB?.setVfoFrequency(hz));

        const formatSpeed = (d) => d === 1 ? 'Full' : `1/${d}`;
        const formatBright = (db) => db <= 0 ? 'Off' : `+${db}`;
        const initialSpanA = @(Model.SdrSampleRateHzA);
        document.querySelectorAll('.span-btn[data-vfo="A"]').forEach(btn => {
            btn.classList.toggle('u2-btn-active', btn.dataset.hz === String(initialSpanA));
            btn.classList.toggle('active', btn.dataset.hz === String(initialSpanA));
        });

        ['A', 'B'].forEach(vfo => {
            const panel = vfo === 'B' ? spectrumPanelB : spectrumPanelA;
            const rangeSlider = document.querySelector(`.spectrum-range-slider[data-vfo="${vfo}"]`);
            const rangeLabel  = document.querySelector(`.spectrum-range-label[data-vfo="${vfo}"]`);
            if (rangeSlider && rangeLabel && panel) {
                const r = Math.round(panel.getSpectrumRange());
                rangeSlider.value = String(r);
                rangeLabel.textContent = r + ' dB';
                rangeSlider.addEventListener('input', () => {
                    const v = parseInt(rangeSlider.value, 10);
                    rangeLabel.textContent = v + ' dB';
                    panel.setSpectrumRange(v);
                });
            }
            const speedSlider = document.querySelector(`.spectrum-speed-slider[data-vfo="${vfo}"]`);
            const speedLabel  = document.querySelector(`.spectrum-speed-label[data-vfo="${vfo}"]`);
            if (speedSlider && speedLabel && panel) {
                const speeds = SpectrumPanel.WATERFALL_SPEEDS;
                const idx = Math.max(0, speeds.indexOf(panel.getWaterfallSpeed()));
                speedSlider.value = String(idx);
                speedLabel.textContent = formatSpeed(speeds[idx]);
                speedSlider.addEventListener('input', () => {
                    const divisor = speeds[parseInt(speedSlider.value, 10)];
                    speedLabel.textContent = formatSpeed(divisor);
                    panel.setWaterfallSpeed(divisor);
                });
            }
            const brightSlider = document.querySelector(`.spectrum-bright-slider[data-vfo="${vfo}"]`);
            const brightLabel  = document.querySelector(`.spectrum-bright-label[data-vfo="${vfo}"]`);
            if (brightSlider && brightLabel && panel) {
                const b = panel.getWaterfallBrightness();
                brightSlider.value = String(b);
                brightLabel.textContent = formatBright(b);
                brightSlider.addEventListener('input', () => {
                    const db = parseInt(brightSlider.value, 10);
                    brightLabel.textContent = formatBright(db);
                    panel.setWaterfallBrightness(db);
                });
            }
        });

        document.querySelectorAll('.spectrum-hold-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                const vfo = btn.dataset.vfo;
                const panel = vfo === 'B' ? spectrumPanelB : spectrumPanelA;
                if (!panel) return;
                const nowHeld = !panel.isHeld();
                panel.setHold(nowHeld);
                btn.classList.toggle('u2-btn-warn', nowHeld);
                btn.classList.toggle('active', nowHeld);
                const badge = document.getElementById('spectrumStatusBadge' + vfo);
                if (badge) badge.textContent = nowHeld ? 'Hold' : 'Live';
            });
        });

        document.querySelectorAll('.span-btn').forEach(btn => {
            btn.addEventListener('click', async () => {
                const hz = btn.dataset.hz;
                const vfo = btn.dataset.vfo || 'A';
                try {
                    const res = await fetch(`/api/sdr/span?hz=${hz}&sdrId=${vfo}`, { method: 'POST' });
                    if (res.ok) {
                        document.querySelectorAll(`.span-btn[data-vfo="${vfo}"]`).forEach(b => {
                            b.classList.remove('u2-btn-active', 'active');
                        });
                        btn.classList.add('u2-btn-active', 'active');
                    }
                } catch { /* ignore */ }
            });
        });

        spectrumPipeline.connect();
        window.addEventListener('pagehide', () => {
            try { spectrumPipeline.disconnect(); } catch { /* ignore */ }
        });
    </script>
}
