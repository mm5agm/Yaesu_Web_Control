@page
@model Yaesu_Web_Control.Pages.SettingsModel

<div class="mt-4">

    @if (!string.IsNullOrEmpty(Model.StatusMessage))
    {
        <div class="alert @(Model.StatusMessage.Contains("success") || Model.StatusMessage.Contains("✓") ? "alert-success" : "alert-danger") alert-dismissible fade show" role="alert">
            @Model.StatusMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @* Restart-required banner — shown when a setting like the radio model was
       changed and the running app needs a restart for it to fully take effect.
       Bigger, brighter, and non-dismissible compared to the StatusMessage above,
       so the user can't miss it. Issue #9. *@
    @if (!string.IsNullOrEmpty(Model.RestartRequiredReason))
    {
        <div class="alert alert-warning border-3 d-flex flex-wrap align-items-center gap-3" role="alert" aria-live="polite">
            <div class="flex-grow-1">
                <h5 class="mb-1"><i class="bi bi-arrow-repeat" aria-hidden="true"></i> Restart Yaesu Web Control to apply your changes</h5>
                <div class="mb-0">
                    You changed the <strong>@Model.RestartRequiredReason</strong>.
                    Most settings take effect immediately, but this one needs a restart so every part of the app — and any open browser tabs from before the change — picks up the new value cleanly.
                </div>
            </div>
            <form method="post" asp-page-handler="Restart" class="m-0">
                <button type="submit" class="btn btn-warning fw-bold"
                        title="Stop the app and relaunch it. Your browser will briefly show the 'Yaesu Web Control has stopped' overlay; reload this tab when the app is back.">
                    <i class="bi bi-arrow-repeat" aria-hidden="true"></i> Restart Now
                </button>
            </form>
        </div>
    }

    <!-- Network Access URLs Card -->
    <div class="row mb-4">
        <div class="col-lg-6 mb-4 mb-lg-0">
            <div class="card border-info h-100">
                <div class="card-header bg-info text-white">
                    <h4 class="mb-0"><i class="bi bi-globe"></i> Network Access URLs</h4>
                </div>
                <div class="card-body">
                    <div class="list-group mb-3">
                        <div class="list-group-item">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <h6 class="mb-1"><i class="bi bi-laptop"></i> Local Access (This PC)</h6>
                                    <code class="fs-5" id="localUrl">http://localhost:@Model.CurrentRunningPort</code>
                                </div>
                                <button class="btn btn-sm btn-outline-primary" onclick="copyToClipboard('localUrl')">
                                    <i class="bi bi-clipboard"></i> Copy
                                </button>
                            </div>
                        </div>
                        @if (Model.NetworkAddresses != null && Model.NetworkAddresses.Any())
                        {
                            @foreach (var addr in Model.NetworkAddresses)
                            {
                                var urlId = $"netUrl{addr.Replace(".", "_")}";
                                <div class="list-group-item">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div>
                                            <h6 class="mb-1"><i class="bi bi-tablet"></i> Network Access (Tablets/Phones)</h6>
                                            <code class="fs-5" id="@urlId">http://@addr:@Model.CurrentRunningPort</code>
                                            @if (addr.StartsWith("192.168") || addr.StartsWith("10.") || addr.StartsWith("172."))
                                            {
                                                <small class="text-muted d-block">Private Network</small>
                                            }
                                        </div>
                                        <button class="btn btn-sm btn-outline-primary" onclick="copyToClipboard('@urlId')">
                                            <i class="bi bi-clipboard"></i> Copy
                                        </button>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="list-group-item">
                                <div class="alert alert-warning mb-0">
                                    <i class="bi bi-exclamation-triangle"></i> No network interfaces detected. Connect to a network to access from other devices.
                                </div>
                            </div>
                        }
                    </div>
                    <div class="alert alert-info mb-0">
                        <i class="bi bi-info-circle"></i> <strong>Tip:</strong> Bookmark these URLs on your tablets and phones for quick access!
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="card h-100">
                <div class="card-header">
                    <h4 class="mb-0">Current Configuration</h4>
                </div>
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-4">Radio Model:</dt>
                        <dd class="col-sm-8">
                            <code>@Model.Settings.RadioModel</code>
                            @if (Model.Settings.RadioModel == "FTdx101MP")
                            {
                                <span class="badge bg-primary">200W</span>
                            }
                            else
                            {
                                <span class="badge bg-info">100W</span>
                            }
                        </dd>
                        <dt class="col-sm-4">Serial Port:</dt>
                        <dd class="col-sm-8"><code>@Model.Settings.SerialPort</code></dd>
                        <dt class="col-sm-4">Baud Rate:</dt>
                        <dd class="col-sm-8"><code>@Model.Settings.BaudRate</code></dd>
                        <dt class="col-sm-4">Network Interface:</dt>
                        <dd class="col-sm-8">
                            <code>@Model.Settings.WebAddress</code>
                            @if (Model.Settings.WebAddress == "0.0.0.0")
                            {
                                <span class="badge bg-success">All Interfaces</span>
                            }
                            else if (Model.Settings.WebAddress == "localhost")
                            {
                                <span class="badge bg-secondary">Local Only</span>
                            }
                        </dd>
                        <dt class="col-sm-4">Web Port:</dt>
                        <dd class="col-sm-8">
                            <code>@Model.CurrentRunningPort</code>
                            @if (Model.CurrentRunningPort != Model.Settings.HttpPort)
                            {
                                <span class="badge bg-warning text-dark ms-1" title="Configured port differs — restart for it to take effect">configured: @Model.Settings.HttpPort</span>
                            }
                        </dd>
                        <dt class="col-sm-4">SDR Device:</dt>
                        <dd class="col-sm-8">
                            @{
                                var sdrA = Model.Settings.SdrDeviceKeyA;
                                var sdrB = Model.Settings.SdrDeviceKeyB;
                            }
                            @if (string.IsNullOrEmpty(sdrA) && string.IsNullOrEmpty(sdrB))
                            {
                                <span class="text-muted">None</span>
                            }
                            else
                            {
                                @if (!string.IsNullOrEmpty(sdrA)) { <div><strong>VFO A:</strong> <code>@sdrA</code></div> }
                                @if (!string.IsNullOrEmpty(sdrB)) { <div><strong>VFO B:</strong> <code>@sdrB</code></div> }
                            }
                        </dd>
                    </dl>
                </div>
            </div>
        </div>
    </div>

    <form method="post">
    <div class="card">
        <div class="card-header">
            <h3>Configuration</h3>
        </div>
        <div class="card-body">
                <div class="row">
                    <div class="col-md-6">
                        <h5 class="mb-3">Radio Connection</h5>
                        <div class="mb-3">
                            <label asp-for="Settings.RadioModel" class="form-label">Radio Model</label>
                            <select asp-for="Settings.RadioModel" class="form-select">
                                <option value="FTdx101MP">FTdx101MP</option>
                                <option value="FTdx101D">FTdx101D</option>
                                <option value="FTdx10">FTdx10</option>
                                <option value="FT-710">FT-710</option>
                                <option value="FTDX3000">FTDX3000</option>
                            </select>
                            <div class="form-text">
                                <strong>FTdx101MP:</strong> 200W output, dual receivers (VFO A + VFO B shown by default)<br />
                                <strong>FTdx101D:</strong> 100W output, dual receivers (VFO A + VFO B shown by default)<br />
                                <strong>FTdx10:</strong> 100W output, single receiver (VFO B for split/memory)<br />
                                <strong>FT-710:</strong> 100W output, single receiver (VFO B for split/memory)<br />
                                <strong>FTDX3000:</strong> 100W output, single receiver, SDR IF output available (9 MHz)
                            </div>
                            <span asp-validation-for="Settings.RadioModel" class="text-danger"></span>
                        </div>
                        <div class="mb-3" id="optionalFiltersSection">
                            <label class="form-label fw-bold">Roofing Filters Installed</label>
                            <div id="filtersMpNote" style="display:@(Model.Settings.RadioModel == "FTdx101MP" ? "block" : "none")">
                                <div class="alert alert-info py-2 mb-0">
                                    The FTdx101MP comes with all roofing filters fitted as standard: 12 kHz, 3 kHz, 1.2 kHz, 600 Hz, and 300 Hz. No configuration is needed.
                                </div>
                            </div>
                            <div id="filtersDSection" style="display:@(Model.Settings.RadioModel == "FTdx101D" ? "block" : "none")">
                                <div class="form-text mb-2">
                                    The FTdx101D comes with 12 kHz, 3 kHz, and 600 Hz fitted as standard.
                                    Tick any optional filters you have installed so the app only shows filters that are actually available.
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="filter8" name="Settings.InstalledRoofingFilters" value="8"
                                           @(Model.Settings.InstalledRoofingFilters.Contains("8") ? "checked" : "") />
                                    <label class="form-check-label" for="filter8">1.2 kHz (optional)</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="filterA" name="Settings.InstalledRoofingFilters" value="A"
                                           @(Model.Settings.InstalledRoofingFilters.Contains("A") ? "checked" : "") />
                                    <label class="form-check-label" for="filterA">300 Hz (optional)</label>
                                </div>
                                <div class="form-text text-muted mt-1">
                                    12 kHz, 3 kHz, and 600 Hz are always shown (standard on FTdx101D).
                                </div>
                            </div>
                            <div id="filtersFtdx10Section" style="display:@(Model.Settings.RadioModel == "FTdx10" ? "block" : "none")">
                                <div class="alert alert-info py-2 mb-2">
                                    The FTdx10 selects its roofing filter automatically — there is no CAT command to control it.
                                    The radio switches to the appropriate filter based on DSP bandwidth and mode.
                                    Tick any optional filters you have installed for your own reference.
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="filter4" name="Settings.InstalledRoofingFilters" value="4"
                                           @(Model.Settings.InstalledRoofingFilters.Contains("4") ? "checked" : "") />
                                    <label class="form-check-label" for="filter4">1.2 kHz installed (optional — YF-130CN)</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="filter5" name="Settings.InstalledRoofingFilters" value="5"
                                           @(Model.Settings.InstalledRoofingFilters.Contains("5") ? "checked" : "") />
                                    <label class="form-check-label" for="filter5">300 Hz installed (optional — YF-130CW)</label>
                                </div>
                            </div>
                            <div id="filtersFt710Section" style="display:@(Model.Settings.RadioModel == "FT-710" ? "block" : "none")">
                                <div class="alert alert-info py-2 mb-0">
                                    The FT-710 has no roofing filter CAT command — the radio selects its filter
                                    automatically based on DSP bandwidth and mode. No configuration is needed.
                                </div>
                            </div>
                            <div id="filtersFtdx3000Section" style="display:@(Model.Settings.RadioModel == "FTDX3000" ? "block" : "none")">
                                <div class="form-text mb-2">
                                    The FTDX3000 roofing filters are selectable via CAT. AUTO, 15 kHz, 6 kHz, and 3 kHz
                                    are fitted as standard. Tick any optional filters you have installed.
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="filter3k4" name="Settings.InstalledRoofingFilters" value="4"
                                           @(Model.Settings.InstalledRoofingFilters.Contains("4") ? "checked" : "") />
                                    <label class="form-check-label" for="filter3k4">600 Hz (optional — YH-77SDE)</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="filter3k5" name="Settings.InstalledRoofingFilters" value="5"
                                           @(Model.Settings.InstalledRoofingFilters.Contains("5") ? "checked" : "") />
                                    <label class="form-check-label" for="filter3k5">300 Hz (optional — YH-77SDE narrow)</label>
                                </div>
                                <div class="form-text text-muted mt-1">AUTO, 15 kHz, 6 kHz, and 3 kHz are always shown.</div>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Settings.SerialPort" class="form-label">Serial Port</label>
                            <input asp-for="Settings.SerialPort" class="form-control" placeholder="COM3" required />
                            <div class="form-text">
                                Enter the COM port where your radio is connected (e.g., COM3, COM4).
                                <br /><strong>Tip:</strong> Check Device Manager to find the correct port.
                            </div>
                            <span asp-validation-for="Settings.SerialPort" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Settings.BaudRate" class="form-label">Baud Rate</label>
                            <select asp-for="Settings.BaudRate" class="form-select">
                                <option value="4800">4800</option>
                                <option value="9600">9600</option>
                                <option value="19200">19200</option>
                                <option value="38400" selected>38400 (Default)</option>
                                <option value="57600">57600</option>
                                <option value="115200">115200</option>
                            </select>
                            <div class="form-text">
                                Select the baud rate configured in your radio.
                                <br /><strong>Default:</strong> 38400 for FT-dx101 Series
                            </div>
                            <span asp-validation-for="Settings.BaudRate" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Settings.BandPlan" class="form-label">Band Plan / IARU Region</label>
                            <select asp-for="Settings.BandPlan" class="form-select">
                                <option value="Region1">IARU Region 1 — Europe, Africa, Middle East (includes 4m)</option>
                                <option value="Region2">IARU Region 2 — Americas (USA FCC Part 97 reference)</option>
                                <option value="Region3">IARU Region 3 — Asia-Pacific</option>
                                <option value="Japan">Japan (JARL band plan)</option>
                            </select>
                            <div class="form-text">
                                Determines the segment frequencies shown in the VFO band dropdowns (CW, FT8, SSB, RTTY).
                                UK is in Region 1; USA, Canada, and South America are in Region 2;
                                Australia, New Zealand, and most of Asia (except Japan) are in Region 3.
                            </div>
                            <span asp-validation-for="Settings.BandPlan" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <h5 class="mb-3">Web Server</h5>
                        <div class="mb-3">
                            <label class="form-label">Network Interface</label>
                            <select asp-for="Settings.WebAddress" class="form-select" id="webAddressSelect">
                                <option value="localhost">localhost (This PC only)</option>
                                <option value="0.0.0.0" selected>All Interfaces (Recommended - works with DHCP and Static IP)</option>
                                @if (Model.NetworkAddresses != null)
                                {
                                    @foreach (var addr in Model.NetworkAddresses)
                                    {
                                        <option value="@addr">@addr (Specific IP)</option>
                                    }
                                }
                            </select>
                            <div class="form-text">
                                <strong>localhost:</strong> Only accessible from this computer<br />
                                <strong>All Interfaces (0.0.0.0):</strong> Best choice - works regardless of DHCP or Static IP<br />
                                <strong>Specific IP:</strong> Bind to a particular network interface
                            </div>
                            <span asp-validation-for="Settings.WebAddress" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Settings.HttpPort" class="form-label">HTTP Port</label>
                            <input asp-for="Settings.HttpPort" type="number" min="1" max="65535" class="form-control" style="max-width: 12em;" />
                            <div class="form-text">
                                Default <strong>8080</strong>. If that port is already used by another program on your PC
                                (Plex, Jenkins, etc.), Yaesu Web Control automatically tries 8081–8089 at startup and uses the first free one.
                                The port actually in use right now is <strong>@Model.CurrentRunningPort</strong>.
                                Pin a specific port here only if you need to override that behaviour (e.g. you always want 9080).
                            </div>
                            <span asp-validation-for="Settings.HttpPort" class="text-danger"></span>
                        </div>
                        <div class="alert alert-warning" role="alert">
                            <i class="bi bi-exclamation-triangle-fill"></i>
                            <strong>Important:</strong> Save Settings and Restart the application after changing web server settings.
                        </div>
                        <div class="alert alert-info" role="alert">
                            <i class="bi bi-app-indicator"></i>
                            <strong>External Applications:</strong> Configure WSJT-X, JTAlert, and Log4OM on the 
                            <a asp-page="/ApplicationSetup" class="alert-link">Application Setup</a> page.
                        </div>
                    </div>
                </div>
        </div>
    </div>
    <!-- SDR Spectrum Display -->
    <div class="card mt-4">
        <div class="card-header bg-dark text-white d-flex align-items-center justify-content-between">
            <h4 class="mb-0"><i class="bi bi-broadcast-pin"></i> SDR Spectrum Display</h4>
            <button type="button" class="btn btn-outline-light btn-sm"
                    data-bs-toggle="modal" data-bs-target="#sdrHelpModal">
                <i class="bi bi-question-circle"></i> Help
            </button>
        </div>
        <div class="card-body">
            <p class="text-muted mb-3">
                Connect your radio's <strong>IF output (RCA)</strong> to an SDR receiver. The spectrum
                display shows the band around your current VFO frequency in real time.
            </p>
            @if (Model.Settings.RadioModel == "FTdx10" || Model.Settings.RadioModel == "FT-710")
            {
                <div class="alert alert-danger border-3" role="alert">
                    <i class="bi bi-exclamation-octagon-fill me-2"></i>
                    <strong>⚠️ Risk of destroying your SDR — @Model.Settings.RadioModel has no IF tap.</strong>
                    Because this radio has no rear-panel IF output, an SDR has to be connected to an antenna port.
                    <strong>Transmitting on that antenna (or any antenna nearby) will deliver enough RF energy
                    into the SDR's front end to damage or destroy it.</strong> Either use a dedicated receive-only
                    antenna for the SDR, fit a coax switch that disconnects the SDR during TX, or fit a
                    transmit/receive RF relay or PIN-diode T/R switch. Do not transmit with the SDR's coax
                    plugged into your TX antenna without one of these protections in place.
                </div>
                <div class="alert alert-warning" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                    <strong>@Model.Settings.RadioModel:</strong> This radio does not have a rear-panel IF output.
                    SDR spectrum display will show absolute RF frequencies from the connected antenna
                    rather than a VFO-centred view. The IF Frequency setting has no effect.
                </div>
            }
            else
            {
                <div class="alert alert-warning" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                    <strong>Safety note:</strong> The SDR is connected to your radio's <strong>IF output</strong>,
                    which is an internal low-level signal — safe during TX. <strong>Never connect the SDR
                    directly to a TX antenna</strong> (or use an antenna very close to one you're transmitting on):
                    the RF energy can destroy the SDR's front end.
                </div>
            }
            <div class="row">
                <div class="col-md-6">
                    <div class="mb-3">
                        <div class="d-flex justify-content-between align-items-end mb-2">
                            <label class="form-label fw-bold mb-0">SDR Devices</label>
                            <button type="button" class="btn btn-outline-secondary btn-sm" id="sdrScanBtn"
                                    onclick="scanSdrDevices()">
                                <i class="bi bi-search"></i> Scan
                            </button>
                        </div>
                        <div class="form-text mb-2">
                            Plug in your SDR(s) before scanning. Each VFO can have its own SDR — the user
                            tells YWC which physical SDR is wired to which VFO's IF output. Leave a slot
                            blank if that VFO has no SDR.
                        </div>

                        <label for="sdrDeviceDropdownA" class="form-label small fw-semibold mb-1">VFO A SDR</label>
                        <select class="form-select form-select-sm mb-1" id="sdrDeviceDropdownA">
                            <option value="">— (none) —</option>
                        </select>
                        <input type="hidden" asp-for="Settings.SdrDeviceKeyA" id="sdrDeviceKeyInput" />
                        <div id="sdrDeviceKeyDisplay" class="font-monospace small text-muted mb-3"></div>

                        <label for="sdrDeviceDropdownB" class="form-label small fw-semibold mb-1">VFO B SDR</label>
                        <select class="form-select form-select-sm mb-1" id="sdrDeviceDropdownB">
                            <option value="">— (none) —</option>
                        </select>
                        <input type="hidden" asp-for="Settings.SdrDeviceKeyB" id="sdrDeviceKeyInputB" />
                        <div id="sdrDeviceKeyDisplayB" class="font-monospace small text-muted"></div>

                        <div id="sdrScanNotes" class="mt-2"></div>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Settings.SdrIfFrequencyHz" class="form-label fw-bold">IF Frequency (Hz)</label>
                        <input asp-for="Settings.SdrIfFrequencyHz" class="form-control" type="number"
                               min="1000000" max="100000000" step="1000" />
                        <div class="form-text">
                            The radio's IF output frequency. <strong>FTdx101 series: 9,000,000 Hz.</strong>
                            ELAD FDM-DUO via USB: set to match the device's IQ centre frequency.
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="mb-3">
                        <label asp-for="Settings.SdrSampleRateHz" class="form-label fw-bold">Sample Rate (Hz) — both VFOs</label>
                        <select asp-for="Settings.SdrSampleRateHz" class="form-select">
                            <option value="62500">62,500 — 62.5 kHz span (narrowest, single-QSO zoom)</option>
                            <option value="125000">125,000 — 125 kHz span (best for 30m / 60m)</option>
                            <option value="250000">250,000 — 250 kHz span</option>
                            <option value="500000">500,000 — 500 kHz span</option>
                            <option value="1024000">1,024,000 — 1 MHz span</option>
                            <option value="2048000">2,048,000 — 2 MHz span (recommended)</option>
                            <option value="2500000">2,500,000 — 2.5 MHz span</option>
                            <option value="3200000">3,200,000 — 3.2 MHz span</option>
                        </select>
                        <div class="form-text">
                            Higher rates give a wider visible span but require more CPU.
                            Not all devices support all rates.
                            <strong>Saving this resets both VFOs</strong> to the chosen rate;
                            use the span buttons above each spectrum on the main page
                            to set each VFO independently afterwards.
                        </div>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Settings.SdrFftSize" class="form-label fw-bold">FFT Size</label>
                        <select asp-for="Settings.SdrFftSize" class="form-select">
                            <option value="512">512 — faster, less frequency resolution</option>
                            <option value="1024">1024 — recommended</option>
                            <option value="2048">2048 — higher resolution, more CPU</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <button type="button" class="btn btn-outline-danger btn-sm"
                                onclick="clearSdrDevice()">
                            <i class="bi bi-x-circle"></i> Disable SDR / Clear Device
                        </button>
                        <div class="form-text">Removes the saved device; the spectrum panel will be hidden.</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- DX Cluster -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h4 class="mb-0"><i class="bi bi-globe2"></i> DX Cluster</h4>
                </div>
                <div class="card-body">
                    <p class="text-muted mb-3">
                        Connect to a DX cluster server to overlay DX spots on the SDR spectrum display.
                        Spots show callsigns at their reported frequencies; click a spot to QSY VFO A to it.
                        Pick any cluster server you have access to — there is no preset default.
                        Cluster servers come and go; if one stops responding, try another. Verified
                        active at the time of writing: <code>dxspider.co.uk:7300</code> (Colin's own
                        regular cluster, recommended starting point), <code>ve7cc.net:23</code>,
                        <code>ei7mre.ath.cx:7300</code>, <code>cluster.f1led.fr:7300</code>,
                        <code>dxfun.com:8000</code>. See the User Manual §6.6 for more, and check
                        the cluster status badge on the spectrum panel for live connection state.
                        The connection is established only after you enable it below.
                    </p>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
