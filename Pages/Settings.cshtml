@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Settings category nav: sidebar pills on lg+, <select> below that.
        // Remembers the active pane in localStorage and the URL hash so Save's
        // RedirectToPage() lands back on the same category.
        (function () {
            var storageKey = 'ywc.settingsTab';
            var list = document.getElementById('settingsTabList');
            var select = document.getElementById('settingsCategorySelect');
            var aliases = {
                dx: 'dx-cluster',
                'remote-audio': 'audio',
                'radio-display': 'display',
                http: 'web',
                cat: 'radio'
            };
            var userMovedTab = false;

            function panes() {
                return document.querySelectorAll('.settings-layout .tab-pane[data-settings-tab]');
            }

            function availableTabs() {
                var ids = [];
                if (!list) return ids;
                list.querySelectorAll('[data-settings-tab]').forEach(function (el) {
                    ids.push(el.getAttribute('data-settings-tab'));
                });
                return ids;
            }

            function resolve(id) {
                if (!id) return null;
                id = String(id).replace(/^#/, '');
                if (aliases[id]) id = aliases[id];
                var avail = availableTabs();
                if (avail.indexOf(id) >= 0) return id;
                return avail[0] || 'radio';
            }

            function paneForInvalid() {
                var form = document.getElementById('settingsForm');
                if (!form) return null;
                var invalid = form.querySelector('.input-validation-error');
                if (!invalid) return null;
                var pane = invalid.closest('.tab-pane');
                return pane && pane.getAttribute('data-settings-tab');
            }

            function desired() {
                var invalidTab = paneForInvalid();
                if (invalidTab) return resolve(invalidTab);
                var hash = (location.hash || '').replace(/^#/, '');
                if (hash) return resolve(hash);
                try {
                    var stored = localStorage.getItem(storageKey);
                    if (stored) return resolve(stored);
                } catch (e) { /* private mode */ }
                return resolve('radio');
            }

            function persist(id) {
                try { localStorage.setItem(storageKey, id); } catch (e) { /* private mode */ }
                var next = '#' + id;
                if ((location.hash || '') !== next && history.replaceState) {
                    history.replaceState(null, '', next);
                }
            }

            function showTab(id) {
                id = resolve(id);
                var btn = list && list.querySelector('[data-settings-tab="' + id + '"]');
                if (btn && window.bootstrap && bootstrap.Tab) {
                    bootstrap.Tab.getOrCreateInstance(btn).show();
                } else {
                    panes().forEach(function (p) {
                        var on = p.getAttribute('data-settings-tab') === id;
                        p.classList.toggle('active', on);
                        p.classList.toggle('show', on);
                    });
                    if (list) {
                        list.querySelectorAll('.nav-link').forEach(function (b) {
                            var on = b.getAttribute('data-settings-tab') === id;
                            b.classList.toggle('active', on);
                            b.setAttribute('aria-selected', on ? 'true' : 'false');
                        });
                    }
                    document.dispatchEvent(new CustomEvent('ywc-settings-tab-shown', { detail: id }));
                }
                if (select && select.value !== id) select.value = id;
                persist(id);
            }

            window.ywcShowSettingsTab = showTab;

            if (list) {
                list.addEventListener('click', function () { userMovedTab = true; });
                list.addEventListener('keydown', function () { userMovedTab = true; });
                list.addEventListener('shown.bs.tab', function (e) {
                    var id = e.target && e.target.getAttribute('data-settings-tab');
                    if (!id) return;
                    if (select) select.value = id;
                    persist(id);
                    document.dispatchEvent(new CustomEvent('ywc-settings-tab-shown', { detail: id }));
                    if (userMovedTab) {
                        var paneId = e.target.getAttribute('aria-controls');
                        var pane = paneId && document.getElementById(paneId);
                        if (pane && typeof pane.focus === 'function') pane.focus({ preventScroll: true });
                    }
                });
            }
            if (select) {
                select.addEventListener('change', function () {
                    userMovedTab = true;
                    showTab(select.value);
                });
            }

            showTab(desired());
        })();
    </script>
    <script>
        // Serial port dropdown — same /api/ports source as Diagnostics
        (function () {
            async function loadSerialPorts() {
                const sel = document.getElementById('Settings_SerialPort');
                if (!sel) return;
                const selected = sel.getAttribute('data-selected') || sel.value || '';
                const selectedKey = selected.toLowerCase();
                try {
                    const res = await fetch('/api/ports');
                    if (!res.ok) throw new Error('HTTP ' + res.status);
                    const data = await res.json();
                    const ports = Array.isArray(data.ports) ? data.ports.slice() : [];
                    ports.sort(function (a, b) {
                        return String(a).localeCompare(String(b), undefined, { numeric: true, sensitivity: 'base' });
                    });

                    const found = ports.some(function (p) { return String(p).toLowerCase() === selectedKey; });

                    sel.innerHTML = '';
                    if (selected && !found) {
                        const missing = document.createElement('option');
                        missing.value = selected;
                        missing.textContent = selected + ' (not currently detected)';
                        missing.selected = true;
                        sel.appendChild(missing);
                    }

                    if (ports.length === 0 && !selected) {
                        const empty = document.createElement('option');
                        empty.value = '';
                        empty.textContent = 'No serial ports detected';
                        sel.appendChild(empty);
                    } else {
                        ports.forEach(function (p) {
                            const opt = document.createElement('option');
                            opt.value = p;
                            opt.textContent = p;
                            if (String(p).toLowerCase() === selectedKey) opt.selected = true;
                            sel.appendChild(opt);
                        });
                    }

                    if (sel.value) sel.setAttribute('data-selected', sel.value);
                } catch (e) {
                    console.warn('Serial port list failed', e);
                    if (!sel.options.length) {
                        const err = document.createElement('option');
                        err.value = selected || '';
                        err.textContent = selected
                            ? selected + ' (list unavailable)'
                            : 'Could not load ports';
                        err.selected = true;
                        sel.appendChild(err);
                    }
                }
            }

            document.getElementById('btnRefreshSerialPorts')?.addEventListener('click', function () {
                const sel = document.getElementById('Settings_SerialPort');
                if (sel?.value) sel.setAttribute('data-selected', sel.value);
                loadSerialPorts();
            });
            loadSerialPorts();
        })();
    </script>
    <script>
        // Remote audio device list + HTTPS certificate generation
        (function () {
            async function loadAudioDevices() {
                const rxSel = document.getElementById('audioRadioRxDevice');
                const txSel = document.getElementById('audioRadioTxDevice');
                if (!rxSel || !txSel) return;
                try {
                    // Always fill the selects — including while a remote-audio
                    // session is live. /api/audio/devices returns the enumerator
                    // cache when PortAudio streams are open (cachedWhileStreaming),
                    // so Settings never triggers a live GetDeviceInfo. Skipping
                    // the fetch left both dropdowns blank on pop-out / refresh
                    // and Save could wipe AudioRadioRxDevice / AudioRadioTxDevice.
                    const res = await fetch('/api/audio/devices');
                    if (!res.ok) throw new Error('HTTP ' + res.status);
                    const data = await res.json();
                    const rxSelected = rxSel.getAttribute('data-selected') || '';
                    const txSelected = txSel.getAttribute('data-selected') || '';
                    // Keys are "{name} [{hostApi}]" so Windows MME/WASAPI/DS/WDM-KS
                    // duplicates stay distinct. Legacy bare-name settings still match.
                    function pickSelectedKey(devices, selected) {
                        if (!selected) return '';
                        const list = devices || [];
                        const exact = list.find(function (d) {
                            return (d.key || d.displayName || d.name) === selected;
                        });
                        if (exact) return exact.key || exact.displayName || exact.name;
                        // Legacy bare name — prefer WASAPI / Core Audio when several match.
                        const byName = list.filter(function (d) { return d.name === selected; });
                        const prefer = byName.find(function (d) { return /WASAPI/i.test(d.hostApiName || ''); })
                            || byName.find(function (d) { return /Core Audio/i.test(d.hostApiName || ''); })
                            || byName[0];
                        return prefer ? (prefer.key || prefer.displayName || prefer.name) : '';
                    }
                    function fillAudioSelect(sel, devices, selected, defaultLabel) {
                        const matchKey = pickSelectedKey(devices, selected);
                        sel.innerHTML = '';
                        const def = document.createElement('option');
                        def.value = '';
                        def.textContent = defaultLabel;
                        if (!selected) def.selected = true;
                        sel.appendChild(def);
                        (devices || []).forEach(function (d) {
                            const key = d.key || d.displayName || d.name;
                            const opt = document.createElement('option');
                            opt.value = key;
                            // Server already sorts likely USB codec names first; mark them in the label.
                            const base = d.displayName || key;
                            opt.textContent = d.likelyRadio ? ('📻 ' + base) : base;
                            if (key === matchKey) opt.selected = true;
                            sel.appendChild(opt);
                        });
                        // Saved key not in the live list — keep it visible so Save doesn't wipe it.
                        if (selected && !matchKey) {
                            const orphan = document.createElement('option');
                            orphan.value = selected;
                            orphan.textContent = selected + ' (not present)';
                            orphan.selected = true;
                            sel.appendChild(orphan);
                        }
                    }
                    fillAudioSelect(rxSel, data.inputs, rxSelected, '(Select radio USB recording…)');
                    fillAudioSelect(txSel, data.outputs, txSelected, '(Select radio USB playback…)');
                } catch (e) {
                    console.warn('Audio device list failed', e);
                }
            }

            async function refreshHttpsInfo() {
                const el = document.getElementById('httpsCertInfo');
                if (!el) return;
                try {
                    const res = await fetch('/api/audio/status');
                    const data = await res.json();
                    el.textContent = data.certificatePresent
                        ? data.certificateInfo
                        : 'No certificate generated yet.';
                } catch (e) {
                    el.textContent = 'Could not read certificate status.';
                }
            }

            document.getElementById('btnRefreshAudioDevices')?.addEventListener('click', loadAudioDevices);

            document.getElementById('btnGenerateHttpsCert')?.addEventListener('click', async function () {
                if (!confirm('Generate a new self-signed certificate? This overwrites any existing one. Restart YWC afterwards if HTTPS is enabled.'))
                    return;
                const san = document.getElementById('Settings_HttpsSanHosts')?.value
                    || document.querySelector('[name="Settings.HttpsSanHosts"]')?.value
                    || '';
                try {
                    const res = await fetch('/api/audio/https/generate', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ sanHosts: san })
                    });
                    const data = await res.json();
                    if (!res.ok) throw new Error(data.error || 'Generate failed');
                    alert('Certificate generated.\n\n' + (data.info || '') + '\n\nSave Settings if you changed HTTPS options, then restart YWC.');
                    refreshHttpsInfo();
                } catch (e) {
                    alert('Certificate generation failed: ' + e.message);
                }
            });

            loadAudioDevices();
            refreshHttpsInfo();
        })();
    </script>
    <script>
        // Must run AFTER _ValidationScriptsPartial so jQuery Validate is present.
        // "Saving…" only when the form will actually POST. Previously the spinner
        // ran even when unobtrusive validation cancelled the post (blank optional
        // fields with implicit [Required]) — looked like a save that "didn't persist".
        (function () {
            var form = document.getElementById('settingsForm');
            var btn = document.getElementById('saveSettingsBtn');
            var icon = document.getElementById('saveSettingsIcon');
            var label = document.getElementById('saveSettingsLabel');
            if (!form || !btn || !icon || !label) return;

            function resetSaveButton() {
                btn.disabled = false;
                icon.className = 'bi bi-save';
                label.textContent = 'Save Settings';
            }

            function markSaving() {
                btn.disabled = true;
                icon.className = 'spinner-border spinner-border-sm';
                label.textContent = 'Saving…';
            }

            function revealFirstInvalid() {
                var invalid = form.querySelector('.input-validation-error, :invalid');
                if (!invalid) return;
                var pane = invalid.closest('.tab-pane');
                var tabId = pane && pane.getAttribute('data-settings-tab');
                if (tabId && typeof window.ywcShowSettingsTab === 'function') {
                    window.ywcShowSettingsTab(tabId);
                }
                invalid.scrollIntoView({ behavior: 'smooth', block: 'center' });
                if (typeof invalid.focus === 'function') invalid.focus();
            }

            if (window.jQuery) {
                var $form = window.jQuery(form);
                $form.on('invalid-form.validate', function () {
                    resetSaveButton();
                    revealFirstInvalid();
                });
                // Only flip the button to Saving… when Validate says the post may proceed.
                $form.on('submit', function (e) {
                    if ($form.data('validator') && !$form.valid()) {
                        e.preventDefault();
                        resetSaveButton();
                        revealFirstInvalid();
                        return;
                    }
                    markSaving();
                });
            } else {
                form.addEventListener('submit', function (e) {
                    if (typeof form.checkValidity === 'function' && !form.checkValidity()) {
                        e.preventDefault();
                        resetSaveButton();
                        revealFirstInvalid();
                        return;
                    }
                    markSaving();
                });
            }

            if (btn.dataset.saveSuccess === '1') {
                setTimeout(function () {
                    icon.className = 'bi bi-save';
                    label.textContent = 'Save Settings';
                }, 3000);
            }
        })();
    </script>
    <script type="module">
        // hwVer (per SDRplay API header) → friendly model name. Kept in sync
        // with the C# HwVerToModel in Services/Sdr/SdrplayDevice.cs.
        const SDRPLAY_HW_VER_NAMES = {
            1: 'RSP1', 2: 'RSP2', 3: 'RSPduo', 4: 'RSPdx', 5: 'RSPdx-R2',
            6: 'RSP1B', 7: 'RSPdxR2', 255: 'RSP1A'
        };

        // Extract serial (and hwVer if present) from an sdrplay:... key.
        // New: "sdrplay:hw6-2405242660" → { hwVer: 6, serial: "2405242660" }
        // Old: "sdrplay:2405242660"      → { hwVer: null, serial: "2405242660" }
        function parseSdrplayKey(key) {
            const body = key.slice('sdrplay:'.length);
            const m = /^hw(\d+)-(.+)$/i.exec(body);
            if (m) return { hwVer: parseInt(m[1], 10), serial: m[2] };
            return { hwVer: null, serial: body };
        }

        // Returns true if either key refers to the same physical device.
        // Handles "old serial-only saved key matches new hwVer-prefixed scan key".
        function sdrplayKeysMatch(a, b) {
            if (!a || !b || !a.startsWith('sdrplay:') || !b.startsWith('sdrplay:')) return false;
            if (a === b) return true;
            const ka = parseSdrplayKey(a), kb = parseSdrplayKey(b);
            return ka.serial === kb.serial;
        }

        // Derives a human-readable label from a saved device key without needing a scan.
        // sdrplay:hw6-2405242660   →  "SDRplay RSP1B (2405242660) [sdrplay]"
        // sdrplay:0000000001       →  "SDRplay (0000000001) [sdrplay]"   (legacy key, no model)
        // driver=rtlsdr,label=Generic RTL2832U,...  →  "Generic RTL2832U [rtlsdr]"
        function keyToLabel(key) {
            if (!key) return '';
            if (key.startsWith('sdrplay:')) {
                const { hwVer, serial } = parseSdrplayKey(key);
                const model = hwVer != null ? (SDRPLAY_HW_VER_NAMES[hwVer] || `hw${hwVer}`) : null;
                return model
                    ? `SDRplay ${model} (${serial}) [sdrplay]`
                    : `SDRplay (${serial}) [sdrplay]`;
            }
            let label = '', driver = '';
            for (const pair of key.split(',')) {
                const eq = pair.indexOf('=');
                if (eq < 1) continue;
                const k = pair.slice(0, eq).trim().toLowerCase();
                const v = pair.slice(eq + 1).trim();
                if (k === 'label')  label  = v;
                if (k === 'driver') driver = v;
            }
            return label ? `${label}${driver ? ' [' + driver + ']' : ''}` : key;
        }

        // ── Dual-SDR device selector (VFO A + VFO B) ─────────────────────────
        //
        // Two dropdowns, each with its own hidden input bound to
        // Settings.SdrDeviceKeyA / SdrDeviceKeyB. One Scan button populates
        // both dropdowns from the same /api/sdr/devices result. Each VFO can
        // independently be set to a device or left as (none) — typical
        // operator has SDR-A wired to the radio's MAIN IF output and may or
        // may not have a second SDR on the SUB IF output.

        // Slot config keyed by VFO label.
        const sdrSlots = {
            A: { dropdownId: 'sdrDeviceDropdownA', inputId: 'sdrDeviceKeyInput',  displayId: 'sdrDeviceKeyDisplay'  },
            B: { dropdownId: 'sdrDeviceDropdownB', inputId: 'sdrDeviceKeyInputB', displayId: 'sdrDeviceKeyDisplayB' },
        };

        function updateDeviceKeyDisplay(slot) {
            const cfg = sdrSlots[slot];
            const key = document.getElementById(cfg.inputId).value;
            const el  = document.getElementById(cfg.displayId);
            el.textContent = key ? `Saved key: ${key}` : '';
        }

        // Initialise both dropdowns from saved keys on page load, then
        // auto-scan so the dropdown for the unconfigured side picks up any
        // available hardware without making the user click Scan again.
        document.addEventListener('DOMContentLoaded', () => {
            for (const slot of ['A', 'B']) {
                const cfg = sdrSlots[slot];
                const savedKey = document.getElementById(cfg.inputId).value;
                if (savedKey) {
                    const dropdown = document.getElementById(cfg.dropdownId);
                    dropdown.innerHTML = '';
                    const noneOpt = document.createElement('option');
                    noneOpt.value = '';
                    noneOpt.textContent = '— (none) —';
                    dropdown.appendChild(noneOpt);
                    const opt = document.createElement('option');
                    opt.value = savedKey;
                    opt.textContent = keyToLabel(savedKey);
                    opt.selected = true;
                    dropdown.appendChild(opt);
                }
                updateDeviceKeyDisplay(slot);

                // Selection change → mirror to the hidden input.
                document.getElementById(cfg.dropdownId).addEventListener('change', function () {
                    document.getElementById(cfg.inputId).value = this.value;
                    updateDeviceKeyDisplay(slot);
                });
            }

            // Kick off an automatic scan so both dropdowns show what's
            // available without the user having to click Scan first. Cheap
            // for SDRplay (sub-second) and surfaces in-use devices via the
            // SdrManager merge in the controller.
            window.scanSdrDevices();
        });

        // Populate BOTH SDR dropdowns from one /api/sdr/devices call. Each
        // dropdown preserves its own selection across re-scans (matched by
        // exact key, or by sdrplayKeysMatch for the legacy→new format jump).
        window.scanSdrDevices = async function () {
            const btn      = document.getElementById('sdrScanBtn');
            const notesDiv = document.getElementById('sdrScanNotes');

            btn.disabled       = true;
            btn.innerHTML      = '<span class="spinner-border spinner-border-sm me-1"></span>Scanning…';
            notesDiv.innerHTML = '';

            try {
                const resp               = await fetch('/api/sdr/devices');
                const { devices, notes } = await resp.json();

                for (const slot of ['A', 'B']) {
                    const cfg      = sdrSlots[slot];
                    const dropdown = document.getElementById(cfg.dropdownId);
                    const savedKey = document.getElementById(cfg.inputId).value;

                    dropdown.innerHTML = '';
                    const noneOpt = document.createElement('option');
                    noneOpt.value       = '';
                    noneOpt.textContent = '— (none) —';
                    dropdown.appendChild(noneOpt);

                    let matched = false;
                    devices.forEach(d => {
                        const opt = document.createElement('option');
                        opt.value       = d.key;
                        // Devices currently held by a running worker get an
                        // "(in use)" suffix so the user understands why we
                        // know about them even though they'd be invisible to
                        // a fresh sdrplay_api_GetDevices call.
                        const suffix = d.inUse ? ' (in use)' : '';
                        opt.textContent = `${d.label} [${d.driver}]${suffix}`;
                        const sameDevice =
                            d.key === savedKey ||
                            sdrplayKeysMatch(d.key, savedKey);
                        if (sameDevice) {
                            opt.selected = true;
                            matched = true;
                            if (d.key !== savedKey) {
                                document.getElementById(cfg.inputId).value = d.key;
                                updateDeviceKeyDisplay(slot);
                            }
                        }
                        dropdown.appendChild(opt);
                    });

                    // Saved key not in scan results AND not surfaced by SdrManager
                    // either — the device is genuinely absent. Append a placeholder
                    // so the user doesn't lose their saved choice silently.
                    if (savedKey && !matched) {
                        const opt = document.createElement('option');
                        opt.value       = savedKey;
                        opt.textContent = `${keyToLabel(savedKey)} (not plugged in)`;
                        opt.selected    = true;
                        dropdown.appendChild(opt);
                    }
                }

                // Show any installation notes returned by the server.
                if (notes && notes.length > 0) {
                    const ul = document.createElement('ul');
                    ul.className = 'mb-0 ps-3';
                    notes.forEach(msg => {
                        const li = document.createElement('li');
                        li.textContent = msg;
                        ul.appendChild(li);
                    });
                    const wrapper = document.createElement('div');
                    wrapper.className = devices.length === 0
                        ? 'alert alert-warning py-2 small'
                        : 'alert alert-info py-2 small';
                    wrapper.appendChild(ul);
                    notesDiv.appendChild(wrapper);
                }

            } catch (e) {
                for (const slot of ['A', 'B']) {
                    document.getElementById(sdrSlots[slot].dropdownId).innerHTML =
                        '<option value="">Error contacting scan API</option>';
                }
            } finally {
                btn.disabled  = false;
                btn.innerHTML = '<i class="bi bi-search"></i> Scan';
            }
        };

        window.clearSdrDevice = function () {
            for (const slot of ['A', 'B']) {
                const cfg = sdrSlots[slot];
                document.getElementById(cfg.inputId).value = '';
                document.getElementById(cfg.dropdownId).innerHTML =
                    '<option value="" selected>— (none) —</option>';
                updateDeviceKeyDisplay(slot);
            }
            document.getElementById('sdrScanNotes').innerHTML = '';
        };

        // DX cluster connection test — POSTs the current Settings-page values
        // (host, port, callsign) to /api/dxcluster/test, which opens a TCP
        // connection, sends the callsign, reads ~10 s of output, and returns
        // the transcript. Result is shown in a Bootstrap modal.
        window.testDxCluster = async function () {
            const host = document.getElementById('Settings_DxClusterHost').value.trim();
            const port = parseInt(document.getElementById('Settings_DxClusterPort').value, 10);
            const callsign = document.getElementById('Settings_DxClusterLoginCallsign').value.trim();

            const statusEl = document.getElementById('dxClusterTestStatus');
            const transcriptEl = document.getElementById('dxClusterTestTranscript');
            statusEl.className = 'alert alert-info';
            statusEl.textContent = `Connecting to ${host}:${port}…  (waits up to ~10 seconds)`;
            transcriptEl.textContent = '';

            const modalEl = document.getElementById('dxClusterTestModal');
            const modal = bootstrap.Modal.getOrCreateInstance(modalEl);
            modal.show();

            const btn = document.getElementById('dxClusterTestBtn');
            // Reset to the "untested" yellow state on every click — so if a
            // previous click left it green, retesting a different host shows
            // visual feedback for the new attempt rather than carrying over
            // a stale result.
            btn.classList.remove('btn-success');
            btn.classList.add('btn-warning');
            btn.innerHTML = '<i class="bi bi-broadcast"></i> Test cluster connection';
            btn.disabled = true;
            try {
                const resp = await fetch('/api/dxcluster/test', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ host, port, loginCallsign: callsign }),
                });
                const r = await resp.json();
                statusEl.className = r.success ? 'alert alert-success' : 'alert alert-danger';
                statusEl.textContent = r.status || (r.success ? 'OK' : 'Failed');
                transcriptEl.textContent = r.transcript || '(no data received)';
                if (r.success) {
                    // Solid green button + checkmark + confirmation text
                    // = unambiguous "this cluster is working". Stays green
                    // until the user clicks the button again.
                    btn.classList.remove('btn-warning');
                    btn.classList.add('btn-success');
                    btn.innerHTML = '<i class="bi bi-check-circle-fill"></i> Cluster connection successful';
                }
            } catch (e) {
                statusEl.className = 'alert alert-danger';
                statusEl.textContent = `Error contacting the test endpoint: ${e.message}`;
            } finally {
                btn.disabled = false;
            }
        };
    </script>
    <script>
        function copyToClipboard(elementId) {
            const element = document.getElementById(elementId);
            const text = element.textContent;
            navigator.clipboard.writeText(text).then(() => {
                // Visual feedback
                const button = event.target.closest('button');
                const originalHTML = button.innerHTML;
                button.innerHTML = '<i class="bi bi-check"></i> Copied!';
                button.classList.remove('btn-outline-primary');
                button.classList.add('btn-success');
                setTimeout(() => {
                    button.innerHTML = originalHTML;
                    button.classList.remove('btn-success');
                    button.classList.add('btn-outline-primary');
                }, 2000);
            }).catch(err => {
                console.error('Failed to copy:', err);
                alert('Failed to copy to clipboard');
            });
        }

        async function testConnection() {
            const btn = event.target;
            const originalHTML = btn.innerHTML;
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Testing...';

            try {
                const response = await fetch('/api/cat/reinitialize', { method: 'POST' });
                const data = await response.json();

                if (data.success) {
                    // Show 'Connected!' briefly, then revert the button so the
                    // user can stay on Settings and continue tweaking. (The
                    // earlier UX redirected to home after success, which made
                    // sense when this button was 'Reinitialize' but is jarring
                    // now that it's a confirmation-only Test Connection.)
                    btn.innerHTML = '<i class="bi bi-check-circle"></i> ' + (data.message || 'Connected!');
                    btn.classList.remove('btn-success');
                    btn.classList.add('btn-info');
                    setTimeout(() => {
                        btn.innerHTML = originalHTML;
                        btn.classList.remove('btn-info');
                        btn.classList.add('btn-success');
                        btn.disabled = false;
                    }, 3000);
                } else {
                    btn.innerHTML = '<i class="bi bi-x-circle"></i> Failed';
                    btn.classList.remove('btn-success');
                    btn.classList.add('btn-danger');
                    alert(data.message || 'Connection failed. Check your settings and radio.');
                    setTimeout(() => {
                        btn.innerHTML = originalHTML;
                        btn.classList.remove('btn-danger');
                        btn.classList.add('btn-success');
                        btn.disabled = false;
                    }, 3000);
                }
            } catch (err) {
                btn.innerHTML = '<i class="bi bi-x-circle"></i> Error';
                btn.classList.add('btn-danger');
                alert('Error testing connection: ' + err.message);
                setTimeout(() => {
                    btn.innerHTML = originalHTML;
                    btn.classList.remove('btn-danger');
                    btn.classList.add('btn-success');
                    btn.disabled = false;
                }, 3000);
            }
        }

    </script>
    <script>
