    <script>
        // Save button feedback: "Saving…" the instant the form is submitted
        // (the POST → redirect → reload round trip takes a few seconds, and
        // without this the button just sits there looking unresponsive),
        // then "Saved ✓" on the reloaded page after a successful save,
        // reverting back to normal after a few seconds. #65 follow-up.
        (function () {
            var form = document.getElementById('settingsForm');
            var btn = document.getElementById('saveSettingsBtn');
            var icon = document.getElementById('saveSettingsIcon');
            var label = document.getElementById('saveSettingsLabel');
            if (!form || !btn || !icon || !label) return;

            form.addEventListener('submit', function () {
                btn.disabled = true;
                icon.className = 'spinner-border spinner-border-sm';
                label.textContent = 'Saving…';
            });

            if (btn.dataset.saveSuccess === '1') {
                setTimeout(function () {
                    icon.className = 'bi bi-save';
                    label.textContent = 'Save Settings';
                }, 3000);
            }
        })();
    </script>

    <!-- Backup / Restore — outside the main form so the import button doesn't trigger a save -->
    <details class="settings-section" @(ViewContext.ModelState.IsValid ? "" : "open")>
        <summary><i class="bi bi-box-arrow-up" aria-hidden="true"></i>&nbsp;Backup &amp; Restore</summary>
        <div class="section-body">
            <p class="text-muted">
                Download a single zip file containing everything you've customised in YWC — settings, memories, memory banks, calibration, and accessible-label overrides.
                Use it to safeguard your configuration, move to a new PC, or share a setup with another operator.
            </p>
            <div class="d-flex flex-wrap gap-2 align-items-center">
                <a class="btn btn-outline-primary" href="/api/backup/export">
                    <i class="bi bi-download"></i> Export full backup
                </a>
                <label class="btn btn-outline-warning mb-0" for="backupImportFile">
                    <i class="bi bi-upload"></i> Import full backup…
                </label>
                <input type="file" id="backupImportFile" accept="application/zip,.zip" hidden>
                <span id="backupImportStatus" class="ms-2 small"></span>
            </div>
            <p class="text-muted small mt-2 mb-0">
                Import overwrites the matching files in your user-data folder. Each replaced file is kept as a <code>.bak</code> so you can recover.
                After importing, <strong>restart the app</strong> so the radio-connection, DX-cluster, SDR and rigctld services pick up the new values.
                Radio state (live frequency, mode etc.) is not included in the backup — it resets to whatever the radio reports on next connect.
            </p>
        </div>
    </details>
</div>

<script>
    (function () {
        const fileInput = document.getElementById('backupImportFile');
        const statusEl  = document.getElementById('backupImportStatus');
        if (!fileInput) return;
        fileInput.addEventListener('change', async () => {
            if (!fileInput.files || fileInput.files.length === 0) return;
            const file = fileInput.files[0];
            if (!confirm(`Replace YWC's user data with the contents of "${file.name}"?\n\nMatching files in your user-data folder will be overwritten. Each replaced file is kept as a .bak.`)) {
                fileInput.value = '';
                return;
            }
            statusEl.textContent = 'Importing…';
            statusEl.className = 'ms-2 small text-muted';
            const fd = new FormData();
            fd.append('file', file);
            try {
                const r = await fetch('/api/backup/import', { method: 'POST', body: fd });
                const data = await r.json().catch(() => ({}));
                if (!r.ok) {
                    statusEl.textContent = `Import failed: ${data.error || r.statusText}`;
                    statusEl.className = 'ms-2 small text-danger';
                    return;
                }
                statusEl.textContent = `Imported ${data.restored} file${data.restored === 1 ? '' : 's'}. Please restart the app.`;
                statusEl.className = 'ms-2 small text-success';
                alert(data.message || 'Backup imported. Restart the app for all changes to take effect.');
            } catch (e) {
                statusEl.textContent = `Import failed: ${e.message}`;
                statusEl.className = 'ms-2 small text-danger';
            } finally {
                fileInput.value = '';
            }
        });
    })();
</script>

<!-- SDR Help Modal -->
