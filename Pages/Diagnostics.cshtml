@page "/Diagnostics"
@model Yaesu_Web_Control.Pages.DiagnosticsModel
@{
    ViewData["Title"] = "Diagnostics";
}

<h1 class="mb-3">Diagnostics</h1>

<div class="alert alert-info py-2">
    <div class="d-flex align-items-center gap-2 flex-wrap mb-1">
        <button type="button" id="diag-mark-log" class="btn btn-sm btn-outline-primary">
            <i class="bi bi-flag" aria-hidden="true"></i> Start fresh test log
        </button>
        <a href="/api/diagnostics/log" class="btn btn-sm btn-primary" download>
            <i class="bi bi-download" aria-hidden="true"></i> Download test log
        </a>
        <span id="diag-mark-result" class="small text-success" role="status"></span>
    </div>
    <div class="small">
        If I've asked you for a log: click <strong>Start fresh test log</strong>, do the test on the radio, then
        <strong>Download test log</strong> — you'll get just that test's log. Drag the downloaded file straight into the
        GitHub issue or discussion to attach it. (Need everything? <a href="/api/diagnostics/log?full=true" download>Download the full log</a>.)
    </div>
</div>

<div class="d-flex align-items-center gap-3 mb-2 flex-wrap">
    <span>SignalR: <span id="diag-status" class="badge bg-secondary">Connecting&hellip;</span></span>
    <button type="button" id="diag-toggle-ports" class="btn btn-sm btn-outline-secondary"
            aria-expanded="false" aria-controls="diag-ports-panel">COM Ports</button>
    <button type="button" id="diag-toggle-cat" class="btn btn-sm btn-outline-secondary"
            aria-expanded="false" aria-controls="diag-cat-panel">CAT Status JSON</button>
    <button type="button" id="diag-toggle-voice" class="btn btn-sm btn-outline-secondary"
            aria-expanded="false" aria-controls="diag-voice-panel">Voice Control Log</button>
</div>

<div id="diag-ports-panel" class="card mb-2" hidden>
    <div class="card-body py-2 d-flex align-items-start gap-3 flex-wrap">
        <div class="flex-grow-1">
            <div class="fw-semibold mb-1">Available COM ports</div>
            <div id="diag-ports-body" class="small text-muted"><em>Loading&hellip;</em></div>
        </div>
        <button type="button" id="diag-ports-refresh" class="btn btn-sm btn-outline-secondary">Refresh</button>
    </div>
</div>

<div id="diag-cat-panel" class="card mb-2" hidden>
    <div class="card-body py-2">
        <div class="d-flex align-items-center justify-content-between mb-1">
            <span class="fw-semibold">CAT status (live snapshot)</span>
            <button type="button" id="diag-cat-refresh" class="btn btn-sm btn-outline-secondary">Refresh</button>
        </div>
        <pre id="diag-cat-body"
             style="max-height:240px;overflow:auto;font-size:12px;background:#1e1e1e;color:#d4d4d4;padding:8px;margin:0"><em style="color:#888">Loading&hellip;</em></pre>
    </div>
</div>

<div id="diag-voice-panel" class="card mb-2" hidden>
    <div class="card-body py-2">
        <div class="d-flex align-items-center justify-content-between mb-1 flex-wrap gap-2">
            <span class="fw-semibold">
                Voice control log <small class="text-muted fw-normal" id="diag-voice-meta">&mdash;</small>
            </span>
            <div class="d-flex gap-2">
                <button type="button" id="diag-voice-refresh" class="btn btn-sm btn-outline-secondary">Refresh</button>
                <button type="button" id="diag-voice-copy" class="btn btn-sm btn-outline-primary">Copy to clipboard</button>
            </div>
        </div>
        <div class="small text-muted mb-1">
            Recent <code>[Voice]</code> and <code>[IntentDispatcher]</code> entries from today's YWC log,
            filtered server-side. Use the <strong>Copy to clipboard</strong> button if you want to paste
            these into a GitHub issue.
        </div>
        <pre id="diag-voice-body"
             style="max-height:320px;overflow:auto;font-size:12px;background:#1e1e1e;color:#d4d4d4;padding:8px;margin:0"><em style="color:#888">Click <strong>Voice Control Log</strong> above to load&hellip;</em></pre>
    </div>
</div>

<div class="alert alert-secondary py-2 mb-3 small">
    <strong>Capture workflow:</strong> set filters &rarr; press <strong>Start</strong> &rarr; do the test on the radio &rarr; press <strong>Stop</strong> &rarr; <strong>Save&hellip;</strong> to download. The log only fills while capturing.
</div>

<div class="row g-3">

    <!-- Live meter readings -->
    <div class="col-xl-5">
        <div class="card">
            <div class="card-header fw-semibold">Live Meter Readings <small class="text-muted fw-normal">(raw 0–255, as received from radio)</small></div>
            <div class="card-body p-0">
                <table class="table table-sm table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Meter</th>
                            <th>CAT</th>
                            <th class="text-end">Raw value</th>
                            <th class="text-end">Updated</th>
                        </tr>
                    </thead>
                    <tbody id="diag-meter-tbody"></tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Event log -->
    <div class="col-xl-7">
        <div class="card">
            <div class="card-header fw-semibold d-flex justify-content-between align-items-center flex-wrap gap-2">
                <span>
                    SignalR Event Log
                    <span id="diag-capture-indicator" class="ms-2 small fw-normal text-muted">Idle &mdash; 0 events</span>
                </span>
                <div class="d-flex gap-2 align-items-center flex-wrap">
                    <select id="diag-filter" class="form-select form-select-sm" style="width:auto"
                            aria-label="Filter event log by exact property name">
                        <optgroup label="All / common">
                            <option value="">All properties</option>
                            <option value="__SPLIT_INVESTIGATION__">Split investigation set</option>
                        </optgroup>
                        <optgroup label="Meters">
                            <option value="IsTransmitting">IsTransmitting</option>
                            <option value="SWRMeter">SWRMeter</option>
                            <option value="PowerMeter">PowerMeter</option>
                            <option value="SMeterA">SMeterA</option>
                            <option value="SMeterB">SMeterB</option>
                            <option value="ALCMeter">ALCMeter</option>
                            <option value="CompressionMeter">CompressionMeter</option>
                            <option value="IDDMeter">IDDMeter</option>
                            <option value="VDDMeter">VDDMeter</option>
                            <option value="Temperature">Temperature</option>
                        </optgroup>
                        <optgroup label="VFO state">
                            <option value="SplitMode">SplitMode</option>
                            <option value="TxVfo">TxVfo</option>
                            <option value="FrequencyA">FrequencyA</option>
                            <option value="FrequencyB">FrequencyB</option>
                            <option value="ModeA">ModeA</option>
                            <option value="ModeB">ModeB</option>
                            <option value="BandA">BandA</option>
                            <option value="BandB">BandB</option>
                            <option value="AntennaA">AntennaA</option>
                            <option value="AntennaB">AntennaB</option>
                            <option value="AtuEnabled">AtuEnabled</option>
                            <option value="AtuTuning">AtuTuning</option>
                            <option value="RxClarOn">RxClarOn</option>
                            <option value="TxClarOn">TxClarOn</option>
                        </optgroup>
                    </select>
                    <input id="diag-textfilter" type="text" class="form-control form-control-sm"
                           style="width:140px" placeholder="text filter…"
                           title="Substring match on property name (case-insensitive). Combines with the dropdown (AND)."
                           aria-label="Free-text substring filter on property names" />
                    <button id="diag-startstop" class="btn btn-sm btn-success">Start</button>
                    <button id="diag-clear" class="btn btn-sm btn-outline-secondary">Clear</button>
                    <button id="diag-save" class="btn btn-sm btn-outline-secondary">Save&hellip;</button>
                </div>
            </div>
            <div id="diag-log"
                 style="height:420px;overflow-y:auto;font-family:monospace;font-size:12px;padding:6px;background:#1e1e1e;color:#d4d4d4">
                <em style="color:#888">Waiting for events&hellip;</em>
            </div>
        </div>
    </div>

</div>

@section Scripts {
<script>
(function () {

    // "Start fresh test log" — drops a marker in the Serilog file so the
    // "Download test log" button returns only the lines from here on.
    document.getElementById('diag-mark-log')?.addEventListener('click', async function () {
        const result = document.getElementById('diag-mark-result');
        this.disabled = true;
        try {
            const r = await fetch('/api/diagnostics/log/mark', { method: 'POST' });
            if (result) result.textContent = r.ok
                ? '✓ Fresh capture started — do your test, then Download test log.'
                : 'Could not mark the log.';
        } catch {
            if (result) result.textContent = 'Could not mark the log.';
        } finally {
            this.disabled = false;
        }
    });

    // ── Meter definitions ─────────────────────────────────────────────────────
    const METERS = [
        { property: 'IsTransmitting',   label: 'TX State',       cat: 'TX;'  },
        { property: 'SWRMeter',         label: 'SWR',            cat: 'RM6;' },
        { property: 'PowerMeter',       label: 'Power',          cat: 'RM5;' },
        { property: 'SMeterA',          label: 'S-Meter A',      cat: 'SM0;' },
        { property: 'SMeterB',          label: 'S-Meter B',      cat: 'SM1;' },
        { property: 'ALCMeter',         label: 'ALC',            cat: 'RM4;' },
        { property: 'CompressionMeter', label: 'Compression',    cat: 'RM3;' },
        { property: 'IDDMeter',         label: 'IDD',            cat: 'RM7;' },
        { property: 'VDDMeter',         label: 'VDD',            cat: 'RM8;' },
        { property: 'Temperature',      label: 'Temp (PA)',      cat: 'RM9;' },
        { property: 'FrequencyA',       label: 'Freq A (Hz)',    cat: 'FA;'  },
        { property: 'FrequencyB',       label: 'Freq B (Hz)',    cat: 'FB;'  },
    ];

    // ── Build meter table ─────────────────────────────────────────────────────
    const tbody  = document.getElementById('diag-meter-tbody');
    const rowMap = {};

    METERS.forEach(m => {
        const tr = document.createElement('tr');
        tr.innerHTML =
            `<td>${m.label}</td>` +
            `<td><code>${m.cat}</code></td>` +
            `<td class="text-end fw-bold" id="dv-${m.property}" style="min-width:80px">—</td>` +
            `<td class="text-end text-muted small" id="dt-${m.property}" style="min-width:72px">—</td>`;
        tbody.appendChild(tr);
        rowMap[m.property] = tr;
    });

    function updateMeterRow(property, value) {
        const valEl  = document.getElementById(`dv-${property}`);
        const timeEl = document.getElementById(`dt-${property}`);
        if (!valEl) return;

        valEl.textContent = String(value);

        // Colour TX state
        if (property === 'IsTransmitting') {
            valEl.style.color = value ? '#22c55e' : '#ef4444';
        }
        // Flag high SWR raw values
        else if (property === 'SWRMeter') {
            valEl.style.color = (typeof value === 'number' && value > 20) ? '#f97316' : '';
        }

        // Flash row
        const tr = rowMap[property];
        if (tr) {
            tr.style.backgroundColor = '#fef9c3';
            setTimeout(() => { tr.style.backgroundColor = ''; }, 400);
        }

        if (timeEl) {
            const n = new Date();
            timeEl.textContent = n.toTimeString().substring(0, 8);
        }
    }

    // ── Event log ─────────────────────────────────────────────────────────────
    const logDiv   = document.getElementById('diag-log');
    // Buffer cap. At ~30 events/sec of meter polling, 2 000 entries roll
    // over in ~1 minute, which displaces the rare events (like SplitMode
    // or TxVfo changes) that the user is actively filtering for. 10 000
    // gives ~5 minutes of unfiltered headroom while still bounding memory.
    // When a filter is active addEntry pre-filters, so the buffer fills
    // only with matching events and effectively never rolls over for the
    // duration of any realistic investigation.
    const MAX_LOG  = 10000;
    let   entries    = [];
    let   capturing  = false;
    let   filter     = '';
    let   textFilter = '';

    const indicator = document.getElementById('diag-capture-indicator');
    function refreshIndicator() {
        const n = entries.length;
        indicator.textContent = (capturing ? 'Recording ● — ' : 'Idle — ')
            + n + ' event' + (n === 1 ? '' : 's');
        indicator.style.color = capturing ? '#dc3545' : '';
    }

    // Preset: "Split investigation set" — the minimal set of properties
    // that actually fire during split toggle and A<->B swap, plus
    // IsTransmitting to confirm which VFO keyed during a test transmit.
    const SPLIT_INVESTIGATION_PROPS = new Set([
        'SplitMode', 'TxVfo',
        'FrequencyA', 'FrequencyB',
        'ModeA', 'ModeB',
        'IsTransmitting'
    ]);

    function matchesFilter(entry) {
        // Dropdown match (exact, or preset group)
        if (filter === '__SPLIT_INVESTIGATION__') {
            if (!SPLIT_INVESTIGATION_PROPS.has(entry.property)) return false;
        } else if (filter && entry.property !== filter) {
            return false;
        }
        // Free-text substring match (case-insensitive). ANDed with the dropdown.
        if (textFilter && !entry.property.toLowerCase().includes(textFilter)) {
            return false;
        }
        return true;
    }

    document.getElementById('diag-filter').addEventListener('change', function () {
        filter = this.value;
        renderLog();
    });

    document.getElementById('diag-textfilter').addEventListener('input', function () {
        textFilter = this.value.trim().toLowerCase();
        renderLog();
    });

    const startStopBtn = document.getElementById('diag-startstop');
    startStopBtn.addEventListener('click', function () {
        capturing = !capturing;
        this.textContent = capturing ? 'Stop' : 'Start';
        this.className   = capturing
            ? 'btn btn-sm btn-danger'
            : 'btn btn-sm btn-success';
        refreshIndicator();
    });

    document.getElementById('diag-clear').addEventListener('click', function () {
        entries = [];
        renderLog();
        refreshIndicator();
    });

    document.getElementById('diag-save').addEventListener('click', function () {
        // Save what's currently visible (i.e. honour both filters), so the
        // "Split investigation" capture exported from this button matches
        // exactly what's on screen.
        const source = (filter || textFilter) ? entries.filter(matchesFilter) : entries;
        const text = source
            .map(e => `${e.time}\t${e.property}\t${JSON.stringify(e.value)}`)
            .join('\n');
        const blob = new Blob([text], { type: 'text/plain' });
        const a    = document.createElement('a');
        a.href     = URL.createObjectURL(blob);
        a.download = `diag-${new Date().toISOString().replace(/[:.]/g,'-')}.txt`;
        a.click();
    });

    function ts() {
        const n = new Date();
        return n.toTimeString().substring(0, 8) + '.' +
               String(n.getMilliseconds()).padStart(3, '0');
    }

    function rowColor(property, value) {
        if (property === 'IsTransmitting') return value ? '#22c55e' : '#ef4444';
        if (property === 'SWRMeter' && typeof value === 'number' && value > 20)
            return '#f97316';
        return '#d4d4d4';
    }

    function renderLog() {
        const visible = (filter || textFilter)
            ? entries.filter(matchesFilter)
            : entries;

        if (visible.length === 0) {
            logDiv.innerHTML = '<em style="color:#888">No events.</em>';
            return;
        }

        const atBottom = logDiv.scrollHeight - logDiv.scrollTop - logDiv.clientHeight < 40;

        logDiv.innerHTML = visible.map(e =>
            `<div>` +
            `<span style="color:#666">${e.time}</span> ` +
            `<span style="color:#9cdcfe;display:inline-block;width:190px">${e.property}</span>` +
            `<span style="color:${rowColor(e.property, e.value)}">${JSON.stringify(e.value)}</span>` +
            `</div>`
        ).join('');

        if (atBottom) logDiv.scrollTop = logDiv.scrollHeight;
    }

    // Render throttle. The previous code called renderLog() — which
    // innerHTML's the entire visible event list — on every incoming
    // event. At meter-polling rates (~30 events/sec) the browser spends
    // so much time re-painting the log that UI controls (the filter
    // dropdown, Pause button) become sluggish or unresponsive. This
    // schedules at most one render per ~100 ms (10 Hz), still smooth
    // enough to look live but leaves plenty of idle time for the
    // browser to process clicks and dropdown opens.
    let renderPending = false;
    function scheduleRender() {
        if (renderPending) return;
        renderPending = true;
        setTimeout(() => {
            renderPending = false;
            renderLog();
        }, 100);
    }

    function addEntry(property, value) {
        if (!capturing) return;
        const entry = { time: ts(), property, value };
        // Pre-filter at insert time when a filter is active. Without this,
        // the high-rate meter polls keep pushing rare-but-interesting
        // events (SplitMode, TxVfo, etc.) out of the buffer before the
        // user can inspect them.
        if ((filter || textFilter) && !matchesFilter(entry)) return;
        entries.push(entry);
        if (entries.length > MAX_LOG) entries.shift();
        scheduleRender();
        refreshIndicator();
    }

    // ── SignalR connection ────────────────────────────────────────────────────
    const statusBadge = document.getElementById('diag-status');

    const conn = new signalR.HubConnectionBuilder()
        .withUrl('/radioHub')
        .withAutomaticReconnect()
        .build();

    conn.on('RadioStateUpdate', function (data) {
        let { property, value } = data;

        // PowerMeter is wrapped: { value, isTransmitting }
        if (property === 'PowerMeter' && value !== null && typeof value === 'object') {
            value = value.value;
        }

        updateMeterRow(property, value);
        addEntry(property, value);
    });

    conn.onreconnecting(() => {
        statusBadge.textContent = 'Reconnecting…';
        statusBadge.className   = 'badge bg-warning text-dark';
        addEntry('_connection', 'reconnecting');
    });

    conn.onreconnected(() => {
        statusBadge.textContent = 'Connected';
        statusBadge.className   = 'badge bg-success';
        addEntry('_connection', 'reconnected');
    });

    conn.onclose(() => {
        statusBadge.textContent = 'Disconnected';
        statusBadge.className   = 'badge bg-danger';
        addEntry('_connection', 'closed');
    });

    conn.start()
        .then(() => {
            statusBadge.textContent = 'Connected';
            statusBadge.className   = 'badge bg-success';
        })
        .catch(err => {
            statusBadge.textContent = 'Failed';
            statusBadge.className   = 'badge bg-danger';
            addEntry('_connection', 'failed: ' + err.message);
        });

    // ── COM Ports panel ───────────────────────────────────────────────────────
    const portsPanel = document.getElementById('diag-ports-panel');
    const portsBody  = document.getElementById('diag-ports-body');
    const portsToggle = document.getElementById('diag-toggle-ports');
    let portsLoaded = false;

    async function loadPorts() {
        portsBody.innerHTML = '<em>Loading&hellip;</em>';
        try {
            const r = await fetch('/api/ports');
            const j = await r.json();
            const list = (j.ports && j.ports.length)
                ? j.ports.map(p => `<code class="me-2">${p}</code>`).join('')
                : '<em>No COM ports detected.</em>';
            const com6 = j.com6Present
                ? '<span class="badge bg-success ms-2">COM6 present</span>'
                : '<span class="badge bg-danger ms-2">COM6 not present</span>';
            portsBody.innerHTML = list + com6;
            portsLoaded = true;
        } catch (e) {
            portsBody.innerHTML = '<span class="text-danger">Failed to load: ' + e.message + '</span>';
        }
    }

    portsToggle.addEventListener('click', () => {
        const open = !portsPanel.hidden;
        portsPanel.hidden = open;
        portsToggle.setAttribute('aria-expanded', String(!open));
        if (!open && !portsLoaded) loadPorts();
    });
    document.getElementById('diag-ports-refresh').addEventListener('click', loadPorts);

    // ── CAT Status panel ──────────────────────────────────────────────────────
    const catPanel = document.getElementById('diag-cat-panel');
    const catBody  = document.getElementById('diag-cat-body');
    const catToggle = document.getElementById('diag-toggle-cat');
    let catLoaded = false;

    async function loadCatStatus() {
        catBody.innerHTML = '<em style="color:#888">Loading&hellip;</em>';
        try {
            const r = await fetch('/api/cat/status');
            const j = await r.json();
            catBody.textContent = JSON.stringify(j, null, 2);
            catLoaded = true;
        } catch (e) {
            catBody.innerHTML = '<span style="color:#f87171">Failed to load: ' + e.message + '</span>';
        }
    }

    catToggle.addEventListener('click', () => {
        const open = !catPanel.hidden;
        catPanel.hidden = open;
        catToggle.setAttribute('aria-expanded', String(!open));
        if (!open && !catLoaded) loadCatStatus();
    });
    document.getElementById('diag-cat-refresh').addEventListener('click', loadCatStatus);

    // ── Voice Control Log panel ───────────────────────────────────────────────
    // Reads /api/voice/log which returns recent [Voice] and [IntentDispatcher]
    // entries from today's YWC log, filtered server-side. Designed for bug
    // reporters: open the panel, click Copy to clipboard, paste into an
    // issue. No log-file location knowledge required.
    const voicePanel  = document.getElementById('diag-voice-panel');
    const voiceBody   = document.getElementById('diag-voice-body');
    const voiceMeta   = document.getElementById('diag-voice-meta');
    const voiceToggle = document.getElementById('diag-toggle-voice');
    let voiceLoaded = false;

    async function loadVoiceLog() {
        voiceBody.innerHTML = '<em style="color:#888">Loading&hellip;</em>';
        voiceMeta.textContent = '—';
        try {
            const r = await fetch('/api/voice/log?lines=200');
            const j = await r.json();
            if (!j.lines || j.lines.length === 0) {
                voiceBody.innerHTML = '<em style="color:#888">No voice activity found in '
                    + (j.source ? '<code style="color:#888">' + j.source + '</code>'
                                : 'today\'s log')
                    + '. Try the mic button on the main page, then refresh.</em>';
                voiceMeta.textContent = j.source
                    ? 'from ' + j.source + ' (0 lines)'
                    : 'no log file yet';
                voiceLoaded = true;
                return;
            }
            voiceBody.textContent = j.lines.join('\n');
            voiceMeta.textContent = 'from ' + j.source + ' — '
                + j.returned + ' of ' + j.totalMatched + ' matched';
            voiceLoaded = true;
            // Auto-scroll to bottom so the most recent event is visible.
            voiceBody.scrollTop = voiceBody.scrollHeight;
        } catch (e) {
            voiceBody.innerHTML = '<span style="color:#f87171">Failed to load: ' + e.message + '</span>';
        }
    }

    voiceToggle.addEventListener('click', () => {
        const open = !voicePanel.hidden;
        voicePanel.hidden = open;
        voiceToggle.setAttribute('aria-expanded', String(!open));
        if (!open && !voiceLoaded) loadVoiceLog();
    });
    document.getElementById('diag-voice-refresh').addEventListener('click', loadVoiceLog);

    // Auto-refresh on every voice event so the user doesn't need to remember
    // to press Refresh after each test press. Each PTT generates a small
    // burst (Listening -> Heard -> Executing -> Idle), so we debounce ~500 ms
    // and refresh once when the burst settles. Only refreshes while the
    // panel is visible, to avoid churning the API for users who don't have
    // the log panel open.
    let voiceRefreshDebounce = null;
    function scheduleVoiceRefresh() {
        if (voicePanel.hidden) return;       // panel not visible -- skip
        clearTimeout(voiceRefreshDebounce);
        voiceRefreshDebounce = setTimeout(loadVoiceLog, 500);
    }
    conn.on('VoiceStatusUpdate', scheduleVoiceRefresh);
    document.getElementById('diag-voice-copy').addEventListener('click', async () => {
        const text = voiceBody.textContent || '';
        if (!text.trim()) return;
        try {
            await navigator.clipboard.writeText(text);
            const btn = document.getElementById('diag-voice-copy');
            const orig = btn.textContent;
            btn.textContent = 'Copied!';
            btn.classList.add('btn-success');
            btn.classList.remove('btn-outline-primary');
            setTimeout(() => {
                btn.textContent = orig;
                btn.classList.remove('btn-success');
                btn.classList.add('btn-outline-primary');
            }, 1200);
        } catch (e) {
            alert('Could not copy: ' + e.message);
        }
    });


    refreshIndicator();

})();
</script>
}
