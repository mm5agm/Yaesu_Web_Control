<div id="vfoBCol" class="ywc-vfo ywc-vfo-b" data-ywc-vfo-ui="dock">
    <div class="ywc-vfo-inner">
        <div class="ywc-vfo-toolbar ywc-vfo-toolbar-b ywc-flex-wrap">
            <strong class="ywc-vfo-title" id="receiverBHeading">VFO B</strong>
            <span id="splitTxBadgeB" class="ywc-badge ywc-badge-danger" style="display:none;" aria-live="polite">SPLIT TX</span>
            <button type="button" id="zinBtnB" class="ywc-btn ywc-btn-sm ywc-btn-outline"
                    onclick="cwZeroIn('B')"
                    aria-label="VFO B CW Auto Zero In"
                    title="CW Auto Zero In on VFO B — nudges the VFO so the received CW signal sits at your configured CW pitch">ZIN</button>
            @if (Model.View.HasVcTuneSub) {
            <button type="button" id="vcTuneToggleBtnB" class="ywc-btn ywc-btn-sm ywc-btn-outline"
                    style="display:none"
                    onclick="vcTuneToggle('b')"
                    aria-label="SUB VC Tune on/off"
                    title="Toggle SUB VC Tune preselector on/off">VC Tune</button>
            <span id="vcTuneRowB" class="ywc-vfo-vctune ywc-flex" style="display:none !important;">
                <button id="vcTuneDefaultBtnB" class="ywc-btn ywc-btn-sm ywc-btn-outline"
                        onclick="vcTuneCommand('b','default')"
                        aria-label="SUB VC Tune default" title="SUB VC Tune auto-tune">Default</button>
                <button class="ywc-btn ywc-btn-sm ywc-btn-outline"
                        onclick="vcTuneStep('b','minus')"
                        aria-label="SUB VC Tune step down" title="Step SUB preselector capacitor down">−</button>
                <select id="vcTuneStepB" class="ywc-select ywc-vfo-vctune-step"
                        aria-label="SUB VC Tune step size" title="Step size (1–9)">
                    <option value="1">1</option><option value="2">2</option><option value="3">3</option>
                    <option value="4">4</option><option value="5" selected>5</option><option value="6">6</option>
                    <option value="7">7</option><option value="8">8</option><option value="9">9</option>
                </select>
                <button class="ywc-btn ywc-btn-sm ywc-btn-outline"
                        onclick="vcTuneStep('b','plus')"
                        aria-label="SUB VC Tune step up" title="Step SUB preselector capacitor up">+</button>
                <button id="vcTuneCenterBtnB" class="ywc-btn ywc-btn-sm ywc-btn-outline"
                        onclick="vcTuneCommand('b','center')"
                        aria-label="SUB VC Tune center" title="Center SUB preselector capacitor">Center</button>
                <span id="vcTuneMeterB" class="ywc-vfo-muted">P5: —</span>
                <span id="vcTuneWarnB" class="ywc-vfo-warn" style="display:none;"></span>
            </span>
            }
            <button id="txButtonB" class="ywc-btn ywc-btn-sm ywc-btn-warning" style="display:none;"
                    onclick="toggleTx()" title="Toggle Transmit" aria-label="Toggle Transmit">TX</button>
        </div>

        <div class="ywc-vfo-body">
            <div class="ywc-vfo-controls-group">
                <div class="ywc-vfo-mem">
                    <button id="saveMemBtnB" type="button"
                            class="ywc-btn ywc-btn-sm ywc-btn-outline"
                            onclick="saveVfoToMemory('B')"
                            aria-label="Save VFO B to memories"
                            title="Save VFO B frequency, mode and clarifier to app memories">
                        Save to Mem
                    </button>
                    <span id="saveMemStatusB" class="visually-hidden" role="status" aria-live="polite"></span>
                </div>

                <div class="ywc-vfo-bands">
                    @await Html.PartialAsync("_BandButtonsPartial", Tuple.Create("unused", "B", Model.SelectedBandB))
                    <div class="ywc-vfo-mode-row ywc-flex">
                        <label class="ywc-vfo-label" for="modeSelectB">Mode</label>
                        <select class="ywc-select vfo-mode-select" id="modeSelectB"
                                aria-label="VFO B mode"
                                title="VFO B mode"
                                onchange="setMode('B', this.value)">
                            @foreach (var mode in Model.View.AllModes)
                            {
                                @if (Model.RadioState.ModeB == mode)
                                {
                                    <option value="@mode" selected>@DockViewState.ModeLabel(mode)</option>
                                }
                                else
                                {
                                    <option value="@mode">@DockViewState.ModeLabel(mode)</option>
                                }
                            }
                        </select>
                        @if (Model.View.HasAntennaSelector)
                        {
                            <select class="ywc-select vfo-ant-select" id="antennaSelectB"
                                    aria-label="VFO B antenna"
                                    title="VFO B antenna"
                                    onchange="window.radioControl.setAntenna('B', this.value)">
                                @foreach (var ant in new[] { "1", "2", "3" })
                                {
                                    @if (Model.RadioState.AntennaB == ant)
                                    {
                                        <option value="@ant" selected>ANT @ant</option>
                                    }
                                    else
                                    {
                                        <option value="@ant">ANT @ant</option>
                                    }
                                }
                            </select>
                        }
                    </div>
                </div>

                @if (!Model.View.IsSingleReceiver)
                {
                <div class="ywc-vfo-voice" id="voiceMicContainerB" style="display:none;">
                    <div class="ywc-flex">
                        <select id="voiceNudgeStepSelectB"
                                class="ywc-select ywc-vfo-voice-step"
                                title="Voice nudge step size — how far 'tune up'/'tune down' moves VFO B"
                                aria-label="VFO B voice nudge step size">
                            <option value="10">10 Hz</option>
                            <option value="100">100 Hz</option>
                            <option value="1000">1 kHz</option>
                            <option value="10000">10 kHz</option>
                            <option value="100000">100 kHz</option>
                        </select>
                        <button id="voiceMicBtnB" type="button"
                                class="ywc-btn ywc-btn-outline ywc-btn-danger voice-mic-btn"
                                title="Hold to give a VFO B voice command (right-click for the command list)"
                                aria-label="Voice command VFO B — hold to speak">
                            <span class="ywc-vfo-mic-icon" aria-hidden="true">🎤</span>
                        </button>
                    </div>
                    <div id="voiceLastHeardB" class="ywc-vfo-voice-heard" aria-live="polite"></div>
                </div>
                }

                <div class="ywc-vfo-scope" id="filterScopeContainerB">
                    <canvas id="filterScopeCanvasB" role="img" aria-hidden="true"
                            aria-label="VFO B filter display" data-a11y-key="filter.scopeB"></canvas>
                </div>

                <div class="vfo-controls-column ywc-vfo-grid">
                    <div class="vfo-control-item">
                        <label class="ywc-vfo-label">AGC</label>
                        <select class="ywc-select" id="agcSelectB"
                                aria-label="VFO B AGC"
                                title="VFO B AGC"
                                onchange="window.radioControl.setAgc('B', this.value)">
                            <option value="0" selected="@(Model.RadioState.AgcB == "0" ? "selected" : null)">OFF</option>
                            <option value="1" selected="@(Model.RadioState.AgcB == "1" ? "selected" : null)">FAST</option>
                            <option value="2" selected="@(Model.RadioState.AgcB == "2" ? "selected" : null)">MID</option>
                            <option value="3" selected="@(Model.RadioState.AgcB == "3" ? "selected" : null)">SLOW</option>
                            <option value="4" selected="@(Model.RadioState.AgcB == "4" ? "selected" : null)">AUTO</option>
                        </select>
                    </div>
                    <div class="vfo-control-item">
                        <label class="ywc-vfo-label">IPO/AMP</label>
                        <select class="ywc-select" id="ipoSelectB"
                                aria-label="VFO B IPO amp"
                                title="VFO B IPO / amplifier"
                                onchange="window.radioControl.setIpo('B', this.value)">
                            <option value="0" selected="@(Model.RadioState.IpoB == "0" ? "selected" : null)">IPO</option>
                            <option value="1" selected="@(Model.RadioState.IpoB == "1" ? "selected" : null)">AMP1</option>
                            <option value="2" selected="@(Model.RadioState.IpoB == "2" ? "selected" : null)">AMP2</option>
                        </select>
                    </div>
                    <div class="vfo-control-item">
                        <label class="ywc-vfo-label">ATT</label>
                        <select class="ywc-select" id="attSelectB"
                                aria-label="VFO B attenuator"
                                title="VFO B attenuator"
                                onchange="window.radioControl.setAttenuator('B', this.value)">
                            <option value="00" selected="@(Model.RadioState.AttB == "00" ? "selected" : null)">OFF</option>
                            <option value="06" selected="@(Model.RadioState.AttB == "06" ? "selected" : null)">6 dB</option>
                            <option value="12" selected="@(Model.RadioState.AttB == "12" ? "selected" : null)">12 dB</option>
                            <option value="18" selected="@(Model.RadioState.AttB == "18" ? "selected" : null)">18 dB</option>
                        </select>
                    </div>
                    <div class="vfo-control-item">
                        <label class="ywc-vfo-label">@(Model.View.IsFtdx10 || Model.View.IsFt710 ? "DNR" : "NR")</label>
                        <select class="ywc-select" id="nrSelectB"
                                aria-label="VFO B @(Model.View.IsFtdx10 || Model.View.IsFt710 ? "digital noise reduction" : "noise reduction")"
                                title="VFO B @(Model.View.IsFtdx10 || Model.View.IsFt710 ? "digital noise reduction" : "noise reduction")"
                                onchange="window.radioControl.setNr('B', this.value)">
                            <option value="0" selected="@(Model.RadioState.NrB == "0" ? "selected" : null)">OFF</option>
                            @if (Model.View.IsFtdx10 || Model.View.IsFt710)
                            {
                                <option value="1" selected="@(Model.RadioState.NrB == "1" ? "selected" : null)">ON</option>
                            }
                            else
                            {
                                <option value="1" selected="@(Model.RadioState.NrB == "1" ? "selected" : null)">NR1</option>
                                <option value="2" selected="@(Model.RadioState.NrB == "2" ? "selected" : null)">NR2</option>
                            }
                        </select>
                    </div>
                    <div class="vfo-control-item">
                        <label class="ywc-vfo-label">@(Model.View.IsFtdx10 || Model.View.IsFt710 ? "DNR No." : "NR Lvl")</label>
                        <select class="ywc-select" id="nrLevelSelectB"
                                aria-label="VFO B @(Model.View.IsFtdx10 || Model.View.IsFt710 ? "DNR algorithm" : "NR level") (1-15)"
                                title="VFO B @(Model.View.IsFtdx10 || Model.View.IsFt710 ? "DNR algorithm (1=lightest, 15=heaviest)" : "NR depth (1=light, 15=heavy)")"
                                onchange="setNrLevel('B', this.value)">
                            @for (int i = 1; i <= 15; i++) {
                                <option value="@i" selected="@(Model.RadioState.NrLevelB == i ? "selected" : null)">@i</option>
                            }
                        </select>
                    </div>
                    <div class="vfo-control-item">
                        <label class="ywc-vfo-label">NB</label>
                        <select class="ywc-select" id="nbSelectB"
                                aria-label="VFO B noise blanker"
                                title="VFO B noise blanker"
                                onchange="window.radioControl.setNoiseBlanker('B', this.value)">
                            <option value="0" selected="@(Model.RadioState.NbB == "0" ? "selected" : null)">OFF</option>
                            <option value="1" selected="@(Model.RadioState.NbB == "1" ? "selected" : null)">ON</option>
                        </select>
                    </div>
                    <div class="vfo-control-item">
                        <label class="ywc-vfo-label">NB Level</label>
                        <select class="ywc-select" id="nbLevelSelectB"
                                aria-label="VFO B noise blanker level"
                                title="VFO B noise blanker depth (1=min, 20=max)"
                                onchange="setNbLevel('B', this.value)">
                            @for (int i = 1; i <= 20; i++) {
                                <option value="@i" selected="@(Model.RadioState.NbLevelB == i ? "selected" : null)">@i</option>
                            }
                        </select>
                    </div>
                    <div class="vfo-control-item">
                        <label class="ywc-vfo-label">Auto Notch</label>
                        <select class="ywc-select" id="autoNotchSelectB"
                                aria-label="VFO B auto notch"
                                title="VFO B auto notch"
                                onchange="window.radioControl.setAutoNotch('B', this.value)">
                            <option value="0" selected="@(Model.RadioState.AutoNotchB == "0" ? "selected" : null)">OFF</option>
                            <option value="1" selected="@(Model.RadioState.AutoNotchB == "1" ? "selected" : null)">ON</option>
                        </select>
                    </div>
                    <div class="vfo-control-item">
                        <label class="ywc-vfo-label">Man Notch</label>
                        <select class="ywc-select" id="manualNotchSelectB"
                                aria-label="VFO B manual notch"
                                title="VFO B manual notch"
                                onchange="window.radioControl.setManualNotch('B', this.value)">
                            <option value="0" selected="@(Model.RadioState.ManualNotchB == "0" ? "selected" : null)">OFF</option>
                            <option value="1" selected="@(Model.RadioState.ManualNotchB == "1" ? "selected" : null)">ON</option>
                        </select>
                    </div>
                    <div class="vfo-control-item ywc-vfo-span">
                        <label class="ywc-vfo-label">Notch Hz</label>
                        <input type="range" class="ywc-range" id="manualNotchFreqB"
                               aria-label="VFO B manual notch frequency" title="VFO B manual notch frequency"
                               min="10" max="3200" step="10" value="@Model.RadioState.ManualNotchFreqB"
                               oninput="document.getElementById('manualNotchFreqValueB').textContent = this.value + ' Hz'; window.radioControl.setManualNotchFreq('B', this.value)">
                        <span id="manualNotchFreqValueB" class="ywc-vfo-val">@Model.RadioState.ManualNotchFreqB Hz</span>
                    </div>
                    <div class="vfo-control-item ywc-vfo-span">
                        <label class="ywc-vfo-label">RF Gain</label>
                        <input type="range" class="ywc-range" id="rfGainSliderB"
                               aria-label="VFO B RF gain" title="VFO B RF gain (0=min, 255=max)"
                               min="0" max="255" step="1" value="@Model.RadioState.RfGainB"
                               oninput="document.getElementById('rfGainValueB').textContent = this.value"
                               onchange="setRfGain('B', this.value)">
                        <span id="rfGainValueB" class="ywc-vfo-val">@Model.RadioState.RfGainB</span>
                    </div>
                    <div class="vfo-control-item ywc-vfo-span" id="squelchRowB" style="display:none;">
                        <label class="ywc-vfo-label">Squelch</label>
                        <input type="range" class="ywc-range" id="squelchSliderB"
                               aria-label="VFO B squelch" title="VFO B squelch level (0=open, 255=max)"
                               min="0" max="255" step="1" value="@Model.RadioState.SquelchB"
                               oninput="document.getElementById('squelchValueB').textContent = this.value"
                               onchange="setSquelch('B', this.value)">
                        <span id="squelchValueB" class="ywc-vfo-val">@Model.RadioState.SquelchB</span>
                    </div>
                </div>
            </div>

            <div class="ywc-vfo-row ywc-flex-wrap">
                <span class="ywc-vfo-label">Segment</span>
                <select class="ywc-select segment-select" id="segmentSelectB"
                        aria-label="VFO B band segment"
                        title="VFO B band segment"
                        onchange="window.onSegmentChange && window.onSegmentChange('B', this.value)">
                    <option value="">--</option>
                </select>
                <button type="button" id="contourBtnB"
                        class="ywc-btn ywc-btn-sm @(Model.RadioState.ContourOnB ? "ywc-btn-success" : "ywc-btn-outline")"
                        aria-label="VFO B Contour filter" title="Toggle Contour audio peak filter"
                        onclick="toggleContour('B')">@(Model.RadioState.ContourOnB ? "Contour On" : "Contour Off")</button>
                <input type="range" class="ywc-range ywc-vfo-slider-sm" id="contourFreqSliderB"
                       min="100" max="@Model.View.ContourMaxFreq" step="@Model.View.ContourStep"
                       value="@Model.RadioState.ContourFreqB"
                       oninput="document.getElementById('contourFreqValueB').textContent = this.value + ' Hz'"
                       onchange="setContourFreq('B', parseInt(this.value))"
                       aria-label="VFO B Contour frequency">
                <span id="contourFreqValueB" class="ywc-vfo-val">@(Model.RadioState.ContourFreqB) Hz</span>
                <button type="button" id="apfBtnB"
                        class="ywc-btn ywc-btn-sm @(Model.RadioState.ApfOnB ? "ywc-btn-success" : "ywc-btn-outline")"
                        aria-label="VFO B APF filter" title="Toggle APF audio peak filter (CW)"
                        onclick="toggleApf('B')">@(Model.RadioState.ApfOnB ? "APF On" : "APF Off")</button>
                <input type="range" class="ywc-range ywc-vfo-slider-sm" id="apfFreqSliderB"
                       min="-250" max="250" step="@Model.View.ApfStep"
                       value="@Model.RadioState.ApfFreqB"
                       oninput="document.getElementById('apfFreqValueB').textContent = this.value + ' Hz'"
                       onchange="setApfFreq('B', parseInt(this.value))"
                       aria-label="VFO B APF frequency">
                <span id="apfFreqValueB" class="ywc-vfo-val">@(Model.RadioState.ApfFreqB) Hz</span>
            </div>

            <div class="ywc-vfo-freq-row ywc-flex-wrap">
                <span id="freqB" class="frequency-display digit-display ywc-vfo-freq" role="spinbutton"
                      aria-label="VFO B frequency" title="VFO B frequency" data-a11y-key="vfo.b.frequency"
                      tabindex="0" aria-valuemin="0.03" aria-valuemax="75" aria-valuenow="0"></span>
                <span class="frequency-display digit-display ywc-vfo-freq-unit">MHz</span>
                <div id="freqB-controls" class="freq-step-controls ywc-vfo-freq-steps"
                     style="display:@(Model.ShowFrequencyArrowButtons ? "inline-flex" : "none");">
                    <button type="button" id="freqB-up" class="ywc-btn ywc-btn-sm ywc-btn-secondary"
                            aria-label="Step VFO B selected digit up" title="Step VFO B selected digit up (↑)">▲</button>
                    <button type="button" id="freqB-down" class="ywc-btn ywc-btn-sm ywc-btn-secondary"
                            aria-label="Step VFO B selected digit down" title="Step VFO B selected digit down (↓)">▼</button>
                </div>
                <button class="ywc-btn ywc-btn-sm ywc-btn-outline fkb-open-btn"
                        data-freq-keyboard="B"
                        aria-label="Keyboard — enter VFO B frequency"
                        data-a11y-key="keyboard.openB"
                        title="Keyboard — enter VFO B frequency">
                    <strong>123</strong>
                </button>
                @if (!Model.View.IsFt710)
                {
                <label class="ywc-vfo-label" for="roofingFilterSelectB">Roofing</label>
                <select class="ywc-select" id="roofingFilterSelectB"
                        aria-label="VFO B roofing filter"
                        title="VFO B roofing filter"
                        onchange="window.radioControl.setRoofingFilter('B', this.value)">
                    @if (Model.View.IsFtdx10)
                    {
                        @foreach (var opt in Model.View.RoofingOptionsFtdx10)
                        {
                            <option value="@opt.Value" selected="@(Model.RadioState.RoofingFilterB==opt.Value ? "selected" : null)">@opt.Label</option>
                        }
                    }
                    else if (Model.View.IsFtdx3000)
                    {
                        @foreach (var opt in Model.View.RoofingOptions3000)
                        {
                            <option value="@opt.Value" selected="@(Model.RadioState.RoofingFilterB==opt.Value ? "selected" : null)">@opt.Label</option>
                        }
                    }
                    else
                    {
                        @foreach (var opt in Model.View.RoofingOptions)
                        {
                            <option value="@opt.Value" selected="@(Model.RadioState.RoofingFilterB==opt.Value ? "selected" : null)">@opt.Label</option>
                        }
                    }
                </select>
                }
                <label class="ywc-vfo-label" for="afGainSliderB">AF Gain <span id="afGainValueB" class="ywc-vfo-val">@Model.AfGainB</span></label>
                <input type="range" class="ywc-range ywc-vfo-slider-sm"
                       id="afGainSliderB"
                       aria-label="VFO B AF gain"
                       title="VFO B AF gain"
                       min="0" max="255" step="1" value="@Model.AfGainB"
                       oninput="document.getElementById('afGainValueB').innerText = this.value">
            </div>

            <div class="ywc-vfo-if-row ywc-flex-wrap">
                <label class="ywc-vfo-label" for="ifWidthSelectB">IF Width</label>
                <select class="ywc-select" id="ifWidthSelectB"
                        aria-label="VFO B IF width"
                        title="VFO B IF width"
                        onchange="window.radioControl.setIfWidth('B', this.value)">
                    @foreach (var opt in Model.View.IfWidthOptions)
                    {
                        bool isDefault = string.IsNullOrEmpty(Model.RadioState.IfWidthB) && opt.Value == Model.View.IfWidthDefaultB;
                        <option value="@opt.Value" selected="@(Model.RadioState.IfWidthB==opt.Value||isDefault ? "selected" : null)">@opt.Label</option>
                    }
                </select>
                <button type="button" class="ywc-btn ywc-btn-sm ywc-btn-secondary"
                        id="audioFilterBtnB"
                        aria-label="VFO B Audio Filter"
                        title="Open the Audio Filter dialog for VFO B's current mode (LCUT FREQ, LCUT SLOPE, HCUT FREQ, HCUT SLOPE)"
                        onclick="window.audioFilter && window.audioFilter.open('B')">
                    Audio Filter
                </button>
                <label class="ywc-vfo-label" for="ifShiftSliderB">IF Shift <span id="ifShiftValueB" class="ywc-vfo-val">@Model.RadioState.IfShiftB</span></label>
                <input type="range" class="ywc-range ifshift-slider ywc-vfo-slider-sm"
                       id="ifShiftSliderB"
                       aria-label="VFO B IF shift"
                       title="VFO B IF shift"
                       min="-1000" max="1000" step="20" value="@Model.RadioState.IfShiftB"
                       oninput="document.getElementById('ifShiftValueB').textContent = this.value; if(window.filterScopePanelB) window.filterScopePanelB.setState({ifShiftHz: parseInt(this.value)||0})">
                <button type="button" class="ywc-btn ywc-btn-sm ywc-btn-secondary"
                        onclick="resetIfShift('B')" title="Zero IF Shift">Zero</button>
            </div>

            <div id="vfoBStatusLine"
                 class="ywc-vfo-status ywc-vfo-status-b"
                 aria-live="polite" aria-atomic="true">—</div>
        </div>
    </div>
</div>
