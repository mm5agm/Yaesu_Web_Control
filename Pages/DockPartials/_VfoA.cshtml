        <div class="ywc-vfo-panel" id="vfoACol">
            <div class="ywc-vfo-card receiver-card">
                <div class="ywc-vfo-header">
                    <div class="ywc-flex justify-content-between align-items-center flex-wrap gap-1">
                        <h5 class="mb-0">
                            <span id="receiverAHeading">VFO A</span>
                        </h5>
                        <div class="ywc-flex align-items-center gap-1 flex-wrap">
                            <span id="splitTxBadgeA" class="ywc-badge bg-danger" style="display:none;" aria-live="polite">SPLIT TX</span>
                            <button type="button" id="zinBtnA" class="ywc-btn btn-outline-light btn-sm"
                                    onclick="cwZeroIn('A')"
                                    aria-label="VFO A CW Auto Zero In"
                                    title="CW Auto Zero In on VFO A — nudges the VFO so the received CW signal sits at your configured CW pitch">ZIN</button>
                            @if (Model.View.HasVcTune) {
                            <button type="button" id="vcTuneToggleBtnA" class="ywc-btn btn-outline-light btn-sm"
                                    onclick="vcTuneToggle('a')"
                                    aria-label="MAIN VC Tune on/off"
                                    title="Toggle MAIN VC Tune preselector on/off">VC Tune</button>
                            <span id="vcTuneRowA" class="d-inline-flex align-items-center gap-1">
                                <button id="vcTuneDefaultBtnA" class="ywc-btn btn-sm btn-outline-light"
                                        onclick="vcTuneCommand('a','default')"
                                        aria-label="MAIN VC Tune default" title="MAIN VC Tune auto-tune">Default</button>
                                <button class="ywc-btn btn-sm btn-outline-light"
                                        onclick="vcTuneStep('a','minus')"
                                        aria-label="MAIN VC Tune step down" title="Step MAIN preselector capacitor down">−</button>
                                <select id="vcTuneStepA" class="ywc-select form-select-sm"
                                        style="width: 3.5rem; background-color: transparent; color: white; border-color: rgba(255,255,255,0.5);"
                                        aria-label="MAIN VC Tune step size" title="Step size (1–9)">
                                    <option value="1" style="color:black;">1</option><option value="2" style="color:black;">2</option><option value="3" style="color:black;">3</option>
                                    <option value="4" style="color:black;">4</option><option value="5" selected style="color:black;">5</option><option value="6" style="color:black;">6</option>
                                    <option value="7" style="color:black;">7</option><option value="8" style="color:black;">8</option><option value="9" style="color:black;">9</option>
                                </select>
                                <button class="ywc-btn btn-sm btn-outline-light"
                                        onclick="vcTuneStep('a','plus')"
                                        aria-label="MAIN VC Tune step up" title="Step MAIN preselector capacitor up">+</button>
                                <button id="vcTuneCenterBtnA" class="ywc-btn btn-sm btn-outline-light"
                                        onclick="vcTuneCommand('a','center')"
                                        aria-label="MAIN VC Tune center" title="Center MAIN preselector capacitor">Center</button>
                                <span id="vcTuneMeterA" class="small text-white-50" style="font-size: 0.75rem; min-width: 44px;">P5: —</span>
                                <span id="vcTuneWarnA" class="text-warning small" style="display:none; font-size: 0.75rem;"></span>
                            </span>
                            }
                            <button id="txButtonA" class="ywc-btn btn-warning btn-sm" style="display:none;"
                                    onclick="toggleTx()" title="Toggle Transmit">
                                <i class="bi bi-broadcast" aria-hidden="true"></i> TX
                            </button>
                        </div>
                    </div>
                </div>
                <div class="ywc-vfo-body">
                    <!-- Receiver Controls Group: Save-to-Mem, Band buttons, Mode select.
                         The S-meter and its history strip moved to the top meter row
                         in v2.3.9 (Jacek SP3L #34, Colin's design call) -- the radio
                         has only one calibrated S-meter, so showing it once at the
                         top is honest. -->
                    <div class="receiver-controls-group d-flex flex-nowrap mb-0 gap-2 align-items-start">
                        <!-- Left: Save-to-Mem button (S-meter moved to top row) -->
                        <div class="flex-shrink-0">
                            <button id="saveMemBtnA" type="button"
                                    class="ywc-btn btn-outline-secondary btn-sm"
                                    style="padding:1px 4px;"
                                    onclick="saveVfoToMemory('A')"
                                    aria-label="Save VFO A to memories"
                                    title="Save VFO A frequency, mode and clarifier to app memories">
                                Save to Mem
                            </button>
                            <span id="saveMemStatusA" class="visually-hidden" role="status" aria-live="polite"></span>
                        </div>
                        <!-- Middle: Band buttons + Mode/Antenna below + filter scope -->
                        <div class="flex-grow-1 d-flex flex-column gap-1">
                            @await Html.PartialAsync("_BandButtonsPartial", Tuple.Create("unused", "A", Model.SelectedBandA))
                            @if (Model.View.HasQmb)
                            {
                                <!-- Quick Memory Bank (QMB) — global radio function, shown once.
                                     Store (QI;) pushes the current VFO into the QMB stack; Recall
                                     (QR;) recalls / cycles through the stored slots. Buttons only,
                                     per Thomas OZ1JTE's request (no stack-contents display). -->
                                <div class="ywc-flex align-items-center gap-2 mt-1" id="qmbControls">
                                    <span class="vfo-control-label" aria-hidden="true">QMB</span>
                                    <button id="qmbStoreBtn" type="button"
                                            class="ywc-btn btn-outline-secondary btn-sm"
                                            style="padding:1px 6px;"
                                            onclick="qmbStore()"
                                            aria-label="Store current VFO to Quick Memory Bank"
                                            title="Store the current VFO frequency and mode into the radio's Quick Memory Bank">
                                        Store
                                    </button>
                                    <button id="qmbRecallBtn" type="button"
                                            class="ywc-btn btn-outline-secondary btn-sm"
                                            style="padding:1px 6px;"
                                            onclick="qmbRecall()"
                                            aria-label="Recall from Quick Memory Bank"
                                            title="Recall from the Quick Memory Bank — the display switches to QMB; repeated presses step through the stored slots. Use V/M to return to VFO.">
                                        Recall
                                    </button>
                                    <button id="qmbVfoBtn" type="button"
                                            class="ywc-btn btn-outline-secondary btn-sm"
                                            style="padding:1px 6px;"
                                            onclick="qmbVfo()"
                                            aria-label="Return to VFO mode (V/M key)"
                                            title="Return to VFO mode — leaves QMB (mirrors the radio's V/M key).">
                                        V/M
                                    </button>
                                    <span id="qmbStatus" class="visually-hidden" role="status" aria-live="polite"></span>
                                </div>
                            }
                            <div class="ywc-flex align-items-center gap-2 mt-1">
                                <label class="vfo-control-label" for="modeSelectA">Mode</label>
                                <select class="ywc-select form-select-sm vfo-mode-select" id="modeSelectA"
                                        aria-label="VFO A mode"
                                        title="VFO A mode"
                                        onchange="setMode('A', this.value)">
                                    @foreach (var mode in Model.View.AllModes)
                                    {
                                        @if (Model.RadioState.ModeA == mode)
                                        {
                                            <option value="@mode" selected>@DockViewState.ModeLabel(mode)</option>
                                        }
                                        else
                                        {
                                            <option value="@mode">@DockViewState.ModeLabel(mode)</option>
                                        }
                                    }
                                </select>
                                @if (Model.View.HasAntennaSelector)
                                {
                                    <select class="ywc-select form-select-sm vfo-ant-select" id="antennaSelectA"
                                            aria-label="VFO A antenna"
                                            title="VFO A antenna"
                                            onchange="window.radioControl.setAntenna('A', this.value)">
                                        @foreach (var ant in new[] { "1", "2", "3" })
                                        {
                                            @if (Model.RadioState.AntennaA == ant)
                                            {
                                                <option value="@ant" selected>ANT @ant</option>
                                            }
                                            else
                                            {
                                                <option value="@ant">ANT @ant</option>
                                            }
                                        }
                                    </select>
                                }
                            </div>
                        </div>
                        <!-- Voice control mic button + step selector VFO A — large PTT target for accessibility, step select left of the button, both enlarged per Colin's testing feedback; shown only when voice control is enabled (voice-control.js) -->
                        <div class="flex-shrink-0" id="voiceMicContainerA" style="display:none;">
                            <div class="ywc-flex align-items-center gap-2">
                                <select id="voiceNudgeStepSelectA"
                                        class="form-select"
                                        style="width:auto; font-size:1.4rem; font-weight:600; padding:0.4rem 2.4rem 0.4rem 0.6rem;"
                                        title="Voice nudge step size — how far 'tune up'/'tune down' moves VFO A"
                                        aria-label="VFO A voice nudge step size">
                                    <option value="10">10 Hz</option>
                                    <option value="100">100 Hz</option>
                                    <option value="1000">1 kHz</option>
                                    <option value="10000">10 kHz</option>
                                    <option value="100000">100 kHz</option>
                                </select>
                                <button id="voiceMicBtnA" type="button"
                                        class="ywc-btn btn-outline-danger voice-mic-btn d-flex align-items-center justify-content-center"
                                        style="width:140px; height:120px; padding:0;"
                                        title="Hold to give a VFO A voice command (right-click for the command list)"
                                        aria-label="Voice command VFO A — hold to speak">
                                    <i class="bi bi-mic-fill" style="font-size:4.5rem; line-height:1;" aria-hidden="true"></i>
                                </button>
                            </div>
                            <div id="voiceLastHeardA"
                                 style="font-size:1.1rem; font-weight:700; color:#000; margin-top:0.3rem; max-width:320px; overflow-wrap:break-word;"
                                 aria-live="polite"></div>
                        </div>
                        <!-- Filter scope display VFO A — sits between band buttons and AGC column -->
                        <div class="flex-shrink-0" id="filterScopeContainerA" style="width:160px;">
                            <canvas id="filterScopeCanvasA" role="img" aria-hidden="true"
                                    aria-label="VFO A filter display" data-a11y-key="filter.scopeA"
                                    style="display:block; height:80px; border-radius:4px;"></canvas>
                        </div>
                        <!-- Right: Controls column (2-column grid) -->
                        <div class="vfo-controls-column">
                            <div class="vfo-control-item">
                                <label class="vfo-control-label">AGC</label>
                                <select class="ywc-select form-select-sm" id="agcSelectA"
                                        aria-label="VFO A AGC"
                                        title="VFO A AGC"
                                        onchange="window.radioControl.setAgc('A', this.value)">
                                    <option value="0" selected="@(Model.RadioState.AgcA == "0" ? "selected" : null)">OFF</option>
                                    <option value="1" selected="@(Model.RadioState.AgcA == "1" ? "selected" : null)">FAST</option>
                                    <option value="2" selected="@(Model.RadioState.AgcA == "2" ? "selected" : null)">MID</option>
                                    <option value="3" selected="@(Model.RadioState.AgcA == "3" ? "selected" : null)">SLOW</option>
                                    <option value="4" selected="@(Model.RadioState.AgcA == "4" ? "selected" : null)">AUTO</option>
                                </select>
                            </div>
                            <div class="vfo-control-item">
                                <label class="vfo-control-label">IPO/AMP</label>
                                <select class="ywc-select form-select-sm" id="ipoSelectA"
                                        aria-label="VFO A IPO amp"
                                        title="VFO A IPO / amplifier"
                                        onchange="window.radioControl.setIpo('A', this.value)">
                                    <option value="0" selected="@(Model.RadioState.IpoA == "0" ? "selected" : null)">IPO</option>
                                    <option value="1" selected="@(Model.RadioState.IpoA == "1" ? "selected" : null)">AMP1</option>
                                    <option value="2" selected="@(Model.RadioState.IpoA == "2" ? "selected" : null)">AMP2</option>
                                </select>
                            </div>
                            <div class="vfo-control-item">
                                <label class="vfo-control-label">ATT</label>
                                <select class="ywc-select form-select-sm" id="attSelectA"
                                        aria-label="VFO A attenuator"
                                        title="VFO A attenuator"
                                        onchange="window.radioControl.setAttenuator('A', this.value)">
                                    <option value="00" selected="@(Model.RadioState.AttA == "00" ? "selected" : null)">OFF</option>
                                    <option value="06" selected="@(Model.RadioState.AttA == "06" ? "selected" : null)">6 dB</option>
                                    <option value="12" selected="@(Model.RadioState.AttA == "12" ? "selected" : null)">12 dB</option>
                                    <option value="18" selected="@(Model.RadioState.AttA == "18" ? "selected" : null)">18 dB</option>
                                </select>
                            </div>
                            <div class="vfo-control-item">
                                <label class="vfo-control-label">@(Model.View.IsFtdx10 || Model.View.IsFt710 ? "DNR" : "NR")</label>
                                <select class="ywc-select form-select-sm" id="nrSelectA"
                                        aria-label="VFO A @(Model.View.IsFtdx10 || Model.View.IsFt710 ? "digital noise reduction" : "noise reduction")"
                                        title="VFO A @(Model.View.IsFtdx10 || Model.View.IsFt710 ? "digital noise reduction" : "noise reduction")"
                                        onchange="window.radioControl.setNr('A', this.value)">
                                    <option value="0" selected="@(Model.RadioState.NrA == "0" ? "selected" : null)">OFF</option>
                                    @if (Model.View.IsFtdx10 || Model.View.IsFt710)
                                    {
                                        <option value="1" selected="@(Model.RadioState.NrA == "1" ? "selected" : null)">ON</option>
                                    }
                                    else
                                    {
                                        <option value="1" selected="@(Model.RadioState.NrA == "1" ? "selected" : null)">NR1</option>
                                        <option value="2" selected="@(Model.RadioState.NrA == "2" ? "selected" : null)">NR2</option>
                                    }
                                </select>
                            </div>
                            <div class="vfo-control-item">
                                <label class="vfo-control-label">@(Model.View.IsFtdx10 || Model.View.IsFt710 ? "DNR No." : "NR Lvl")</label>
                                <select class="ywc-select form-select-sm" id="nrLevelSelectA"
                                        aria-label="VFO A @(Model.View.IsFtdx10 || Model.View.IsFt710 ? "DNR algorithm" : "NR level") (1-15)"
                                        title="VFO A @(Model.View.IsFtdx10 || Model.View.IsFt710 ? "DNR algorithm (1=lightest, 15=heaviest)" : "NR depth (1=light, 15=heavy)")"
                                        onchange="setNrLevel('A', this.value)">
                                    @for (int i = 1; i <= 15; i++) {
                                        <option value="@i" selected="@(Model.RadioState.NrLevelA == i ? "selected" : null)">@i</option>
                                    }
                                </select>
                            </div>
                            <div class="vfo-control-item">
                                <label class="vfo-control-label">NB</label>
                                <select class="ywc-select form-select-sm" id="nbSelectA"
                                        aria-label="VFO A noise blanker"
                                        title="VFO A noise blanker"
                                        onchange="window.radioControl.setNoiseBlanker('A', this.value)">
                                    <option value="0" selected="@(Model.RadioState.NbA == "0" ? "selected" : null)">OFF</option>
                                    <option value="1" selected="@(Model.RadioState.NbA == "1" ? "selected" : null)">ON</option>
                                </select>
                            </div>
                            <div class="vfo-control-item">
                                <label class="vfo-control-label">NB Level</label>
                                <select class="ywc-select form-select-sm" id="nbLevelSelectA"
                                        aria-label="VFO A noise blanker level"
                                        title="VFO A noise blanker depth (1=min, 20=max)"
                                        onchange="setNbLevel('A', this.value)">
                                    @for (int i = 1; i <= 20; i++) {
                                        <option value="@i" selected="@(Model.RadioState.NbLevelA == i ? "selected" : null)">@i</option>
                                    }
                                </select>
                            </div>
                            <div class="vfo-control-item">
                                <label class="vfo-control-label">Auto Notch</label>
                                <select class="ywc-select form-select-sm" id="autoNotchSelectA"
                                        aria-label="VFO A auto notch"
                                        title="VFO A auto notch"
                                        onchange="window.radioControl.setAutoNotch('A', this.value)">
                                    <option value="0" selected="@(Model.RadioState.AutoNotchA == "0" ? "selected" : null)">OFF</option>
                                    <option value="1" selected="@(Model.RadioState.AutoNotchA == "1" ? "selected" : null)">ON</option>
                                </select>
                            </div>
                            <div class="vfo-control-item">
                                <label class="vfo-control-label">Man Notch</label>
                                <select class="ywc-select form-select-sm" id="manualNotchSelectA"
                                        aria-label="VFO A manual notch"
                                        title="VFO A manual notch"
                                        onchange="window.radioControl.setManualNotch('A', this.value)">
                                    <option value="0" selected="@(Model.RadioState.ManualNotchA == "0" ? "selected" : null)">OFF</option>
                                    <option value="1" selected="@(Model.RadioState.ManualNotchA == "1" ? "selected" : null)">ON</option>
                                </select>
                            </div>
                            <div class="vfo-control-item" style="grid-column: 1 / -1;">
                                <label class="vfo-control-label">Notch Hz</label>
                                <input type="range" id="manualNotchFreqA" aria-label="VFO A manual notch frequency" title="VFO A manual notch frequency" min="10" max="3200" step="10" value="@Model.RadioState.ManualNotchFreqA"
                                       style="flex: 1; height: 16px;"
                                       oninput="document.getElementById('manualNotchFreqValueA').textContent = this.value + ' Hz'; window.radioControl.setManualNotchFreq('A', this.value)">
                                <span id="manualNotchFreqValueA" class="vfo-control-label" style="min-width: 52px; text-align: right;">@Model.RadioState.ManualNotchFreqA Hz</span>
                            </div>
                            <div class="vfo-control-item" style="grid-column: 1 / -1;">
                                <label class="vfo-control-label">RF Gain</label>
                                <input type="range" id="rfGainSliderA" aria-label="VFO A RF gain" title="VFO A RF gain (0=min, 255=max)" min="0" max="255" step="1" value="@Model.RadioState.RfGainA"
                                       style="flex: 1; height: 16px;"
                                       oninput="document.getElementById('rfGainValueA').textContent = this.value"
                                       onchange="setRfGain('A', this.value)">
                                <span id="rfGainValueA" class="vfo-control-label" style="min-width: 36px; text-align: right;">@Model.RadioState.RfGainA</span>
                            </div>
                            <div class="vfo-control-item" id="squelchRowA" style="grid-column: 1 / -1; display:none;">
                                <label class="vfo-control-label">Squelch</label>
                                <input type="range" id="squelchSliderA" aria-label="VFO A squelch" title="VFO A squelch level (0=open, 255=max)" min="0" max="255" step="1" value="@Model.RadioState.SquelchA"
                                       style="flex: 1; height: 16px;"
                                       oninput="document.getElementById('squelchValueA').textContent = this.value"
                                       onchange="setSquelch('A', this.value)">
                                <span id="squelchValueA" class="vfo-control-label" style="min-width: 36px; text-align: right;">@Model.RadioState.SquelchA</span>
                            </div>
                        </div>
                    </div>

                    <!-- Segment selector + Contour/APF controls on one row -->
                    <div class="ywc-flex align-items-center gap-1 mb-1 flex-wrap" style="margin-top: 2px;">
                        <span class="fw-bold" style="font-size: 0.8rem; white-space: nowrap;">Segment</span>
                        <select class="ywc-select form-select-sm segment-select" id="segmentSelectA"
                                aria-label="VFO A band segment"
                                title="VFO A band segment"
                                onchange="window.onSegmentChange && window.onSegmentChange('A', this.value)">
                            <option value="">--</option>
                        </select>
                        <button type="button" id="contourBtnA"
                                class="ywc-btn btn-sm @(Model.RadioState.ContourOnA ? "btn-success" : "btn-outline-secondary") flex-shrink-0"
                                style="color: black; font-weight: bold;"
                                aria-label="VFO A Contour filter" title="Toggle Contour audio peak filter"
                                onclick="toggleContour('A')">@(Model.RadioState.ContourOnA ? "Contour On" : "Contour Off")</button>
                        <input type="range" id="contourFreqSliderA"
                               min="100" max="@Model.View.ContourMaxFreq" step="@Model.View.ContourStep"
                               value="@Model.RadioState.ContourFreqA"
                               style="width: clamp(60px, 8vw, 110px); height: 16px;"
                               oninput="document.getElementById('contourFreqValueA').textContent = this.value + ' Hz'"
                               onchange="setContourFreq('A', parseInt(this.value))"
                               aria-label="VFO A Contour frequency">
                        <span id="contourFreqValueA" style="font-size: 0.8rem; white-space: nowrap; min-width: 46px;">@(Model.RadioState.ContourFreqA) Hz</span>
                        <button type="button" id="apfBtnA"
                                class="ywc-btn btn-sm @(Model.RadioState.ApfOnA ? "btn-success" : "btn-outline-secondary") flex-shrink-0"
                                style="color: black; font-weight: bold;"
                                aria-label="VFO A APF filter" title="Toggle APF audio peak filter (CW)"
                                onclick="toggleApf('A')">@(Model.RadioState.ApfOnA ? "APF On" : "APF Off")</button>
                        <input type="range" id="apfFreqSliderA"
                               min="-250" max="250" step="@Model.View.ApfStep"
                               value="@Model.RadioState.ApfFreqA"
                               style="width: clamp(60px, 8vw, 110px); height: 16px;"
                               oninput="document.getElementById('apfFreqValueA').textContent = this.value + ' Hz'"
                               onchange="setApfFreq('A', parseInt(this.value))"
                               aria-label="VFO A APF frequency">
                        <span id="apfFreqValueA" style="font-size: 0.8rem; white-space: nowrap; min-width: 46px;">@(Model.RadioState.ApfFreqA) Hz</span>
                    </div>

                    <!-- Frequency + Roofing + AF Gain on one row -->
                    <div class="vfo-freq-row d-flex align-items-center flex-wrap gap-2 mb-1" style="margin-top: -2px;">
                        <span id="freqA" class="fw-bold frequency-display digit-display" role="spinbutton" aria-label="VFO A frequency" title="VFO A frequency" data-a11y-key="vfo.a.frequency" tabindex="0" aria-valuemin="0.03" aria-valuemax="75" aria-valuenow="0"></span>
                        <span class="frequency-display digit-display">MHz</span>
                        <div id="freqA-controls" class="freq-step-controls" style="display:@(Model.ShowFrequencyArrowButtons ? "inline-flex" : "none");">
                            <button type="button" id="freqA-up" class="ywc-btn btn-secondary btn-sm" aria-label="Step VFO A selected digit up" title="Step VFO A selected digit up (↑)">▲</button>
                            <button type="button" id="freqA-down" class="ywc-btn btn-secondary btn-sm" aria-label="Step VFO A selected digit down" title="Step VFO A selected digit down (↓)">▼</button>
                        </div>
                        <button class="ywc-btn btn-outline-secondary btn-sm fkb-open-btn"
                                data-freq-keyboard="A"
                                aria-label="Keyboard — enter VFO A frequency"
                                data-a11y-key="keyboard.openA"
                                title="Keyboard — enter VFO A frequency">
                            <strong>123</strong>
                        </button>
                        @if (!Model.View.IsFt710)
                        {
                        <label class="mb-0 text-nowrap ms-1 fw-bold">Roofing:</label>
                        <select class="ywc-select form-select-sm fw-bold flex-shrink-0" id="roofingFilterSelectA"
                                aria-label="VFO A roofing filter"
                                title="VFO A roofing filter"
                                style="width: auto;"
                                onchange="window.radioControl.setRoofingFilter('A', this.value)">
                            @if (Model.View.IsFtdx10)
                            {
                                @foreach (var opt in Model.View.RoofingOptionsFtdx10)
                                {
                                    <option value="@opt.Value" selected="@(Model.RadioState.RoofingFilterA==opt.Value ? "selected" : null)">@opt.Label</option>
                                }
                            }
                            else if (Model.View.IsFtdx3000)
                            {
                                @foreach (var opt in Model.View.RoofingOptions3000)
                                {
                                    <option value="@opt.Value" selected="@(Model.RadioState.RoofingFilterA==opt.Value ? "selected" : null)">@opt.Label</option>
                                }
                            }
                            else
                            {
                                @foreach (var opt in Model.View.RoofingOptions)
                                {
                                    <option value="@opt.Value" selected="@(Model.RadioState.RoofingFilterA==opt.Value ? "selected" : null)">@opt.Label</option>
                                }
                            }
                        </select>
                        }
                        <label class="mb-0 text-nowrap ms-1 fw-bold">AF Gain: <span id="afGainValueA" class="fw-bold">@Model.AfGainA</span></label>
                        <input type="range" class="flex-shrink-0"
                               id="afGainSliderA"
                               aria-label="VFO A AF gain"
                               title="VFO A AF gain"
                               min="0" max="255" step="1" value="@Model.AfGainA"
                               style="width: clamp(70px, 8vw, 120px); height: 18px;"
                               oninput="document.getElementById('afGainValueA').innerText = this.value">
                    </div>

                    <!-- IF Width and IF Shift -->
                    <div class="ywc-flex align-items-center gap-2 mb-0" style="flex-wrap: wrap;">
                        <label class="mb-0 text-nowrap fw-bold">IF Width:</label>
                        <select class="ywc-select form-select-sm fw-bold flex-shrink-0" id="ifWidthSelectA"
                                aria-label="VFO A IF width"
                                title="VFO A IF width"
                                style="width: auto;"
                                onchange="window.radioControl.setIfWidth('A', this.value)">
                            @foreach (var opt in Model.View.IfWidthOptions)
                            {
                                bool isDefault = string.IsNullOrEmpty(Model.RadioState.IfWidthA) && opt.Value == Model.View.IfWidthDefaultA;
                                <option value="@opt.Value" selected="@(Model.RadioState.IfWidthA==opt.Value||isDefault ? "selected" : null)">@opt.Label</option>
                            }
                        </select>
                        <button type="button" class="ywc-btn btn-secondary btn-sm fw-bold flex-shrink-0 ms-2"
                                id="audioFilterBtnA"
                                aria-label="VFO A Audio Filter"
                                title="Open the Audio Filter dialog for VFO A's current mode (LCUT FREQ, LCUT SLOPE, HCUT FREQ, HCUT SLOPE)"
                                onclick="window.audioFilter && window.audioFilter.open('A')">
                            Audio Filter
                        </button>
                        <label class="mb-0 text-nowrap ms-1 fw-bold">IF Shift: <span id="ifShiftValueA" class="fw-bold">@Model.RadioState.IfShiftA</span></label>
                        <input type="range" class="ywc-range ifshift-slider flex-shrink-0"
                               id="ifShiftSliderA"
                               aria-label="VFO A IF shift"
                               title="VFO A IF shift"
                               min="-1000" max="1000" step="20" value="@Model.RadioState.IfShiftA"
                               style="width: clamp(70px, 8vw, 120px); height: 18px;"
                               oninput="document.getElementById('ifShiftValueA').textContent = this.value; if(window.filterScopePanelA) window.filterScopePanelA.setState({ifShiftHz: parseInt(this.value)||0})">
                        <button type="button" class="ywc-btn btn-secondary btn-sm flex-shrink-0"
                                onclick="resetIfShift('A')" title="Zero IF Shift">Zero</button>
                    </div>

                    <!-- VFO A status line — live band/mode/freq/power summary, banner-coloured -->
                    <div id="vfoAStatusLine"
                         class="bg-primary text-white px-2 py-1 mt-1 font-monospace rounded"
                         style="font-size:0.9rem; line-height:1.25; overflow-x:auto; white-space:nowrap;"
                         aria-live="polite" aria-atomic="true">—</div>
                            </div>
                        </div>
                    </div>
