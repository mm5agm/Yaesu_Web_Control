<div id="vfoACol" class="ywc-vfo ywc-vfo-a" data-ywc-vfo-ui="dock">
    <div class="ywc-vfo-inner">
        <div class="ywc-vfo-toolbar ywc-flex-wrap">
            <strong class="ywc-vfo-title" id="receiverAHeading">VFO A</strong>
            <span id="splitTxBadgeA" class="ywc-badge ywc-badge-danger" style="display:none;" aria-live="polite">SPLIT TX</span>
            <button type="button" id="zinBtnA" class="ywc-btn ywc-btn-sm ywc-btn-outline"
                    onclick="cwZeroIn('A')"
                    aria-label="VFO A CW Auto Zero In"
                    title="CW Auto Zero In on VFO A — nudges the VFO so the received CW signal sits at your configured CW pitch">ZIN</button>
            @if (Model.View.HasVcTune) {
            <button type="button" id="vcTuneToggleBtnA" class="ywc-btn ywc-btn-sm ywc-btn-outline"
                    onclick="vcTuneToggle('a')"
                    aria-label="MAIN VC Tune on/off"
                    title="Toggle MAIN VC Tune preselector on/off">VC Tune</button>
            <span id="vcTuneRowA" class="ywc-vfo-vctune ywc-flex">
                <button id="vcTuneDefaultBtnA" class="ywc-btn ywc-btn-sm ywc-btn-outline"
                        onclick="vcTuneCommand('a','default')"
                        aria-label="MAIN VC Tune default" title="MAIN VC Tune auto-tune">Default</button>
                <button class="ywc-btn ywc-btn-sm ywc-btn-outline"
                        onclick="vcTuneStep('a','minus')"
                        aria-label="MAIN VC Tune step down" title="Step MAIN preselector capacitor down">−</button>
                <select id="vcTuneStepA" class="ywc-select ywc-vfo-vctune-step"
                        aria-label="MAIN VC Tune step size" title="Step size (1–9)">
                    <option value="1">1</option><option value="2">2</option><option value="3">3</option>
                    <option value="4">4</option><option value="5" selected>5</option><option value="6">6</option>
                    <option value="7">7</option><option value="8">8</option><option value="9">9</option>
                </select>
                <button class="ywc-btn ywc-btn-sm ywc-btn-outline"
                        onclick="vcTuneStep('a','plus')"
                        aria-label="MAIN VC Tune step up" title="Step MAIN preselector capacitor up">+</button>
                <button id="vcTuneCenterBtnA" class="ywc-btn ywc-btn-sm ywc-btn-outline"
                        onclick="vcTuneCommand('a','center')"
                        aria-label="MAIN VC Tune center" title="Center MAIN preselector capacitor">Center</button>
                <span id="vcTuneMeterA" class="ywc-vfo-muted">P5: —</span>
                <span id="vcTuneWarnA" class="ywc-vfo-warn" style="display:none;"></span>
            </span>
            }
            <button id="txButtonA" class="ywc-btn ywc-btn-sm ywc-btn-warning" style="display:none;"
                    onclick="toggleTx()" title="Toggle Transmit" aria-label="Toggle Transmit">TX</button>
        </div>

        <div class="ywc-vfo-body">
            <div class="ywc-vfo-controls-group">
                <div class="ywc-vfo-mem">
                    <button id="saveMemBtnA" type="button"
                            class="ywc-btn ywc-btn-sm ywc-btn-outline"
                            onclick="saveVfoToMemory('A')"
                            aria-label="Save VFO A to memories"
                            title="Save VFO A frequency, mode and clarifier to app memories">
                        Save to Mem
                    </button>
                    <span id="saveMemStatusA" class="visually-hidden" role="status" aria-live="polite"></span>
                </div>

                <div class="ywc-vfo-bands">
                    @await Html.PartialAsync("_BandButtonsPartial", Tuple.Create("unused", "A", Model.SelectedBandA))
                    @if (Model.View.HasQmb)
                    {
                        <div class="ywc-vfo-qmb ywc-flex" id="qmbControls">
                            <span class="ywc-vfo-label" aria-hidden="true">QMB</span>
                            <button id="qmbStoreBtn" type="button"
                                    class="ywc-btn ywc-btn-sm ywc-btn-outline"
                                    onclick="qmbStore()"
                                    aria-label="Store current VFO to Quick Memory Bank"
                                    title="Store the current VFO frequency and mode into the radio's Quick Memory Bank">
                                Store
                            </button>
                            <button id="qmbRecallBtn" type="button"
                                    class="ywc-btn ywc-btn-sm ywc-btn-outline"
                                    onclick="qmbRecall()"
                                    aria-label="Recall from Quick Memory Bank"
                                    title="Recall from the Quick Memory Bank — the display switches to QMB; repeated presses step through the stored slots. Use V/M to return to VFO.">
                                Recall
                            </button>
                            <button id="qmbVfoBtn" type="button"
                                    class="ywc-btn ywc-btn-sm ywc-btn-outline"
                                    onclick="qmbVfo()"
                                    aria-label="Return to VFO mode (V/M key)"
                                    title="Return to VFO mode — leaves QMB (mirrors the radio's V/M key).">
                                V/M
                            </button>
                            <span id="qmbStatus" class="visually-hidden" role="status" aria-live="polite"></span>
                        </div>
                    }
                    <div class="ywc-vfo-mode-row ywc-flex">
                        <label class="ywc-vfo-label" for="modeSelectA">Mode</label>
                        <select class="ywc-select vfo-mode-select" id="modeSelectA"
                                aria-label="VFO A mode"
                                title="VFO A mode"
                                onchange="setMode('A', this.value)">
                            @foreach (var mode in Model.View.AllModes)
                            {
                                @if (Model.RadioState.ModeA == mode)
                                {
                                    <option value="@mode" selected>@DockViewState.ModeLabel(mode)</option>
                                }
                                else
                                {
                                    <option value="@mode">@DockViewState.ModeLabel(mode)</option>
                                }
                            }
                        </select>
                        @if (Model.View.HasAntennaSelector)
                        {
                            <select class="ywc-select vfo-ant-select" id="antennaSelectA"
                                    aria-label="VFO A antenna"
                                    title="VFO A antenna"
                                    onchange="window.radioControl.setAntenna('A', this.value)">
                                @foreach (var ant in new[] { "1", "2", "3" })
                                {
                                    @if (Model.RadioState.AntennaA == ant)
                                    {
                                        <option value="@ant" selected>ANT @ant</option>
                                    }
                                    else
                                    {
                                        <option value="@ant">ANT @ant</option>
                                    }
                                }
                            </select>
                        }
                    </div>
                </div>

                <div class="ywc-vfo-voice" id="voiceMicContainerA" style="display:none;">
                    <div class="ywc-flex">
                        <select id="voiceNudgeStepSelectA"
                                class="ywc-select ywc-vfo-voice-step"
                                title="Voice nudge step size — how far 'tune up'/'tune down' moves VFO A"
                                aria-label="VFO A voice nudge step size">
                            <option value="10">10 Hz</option>
                            <option value="100">100 Hz</option>
                            <option value="1000">1 kHz</option>
                            <option value="10000">10 kHz</option>
                            <option value="100000">100 kHz</option>
                        </select>
                        <button id="voiceMicBtnA" type="button"
                                class="ywc-btn ywc-btn-outline ywc-btn-danger voice-mic-btn"
                                title="Hold to give a VFO A voice command (right-click for the command list)"
                                aria-label="Voice command VFO A — hold to speak">
                            <span class="ywc-vfo-mic-icon" aria-hidden="true">🎤</span>
                        </button>
                    </div>
                    <div id="voiceLastHeardA" class="ywc-vfo-voice-heard" aria-live="polite"></div>
                </div>

                <div class="ywc-vfo-scope" id="filterScopeContainerA">
                    <canvas id="filterScopeCanvasA" role="img" aria-hidden="true"
                            aria-label="VFO A filter display" data-a11y-key="filter.scopeA"></canvas>
                </div>

                <div class="vfo-controls-column ywc-vfo-grid">
                    <div class="vfo-control-item">
                        <label class="ywc-vfo-label">AGC</label>
                        <select class="ywc-select" id="agcSelectA"
                                aria-label="VFO A AGC"
                                title="VFO A AGC"
                                onchange="window.radioControl.setAgc('A', this.value)">
                            <option value="0" selected="@(Model.RadioState.AgcA == "0" ? "selected" : null)">OFF</option>
                            <option value="1" selected="@(Model.RadioState.AgcA == "1" ? "selected" : null)">FAST</option>
                            <option value="2" selected="@(Model.RadioState.AgcA == "2" ? "selected" : null)">MID</option>
                            <option value="3" selected="@(Model.RadioState.AgcA == "3" ? "selected" : null)">SLOW</option>
                            <option value="4" selected="@(Model.RadioState.AgcA == "4" ? "selected" : null)">AUTO</option>
                        </select>
                    </div>
                    <div class="vfo-control-item">
                        <label class="ywc-vfo-label">IPO/AMP</label>
                        <select class="ywc-select" id="ipoSelectA"
                                aria-label="VFO A IPO amp"
                                title="VFO A IPO / amplifier"
                                onchange="window.radioControl.setIpo('A', this.value)">
                            <option value="0" selected="@(Model.RadioState.IpoA == "0" ? "selected" : null)">IPO</option>
                            <option value="1" selected="@(Model.RadioState.IpoA == "1" ? "selected" : null)">AMP1</option>
                            <option value="2" selected="@(Model.RadioState.IpoA == "2" ? "selected" : null)">AMP2</option>
                        </select>
                    </div>
                    <div class="vfo-control-item">
                        <label class="ywc-vfo-label">ATT</label>
                        <select class="ywc-select" id="attSelectA"
                                aria-label="VFO A attenuator"
                                title="VFO A attenuator"
                                onchange="window.radioControl.setAttenuator('A', this.value)">
                            <option value="00" selected="@(Model.RadioState.AttA == "00" ? "selected" : null)">OFF</option>
                            <option value="06" selected="@(Model.RadioState.AttA == "06" ? "selected" : null)">6 dB</option>
                            <option value="12" selected="@(Model.RadioState.AttA == "12" ? "selected" : null)">12 dB</option>
                            <option value="18" selected="@(Model.RadioState.AttA == "18" ? "selected" : null)">18 dB</option>
                        </select>
                    </div>
                    <div class="vfo-control-item">
                        <label class="ywc-vfo-label">@(Model.View.IsFtdx10 || Model.View.IsFt710 ? "DNR" : "NR")</label>
                        <select class="ywc-select" id="nrSelectA"
                                aria-label="VFO A @(Model.View.IsFtdx10 || Model.View.IsFt710 ? "digital noise reduction" : "noise reduction")"
                                title="VFO A @(Model.View.IsFtdx10 || Model.View.IsFt710 ? "digital noise reduction" : "noise reduction")"
                                onchange="window.radioControl.setNr('A', this.value)">
                            <option value="0" selected="@(Model.RadioState.NrA == "0" ? "selected" : null)">OFF</option>
                            @if (Model.View.IsFtdx10 || Model.View.IsFt710)
                            {
                                <option value="1" selected="@(Model.RadioState.NrA == "1" ? "selected" : null)">ON</option>
                            }
                            else
                            {
                                <option value="1" selected="@(Model.RadioState.NrA == "1" ? "selected" : null)">NR1</option>
                                <option value="2" selected="@(Model.RadioState.NrA == "2" ? "selected" : null)">NR2</option>
                            }
                        </select>
                    </div>
                    <div class="vfo-control-item">
                        <label class="ywc-vfo-label">@(Model.View.IsFtdx10 || Model.View.IsFt710 ? "DNR No." : "NR Lvl")</label>
                        <select class="ywc-select" id="nrLevelSelectA"
                                aria-label="VFO A @(Model.View.IsFtdx10 || Model.View.IsFt710 ? "DNR algorithm" : "NR level") (1-15)"
                                title="VFO A @(Model.View.IsFtdx10 || Model.View.IsFt710 ? "DNR algorithm (1=lightest, 15=heaviest)" : "NR depth (1=light, 15=heavy)")"
                                onchange="setNrLevel('A', this.value)">
                            @for (int i = 1; i <= 15; i++) {
                                <option value="@i" selected="@(Model.RadioState.NrLevelA == i ? "selected" : null)">@i</option>
                            }
                        </select>
                    </div>
                    <div class="vfo-control-item">
                        <label class="ywc-vfo-label">NB</label>
                        <select class="ywc-select" id="nbSelectA"
                                aria-label="VFO A noise blanker"
                                title="VFO A noise blanker"
                                onchange="window.radioControl.setNoiseBlanker('A', this.value)">
                            <option value="0" selected="@(Model.RadioState.NbA == "0" ? "selected" : null)">OFF</option>
                            <option value="1" selected="@(Model.RadioState.NbA == "1" ? "selected" : null)">ON</option>
                        </select>
                    </div>
                    <div class="vfo-control-item">
                        <label class="ywc-vfo-label">NB Level</label>
                        <select class="ywc-select" id="nbLevelSelectA"
                                aria-label="VFO A noise blanker level"
                                title="VFO A noise blanker depth (1=min, 20=max)"
                                onchange="setNbLevel('A', this.value)">
                            @for (int i = 1; i <= 20; i++) {
                                <option value="@i" selected="@(Model.RadioState.NbLevelA == i ? "selected" : null)">@i</option>
                            }
                        </select>
                    </div>
                    <div class="vfo-control-item">
                        <label class="ywc-vfo-label">Auto Notch</label>
                        <select class="ywc-select" id="autoNotchSelectA"
                                aria-label="VFO A auto notch"
                                title="VFO A auto notch"
                                onchange="window.radioControl.setAutoNotch('A', this.value)">
                            <option value="0" selected="@(Model.RadioState.AutoNotchA == "0" ? "selected" : null)">OFF</option>
                            <option value="1" selected="@(Model.RadioState.AutoNotchA == "1" ? "selected" : null)">ON</option>
                        </select>
                    </div>
                    <div class="vfo-control-item">
                        <label class="ywc-vfo-label">Man Notch</label>
                        <select class="ywc-select" id="manualNotchSelectA"
                                aria-label="VFO A manual notch"
                                title="VFO A manual notch"
                                onchange="window.radioControl.setManualNotch('A', this.value)">
                            <option value="0" selected="@(Model.RadioState.ManualNotchA == "0" ? "selected" : null)">OFF</option>
                            <option value="1" selected="@(Model.RadioState.ManualNotchA == "1" ? "selected" : null)">ON</option>
                        </select>
                    </div>
                    <div class="vfo-control-item ywc-vfo-span">
                        <label class="ywc-vfo-label">Notch Hz</label>
                        <input type="range" class="ywc-range" id="manualNotchFreqA"
                               aria-label="VFO A manual notch frequency" title="VFO A manual notch frequency"
                               min="10" max="3200" step="10" value="@Model.RadioState.ManualNotchFreqA"
                               oninput="document.getElementById('manualNotchFreqValueA').textContent = this.value + ' Hz'; window.radioControl.setManualNotchFreq('A', this.value)">
                        <span id="manualNotchFreqValueA" class="ywc-vfo-val">@Model.RadioState.ManualNotchFreqA Hz</span>
                    </div>
                    <div class="vfo-control-item ywc-vfo-span">
                        <label class="ywc-vfo-label">RF Gain</label>
                        <input type="range" class="ywc-range" id="rfGainSliderA"
                               aria-label="VFO A RF gain" title="VFO A RF gain (0=min, 255=max)"
                               min="0" max="255" step="1" value="@Model.RadioState.RfGainA"
                               oninput="document.getElementById('rfGainValueA').textContent = this.value"
                               onchange="setRfGain('A', this.value)">
                        <span id="rfGainValueA" class="ywc-vfo-val">@Model.RadioState.RfGainA</span>
                    </div>
                    <div class="vfo-control-item ywc-vfo-span" id="squelchRowA" style="display:none;">
                        <label class="ywc-vfo-label">Squelch</label>
                        <input type="range" class="ywc-range" id="squelchSliderA"
                               aria-label="VFO A squelch" title="VFO A squelch level (0=open, 255=max)"
                               min="0" max="255" step="1" value="@Model.RadioState.SquelchA"
                               oninput="document.getElementById('squelchValueA').textContent = this.value"
                               onchange="setSquelch('A', this.value)">
                        <span id="squelchValueA" class="ywc-vfo-val">@Model.RadioState.SquelchA</span>
                    </div>
                </div>
            </div>

            <div class="ywc-vfo-row ywc-flex-wrap">
                <span class="ywc-vfo-label">Segment</span>
                <select class="ywc-select segment-select" id="segmentSelectA"
                        aria-label="VFO A band segment"
                        title="VFO A band segment"
                        onchange="window.onSegmentChange && window.onSegmentChange('A', this.value)">
                    <option value="">--</option>
                </select>
                <button type="button" id="contourBtnA"
                        class="ywc-btn ywc-btn-sm @(Model.RadioState.ContourOnA ? "ywc-btn-success" : "ywc-btn-outline")"
                        aria-label="VFO A Contour filter" title="Toggle Contour audio peak filter"
                        onclick="toggleContour('A')">@(Model.RadioState.ContourOnA ? "Contour On" : "Contour Off")</button>
                <input type="range" class="ywc-range ywc-vfo-slider-sm" id="contourFreqSliderA"
                       min="100" max="@Model.View.ContourMaxFreq" step="@Model.View.ContourStep"
                       value="@Model.RadioState.ContourFreqA"
                       oninput="document.getElementById('contourFreqValueA').textContent = this.value + ' Hz'"
                       onchange="setContourFreq('A', parseInt(this.value))"
                       aria-label="VFO A Contour frequency">
                <span id="contourFreqValueA" class="ywc-vfo-val">@(Model.RadioState.ContourFreqA) Hz</span>
                <button type="button" id="apfBtnA"
                        class="ywc-btn ywc-btn-sm @(Model.RadioState.ApfOnA ? "ywc-btn-success" : "ywc-btn-outline")"
                        aria-label="VFO A APF filter" title="Toggle APF audio peak filter (CW)"
                        onclick="toggleApf('A')">@(Model.RadioState.ApfOnA ? "APF On" : "APF Off")</button>
                <input type="range" class="ywc-range ywc-vfo-slider-sm" id="apfFreqSliderA"
                       min="-250" max="250" step="@Model.View.ApfStep"
                       value="@Model.RadioState.ApfFreqA"
                       oninput="document.getElementById('apfFreqValueA').textContent = this.value + ' Hz'"
                       onchange="setApfFreq('A', parseInt(this.value))"
                       aria-label="VFO A APF frequency">
                <span id="apfFreqValueA" class="ywc-vfo-val">@(Model.RadioState.ApfFreqA) Hz</span>
            </div>

            <div class="ywc-vfo-freq-row ywc-flex-wrap">
                <span id="freqA" class="frequency-display digit-display ywc-vfo-freq" role="spinbutton"
                      aria-label="VFO A frequency" title="VFO A frequency" data-a11y-key="vfo.a.frequency"
                      tabindex="0" aria-valuemin="0.03" aria-valuemax="75" aria-valuenow="0"></span>
                <span class="frequency-display digit-display ywc-vfo-freq-unit">MHz</span>
                <div id="freqA-controls" class="freq-step-controls ywc-vfo-freq-steps"
                     style="display:@(Model.ShowFrequencyArrowButtons ? "inline-flex" : "none");">
                    <button type="button" id="freqA-up" class="ywc-btn ywc-btn-sm ywc-btn-secondary"
                            aria-label="Step VFO A selected digit up" title="Step VFO A selected digit up (↑)">▲</button>
                    <button type="button" id="freqA-down" class="ywc-btn ywc-btn-sm ywc-btn-secondary"
                            aria-label="Step VFO A selected digit down" title="Step VFO A selected digit down (↓)">▼</button>
                </div>
                <button class="ywc-btn ywc-btn-sm ywc-btn-outline fkb-open-btn"
                        data-freq-keyboard="A"
                        aria-label="Keyboard — enter VFO A frequency"
                        data-a11y-key="keyboard.openA"
                        title="Keyboard — enter VFO A frequency">
                    <strong>123</strong>
                </button>
                @if (!Model.View.IsFt710)
                {
                <label class="ywc-vfo-label" for="roofingFilterSelectA">Roofing</label>
                <select class="ywc-select" id="roofingFilterSelectA"
                        aria-label="VFO A roofing filter"
                        title="VFO A roofing filter"
                        onchange="window.radioControl.setRoofingFilter('A', this.value)">
                    @if (Model.View.IsFtdx10)
                    {
                        @foreach (var opt in Model.View.RoofingOptionsFtdx10)
                        {
                            <option value="@opt.Value" selected="@(Model.RadioState.RoofingFilterA==opt.Value ? "selected" : null)">@opt.Label</option>
                        }
                    }
                    else if (Model.View.IsFtdx3000)
                    {
                        @foreach (var opt in Model.View.RoofingOptions3000)
                        {
                            <option value="@opt.Value" selected="@(Model.RadioState.RoofingFilterA==opt.Value ? "selected" : null)">@opt.Label</option>
                        }
                    }
                    else
                    {
                        @foreach (var opt in Model.View.RoofingOptions)
                        {
                            <option value="@opt.Value" selected="@(Model.RadioState.RoofingFilterA==opt.Value ? "selected" : null)">@opt.Label</option>
                        }
                    }
                </select>
                }
                <label class="ywc-vfo-label" for="afGainSliderA">AF Gain <span id="afGainValueA" class="ywc-vfo-val">@Model.AfGainA</span></label>
                <input type="range" class="ywc-range ywc-vfo-slider-sm"
                       id="afGainSliderA"
                       aria-label="VFO A AF gain"
                       title="VFO A AF gain"
                       min="0" max="255" step="1" value="@Model.AfGainA"
                       oninput="document.getElementById('afGainValueA').innerText = this.value">
            </div>

            <div class="ywc-vfo-if-row ywc-flex-wrap">
                <label class="ywc-vfo-label" for="ifWidthSelectA">IF Width</label>
                <select class="ywc-select" id="ifWidthSelectA"
                        aria-label="VFO A IF width"
                        title="VFO A IF width"
                        onchange="window.radioControl.setIfWidth('A', this.value)">
                    @foreach (var opt in Model.View.IfWidthOptions)
                    {
                        bool isDefault = string.IsNullOrEmpty(Model.RadioState.IfWidthA) && opt.Value == Model.View.IfWidthDefaultA;
                        <option value="@opt.Value" selected="@(Model.RadioState.IfWidthA==opt.Value||isDefault ? "selected" : null)">@opt.Label</option>
                    }
                </select>
                <button type="button" class="ywc-btn ywc-btn-sm ywc-btn-secondary"
                        id="audioFilterBtnA"
                        aria-label="VFO A Audio Filter"
                        title="Open the Audio Filter dialog for VFO A's current mode (LCUT FREQ, LCUT SLOPE, HCUT FREQ, HCUT SLOPE)"
                        onclick="window.audioFilter && window.audioFilter.open('A')">
                    Audio Filter
                </button>
                <label class="ywc-vfo-label" for="ifShiftSliderA">IF Shift <span id="ifShiftValueA" class="ywc-vfo-val">@Model.RadioState.IfShiftA</span></label>
                <input type="range" class="ywc-range ifshift-slider ywc-vfo-slider-sm"
                       id="ifShiftSliderA"
                       aria-label="VFO A IF shift"
                       title="VFO A IF shift"
                       min="-1000" max="1000" step="20" value="@Model.RadioState.IfShiftA"
                       oninput="document.getElementById('ifShiftValueA').textContent = this.value; if(window.filterScopePanelA) window.filterScopePanelA.setState({ifShiftHz: parseInt(this.value)||0})">
                <button type="button" class="ywc-btn ywc-btn-sm ywc-btn-secondary"
                        onclick="resetIfShift('A')" title="Zero IF Shift">Zero</button>
            </div>

            <div id="vfoAStatusLine"
                 class="ywc-vfo-status ywc-vfo-status-a"
                 aria-live="polite" aria-atomic="true">—</div>
        </div>
    </div>
</div>
