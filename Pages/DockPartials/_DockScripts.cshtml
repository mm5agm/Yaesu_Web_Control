        // --- DRAGGABLE PANELS ---
        function _saveDlgPos(dialog) {
            try { localStorage.setItem('dlgPos_' + dialog.id, JSON.stringify({ left: dialog.style.left, top: dialog.style.top })); } catch {}
        }

        function makeDraggable(dialog, handle) {
            handle.style.cursor = 'grab';
            handle.addEventListener('mousedown', e => {
                if (e.button !== 0 || e.target.closest('button')) return;
                const r = dialog.getBoundingClientRect();
                let startX = e.clientX, startY = e.clientY;
                let origLeft = r.left, origTop = r.top;
                dialog.style.transform = 'none';
                function onMove(e) {
                    dialog.style.left = (origLeft + e.clientX - startX) + 'px';
                    dialog.style.top  = (origTop  + e.clientY - startY) + 'px';
                }
                function onUp() {
                    document.removeEventListener('mousemove', onMove);
                    document.removeEventListener('mouseup', onUp);
                    handle.style.cursor = 'grab';
                    _saveDlgPos(dialog);
                }
                document.addEventListener('mousemove', onMove);
                document.addEventListener('mouseup', onUp);
                handle.style.cursor = 'grabbing';
                e.preventDefault();
            });
            handle.addEventListener('touchstart', e => {
                if (e.target.closest('button') || e.touches.length !== 1) return;
                const r = dialog.getBoundingClientRect();
                let startX = e.touches[0].clientX, startY = e.touches[0].clientY;
                let origLeft = r.left, origTop = r.top;
                dialog.style.transform = 'none';
                function onMove(e) {
                    dialog.style.left = (origLeft + e.touches[0].clientX - startX) + 'px';
                    dialog.style.top  = (origTop  + e.touches[0].clientY - startY) + 'px';
                    e.preventDefault();
                }
                function onEnd() {
                    document.removeEventListener('touchmove', onMove);
                    document.removeEventListener('touchend', onEnd);
                    _saveDlgPos(dialog);
                }
                document.addEventListener('touchmove', onMove, { passive: false });
                document.addEventListener('touchend', onEnd);
            }, { passive: true });
        }

        ['voxDialog', 'cwDialog', 'fmDialog', 'dxWatchDialog', 'voiceDialog', 'voiceHelpDialog', 'audioFilterDialogA', 'audioFilterDialogB', 'utcClockInfoDialog'].forEach(id => {
            const dlg = document.getElementById(id);
            if (!dlg) return;
            makeDraggable(dlg, dlg.querySelector('div'));
            try {
                const saved = JSON.parse(localStorage.getItem('dlgPos_' + id) || 'null');
                if (saved && saved.left && saved.top) {
                    dlg.style.left = saved.left;
                    dlg.style.top  = saved.top;
                    dlg.style.transform = 'none';
                }
            } catch {}
