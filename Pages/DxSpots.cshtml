@page
@model Yaesu_Web_Control.Pages.DxSpotsModel
@{
    Layout = null;
    ViewData["Title"] = "DX Spots";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="x-app-version" content="@Yaesu_Web_Control.AppVersion.Current">
    <title>DX Spots - Yaesu Web Control</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        html, body { height: 100%; margin: 0; background: #222; color: #eee; overflow: hidden; }
        /* The panel is the whole window here, not a floating dialog: the
           window's own frame does the moving and resizing, and the table
           scrolls inside it. */
        #dxSpotsDialog.dxs-popout {
            position: static;
            display: flex;
            flex-direction: column;
            width: 100%;
            height: 100%;
            min-width: 0;
            max-width: none;
            max-height: none;
            margin: 0;
            padding: 0;
            border: 0;
            background: #222;
            color: #eee;
        }
        #dxSpotsDialog.dxs-popout .dxs-header { flex: 0 0 auto; flex-wrap: wrap; gap: 0.4rem; }
        #dxSpotsDialog.dxs-popout .dxs-body { flex: 1 1 auto; min-height: 0; }
        .popout-screen-offer {
            font-size: 0.85rem; color: #cde; background: rgba(120, 170, 255, 0.10);
            border-left: 3px solid #78aaff; border-radius: 0.25rem;
            padding: 0.4rem 0.6rem; margin-bottom: 0.5rem;
        }
    </style>
</head>
<body>
    <partial name="_DxSpotsPartial" model="true" />

    <script>
        // band-plan.js reads this at call time: false means a click on a spot
        // only moves the frequency, never the mode (discussion #169).
        window.ywcAutoModeChangeOnTune = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.AutoModeChangeOnTune));
    </script>
    <script src="~/lib/microsoft-signalr/signalr.min.js"></script>
    @* Builds the hub connection with a retry policy that never gives up.
       This page has no _Layout, so it must load it itself. *@
    <script src="~/js/ui/hub-connection.js" asp-append-version="true"></script>
    <script type="module">
        import { DxSpotsPanel } from "/js/ui/dx-spots-panel.js?v=@Yaesu_Web_Control.AppVersion.Current";
        import { autoModeForHz } from "/js/ui/band-plan.js?v=1";
        import { PopoutChild, offerScreenPermission } from "/js/popout/popout.js?v=@Yaesu_Web_Control.AppVersion.Current";

        const popout = new PopoutChild({ name: 'dx-spots', fallbackUrl: '/' }).start();
        offerScreenPermission(document.querySelector('#dxSpotsDialog .dxs-body'));
        document.getElementById('dxSpotsReattachBtn')
            ?.addEventListener('click', () => popout.reattach());

        // The same CAT mode codes site.js's setMode sends; this page has no
        // site.js, so click-to-QSY goes straight to the API.
        const MODE_CODE = {
            'LSB': '1', 'USB': '2', 'CW-U': '3', 'FM': '4', 'AM': '5', 'RTTY-L': '6', 'CW-L': '7', 'DATA-L': '8',
            'RTTY-U': '9', 'DATA-FM': 'A', 'FM-N': 'B', 'DATA-U': 'C', 'AM-N': 'D', 'PSK': 'E', 'DATA-FM-N': 'F',
        };
        const post = (url, body) => fetch(url, {
            method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body),
        });
        async function tune(hz) {
            try {
                await post('/api/cat/frequency/a', { frequencyHz: hz });
                // Band-plan-aware mode change, as on the main page, unless the
                // operator has turned it off in Settings.
                const code = MODE_CODE[autoModeForHz(hz)];
                if (code) await post('/api/cat/mode/a', { mode: code });
            } catch (e) { console.error('[dx-spots-popout] QSY', e); }
        }

        // "Show only watched callsigns" is set in the main page's DX Watch
        // panel and kept in localStorage, so a change there arrives here as a
        // storage event.
        const readWatched = () => {
            try { window.dxOnlyWatched = localStorage.getItem('dxOnlyWatched') === '1'; } catch { window.dxOnlyWatched = false; }
        };
        readWatched();

        const panel = new DxSpotsPanel({ floating: false, tune });
        panel.init();
        panel.setVfoFrequency(@Model.FrequencyA);
        window.addEventListener('storage', e => {
            if (e.key === 'dxOnlyWatched') { readWatched(); panel.redraw(); }
        });

        const loadSpots = () => fetch('/api/dxcluster/spots')
            .then(r => r.ok ? r.json() : [])
            .then(arr => panel.setSpots(arr))
            .catch(() => { /* cluster off or host not ready */ });
        loadSpots();

        // New spots and VFO A moves. A reconnect reloads the list, since
        // spots that arrived while the link was down were never pushed here.
        // This connection is also what keeps the host running while this
        // window is the only one open: the page sets Layout = null, so there
        // is no site.js here.
        const conn = window.ywcHubConnection('/radioHub');
        conn.on('RadioStateUpdate', update => {
            if (update.property === 'DxSpot') panel.addSpot(update.value);
            else if (update.property === 'FrequencyA') panel.setVfoFrequency(update.value);
        });
        conn.onreconnected(loadSpots);
        conn.start().catch(err => console.error('[dx-spots-popout]', err));
    </script>
</body>
</html>
