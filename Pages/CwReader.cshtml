@page
@model Yaesu_Web_Control.Pages.CwReaderModel
@{
    Layout = null;
    ViewData["Title"] = "CW Reader";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="x-app-version" content="@Yaesu_Web_Control.AppVersion.Current">
    <title>CW Reader - Yaesu Web Control</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        html, body { height: 100%; margin: 0; background: #222; color: #eee; overflow: hidden; }
        /* The panel is the whole window here, not a floating dialog: the
           window's own frame does the moving and resizing. */
        #cwReaderDialog.cwr-popout {
            position: static;
            display: flex;
            flex-direction: column;
            width: 100%;
            height: 100%;
            min-width: 0;
            min-height: 0;
            max-width: none;
            max-height: none;
            margin: 0;
            padding: 0;
            border: 0;
            border-radius: 0;
            background: #222;
            color: #eee;
            resize: none;
            overflow: auto;
        }
        #cwReaderDialog.cwr-popout .cwr-header { cursor: default; flex-wrap: wrap; gap: 0.4rem; }
        #cwReaderDialog.cwr-popout .cwr-header > div { flex-wrap: wrap; }
        .popout-screen-offer {
            font-size: 0.85rem; color: #cde; background: rgba(120, 170, 255, 0.10);
            border-left: 3px solid #78aaff; border-radius: 0.25rem;
            padding: 0.4rem 0.6rem; margin-bottom: 0.5rem;
        }
    </style>
</head>
<body>
    <partial name="_CwReaderPartial" model="true" />
    <div id="cwReaderAnnounce" class="visually-hidden" role="status" aria-live="polite"></div>

    <script src="~/lib/microsoft-signalr/signalr.min.js"></script>
    @* Builds the hub connection with a retry policy that never gives up.
       This page has no _Layout, so it must load it itself. *@
    <script src="~/js/hub/hub-connection.js" asp-append-version="true"></script>
    <script type="module">
        import { CwReaderPanel }  from "/js/cw/cw-reader-panel.js?v=@Yaesu_Web_Control.AppVersion.Current";
        import { startModePausedPopout } from "/js/popout/popout-mode-pause.js?v=@Yaesu_Web_Control.AppVersion.Current";
        import { PopoutChild, offerScreenPermission } from "/js/popout/popout.js?v=@Yaesu_Web_Control.AppVersion.Current";

        const popout = new PopoutChild({ name: 'cw-reader', fallbackUrl: '/' }).start();
        offerScreenPermission(document.querySelector('#cwReaderDialog .cwr-body'));
        document.getElementById('cwReaderReattachBtn')
            ?.addEventListener('click', () => popout.reattach());

        const panel = new CwReaderPanel();
        panel.init({ standalone: true });

        const belongs = m => typeof m === 'string' && m.startsWith('CW');
        // The main page closes its CW reader once the mode has settled
        // outside CW. A window on a second monitor closing itself would be
        // worse than a dialog doing it, so this one pauses instead and picks
        // up again the moment the radio is back in CW. The decoder keeps
        // running on the server throughout, exactly as when the dialog closes.
        // startModePausedPopout (core) does the pausing and the resuming,
        // and starts at once only if the window opened in one of its modes.
        const modePause = startModePausedPopout({
            name: 'CW reader',
            panel: panel,
            belongs,
            pausedText: m =>
                `Not in CW mode (the radio is in ${m}), so the reader is paused. ` +
                'It picks up again when you go back to CW.',
            startNow: () => panel.startPolling(),
            initialMode: '@Model.ModeA',
            announceEl: document.getElementById('cwReaderAnnounce'),
        });

        // Mode changes, and the hub's state replay on connect. This
        // connection is also what keeps the host running while this window is
        // the only one open: the page sets Layout = null, so there is no
        // site.js here.
        const conn = window.rwcHubConnection('/radioHub');
        conn.on('RadioStateUpdate', update => {
            if (update.property === 'ModeA') modePause.setMode(update.value);
        });
        conn.start().catch(err => console.error('[cw-reader-popout]', err));
    </script>
</body>
</html>
