@page
@model Yaesu_Web_Control.Pages.MemoriesModel
@{
    ViewData["Title"] = "Radio Memories";

    var allModes = new[] {
        "LSB", "USB", "CW-U", "CW-L", "FM", "FM-N", "AM", "AM-N",
        "RTTY-L", "RTTY-U", "DATA-L", "DATA-U", "DATA-FM", "DATA-FM-N", "PSK"
    };
}

<style>
    /* Sortable headings: the whole cell is the click target, and it looks like one. */
    #memoriesTable th.sort-th { cursor: pointer; }
    #memoriesTable th.sort-th:hover .sort-btn { text-decoration: underline !important; }
    #memoriesTable .sort-arrow { display: inline-block; min-width: 1em; }
</style>

<div class="mt-4">

    <div class="d-flex align-items-baseline gap-3 mb-2 flex-wrap">
        <h2 class="mb-0">Radio Memories</h2>
        <a href="/Memories" target="_blank" rel="noopener" class="btn btn-sm btn-outline-secondary" title="Open in new tab for use on a second monitor or tablet">
            <i class="bi bi-box-arrow-up-right"></i> Pop Out
        </a>
    </div>

    <p class="text-muted mb-3">
        Edit memory labels, frequencies, and modes here, then click <strong>Save</strong>.
        On the main page, click <strong>Mem</strong> to open the floating memory panel and tune the radio to any memory.
    </p>

    @if (!string.IsNullOrEmpty(Model.StatusMessage))
    {
        <div class="alert @(Model.StatusMessage.Contains("✓") ? "alert-success" : "alert-danger") alert-dismissible fade show" role="alert">
            @Model.StatusMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div id="importExportStatus" class="alert d-none" role="status" aria-live="polite"></div>

    <!-- Memory Banks -->
    <div class="card mb-3 border-secondary">
        <div class="card-body py-2 px-3">
            <div class="d-flex align-items-center gap-2 flex-wrap">
                <span class="fw-bold me-1">Memory Banks:</span>
                <select id="bankSelect" class="form-select form-select-sm" style="width:auto;min-width:160px"
                        onchange="updateBankButtons()">
                    <option value="">-- Select bank --</option>
                </select>
                <button type="button" class="btn btn-sm btn-outline-primary" id="loadBankBtn"
                        onclick="loadBank()" disabled
                        title="Replace current app memories with this bank">
                    <i class="bi bi-box-arrow-in-down" aria-hidden="true"></i> Load
                </button>
                <button type="button" class="btn btn-sm btn-outline-success"
                        onclick="saveBankAs()"
                        title="Save current app memories as a named bank">
                    <i class="bi bi-floppy" aria-hidden="true"></i> Save As…
                </button>
                <button type="button" class="btn btn-sm btn-outline-danger" id="deleteBankBtn"
                        onclick="deleteBank()" disabled
                        title="Delete this bank">
                    <i class="bi bi-trash" aria-hidden="true"></i> Delete
                </button>
                <button type="button" class="btn btn-sm btn-outline-info"
                        onclick="createThemedBanks()"
                        title="Split the YWC starter bank into themed banks (FT8, CW, SSB, RTTY, FM) you can load individually">
                    <i class="bi bi-collection" aria-hidden="true"></i> Create themed banks…
                </button>
                <span id="bankStatus" class="text-muted small ms-2"></span>
            </div>
        </div>
    </div>

    <!-- Import / Export bar -->
    <div class="card mb-3 border-secondary">
        <div class="card-body py-2 px-3">
            <div class="d-flex align-items-center gap-2 flex-wrap">
                <span class="fw-bold me-1">Radio Channels:</span>
                <button type="button" class="btn btn-sm btn-outline-primary" id="importReplaceBtn"
                        onclick="importFromRadio('replace')"
                        title="Read channels 001–099 from radio and replace all app memories">
                    <i class="bi bi-cloud-download" aria-hidden="true"></i> Import (Replace)
                </button>
                <button type="button" class="btn btn-sm btn-outline-secondary" id="importMergeBtn"
                        onclick="importFromRadio('merge')"
                        title="Read channels 001–099 from radio and add to existing app memories">
                    <i class="bi bi-cloud-download" aria-hidden="true"></i> Import (Add)
                </button>
                <button type="button" class="btn btn-sm btn-outline-warning" id="exportBtn"
                        onclick="exportToRadio()"
                        title="Write app memories to radio channels 001 onwards">
                    <i class="bi bi-cloud-upload" aria-hidden="true"></i> Export to Radio
                </button>
                <span id="radioProgress" class="text-muted small ms-2" style="display:none;">
                    <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                    <span id="radioProgressText">Working…</span>
                </span>
            </div>
        </div>
    </div>

    <!-- ADIF import — bring favourite frequencies from a logger -->
    <div class="card mb-3 border-secondary">
        <div class="card-body py-2 px-3">
            <div class="d-flex align-items-center gap-2 flex-wrap">
                <span class="fw-bold me-1">ADIF import:</span>
                <label class="btn btn-sm btn-outline-info mb-0" for="adifImportFile"
                       title="Read an ADIF log file and turn each unique frequency/mode pair into a YWC memory">
                    <i class="bi bi-cloud-download" aria-hidden="true"></i> Import from ADIF…
                </label>
                <input type="file" id="adifImportFile" accept=".adi,.adif,.txt" hidden>
                <span id="adifImportStatus" class="text-muted small ms-2"></span>
            </div>
            <p class="text-muted small mb-0 mt-1">
                Reads QSO records from a Log4OM (or any standard ADIF) export and creates a memory for each unique frequency/mode pair.
                Duplicates of memories you already have are skipped, so re-importing the same file is safe.
            </p>
        </div>
    </div>

    <!-- Memory editor form -->
    <form method="post">
        <div class="d-flex align-items-center gap-2 mb-2">
            <div class="form-check form-switch mb-0">
                <input class="form-check-input" type="checkbox" role="switch" id="showAdvanced"
                       onchange="toggleAdvanced(this.checked)">
                <label class="form-check-label" for="showAdvanced">Show advanced fields</label>
            </div>
            <span class="text-muted small">
                Antenna, IF Width/Shift, Roofing, NB, NR, AGC, Power, Notes —
                applied on recall only if set. Not exported to the radio's own memory channels.
            </span>
        </div>
        <p class="text-muted small mb-2">
            The order here is the order of the Mem panel tiles and the order memories go to the radio
            (Export writes the first 99). Click <strong>Label</strong>, <strong>Frequency</strong> or
            <strong>Mode</strong> to sort, or use the row buttons to move one memory.
            <span id="orderHint" class="fw-bold text-warning-emphasis" role="status" aria-live="polite"></span>
        </p>
        <div class="table-responsive">
            <table class="table table-sm table-striped table-hover mb-3" id="memoriesTable">
                <thead class="table-dark">
                    <tr>
                        <th style="width:40px">#</th>
                        <th style="min-width:140px" aria-sort="none" data-sort-key="label" class="sort-th" onclick="if (event.target === this) this.querySelector('button').click()">
                            <button type="button" class="btn btn-link btn-sm p-0 text-reset text-decoration-none fw-bold sort-btn d-block w-100 text-start"
                                    onclick="sortRows('label', this)" title="Sort by label">
                                Label <span class="sort-arrow" aria-hidden="true"></span>
                            </button>
                        </th>
                        <th style="min-width:130px" aria-sort="none" data-sort-key="freq" class="sort-th" onclick="if (event.target === this) this.querySelector('button').click()">
                            <button type="button" class="btn btn-link btn-sm p-0 text-reset text-decoration-none fw-bold sort-btn d-block w-100 text-start"
                                    onclick="sortRows('freq', this)" title="Sort by frequency">
                                Frequency (MHz) <span class="sort-arrow" aria-hidden="true"></span>
                            </button>
                        </th>
                        <th style="min-width:100px" aria-sort="none" data-sort-key="mode" class="sort-th" onclick="if (event.target === this) this.querySelector('button').click()">
                            <button type="button" class="btn btn-link btn-sm p-0 text-reset text-decoration-none fw-bold sort-btn d-block w-100 text-start"
                                    onclick="sortRows('mode', this)" title="Sort by mode, then frequency">
                                Mode <span class="sort-arrow" aria-hidden="true"></span>
                            </button>
                        </th>
                        <th style="min-width:100px">Clarifier (Hz)</th>
                        <th style="width:70px">RX Clar</th>
                        <th style="width:70px">TX Clar</th>
                        <th class="advanced-col" style="min-width:70px; display:none">Ant</th>
                        <th class="advanced-col" style="min-width:90px; display:none">IF Width</th>
                        <th class="advanced-col" style="min-width:90px; display:none">IF Shift</th>
                        <th class="advanced-col" style="min-width:90px; display:none">Roofing</th>
                        <th class="advanced-col" style="width:60px; display:none">NB</th>
                        <th class="advanced-col" style="width:70px; display:none">NB Lvl</th>
                        <th class="advanced-col" style="min-width:80px; display:none">NR</th>
                        <th class="advanced-col" style="min-width:80px; display:none">AGC</th>
                        <th class="advanced-col" style="width:80px; display:none">Power</th>
                        <th class="advanced-col" style="min-width:140px; display:none">Notes</th>
                        <th style="width:150px"><span class="visually-hidden">Move or delete</span></th>
                    </tr>
                </thead>
                <tbody>
                    @for (int i = 0; i < Model.Memories.Count; i++)
                    {
                        var m = Model.Memories[i];
                        <tr>
                            <td class="align-middle text-muted small row-num">@(i + 1)</td>
                            <td>
                                <input type="hidden" name="Memories[@i].Id" value="@m.Id" />
                                <input type="hidden" class="sort-order" name="Memories[@i].SortOrder" value="@m.SortOrder" />
                                <input class="form-control form-control-sm"
                                       name="Memories[@i].Label"
                                       value="@m.Label"
                                       maxlength="12"
                                       autocomplete="off"
                                       placeholder="e.g. 20m FT8" />
                            </td>
                            <td>
                                <input class="form-control form-control-sm"
                                       type="number"
                                       value="@(m.FrequencyHz > 0 ? (m.FrequencyHz / 1_000_000.0).ToString("F3", System.Globalization.CultureInfo.InvariantCulture) : "")"
                                       min="0.03"
                                       max="75"
                                       step="0.001"
                                       placeholder="e.g. 14.074"
                                       oninput="updateFreqHz(this, @i)" />
                                <input type="hidden"
                                       id="freqHz_@i"
                                       name="Memories[@i].FrequencyHz"
                                       value="@m.FrequencyHz" />
                            </td>
                            <td>
                                <select class="form-select form-select-sm" name="Memories[@i].Mode">
                                    @foreach (var mode in allModes)
                                    {
                                        <option value="@mode" selected="@(m.Mode == mode ? "selected" : null)">@mode</option>
                                    }
                                </select>
                            </td>
                            <td>
                                <input class="form-control form-control-sm"
                                       name="Memories[@i].ClarifierOffsetHz"
                                       type="number"
                                       value="@m.ClarifierOffsetHz"
                                       min="-9990" max="9990" step="10" />
                            </td>
                            <td class="text-center align-middle">
                                <input class="form-check-input" type="checkbox"
                                       name="Memories[@i].RxClarOn"
                                       value="true"
                                       @(m.RxClarOn ? "checked" : "") />
                                <input type="hidden" name="Memories[@i].RxClarOn" value="false" />
                            </td>
                            <td class="text-center align-middle">
                                <input class="form-check-input" type="checkbox"
                                       name="Memories[@i].TxClarOn"
                                       value="true"
                                       @(m.TxClarOn ? "checked" : "") />
                                <input type="hidden" name="Memories[@i].TxClarOn" value="false" />
                            </td>
                            <td class="advanced-col" style="display:none">
                                <select class="form-select form-select-sm" name="Memories[@i].Antenna">
                                    <option value="" selected="@(string.IsNullOrEmpty(m.Antenna) ? "selected" : null)">—</option>
                                    <option value="1" selected="@(m.Antenna == "1" ? "selected" : null)">1</option>
                                    <option value="2" selected="@(m.Antenna == "2" ? "selected" : null)">2</option>
                                    <option value="3" selected="@(m.Antenna == "3" ? "selected" : null)">3</option>
                                </select>
                            </td>
                            <td class="advanced-col" style="display:none">
                                <input class="form-control form-control-sm"
                                       name="Memories[@i].IfWidthCode"
                                       value="@m.IfWidthCode"
                                       placeholder="—"
                                       title="SH command code (raw integer, e.g. 8)" />
                            </td>
                            <td class="advanced-col" style="display:none">
                                <input class="form-control form-control-sm"
                                       name="Memories[@i].IfShiftHz"
                                       type="number"
                                       value="@(m.IfShiftHz?.ToString() ?? "")"
                                       min="-1000" max="1000" step="20"
                                       placeholder="—" />
                            </td>
                            <td class="advanced-col" style="display:none">
                                <input class="form-control form-control-sm"
                                       name="Memories[@i].RoofingCode"
                                       value="@m.RoofingCode"
                                       placeholder="—"
                                       title="Roofing filter code (6=12kHz, 7=3kHz, 8=1.2kHz, 9=600Hz, A=300Hz)" />
                            </td>
                            <td class="advanced-col text-center align-middle" style="display:none">
                                <select class="form-select form-select-sm" name="Memories[@i].NbOn">
                                    <option value="" selected="@(m.NbOn == null ? "selected" : null)">—</option>
                                    <option value="true" selected="@(m.NbOn == true ? "selected" : null)">On</option>
                                    <option value="false" selected="@(m.NbOn == false ? "selected" : null)">Off</option>
                                </select>
                            </td>
                            <td class="advanced-col" style="display:none">
                                <input class="form-control form-control-sm"
                                       name="Memories[@i].NbLevel"
                                       type="number"
                                       value="@(m.NbLevel?.ToString() ?? "")"
                                       min="1" max="20"
                                       placeholder="—" />
                            </td>
                            <td class="advanced-col" style="display:none">
                                <select class="form-select form-select-sm" name="Memories[@i].NrLevel">
                                    <option value="" selected="@(string.IsNullOrEmpty(m.NrLevel) ? "selected" : null)">—</option>
                                    <option value="0" selected="@(m.NrLevel == "0" ? "selected" : null)">Off</option>
                                    <option value="1" selected="@(m.NrLevel == "1" ? "selected" : null)">On</option>
                                </select>
                            </td>
                            <td class="advanced-col" style="display:none">
                                <select class="form-select form-select-sm" name="Memories[@i].AgcMode">
                                    <option value="" selected="@(string.IsNullOrEmpty(m.AgcMode) ? "selected" : null)">—</option>
                                    <option value="0" selected="@(m.AgcMode == "0" ? "selected" : null)">Off</option>
                                    <option value="1" selected="@(m.AgcMode == "1" ? "selected" : null)">Fast</option>
                                    <option value="2" selected="@(m.AgcMode == "2" ? "selected" : null)">Mid</option>
                                    <option value="3" selected="@(m.AgcMode == "3" ? "selected" : null)">Slow</option>
                                    <option value="4" selected="@(m.AgcMode == "4" ? "selected" : null)">Auto</option>
                                </select>
                            </td>
                            <td class="advanced-col" style="display:none">
                                <input class="form-control form-control-sm"
                                       name="Memories[@i].PowerWatts"
                                       type="number"
                                       value="@(m.PowerWatts?.ToString() ?? "")"
                                       min="5" max="200"
                                       placeholder="—" />
                            </td>
                            <td class="advanced-col" style="display:none">
                                <input class="form-control form-control-sm"
                                       name="Memories[@i].Notes"
                                       value="@m.Notes"
                                       maxlength="100"
                                       placeholder="(notes)" />
                            </td>
                            <td class="text-nowrap">
                                <button type="button" class="btn btn-sm btn-outline-secondary"
                                        aria-label="Move memory @(i + 1) to the top"
                                        title="Move to top"
                                        onclick="moveRow(this, 'top')">
                                    <i class="bi bi-chevron-double-up" aria-hidden="true"></i>
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-secondary"
                                        aria-label="Move memory @(i + 1) up one"
                                        title="Move up"
                                        onclick="moveRow(this, 'up')">
                                    <i class="bi bi-chevron-up" aria-hidden="true"></i>
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-secondary"
                                        aria-label="Move memory @(i + 1) down one"
                                        title="Move down"
                                        onclick="moveRow(this, 'down')">
                                    <i class="bi bi-chevron-down" aria-hidden="true"></i>
                                </button>
                                <button type="submit" asp-page-handler="Delete"
                                        asp-route-id="@m.Id"
                                        class="btn btn-sm btn-outline-danger"
                                        aria-label="Delete memory @(i + 1)"
                                        title="Delete this memory"
                                        onclick="event.preventDefault(); confirmDelete(this)">
                                    <i class="bi bi-trash" aria-hidden="true"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="d-flex gap-2 mb-4 flex-wrap">
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-check-lg" aria-hidden="true"></i> Save
            </button>
            <button type="submit" asp-page-handler="Add" class="btn btn-outline-success">
                <i class="bi bi-plus-lg" aria-hidden="true"></i> Add Memory
            </button>
        </div>
    </form>

</div>

@section Scripts {
<script>
    // Show/hide advanced columns. Persists the choice in localStorage so
    // returning to the page keeps the previous view.
    function toggleAdvanced(show) {
        document.querySelectorAll('.advanced-col').forEach(el => {
            el.style.display = show ? '' : 'none';
        });
        try { localStorage.setItem('mem_show_advanced', show ? '1' : '0'); } catch {}
    }
    document.addEventListener('DOMContentLoaded', () => {
        let saved = '0';
        try { saved = localStorage.getItem('mem_show_advanced') || '0'; } catch {}
        if (saved === '1') {
            const sw = document.getElementById('showAdvanced');
            if (sw) { sw.checked = true; toggleAdvanced(true); }
        }
    });

    function updateFreqHz(input, index) {
        const mhz = parseFloat(input.value);
        const hidden = document.getElementById('freqHz_' + index);
        if (hidden) hidden.value = isNaN(mhz) ? '' : Math.round(mhz * 1_000_000);
    }

    // ── Row order ─────────────────────────────────────────────────────────────
    // The form binds each row by its Memories[i] index, which never changes:
    // moving a <tr> in the DOM moves nothing on the server. What the server
    // sorts on is the hidden SortOrder field, so every reorder here rewrites
    // that field to the row's new position and renumbers the # column. The
    // order is only kept once Save is pressed, and the hint says so.

    function _rows() {
        return Array.from(document.querySelectorAll('#memoriesTable tbody tr'));
    }

    function _rowValue(tr, key) {
        if (key === 'label') return (tr.querySelector('input[name$=".Label"]')?.value || '').trim().toLowerCase();
        if (key === 'freq')  return parseInt(tr.querySelector('input[name$=".FrequencyHz"]')?.value, 10) || 0;
        if (key === 'mode')  return tr.querySelector('select[name$=".Mode"]')?.value || '';
        return '';
    }

    function _renumber(announcement) {
        _rows().forEach((tr, i) => {
            tr.querySelector('.row-num').textContent = i + 1;
            tr.querySelector('.sort-order').value = i + 1;
            const n = i + 1;
            tr.querySelectorAll('td:last-child button').forEach(b => {
                const label = b.getAttribute('aria-label') || '';
                b.setAttribute('aria-label', label.replace(/memory \d+/, 'memory ' + n));
            });
        });
        const hint = document.getElementById('orderHint');
        if (hint) hint.textContent = announcement + ' Press Save to keep this order.';
    }

    function sortRows(key, btn) {
        const th = btn.closest('th');
        const dir = th.getAttribute('aria-sort') === 'ascending' ? 'descending' : 'ascending';
        document.querySelectorAll('#memoriesTable th[data-sort-key]').forEach(h => {
            h.setAttribute('aria-sort', 'none');
            h.querySelector('.sort-arrow').textContent = '';
        });
        th.setAttribute('aria-sort', dir);
        th.querySelector('.sort-arrow').textContent = dir === 'ascending' ? '\u25B2' : '\u25BC';

        const sign = dir === 'ascending' ? 1 : -1;
        const rows = _rows().map((tr, i) => ({ tr, i, v: _rowValue(tr, key), f: _rowValue(tr, 'freq') }));
        rows.sort((a, b) => {
            let c = a.v < b.v ? -1 : a.v > b.v ? 1 : 0;
            if (c === 0 && key === 'mode') c = a.f < b.f ? -1 : a.f > b.f ? 1 : 0;
            if (c === 0) c = a.i - b.i;   // stable: ties keep their existing order
            return c * sign;
        });
        const tbody = document.querySelector('#memoriesTable tbody');
        rows.forEach(r => tbody.appendChild(r.tr));
        const name = key === 'freq' ? 'frequency' : key;
        _renumber(`Sorted by ${name}, ${dir}.`);
    }

    function moveRow(btn, where) {
        const tr = btn.closest('tr');
        const tbody = tr.parentElement;
        const label = (tr.querySelector('input[name$=".Label"]')?.value || '').trim() || 'memory';
        if (where === 'top') {
            if (tr === tbody.firstElementChild) return;
            tbody.insertBefore(tr, tbody.firstElementChild);
        } else if (where === 'up') {
            const prev = tr.previousElementSibling;
            if (!prev) return;
            tbody.insertBefore(tr, prev);
        } else if (where === 'down') {
            const next = tr.nextElementSibling;
            if (!next) return;
            tbody.insertBefore(next, tr);
        }
        document.querySelectorAll('#memoriesTable th[data-sort-key]').forEach(h => {
            h.setAttribute('aria-sort', 'none');
            h.querySelector('.sort-arrow').textContent = '';
        });
        const pos = _rows().indexOf(tr) + 1;
        _renumber(`${label} is now number ${pos}.`);
        btn.focus();
    }

    function pageConfirm(message) {
        return new Promise(resolve => {
            const dlg = document.createElement('dialog');
            dlg.style.cssText = 'border-radius:8px;border:1px solid #aaa;padding:20px 24px;max-width:420px;width:90vw;z-index:9999;box-shadow:0 8px 30px rgba(0,0,0,0.3)';
            dlg.innerHTML =
                `<p style="margin:0 0 18px;white-space:pre-wrap;font-size:0.9rem;line-height:1.5">${message}</p>` +
                `<div style="display:flex;justify-content:flex-end;gap:8px">` +
                `<button data-r="0" class="btn btn-secondary btn-sm">Cancel</button>` +
                `<button data-r="1" class="btn btn-primary btn-sm">OK</button>` +
                `</div>`;
            document.body.appendChild(dlg);
            dlg.showModal();
            function finish(v) { dlg.close(); dlg.remove(); resolve(v); }
            dlg.querySelectorAll('button').forEach(b =>
                b.addEventListener('click', () => finish(b.dataset.r === '1')));
            dlg.addEventListener('cancel', () => finish(false));
        });
    }

    async function confirmDelete(btn) {
        if (!await pageConfirm('Delete this memory?\n\nThis cannot be undone.')) return;
        btn.form.requestSubmit(btn);
    }

    function _spinner(text) {
        return `<span class="spinner-border spinner-border-sm me-2 align-middle" role="status" aria-hidden="true"></span>${text}`;
    }

    function _reloadLink() {
        return ' <a href="/Memories" style="font-weight:bold">Reload page to see updated list</a>';
    }

    // ── Memory Banks ──────────────────────────────────────────────────────────

    function escHtml(str) {
        return String(str || '')
            .replace(/&/g, '&amp;').replace(/</g, '&lt;')
            .replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }

    function pagePrompt(message, defaultValue) {
        return new Promise(resolve => {
            const dlg = document.createElement('dialog');
            dlg.style.cssText = 'border-radius:8px;border:1px solid #aaa;padding:20px 24px;max-width:420px;width:90vw;z-index:9999;box-shadow:0 8px 30px rgba(0,0,0,0.3)';
            dlg.innerHTML =
                `<p style="margin:0 0 12px;font-size:0.9rem">${escHtml(message)}</p>` +
                `<input type="text" id="dlgInput" class="form-control form-control-sm mb-3" ` +
                `value="${escHtml(defaultValue || '')}" maxlength="50" autocomplete="off" />` +
                `<div style="display:flex;justify-content:flex-end;gap:8px">` +
                `<button data-r="0" class="btn btn-secondary btn-sm">Cancel</button>` +
                `<button data-r="1" class="btn btn-primary btn-sm">OK</button>` +
                `</div>`;
            document.body.appendChild(dlg);
            dlg.showModal();
            const input = dlg.querySelector('#dlgInput');
            input.focus(); input.select();
            function finish(v) { dlg.close(); dlg.remove(); resolve(v); }
            dlg.querySelector('[data-r="1"]').addEventListener('click', () => finish(input.value));
            dlg.querySelector('[data-r="0"]').addEventListener('click', () => finish(null));
            dlg.addEventListener('cancel', () => finish(null));
            input.addEventListener('keydown', e => {
                if (e.key === 'Enter') finish(input.value);
                if (e.key === 'Escape') { e.preventDefault(); finish(null); }
            });
        });
    }

    // Sentinel value for the built-in YWC starter bank option in the Banks
    // dropdown. Real user-saved bank names can't collide because the bank
    // controller rejects names containing path-unsafe characters.
    const STARTER_BANK_VALUE = '__ywc_starter__';

    function updateBankButtons() {
        const sel = document.getElementById('bankSelect');
        const has = sel && sel.value !== '';
        const isStarter = sel && sel.value === STARTER_BANK_VALUE;
        const load = document.getElementById('loadBankBtn');
        const del  = document.getElementById('deleteBankBtn');
        if (load) load.disabled = !has;
        // Built-in starter bank cannot be deleted
        if (del)  del.disabled  = !has || isStarter;
    }

    async function loadBanks(selectName) {
        const sel = document.getElementById('bankSelect');
        if (!sel) return;
        try {
            const resp = await fetch('/api/memorybank');
            const names = await resp.json();
            const current = selectName !== undefined ? selectName : sel.value;
            // Always prepend the built-in starter bank option after the placeholder
            const starterOption = `<option value="${STARTER_BANK_VALUE}"${current === STARTER_BANK_VALUE ? ' selected' : ''}>📥 YWC Starter Bank (built-in)</option>`;
            sel.innerHTML = '<option value="">-- Select bank --</option>' +
                starterOption +
                names.map(n => `<option value="${escHtml(n)}"${n === current ? ' selected' : ''}>${escHtml(n)}</option>`).join('');
            updateBankButtons();
        } catch {}
    }

    async function loadBank() {
        const sel = document.getElementById('bankSelect');
        const name = sel?.value;
        if (!name) return;

        const isStarter = name === STARTER_BANK_VALUE;
        const displayName = isStarter ? 'YWC Starter Bank' : name;
        if (!await pageConfirm(
            `Load bank "${displayName}"?\n\nThis will replace your current app memories. Any unsaved changes will be lost.\n\nContinue?`)) return;

        const statusEl = document.getElementById('bankStatus');
        statusEl.textContent = 'Loading…';
        try {
            // Built-in starter bank is loaded through its own endpoint; user
            // banks go through /api/memorybank. Both produce the same end
            // result — current memories replaced with the bank's contents.
            const url    = isStarter ? '/api/memory/starter-bank/load'                          : `/api/memorybank/${encodeURIComponent(name)}/load`;
            const init   = isStarter
                ? { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ mode: 'replace' }) }
                : { method: 'POST' };
            const resp = await fetch(url, init);
            if (resp.ok) {
                location.reload();
            } else {
                statusEl.textContent = '✗ Load failed';
            }
        } catch {
            statusEl.textContent = '✗ Error';
        }
    }

    async function saveBankAs() {
        const sel = document.getElementById('bankSelect');
        const name = await pagePrompt('Save current memories as bank:', sel?.value || '');
        if (name === null || name.trim() === '') return;
        const trimmed = name.trim();

        const r0 = await fetch('/api/memorybank');
        const existing = await r0.json();
        if (existing.includes(trimmed)) {
            if (!await pageConfirm(`Bank "${trimmed}" already exists.\n\nOverwrite it with the current memories?`)) return;
        }

        const statusEl = document.getElementById('bankStatus');
        statusEl.textContent = 'Saving…';
        try {
            const resp = await fetch('/api/memorybank/save', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ name: trimmed })
            });
            if (resp.ok) {
                await loadBanks(trimmed);
                statusEl.textContent = `✓ Saved as "${trimmed}"`;
            } else {
                statusEl.textContent = '✗ Save failed';
            }
        } catch {
            statusEl.textContent = '✗ Error';
        }
    }

    async function deleteBank() {
        const sel = document.getElementById('bankSelect');
        const name = sel?.value;
        if (!name) return;
        if (!await pageConfirm(`Delete bank "${name}"?\n\nThis cannot be undone.`)) return;

        const statusEl = document.getElementById('bankStatus');
        statusEl.textContent = 'Deleting…';
        try {
            const resp = await fetch(`/api/memorybank/${encodeURIComponent(name)}`, { method: 'DELETE' });
            if (resp.ok) {
                await loadBanks('');
                statusEl.textContent = `✓ Bank "${name}" deleted`;
            } else {
                statusEl.textContent = '✗ Delete failed';
            }
        } catch {
            statusEl.textContent = '✗ Error';
        }
    }

    // Split the bundled region starter bank into themed banks (FT8, CW, SSB,
    // RTTY, FM) and save each non-empty slice as a named bank the user can
    // load individually. First pass leaves existing banks of the same name
    // alone; user can opt in to overwriting any clashing names.
    async function createThemedBanks() {
        if (!await pageConfirm(
            'Create themed banks from the YWC starter bank?\n\n' +
            'This will create banks named FT8, FT4, CW, SSB, RTTY and FM\n' +
            '(skipping any that are empty for your region).\n\n' +
            'Existing banks with the same name will be left untouched —\n' +
            'you\'ll be asked separately if any are found.')) return;

        const statusEl = document.getElementById('bankStatus');
        statusEl.textContent = 'Creating themed banks…';
        try {
            let resp = await fetch('/api/memory/starter-bank/create-themed-banks', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ overwrite: false })
            });
            if (!resp.ok) { statusEl.textContent = '✗ Create failed'; return; }
            let result = await resp.json();

            // If any themed names clashed with existing banks, offer to
            // overwrite. Users who maintain a hand-edited 'FT8' bank can say
            // no and keep their version.
            if (result.skipped && result.skipped.length > 0) {
                const list = result.skipped.join(', ');
                if (await pageConfirm(
                    `These banks already exist and were not changed:\n  ${list}\n\n` +
                    'Overwrite them with the starter-bank versions?')) {
                    resp = await fetch('/api/memory/starter-bank/create-themed-banks', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ overwrite: true })
                    });
                    if (resp.ok) result = await resp.json();
                }
            }

            await loadBanks();
            const createdNote = result.created.length > 0
                ? `✓ Created ${result.created.length} themed bank${result.created.length === 1 ? '' : 's'}: ${result.created.join(', ')}`
                : '✓ No banks created — all themed names already exist (and overwrite was declined).';
            statusEl.textContent = createdNote;
        } catch {
            statusEl.textContent = '✗ Error';
        }
    }

    loadBanks();

    // ── ADIF import wiring ───────────────────────────────────────────────
    (function () {
        const fileInput = document.getElementById('adifImportFile');
        const statusEl  = document.getElementById('adifImportStatus');
        if (!fileInput) return;
        fileInput.addEventListener('change', async () => {
            if (!fileInput.files || fileInput.files.length === 0) return;
            const file = fileInput.files[0];
            const ok = await pageConfirm(
                `Import memories from "${file.name}"?\n\n` +
                `YWC will read every QSO record and create a memory for each unique frequency/mode pair. ` +
                `Memories with labels that already exist are skipped, so this is safe to run repeatedly.`);
            if (!ok) { fileInput.value = ''; return; }

            statusEl.textContent = 'Reading…';
            statusEl.className = 'text-muted small ms-2';
            const fd = new FormData();
            fd.append('file', file);
            try {
                const resp = await fetch('/api/memory/import-adif', { method: 'POST', body: fd });
                const data = await resp.json().catch(() => ({}));
                if (!resp.ok) {
                    statusEl.textContent = `✗ ${data.error || resp.statusText}`;
                    statusEl.className = 'text-danger small ms-2';
                    return;
                }
                statusEl.textContent = data.message || `Added ${data.added} memor${data.added === 1 ? 'y' : 'ies'}.`;
                statusEl.className = 'text-success small ms-2';
                if (data.added > 0) {
                    setTimeout(() => location.reload(), 1500);
                }
            } catch (e) {
                statusEl.textContent = `✗ ${e.message}`;
                statusEl.className = 'text-danger small ms-2';
            } finally {
                fileInput.value = '';
            }
        });
    })();

    const _allBtns = () => ['importReplaceBtn','importMergeBtn','exportBtn']
        .map(id => document.getElementById(id));

    async function importFromRadio(mode) {
        const msg = mode === 'replace'
            ? 'Load from Rig (Replace all):\n\nThis will replace ALL app memories with channels read from the radio. Your current app memories will be lost.\n\nContinue?'
            : 'Load from Rig (Add new):\n\nThis will add radio channels to your existing app memories. Nothing will be deleted.\n\nContinue?';
        if (!await pageConfirm(msg)) return;

        const btns = _allBtns();
        btns.forEach(b => b && (b.disabled = true));

        const statusEl = document.getElementById('importExportStatus');
        statusEl.className = 'alert alert-info';
        statusEl.innerHTML = _spinner('Reading channels 001–099 from radio. This may take up to 30 seconds…');
        statusEl.classList.remove('d-none');

        try {
            const resp = await fetch('/api/memory/import-radio', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ mode })
            });
            if (resp.ok) {
                const data = await resp.json();
                if (data.warning) {
                    statusEl.className = 'alert alert-warning';
                    statusEl.textContent = `⚠ ${data.warning}`;
                } else {
                    statusEl.className = 'alert alert-success';
                    statusEl.innerHTML = `✓ Loaded ${data.imported} from rig.` + _reloadLink();
                }
            } else {
                statusEl.className = 'alert alert-danger';
                statusEl.textContent = 'Load failed. Check that the radio is connected.';
            }
        } catch (e) {
            statusEl.className = 'alert alert-danger';
            statusEl.textContent = 'Load error: ' + e.message;
        } finally {
            btns.forEach(b => b && (b.disabled = false));
        }
    }

    async function exportToRadio() {
        const count = document.querySelectorAll('#memoriesTable tbody tr').length;
        if (!await pageConfirm(
            `Save to Rig (Replace all):\n\nThis will write ${count} app ${count === 1 ? 'memory' : 'memories'} to the radio, replacing ALL existing radio channels.\n\nAny memories on the rig that are not in the app will be lost.\n\nContinue?`))
            return;

        const btns = _allBtns();
        btns.forEach(b => b && (b.disabled = true));

        const statusEl = document.getElementById('importExportStatus');
        statusEl.className = 'alert alert-info';
        statusEl.innerHTML = _spinner('Writing memories to radio…');
        statusEl.classList.remove('d-none');

        try {
            const resp = await fetch('/api/memory/export-radio', { method: 'POST' });
            if (resp.ok) {
                const data = await resp.json();
                statusEl.className = 'alert alert-success';
                statusEl.textContent = `✓ Saved ${data.written} to rig.`;
            } else {
                statusEl.className = 'alert alert-danger';
                statusEl.textContent = 'Save failed. Check that the radio is connected.';
            }
        } catch (e) {
            statusEl.className = 'alert alert-danger';
            statusEl.textContent = 'Export error: ' + e.message;
        } finally {
            btns.forEach(b => b && (b.disabled = false));
        }
    }
</script>
}
