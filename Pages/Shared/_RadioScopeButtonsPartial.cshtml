@model string
@{
    // Shared CAT scope buttons: span, display type/placement/size, speed,
    // MULTI (disabled until a CAT command exists), AF-FFT ATT, OSC ATT/time.
    // Included from the standalone Radio Scope card and the Radio Display
    // toolbar. Query by class inside a root element — never by global id —
    // so the two hosts do not collide if both ever land on one page.
    var radioModel   = Model ?? "";
    var sizeLabels   = Yaesu_Web_Control.Services.RadioCapabilities.ScopeSizeLabels(radioModel);
    var speedLabels  = Yaesu_Web_Control.Services.RadioCapabilities.ScopeSpeedLabels(radioModel);
    var hasAfFft     = Yaesu_Web_Control.Services.RadioCapabilities.SupportsScopeAfFft(radioModel);
    var hasMulti     = Yaesu_Web_Control.Services.RadioCapabilities.SupportsScopeMulti(radioModel);
    var spans = new (string Value, string Label)[]
    {
        ("0", "1k"), ("1", "2k"), ("2", "5k"), ("3", "10k"), ("4", "20k"),
        ("5", "50k"), ("6", "100k"), ("7", "200k"), ("8", "500k"), ("9", "1M")
    };
    var fftAtts = new (string Value, string Label)[] { ("0", "0 dB"), ("1", "10 dB"), ("2", "20 dB") };
    var oscTimes = new (string Value, string Label)[]
    {
        ("0", "1 ms"), ("1", "3 ms"), ("2", "10 ms"),
        ("3", "30 ms"), ("4", "100 ms"), ("5", "300 ms")
    };
    string SizeTitle(string s) => s switch
    {
        "L"      => "Large",
        "N"      => "Normal",
        "S"      => "Small",
        _        => s
    };
}

<div class="d-flex align-items-center gap-2 mb-2 flex-wrap">
    <span class="small text-muted" style="min-width:5.5em;">Span</span>
    <div class="btn-group btn-group-sm flex-wrap" role="group" aria-label="Radio scope span">
        @foreach (var (value, label) in spans)
        {
            <button type="button" class="btn btn-outline-secondary scope-span-btn"
                    data-value="@value" data-a11y-key="radioScope.span@(label)"
                    aria-label="Radio scope span @label" title="Radio scope span @label">@label</button>
        }
    </div>
</div>

<div class="d-flex align-items-center gap-2 mb-2 flex-wrap">
    <span class="small text-muted" style="min-width:5.5em;">Display</span>
    <div class="btn-group btn-group-sm" role="group" aria-label="Radio scope display type">
        <button type="button" class="btn btn-outline-secondary scope-type-btn"
                data-value="wf" data-a11y-key="radioScope.typeWf"
                title="Waterfall display">W/F</button>
        <button type="button" class="btn btn-outline-secondary scope-type-btn"
                data-value="3dss" data-a11y-key="radioScope.type3dss"
                title="3DSS — the radio's three-dimensional spectrum stream display">3DSS</button>
    </div>

    <div class="btn-group btn-group-sm ms-2" role="group" aria-label="Radio scope placement">
        <button type="button" class="btn btn-outline-secondary scope-place-btn"
                data-value="0" data-a11y-key="radioScope.placeCenter"
                title="Centre — the scope stays centred on the operating frequency">Center</button>
        <button type="button" class="btn btn-outline-secondary scope-place-btn"
                data-value="1" data-a11y-key="radioScope.placeCursor"
                title="Cursor — the marker moves within a fixed window">Cursor</button>
        <button type="button" class="btn btn-outline-secondary scope-place-btn"
                data-value="2" data-a11y-key="radioScope.placeFix"
                title="Fix — the window stays put on the band regardless of where you tune">Fix</button>
    </div>

    <div class="scope-size-group btn-group btn-group-sm ms-2" role="group" aria-label="Radio scope size">
        @for (var i = 0; i < sizeLabels.Length; i++)
        {
            <button type="button" class="btn btn-outline-secondary scope-size-btn"
                    data-value="@i" data-a11y-key="radioScope.size@(sizeLabels[i])"
                    title="@SizeTitle(sizeLabels[i]) — waterfall modes only">@sizeLabels[i]</button>
        }
    </div>
</div>

@if (speedLabels.Length > 0)
{
    <div class="d-flex align-items-center gap-2 mb-2 flex-wrap">
        <span class="small text-muted" style="min-width:5.5em;">Speed</span>
        <div class="btn-group btn-group-sm flex-wrap" role="group" aria-label="Radio scope FFT speed">
            @for (var i = 0; i < speedLabels.Length; i++)
            {
                <button type="button" class="btn btn-outline-secondary scope-speed-btn"
                        data-value="@i" data-a11y-key="radioScope.speed@(speedLabels[i])"
                        title="FFT sweep speed @speedLabels[i]">@speedLabels[i]</button>
            }
        </div>
    </div>
}

@if (hasAfFft)
{
    <div class="d-flex align-items-center gap-2 mb-0 flex-wrap">
        <span class="small text-muted" style="min-width:5.5em;">MULTI</span>
        <button type="button" class="btn btn-outline-secondary btn-sm scope-multi-btn"
                data-a11y-key="radioScope.multi"
                @(hasMulti ? null : "disabled")
                title="@(hasMulti
                    ? "Show or hide the oscilloscope and AF-FFT on the radio's screen"
                    : "The radio has no CAT command for MULTI — press it on the TFT.")">MULTI</button>

        <span class="small text-muted ms-2">AF-FFT</span>
        <div class="btn-group btn-group-sm" role="group" aria-label="AF-FFT attenuator">
            @foreach (var (value, label) in fftAtts)
            {
                <button type="button" class="btn btn-outline-secondary scope-fftatt-btn"
                        data-value="@value" data-a11y-key="radioScope.fftAtt@(value)"
                        title="AF-FFT attenuator @label (applies when MULTI is showing on the radio)">@label</button>
            }
        </div>

        <span class="small text-muted ms-2">OSC</span>
        <div class="btn-group btn-group-sm" role="group" aria-label="Oscilloscope attenuator">
            @foreach (var (value, label) in fftAtts)
            {
                <button type="button" class="btn btn-outline-secondary scope-oscatt-btn"
                        data-value="@value" data-a11y-key="radioScope.oscAtt@(value)"
                        title="Oscilloscope attenuator @label (applies when MULTI is showing on the radio)">@label</button>
            }
        </div>

        <span class="small text-muted ms-2">Time</span>
        <div class="btn-group btn-group-sm flex-wrap" role="group" aria-label="Oscilloscope timebase">
            @foreach (var (value, label) in oscTimes)
            {
                <button type="button" class="btn btn-outline-secondary scope-osctime-btn"
                        data-value="@value" data-a11y-key="radioScope.oscTime@(value)"
                        title="Oscilloscope timebase @label">@label</button>
            }
        </div>
    </div>
}
