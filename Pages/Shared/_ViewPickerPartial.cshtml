@model string
@using Yaesu_Web_Control.Models
@* The View dropdown: Classic, Experimental or Radio. The model is the
   button's class, so it can match the nav bar it sits in. Opening a view
   saves it as ApplicationSettings.LastView (IndexModel.OnGetAsync), and the
   app opens that one at start-up through /start. On any other page the
   button just reads "View". *@
@{
    var current = AppViews.ForPath(Context.Request.Path.Value);
}
<button class="@Model dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false"
        title="Choose a view. The one you used last opens when the app starts.">
    @if (current != null)
    {
        <i class="bi @current.Icon" aria-hidden="true"></i> <span class="visually-hidden">View: </span>@current.Label
    }
    else
    {
        <i class="bi bi-window" aria-hidden="true"></i> @:View
    }
</button>
<ul class="dropdown-menu">
    @foreach (var v in AppViews.All)
    {
        <li>
            <a class="dropdown-item@(v == current ? " active" : "")" href="@v.Path" title="@v.Title" aria-current="@(v == current ? "page" : null)">
                <i class="bi @v.Icon" aria-hidden="true"></i> @v.Label
            </a>
        </li>
    }
</ul>
