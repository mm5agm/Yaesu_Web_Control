@model bool
@inject Yaesu_Web_Control.Services.ISettingsService SettingsSvc
@{
    // The RTTY tuner's markup and CSS, shared by the main page's floating
    // dialog and the /RttyTuner pop-out window. RttyTuner (core) finds its
    // elements by these ids, so both pages run the same tuner code.
    //
    // Model: true for the pop-out, which swaps the Pop out button for
    // Reattach; its close button closes the window rather than the dialog.
    var popout = Model;

    // RTTY Contest Mode (Settings). Read here rather than passed in, so the
    // main page's dialog and the pop-out window cannot end up disagreeing
    // about it.
    var contest = (await SettingsSvc.GetSettingsAsync()).RttyContestMode;
}
<style>
    #rttyTunerDialog { width:340px; min-width:220px; min-height:200px; max-width:95vw; max-height:95vh; resize:both; overflow:auto; }
    #rttyTunerDialog[open] { display:flex; flex-direction:column; }
    #rttyTunerDialog .rtty-header { flex:0 0 auto; cursor:move; }
    #rttyTunerDialog .rtty-body { flex:1 1 auto; min-height:0; display:flex; flex-direction:column; }
    #rttyTunerDialog .rtty-scope-box { flex:0 0 auto; }
    /* Once the operator has sized the dialog, or in the pop-out, the scope
       takes whatever room is left and stays square inside it. Positioned so
       that the canvas's own size cannot push the box bigger. */
    #rttyTunerDialog.user-sized .rtty-scope-box { flex:1 1 auto; min-height:120px; position:relative; overflow:hidden; }
    #rttyTunerDialog.user-sized #rttyTunerCanvas { position:absolute; left:50%; top:50%; transform:translate(-50%, -50%); }
    /* Tones only: once Mark is set the operator only needs the cross, so the
       settings and readouts go and the window can be made very small. */
    #rttyTunerDialog.rtty-compact .rtty-controls,
    #rttyTunerDialog.rtty-compact #rttyTunerInfo,
    #rttyTunerDialog.rtty-compact .rtty-hint { display:none !important; }
    #rttyTunerDialog.rtty-compact .rtty-body { padding:0.25rem !important; }
    #rttyTunerDialog.rtty-compact { min-width:160px; min-height:160px; }
    /* Contest Mode: the tuner and nothing else. The hint is there to teach the
       figure, and an operator in a contest has long since learnt it.

       The second rule is the one Bruce VK2RT asked for and did not get. Both
       lines are live regions whose text changes length as the tuner reports -
       "Stopped." to "Mark 2125, shift 450" and back - and every reflow moved
       the scope under a mouse that was tuning. Two lines' worth of room is
       reserved so the text grows into it instead of pushing. min-height, not
       height: a long message still wraps rather than being clipped, and it is
       only the common case that has to stop jumping. */
    #rttyTunerDialog.rtty-contest .rtty-hint { display:none !important; }
    #rttyTunerDialog.rtty-contest #rttyTunerInfo,
    #rttyTunerDialog.rtty-contest #rttyTunerStatus { min-height:2.4em; }
    /* Shown only in the pop-out, which stays open when the mode changes
       rather than vanishing off a second monitor. */
    #rttyTunerPaused {
        font-size: 0.95rem;
        font-weight: 600;
        color: #ffd23f;
        background: rgba(255, 210, 63, 0.10);
        border-left: 3px solid #ffd23f;
        padding: 0.5rem 0.6rem;
        border-radius: 0.25rem;
        margin-bottom: 0.5rem;
    }
</style>
<!-- RTTY tuner: the mark filter on X, the space filter on Y, as a terminal unit
     used to drive an oscilloscope. Non-modal so the VFO stays in reach. -->
<dialog id="rttyTunerDialog" open="@popout"
        class="@(string.Join(" ", new[] { popout ? "rtty-popout user-sized" : null, contest ? "rtty-contest" : null }.Where(c => c is not null)))"
        style="@(popout ? null : "border:1px solid #555; border-radius:8px; background:#222; color:#eee; padding:0;")"
        aria-labelledby="rttyTunerTitle">
    <div class="rtty-header d-flex align-items-center justify-content-between px-3 py-2" style="border-bottom:1px solid #444;">
        <strong id="rttyTunerTitle">RTTY Tuner</strong>
        <div class="d-flex align-items-center gap-1">
            <button id="rttyTunerCompactBtn" class="btn btn-sm btn-outline-secondary" type="button" aria-pressed="false"
                    title="Tones only - show just the scope, without Mark, Shift and the readouts"
                    aria-label="Tones only view"><i class="bi bi-fullscreen-exit" aria-hidden="true"></i></button>
            @if (popout)
            {
                <button id="rttyTunerReattachBtn" class="btn btn-sm btn-outline-secondary" type="button"
                        title="Put the RTTY tuner back in the main page"
                        aria-label="Reattach the RTTY tuner to the main page">Reattach</button>
                <button class="btn btn-sm ywc-dialog-close" type="button" onclick="window.close()"
                        aria-label="Close the RTTY tuner window">&#10005;</button>
            }
            else
            {
                <button id="rttyTunerPopoutBtn" class="btn btn-sm btn-outline-secondary" type="button"
                        title="Open the RTTY tuner in a window of its own, which can go on another monitor"
                        aria-label="Pop the RTTY tuner out into its own window"><i class="bi bi-box-arrow-up-right" aria-hidden="true"></i></button>
                <button class="btn btn-sm ywc-dialog-close" type="button"
                        onclick="document.getElementById('rttyTunerDialog').close()"
                        aria-label="Close RTTY tuner">&#10005;</button>
            }
        </div>
    </div>
    <div class="rtty-body p-2">
        <div id="rttyTunerPaused" role="status" hidden></div>
        <div class="rtty-controls d-flex align-items-center gap-2 mb-2 small flex-wrap">
            <label for="rttyTunerMark">Mark</label>
            <input id="rttyTunerMark" type="number" min="300" max="3000" step="5" value="2125"
                   class="form-control form-control-sm" style="width:5.5rem;"
                   title="Mark tone in the receive audio, Hz. 2125 unless your RTTY setup says otherwise.">
            @* 450 is not one of this radio's own RTTY Shift Width rungs - that menu
               offers 170, 200, 425 and 850 - but the DWD weather stations use it all
               day and the decoder here can copy it. Auto adds an entry of its own
               when it measures a shift that is none of these; see _setChoice in
               rtty-tuner.js. *@
            <label for="rttyTunerShift">Shift</label>
            <select id="rttyTunerShift" class="form-select form-select-sm" style="width:auto;"
                    title="Shift between the two tones, Hz. 170 is amateur RTTY. 450 and 850 are ordinary on utility stations; the radio's own RTTY Shift Width menu has no 450 rung but YWC can still copy it.">
                <option value="170">170</option>
                <option value="200">200</option>
                <option value="425">425</option>
                <option value="450">450</option>
                <option value="850">850</option>
            </select>
            @* The scope does not use the speed - it is two filters and speed
               means nothing to them. The reader does: it is the one setting on
               this panel that only matters to the decoder. Kept on the server
               with Mark and Shift so a page reload does not lose it. *@
            <label for="rttyTunerBaud">Speed</label>
            <select id="rttyTunerBaud" class="form-select form-select-sm" style="width:auto;"
                    title="Sending speed in baud, and what the decoder reads at. 45.45 is amateur RTTY and the only speed the radio's own decoder reads; 50 is most European weather and commercial traffic. The scope itself does not need this.">
                <option value="45.45">45.45</option>
                <option value="50">50</option>
                <option value="75">75</option>
                <option value="100">100</option>
            </select>
            <div class="form-check mb-0">
                <input class="form-check-input" type="checkbox" id="rttyTunerReverse">
                <label class="form-check-label" for="rttyTunerReverse"
                       title="Space on the other side of mark: reversed tones, or REV on the radio">Rev</label>
            </div>
        </div>
        <div class="rtty-scope-box">
            <canvas id="rttyTunerCanvas" width="320" height="320"
                    style="width:100%; display:block; border:1px solid #444; border-radius:6px;"
                    aria-label="RTTY crossed-ellipse tuning scope"></canvas>
        </div>
        <div id="rttyTunerInfo" class="mt-1"
             style="font-family:ui-monospace,Consolas,monospace; font-size:0.72rem; color:#9ab;">
            Waiting.
        </div>
        <div id="rttyTunerStatus" class="mt-1 small" role="status" aria-live="polite">Stopped.</div>
        <div class="rtty-hint small mt-1" style="color:#9ab;">
            Tune for a clean cross: mark draws the line across, space the line up.
            Arms leaning and opening means off tune.
        </div>
    </div>
</dialog>
