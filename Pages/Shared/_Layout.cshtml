<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="Content-Language" content="en">
    <meta name="language" content="en">
    <meta name="x-app-version" content="@Yaesu_Web_Control.AppVersion.Current">
    <title>@(ViewData["Title"]?.ToString() == "Yaesu Web Control" ? "Yaesu Web Control" : ViewData["Title"] + " - Yaesu Web Control")</title>
    <script type="importmap">{}</script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/Yaesu_Web_Control.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/gauge-debug.css" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <!-- Canvas Gauges Library for Analog Meters -->
    <script src="https://cdn.jsdelivr.net/npm/canvas-gauges@2.1.7/gauge.min.js"></script>

    <!-- Calibration engine — exposes window.calibrationEngine for site.js -->
    <!-- v=15: bump this when calibration-engine.js or calibration-tables.js changes -->
    <script type="module">
        import { calibrateNumeric, calibrateSMeterLabel, calibrateSMeterForGauge, loadFromBackend } from '/js/calibration/calibration-engine.js?v=15';
        // Expose immediately with default tables so site.js never gets undefined.
        window.calibrationEngine = { calibrateNumeric, calibrateSMeterLabel, calibrateSMeterForGauge };
        // S-Meter calibration drives BOTH the gauge needle position (SMETER
        // table) AND the snap-to-nearest label ("S7", "+20") (SMETER_LABELS).
        // Without targeting both, calibrating the S-meter only fixed the
        // labels and left the gauge needle on hardcoded defaults — #29 bug.
        const calibMap = { 'S-Meter': ['SMETER', 'SMETER_LABELS'] };
        // Expose loadFromBackend so the SignalR listener below (and the
        // Meter Calibration page after save) can refresh the live tables.
        window.calibrationEngine.reload = () => loadFromBackend(calibMap);
        // Initial load — replace defaults with any user-saved calibration.
        window.calibrationEngine.reload();
    </script>

    <!-- Meter formatters — exposes window.MeterFormatters for site.js -->
    <script type="module">
        import { MeterFormatters } from '/js/ui/meter-formatters.js?v=8';
        window.MeterFormatters = MeterFormatters;
    </script>
</head>
<body>
    @* sticky-top is on <header>, not the inner <nav>. Position: sticky tracks
       the nearest scrolling containing block (here, <body>). If sticky-top is
       on the nav instead, the containing block becomes <header>, which is only
       as tall as the nav itself — so the nav scrolls away with the header
       rather than sticking. v2.2.1 shipped with sticky-top on the nav and
       didn't actually stick; this layout puts it on the header where it
       works. *@
    <header class="sticky-top bg-white" @(((string?)ViewData["BodyRole"] == "application") ? Html.Raw("aria-hidden=\"true\"") : Html.Raw(""))>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow" style="padding-top: 0; padding-bottom: 0; margin-bottom: 2px; min-height: 0;">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-page="/Index" data-a11y-key="nav.brand" aria-label="Yaesu Web Control home">Yaesu Web Control <small class="text-muted fw-normal" style="font-size: 0.6em;">v@(AppVersion.Current) &copy; 2025</small></a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-page="/About">About</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-page="/UserManual">User Manual</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-page="/Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-page="/Settings">Settings</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-page="/ApplicationSetup">Application Setup</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" href="/MeterCalibration">Meter Calibration</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-page="/Memories">Memories</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-page="/Labels">Accessibility Labels</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container-fluid">
        @{
            var _bodyRole  = (string?)ViewData["BodyRole"]  ?? "main";
            var _bodyLabel = (string?)ViewData["BodyLabel"];
        }
        <main role="@_bodyRole" @(_bodyLabel != null ? Html.Raw($"aria-label=\"{_bodyLabel}\"") : Html.Raw("")) class="pb-1">
            @RenderBody()
        </main>
    </div>


    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
    <script src="~/js/ui/site.js" asp-append-version="true"></script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>