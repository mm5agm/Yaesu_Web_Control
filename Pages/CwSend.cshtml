@page
@model Yaesu_Web_Control.Pages.CwSendModel
@{
    Layout = null;
    ViewData["Title"] = "CW Send";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="x-app-version" content="@Yaesu_Web_Control.AppVersion.Current">
    <title>CW Send - Yaesu Web Control</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        html, body { height: 100%; margin: 0; background: #222; color: #eee; overflow: hidden; }
        /* The panel is the whole window here, not a floating dialog: the
           window's own frame does the moving and resizing. */
        #cwSendDialog.cws-popout {
            position: static;
            display: flex;
            flex-direction: column;
            width: 100%;
            height: 100%;
            min-width: 0;
            min-height: 0;
            max-width: none;
            max-height: none;
            margin: 0;
            padding: 0;
            border: 0;
            border-radius: 0;
            background: #222;
            color: #eee;
            resize: none;
            overflow: auto;
        }
        #cwSendDialog.cws-popout .cws-header { cursor: default; flex-wrap: wrap; gap: 0.4rem; }
        #cwSendDialog.cws-popout .cws-header > div { flex-wrap: wrap; }
        .popout-screen-offer {
            font-size: 0.85rem; color: #cde; background: rgba(120, 170, 255, 0.10);
            border-left: 3px solid #78aaff; border-radius: 0.25rem;
            padding: 0.4rem 0.6rem; margin-bottom: 0.5rem;
        }
    </style>
</head>
<body>
    <partial name="_CwSendPartial" model="new Yaesu_Web_Control.Pages.CwSendPartialModel(true, Model.CwSpeed)" />

    <script src="~/lib/microsoft-signalr/signalr.min.js"></script>
    @* Builds the hub connection with a retry policy that never gives up.
       This page has no _Layout, so it must load it itself. *@
    <script src="~/js/hub/hub-connection.js" asp-append-version="true"></script>
    <script type="module">
        import { CwSendPanel } from "/js/ui/cw-send-panel.js?v=@Yaesu_Web_Control.AppVersion.Current";
        import { PopoutChild, offerScreenPermission } from "/js/popout/popout.js?v=@Yaesu_Web_Control.AppVersion.Current";

        const popout = new PopoutChild({ name: 'cw-send', fallbackUrl: '/' }).start();
        offerScreenPermission(document.querySelector('#cwSendDialog .cws-body'));

        const panel = new CwSendPanel();
        panel.init();
        panel.setBreakIn('@Model.CwBreakIn' || null);
        panel.setMode('A', '@Model.ModeA');
        panel.setMode('B', '@Model.ModeB');
        panel.setTxVfo(@Model.TxVfo);
        panel.show();

        // The queue lives in this window. Closing it mid-line would leave the
        // radio's M5 holding a piece of the line instead of the operator's own
        // text, so while anything is going out Reattach waits and closing the
        // window asks first.
        const reattachBtn = document.getElementById('cwSendReattachBtn');
        const closeBtn = document.getElementById('cwSendWindowCloseBtn');
        const busyTitle = 'Wait for the line to finish (or press Stop) - CW Send puts M5 back when it is done';
        const reattachTitle = reattachBtn?.title ?? '';
        // The main page's M1-M5 buttons are marked busy while a line from
        // this window is going out, as they are for one sent from the dialog.
        let busyChannel = null;
        try { busyChannel = new BroadcastChannel('ywc-cw-send-busy'); } catch { /* old browser: no marking */ }
        panel.onBusy = busy => {
            if (reattachBtn) {
                reattachBtn.disabled = busy;
                reattachBtn.title = busy ? busyTitle : reattachTitle;
            }
            try { busyChannel?.postMessage({ busy }); } catch { /* ignore */ }
        };
        reattachBtn?.addEventListener('click', () => { if (!panel.busy) popout.reattach(); });
        closeBtn?.addEventListener('click', () => window.close());
        window.addEventListener('beforeunload', e => {
            if (!panel.busy) return;
            e.preventDefault();
            e.returnValue = '';
        });
        window.addEventListener('pagehide', () => {
            try { busyChannel?.postMessage({ busy: false }); } catch { /* ignore */ }
        });

        // Speed and break-in, and the hub's state replay on connect. This
        // connection is also what keeps the host running while this window is
        // the only one open: the page sets Layout = null, so there is no
        // site.js here.
        const conn = window.rwcHubConnection('/radioHub');
        conn.on('RadioStateUpdate', update => {
            if (update.property === 'CwSpeed')   panel.setSpeed(update.value);
            if (update.property === 'CwBreakIn') panel.setBreakIn(update.value);
            if (update.property === 'ModeA')     panel.setMode('A', update.value);
            if (update.property === 'ModeB')     panel.setMode('B', update.value);
            if (update.property === 'TxVfo')     panel.setTxVfo(update.value);
        });
        conn.start().catch(err => console.error('[cw-send-popout]', err));
    </script>
</body>
</html>
