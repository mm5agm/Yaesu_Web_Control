@page
@model Yaesu_Web_Control.Pages.CwPaddleModel
@{
    Layout = null;
    ViewData["Title"] = "CW Paddle";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="x-app-version" content="@Yaesu_Web_Control.AppVersion.Current">
    <title>CW Paddle (test) - Yaesu Web Control</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        body { background: #222; color: #eee; padding: 1rem; font-size: 0.95rem; }
        h1 { font-size: 1.3rem; }
        .cwp-dry { background: #3a3000; border: 1px solid #a80; color: #fd6; padding: 0.4rem 0.7rem; border-radius: 4px; margin-bottom: 0.8rem; }
        .cwp-dry.live { background: #4a0d0d; border-color: #e44; color: #fcc; }
        .cwp-note { font-size: 0.85rem; color: #bbb; margin-top: 0.4rem; }
        fieldset { border: 1px solid #555; border-radius: 4px; padding: 0.5rem 0.8rem; margin-bottom: 0.8rem; }
        legend { float: none; width: auto; font-size: 0.9rem; padding: 0 0.3rem; margin: 0; color: #aaa; }
        .cwp-row { display: flex; flex-wrap: wrap; gap: 0.6rem 1.2rem; align-items: center; }
        .cwp-row label { display: flex; gap: 0.35rem; align-items: center; margin: 0; }
        input[type=number] { width: 5em; }
        input, select { background: #333; color: #eee; border: 1px solid #666; border-radius: 3px; }
        .cwp-lamp { display: inline-block; min-width: 4.5em; text-align: center; padding: 0.3rem 0.6rem; border-radius: 4px; background: #333; border: 1px solid #555; color: #888; font-weight: bold; }
        .cwp-lamp.on { background: #2a7; color: #fff; border-color: #4c9; }
        #cwpKeyLamp.on { background: #c33; border-color: #f66; }
        #cwpCopy { font-family: Consolas, monospace; font-size: 1.3rem; min-height: 3.2em; background: #111; padding: 0.4rem 0.6rem; border-radius: 4px; white-space: pre-wrap; word-break: break-all; }
        #cwpLog { font-family: Consolas, monospace; font-size: 0.8rem; height: 18em; overflow-y: auto; background: #111; padding: 0.4rem 0.6rem; border-radius: 4px; white-space: pre; }
        button { font-size: 0.85rem; }
    </style>
</head>
<body>
    <h1>CW Paddle (test)</h1>
    <div id="cwpBanner" class="cwp-dry">Dry run: nothing is sent to the radio. With Send to the shack PC ticked, YWC plays the keying into its log only; it opens no COM port and keys nothing.</div>

    <fieldset>
        <legend>Paddle (MIDI)</legend>
        <div class="cwp-row">
            <button id="cwpConnect" class="btn btn-sm btn-primary">Connect paddle</button>
            <label>Device <select id="cwpDevice"><option value="">All MIDI inputs</option></select></label>
            <label>Dit note <input id="cwpDitNote" type="number" min="0" max="127"></label>
            <label>Dah note <input id="cwpDahNote" type="number" min="0" max="127"></label>
            <label>Channel <select id="cwpChannel"></select></label>
            <label><input id="cwpSwap" type="checkbox"> Swap paddles</label>
        </div>
        <div id="cwpStatus" class="mt-2">Press Connect paddle. The browser will ask to use MIDI devices.</div>
    </fieldset>

    <fieldset>
        <legend>Keyer and sidetone</legend>
        <div class="cwp-row">
            <label>WPM <input id="cwpWpm" type="number" min="5" max="50"></label>
            <label>Iambic <select id="cwpMode"><option value="A">Mode A</option><option value="B">Mode B</option></select></label>
            <label>Paddle stuck after <input id="cwpStuck" type="number" min="1" max="30"> s</label>
            <label><input id="cwpTone" type="checkbox"> Sidetone</label>
            <label>Pitch <input id="cwpPitch" type="number" min="300" max="1200" step="10"> Hz</label>
            <label>Volume <input id="cwpVolume" type="range" min="0" max="100"></label>
        </div>
    </fieldset>

    <fieldset>
        <legend>Shack PC</legend>
        <div class="cwp-row">
            <label><input id="cwpLink" type="checkbox"> Send to the shack PC</label>
            <span id="cwpLinkStatus">Not sending.</span>
        </div>
        <div class="cwp-row mt-2">
            <label>Key line <select id="cwpKeyPort"><option value="">Dry run: log only</option></select></label>
            <span id="cwpKeyPortStatus"></span>
        </div>
        <div class="cwp-note">
            Keying the radio uses DTR on its <b>Standard</b> COM port, never the CAT port. On the radio:
            PC KEYING = DTR (set it on the radio's own MENU; the FTdx101 would not take it by CAT).
            <b>Choosing a COM port here transmits, even with BREAK-IN off</b> (seen on the FTdx101MP).
            Use a dummy load or be ready to be on the air. The key line goes back to the dry run whenever YWC restarts.
        </div>
    </fieldset>

    <div class="cwp-row mb-2">
        <span id="cwpDitLamp" class="cwp-lamp">DIT</span>
        <span id="cwpDahLamp" class="cwp-lamp">DAH</span>
        <span id="cwpKeyLamp" class="cwp-lamp">KEY</span>
    </div>

    <div class="d-flex justify-content-between align-items-end"><span class="text-secondary">What the keyer sent</span><button id="cwpClearCopy" class="btn btn-sm btn-outline-light mb-1">Clear</button></div>
    <div id="cwpCopy" class="mb-3"></div>

    <div class="d-flex justify-content-between align-items-end"><span class="text-secondary">Log (times in ms since the page opened)</span><button id="cwpClearLog" class="btn btn-sm btn-outline-light mb-1">Clear</button></div>
    <div id="cwpLog"></div>

    <script src="~/lib/microsoft-signalr/signalr.min.js"></script>
    @* This page has no _Layout, so it loads the hub connection helper itself. *@
    <script src="~/js/hub/hub-connection.js" asp-append-version="true"></script>
    @* Built here so this page holds the host up like every other one, even
       before the module loads; the module uses it for the shack link. *@
    <script>window.cwpHub = window.rwcHubConnection("/radioHub");</script>
    <script type="module" src="~/js/ui/cw-paddle-page.js" asp-append-version="true"></script>
</body>
</html>
