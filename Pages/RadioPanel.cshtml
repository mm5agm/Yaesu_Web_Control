@page "/radio"
@model Yaesu_Web_Control.Pages.RadioPanelModel
@{
    Layout = null;
}
@* The radio panel draws its own page: no Bootstrap, no site nav, and by
   Colin's choice (2026-10-13) no external-program launcher links and no
   accessibility layer - Classic keeps both. *@
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Radio - Yaesu Web Control</title>
    <link rel="icon" href="~/favicon.ico" />
    <style>html, body { margin: 0; height: 100%; background: #0b0d10; }</style>
</head>
<body>
    <div id="radioPanel"></div>

    <script src="~/lib/microsoft-signalr/signalr.min.js"></script>
    <script src="~/js/hub/hub-connection.js" asp-append-version="true"></script>
    <script>window.ywcAutoModeChangeOnTune = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.AutoModeChangeOnTune));</script>
    <script type="module">
        import { startYaesuRadioPanel } from '/js/ui/radio-panel-yaesu.js?v=@Yaesu_Web_Control.AppVersion.Current';
        // Layout = null, so no site.js: this connection is what tells the host
        // a browser is still here. The adapter uses it for live state too.
        const conn = window.rwcHubConnection('/radioHub');
        startYaesuRadioPanel(document.getElementById('radioPanel'), {
            conn,
            model: '@Model.RadioModel',
            dual: @(Model.IsDual ? "true" : "false"),
            maxPowerW: @Model.MaxPower,
            maxHz: @Model.MaxHz,
            scopeCat: @(Model.HasScopeCat ? "true" : "false"),
            bandPlan: '@Model.BandPlan',
            vdd: @(Model.HasVdd ? Html.Raw($"{{ min: {Model.VddDial.Min}, max: {Model.VddDial.Max} }}") : Html.Raw("null")),
            paTemp: @(Model.HasPaTemp ? "true" : "false"),
            antennas: @(Model.HasAntennaSelector ? Html.Raw("['1', '2', '3']") : Html.Raw("[]")),
            roofing: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.RoofingChoices.Select(o => new { code = o.Code, label = o.Label }))),
            // The same lists as the other views' Views and Menu dropdowns
            // (Models/AppViews.cs, Models/AppMenu.cs).
            views: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Yaesu_Web_Control.Models.AppViews.All.Select(v => new { label = v.Label, href = v.Path, title = v.Title, on = v.Key == Yaesu_Web_Control.Models.AppViews.Radio }))),
            menu: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Yaesu_Web_Control.Models.AppMenu.Groups.Select(g => new { group = g.Name.ToUpperInvariant(), items = g.Pages.Select(pg => new { label = pg.Label, href = pg.Path }) }))),
        });
    </script>
</body>
</html>
