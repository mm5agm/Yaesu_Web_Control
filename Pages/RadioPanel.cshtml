@page "/radio"
@model Yaesu_Web_Control.Pages.RadioPanelModel
@{
    Layout = null;
}
@* The radio panel draws its own page: no Bootstrap, no site nav, and by
   Colin's choice (2026-10-13) no external-program launcher links and no
   accessibility layer - Classic keeps both. *@
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="x-app-version" content="@Yaesu_Web_Control.AppVersion.Display">
    <meta name="x-app-repo" content="mm5agm/Yaesu_Web_Control">
    <meta name="x-app-name" content="Yaesu Web Control">
    <title>Radio - Yaesu Web Control</title>
    <link rel="icon" href="~/favicon.ico" />
    <link rel="stylesheet" href="~/css/limited-cat.css" asp-append-version="true" />
    <style>html, body { margin: 0; height: 100%; background: #0b0d10; }</style>
    <script src="~/js/update/update-banner.js" asp-append-version="true"></script>
    <script type="module" src="~/js/txalert/tx-alert.js" asp-append-version="true"></script>
</head>
<body class="@(Model.LimitedCat ? (Model.CanSelectRxVfo ? "ywc-limited-cat ywc-vfo-ab" : "ywc-limited-cat") : null)">
    <div id="radioPanel"></div>

    <script src="~/lib/microsoft-signalr/signalr.min.js"></script>
    <script src="~/js/hub/hub-connection.js" asp-append-version="true"></script>
    <script>window.ywcAutoModeChangeOnTune = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.AutoModeChangeOnTune));</script>
    <script type="module">
        import { startYaesuRadioPanel } from '/js/ui/radio-panel-yaesu.js?v=@Yaesu_Web_Control.AppVersion.Current';
        // Layout = null, so no site.js: this connection is what tells the host
        // a browser is still here. The adapter uses it for live state too.
        const conn = window.rwcHubConnection('/radioHub');
        startYaesuRadioPanel(document.getElementById('radioPanel'), {
            conn,
            model: '@Model.RadioModel',
            dual: @(Model.IsDual ? "true" : "false"),
            maxPowerW: @Model.MaxPower,
            maxHz: @Model.MaxHz,
            limitedCat: @(Model.LimitedCat ? "true" : "false"),
            vfoSelect: @(Model.CanSelectRxVfo ? "true" : "false"),
            scopeCat: @(Model.HasScopeCat ? "true" : "false"),
            bandPlan: '@Model.BandPlan',
            vdd: { min: @Model.VddDial.Min, max: @Model.VddDial.Max },
            paTemp: @(Model.HasPaTemp ? "true" : "false"),
            antennas: @(Model.HasAntennaSelector ? Html.Raw("['1', '2', '3']") : Html.Raw("[]")),
            // AUDIO beside SCOPE on the spectrum: the radio's receive audio in
            // a waterfall window, a click on a signal tunes to it.
            audioUrl: '/audio-waterfall',
            roofing: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.RoofingChoices.Select(o => new { code = o.Code, label = o.Label }))),
            views: [
                { label: 'Classic', href: '/' },
                { label: 'Experimental', href: '/flexui' },
                { label: 'Radio', href: '/radio', on: true },
                { label: 'RTTY Contest', href: '/rtty-contest' },
            ],
            menu: [
                { group: 'SETUP', items: [
                    { label: 'Settings', href: '/Settings' },
                    { label: 'Application Setup', href: '/ApplicationSetup' },
                    { label: 'Memories', href: '/Memories' },
                    { label: 'Labels', href: '/Labels' },
                    { label: 'Meter Calibration', href: '/MeterCalibration' },
                    { label: 'Diagnostics', href: '/Diagnostics' },
                ] },
                { group: 'RECEIVE', items: [
                    { label: 'Audio Waterfall', href: '/audio-waterfall', title: "The radio's USB audio with mode guesses; click a signal to tune to it" },
                    { label: 'Spot Map', href: '/spot-map', title: 'Who hears you and who you hear, live from PSK Reporter' },
                ] },
                { group: 'CW', items: [
                    { label: 'CW Paddle', href: '/CwPaddle', title: 'Key the radio from a paddle on a MIDI adapter' },
                ] },
                { group: 'HELP', items: [
                    { label: 'User Manual', href: '/UserManual' },
                    { label: 'About', href: '/About' },
                ] },
            ],
        });
    </script>
</body>
</html>
